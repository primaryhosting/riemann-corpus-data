/-- Euclidean distance -/
def euclidean_dist (p q : ℝ × ℝ) : ℝ :=
  Real.sqrt ((p.1 - q.1)^2 + (p.2 - q.2)^2)

/-- Rational distance set (WITH PROPER COERCION) -/
def RationalDistanceSet (S : Set (ℝ × ℝ)) : Prop :=
  ∀ p q, p ∈ S → q ∈ S → ∃ r : ℚ, euclidean_dist p q = (r : ℝ)

/-- Dense in plane -/
def IsDensePlane (S : Set (ℝ × ℝ)) : Prop :=
  ∀ x : ℝ × ℝ, ∀ ε > 0, ∃ s ∈ S, euclidean_dist x s < ε

/-- Erdős-Ulam conjecture (OPEN as of Feb 2026) -/
def erdos_ulam_conjecture : Prop :=
  ¬∃ S : Set (ℝ × ℝ), RationalDistanceSet S ∧ IsDensePlane S

/-- Quarter-turn rotation -/
def quarter_turn (p : ℝ × ℝ) : ℝ × ℝ := (-p.2, p.1)

#check IsSquare
#check irrational_sqrt_natCast_iff

/-
If k is square-free and not 1, then k is not a perfect square.
-/
lemma square_free_and_ne_one_implies_not_square (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (hk_ne_one : k ≠ 1) : ¬IsSquare k := by
  rw [ isSquare_iff_exists_sq ];
  -- Assume there exists an r such that k = r^2. Then r must be greater than 1 because k is not 1.
  by_contra h_contra
  obtain ⟨r, hr⟩ := h_contra
  have hr_gt_one : 1 < r := by
    rcases r with ( _ | _ | r ) <;> simp_all +decide;
    linarith [ hk 2 ];
  exact hk r hr_gt_one ( hr.symm ▸ dvd_rfl )

/-
If k is not a perfect square, then any set S of points (x, y√k) with rational x, y that is invariant under quarter-turn rotation must be contained in the x-axis.
-/
theorem quarter_turn_obstruction (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (h_nonsquare : ¬IsSquare k) :
    let S := {p : ℝ × ℝ | ∃ x y : ℚ, p = ((x : ℝ), (y : ℝ) * Real.sqrt (k : ℝ))}
    (∀ p ∈ S, quarter_turn p ∈ S) →
    (∀ p ∈ S, p.2 = 0) := by
      intros S hS p hp;
      -- By assumption, $p = (x, y\sqrt{k})$ for some $x, y \in \mathbb{Q}$.
      obtain ⟨x, y, hx⟩ : ∃ x y : ℚ, p = ((x : ℝ), y * Real.sqrt k) := by
        exact hp;
      -- By assumption, $quarter_turn p \in S$. So there exists $x', y' \in \mathbb{Q}$ such that $quarter_turn p = (x', y' \sqrt{k})$.
      obtain ⟨x', y', hx'⟩ : ∃ x' y' : ℚ, quarter_turn p = ((x' : ℝ), y' * Real.sqrt k) := by
        exact hS p hp;
      -- Since $-y \sqrt{k} = x'$, if $y \neq 0$, then $\sqrt{k} = -\frac{x'}{y}$ is rational.
      by_cases hy : y = 0 <;> simp_all +decide [ quarter_turn ];
      -- Since $y \neq 0$, we can divide both sides of $-y \sqrt{k} = x'$ by $y$ to get $\sqrt{k} = -\frac{x'}{y}$.
      have h_sqrt : Real.sqrt k = -x' / y := by
        exact eq_div_of_mul_eq ( by positivity ) ( by linarith );
      -- Since $\sqrt{k}$ is rational, $k$ must be a perfect square.
      have h_perfect_square : ∃ r : ℚ, k = r^2 := by
        exact ⟨ -x' / y, by rw [ ← @Rat.cast_inj ℝ ] ; push_cast; rw [ ← h_sqrt, Real.sq_sqrt ( Nat.cast_nonneg _ ) ] ⟩;
      exact False.elim <| h_nonsquare <| by obtain ⟨ r, hr ⟩ := h_perfect_square; exact ⟨ r.num.natAbs, by simpa [ ← Int.natCast_inj, sq, Rat.mul_self_num ] using congr_arg Rat.num hr ⟩ ;

/-
If k is not a perfect square, the set S associated with k cannot be both dense in the plane and invariant under quarter-turn rotation.
-/
/-- COROLLARY: No dense set with quarter-turn symmetry on nonsquare lattice -/
theorem no_dense_with_quarter_turn (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (h_nonsquare : ¬IsSquare k) :
    let S := {p : ℝ × ℝ | ∃ x y : ℚ, p = ((x : ℝ), (y : ℝ) * Real.sqrt (k : ℝ))}
    ¬(IsDensePlane S ∧ (∀ p ∈ S, quarter_turn p ∈ S)) := by
      -- By quarter_turn_obstruction, all points in S have y-coordinate 0.
      intros hS_dense hS_symm
      have h_all_y_zero : ∀ p : ℝ × ℝ, p ∈ {p : ℝ × ℝ | ∃ x y : ℚ, p = ((x : ℝ), (y : ℝ) * Real.sqrt (k : ℝ))} → p.2 = 0 := by
        apply quarter_turn_obstruction k hk h_nonsquare hS_symm.right;
      have h_contradiction : ∀ x y : ℝ, ∃ s ∈ hS_dense, euclidean_dist (x, y) s < 1 := by
        exact fun x y => hS_symm.1 ( x, y ) 1 zero_lt_one;
      obtain ⟨ s, hs₁, hs₂ ⟩ := h_contradiction 0 1;
      unfold euclidean_dist at hs₂;
      rw [ Real.sqrt_lt' ] at hs₂ <;> nlinarith [ h_all_y_zero s hs₁ ]

/-- The pentagonal modulus -/
def q : ℕ := 5

/-- Ray assignment -/
def ray (n : ℕ) : Fin 5 := ⟨n % q, Nat.mod_lt n (by decide)⟩

/-- LEMMA: Squares lie on {0,1,4} mod 5 (classical) -/
theorem squares_mod_5 (n : ℕ) :
    (n^2) % 5 ∈ ({0, 1, 4} : Set ℕ) := by
  have h : n % 5 < 5 := Nat.mod_lt n (by decide)
  interval_cases hn : n % 5 <;> simp [Nat.pow_mod, hn] <;> norm_num

/-- RESEARCH FOCUS: Apply quarter-turn obstruction to k=5 case -/
def pentagonal_research_program : Prop :=
  -- For k=5, analyze when quarter-turn symmetry might arise
  -- Use pentagonal geometry to find obstructions
  ∀ S : Set (ℝ × ℝ), RationalDistanceSet S → IsDensePlane S →
  ∃ k : ℕ, (∀ n > 1, ¬(n^2 ∣ k)) ∧ k = 5 → False

/-- CONDITIONAL: Line/circle classification (requires Bombieri-Lang) -/
theorem bombieri_lang_consequence :
  -- This is Tao's conditional result (2014)
  (∀ S : Set (ℝ × ℝ), RationalDistanceSet S → IsDensePlane S → False) ∨
  (∃ S : Set (ℝ × ℝ), RationalDistanceSet S ∧ IsDensePlane S) := by
    grind

/-- CONJECTURE: Dense sets force approximate quarter-turn symmetry -/
def approximate_symmetry_conjecture : Prop :=
  ∀ S : Set (ℝ × ℝ), RationalDistanceSet S → IsDensePlane S →
  ∀ ε > 0, ∃ T : Set (ℝ × ℝ), T ⊆ S ∧
  (∀ p ∈ T, ∃ p' ∈ T, euclidean_dist p' (quarter_turn p) < ε)

