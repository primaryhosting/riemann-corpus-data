def Predictions.EvidenceLevel.computational : Predictions.EvidenceLevel := 1
def Predictions.EvidenceLevel.partial : Predictions.EvidenceLevel := 2
def Predictions.EvidenceLevel.proven : Predictions.EvidenceLevel := 3

#check Predictions.EvidenceLevel

structure Predictions.Prediction where
  description : String
  statement : Prop
  verified : Bool
  confidence : ℚ
  evidence_level : Predictions.EvidenceLevel
  evidence : Option Predictions.ComputationalEvidence
  proof : verified = true → statement

