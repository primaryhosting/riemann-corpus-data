structure MathematicalTruth where
  statement : Prop
  complexity : ℝ
  complexity_pos : 0 < complexity

def t_Planck : ℝ := 1

def t_emergence (T : MathematicalTruth) : ℝ := 
  phi ^ T.complexity * t_Planck

theorem TemporalDynamics.time_positive (T : MathematicalTruth) : 
    0 < t_emergence T := by
  unfold t_emergence t_Planck
  apply mul_pos
  · exact rpow_pos_of_pos GoldenRatio.pos _
  · norm_num

theorem TemporalDynamics.emergence_monotone {T₁ T₂ : MathematicalTruth} 
    (h : T₁.complexity < T₂.complexity) :
    t_emergence T₁ < t_emergence T₂ := by
  unfold t_emergence t_Planck
  rw [mul_lt_mul_right (by norm_num : (0:ℝ) < 1)]
  exact rpow_lt_rpow_of_exponent_lt GoldenRatio.gt_one h

theorem TemporalDynamics.phi_quantized_step {T₁ T₂ : MathematicalTruth}
    (h : T₂.complexity = T₁.complexity + 1) :
    t_emergence T₂ = phi * t_emergence T₁ := by
  unfold t_emergence t_Planck
  rw [h]
  push_cast
  rw [rpow_add GoldenRatio.pos, rpow_one]
  ring

def TemporalDynamics.is_potential (T : MathematicalTruth) (t : ℝ) : Prop := 
  t < t_emergence T

def TemporalDynamics.is_actualized (T : MathematicalTruth) (t : ℝ) : Prop := 
  t ≥ t_emergence T

