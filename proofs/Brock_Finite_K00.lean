/-
Formalized the 2x2 Markov kernel on Brockian rays mod 5 induced by the twin-step. Defined the admissible domain, rays, and transition counts. Proved the kernel values K(0,0)=1, K(0,1)=1, K(1,0)=1, K(1,1)=0, and verified row sums and total admissible starts.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Ray 0 residues mod 5 (nonzero): {1,4}.
-/
def Brock.Finite.Ray0 (r : ZMod 5) : Prop := r = 1 ∨ r = 4

/-
Twin-step on indices: +2 in ZMod 5.
-/
def Brock.Finite.step₂ (r : ZMod 5) : ZMod 5 := r + 2

/-
A total ray label on all residues mod 5. We use: rayVal r = 0 if Ray0 r, rayVal r = 1 otherwise.
-/
def Brock.Finite.rayVal (r : ZMod 5) : Fin 2 :=
  if Brock.Finite.Ray0 r then (0 : Fin 2) else (1 : Fin 2)

/-
Admissibility predicate for twin-step starts.
-/
def Brock.Finite.dom₂ (r : ZMod 5) : Prop := r ≠ 0 ∧ Brock.Finite.step₂ r ≠ 0

/-
Transition predicate for twin-step on the admissible domain.
-/
def Brock.Finite.TwinTransition (i j : Fin 2) (r : ZMod 5) : Prop :=
  Brock.Finite.dom₂ r ∧ Brock.Finite.rayVal r = i ∧ Brock.Finite.rayVal (Brock.Finite.step₂ r) = j

/-
The transition-count kernel K(i,j): number of residues realizing i→j under twin-step.
-/
def Brock.Finite.K (i j : Fin 2) : ℕ :=
  ((Finset.univ : Finset (ZMod 5)).filter (fun r => Brock.Finite.TwinTransition i j r)).card

/-
K 0 0 = 1.
-/
theorem Brock.Finite.K00 : Brock.Finite.K (0 : Fin 2) (0 : Fin 2) = 1 := by
  unfold Brock.Finite.K Brock.Finite.TwinTransition Brock.Finite.dom₂ Brock.Finite.step₂ Brock.Finite.rayVal Brock.Finite.Ray0; simp +decide ;

/-
K 0 1 = 1.
-/
theorem Brock.Finite.K01 : Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 1 := by
  unfold Brock.Finite.K Brock.Finite.TwinTransition Brock.Finite.dom₂ Brock.Finite.step₂ Brock.Finite.rayVal Brock.Finite.Ray0; simp +decide ;

/-
K 1 0 = 1.
-/
theorem Brock.Finite.K10 : Brock.Finite.K (1 : Fin 2) (0 : Fin 2) = 1 := by
  unfold Brock.Finite.K
  skip
  simp +decide [Brock.Finite.TwinTransition];
  simp +decide [ Finset.card, Brock.Finite.dom₂, Brock.Finite.rayVal ];
  simp +decide [ Brock.Finite.step₂, Brock.Finite.Ray0 ]

/-
K 1 1 = 0.
-/
theorem Brock.Finite.K11 : Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 0 := by
  unfold Brock.Finite.K;
  unfold Brock.Finite.TwinTransition;
  simp +decide [ Brock.Finite.dom₂, Brock.Finite.rayVal ];
  simp +decide [ Brock.Finite.Ray0 ]

/-
Row sums: from ray 0 there are 2 admissible starts; from ray 1 there is 1.
-/
theorem Brock.Finite.rowSums :
    (Brock.Finite.K (0 : Fin 2) (0 : Fin 2) + Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 2)
    ∧ (Brock.Finite.K (1 : Fin 2) (0 : Fin 2) + Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 1) := by
  constructor <;> simp [Brock.Finite.K00, Brock.Finite.K01, Brock.Finite.K10, Brock.Finite.K11]

/-
Total admissible starts equals the sum of all kernel entries (here: 3).
-/
theorem Brock.Finite.totalAdmissible :
    (Brock.Finite.K (0 : Fin 2) (0 : Fin 2) + Brock.Finite.K (0 : Fin 2) (1 : Fin 2)
     + Brock.Finite.K (1 : Fin 2) (0 : Fin 2) + Brock.Finite.K (1 : Fin 2) (1 : Fin 2)) = 3 := by
  simp [Brock.Finite.K00, Brock.Finite.K01, Brock.Finite.K10, Brock.Finite.K11]

/-
The twin kernel as an explicit 2×2 table.
-/
theorem Brock.Finite.kernel_table :
    Brock.Finite.K (0 : Fin 2) (0 : Fin 2) = 1 ∧
    Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 1 ∧
    Brock.Finite.K (1 : Fin 2) (0 : Fin 2) = 1 ∧
    Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 0 := by
  simp [Brock.Finite.K00, Brock.Finite.K01, Brock.Finite.K10, Brock.Finite.K11]

/-
K 0 0 = 1 (fixed).
-/
theorem Brock.Finite.K00_fixed : Brock.Finite.K (0 : Fin 2) (0 : Fin 2) = 1 := by
  exact?

/-
K 0 1 = 1 (fixed).
-/
theorem Brock.Finite.K01_fixed : Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 1 := by
  exact?

/-
K 1 0 = 1 (fixed).
-/
theorem Brock.Finite.K10_fixed : Brock.Finite.K (1 : Fin 2) (0 : Fin 2) = 1 := by
  exact?

/-
K 1 1 = 0 (fixed).
-/
theorem Brock.Finite.K11_fixed : Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 0 := by
  exact?

theorem Brock.Finite.K00_val : Brock.Finite.K (0 : Fin 2) (0 : Fin 2) = 1 := by
  exact?

/-
Check rowSums.
-/
example : (Brock.Finite.K (0 : Fin 2) (0 : Fin 2) + Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 2)
    ∧ (Brock.Finite.K (1 : Fin 2) (0 : Fin 2) + Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 1) := Brock.Finite.rowSums

/-
Check totalAdmissible.
-/
example : (Brock.Finite.K (0 : Fin 2) (0 : Fin 2) + Brock.Finite.K (0 : Fin 2) (1 : Fin 2)
     + Brock.Finite.K (1 : Fin 2) (0 : Fin 2) + Brock.Finite.K (1 : Fin 2) (1 : Fin 2)) = 3 := Brock.Finite.totalAdmissible

/-
Check kernel_table.
-/
example : Brock.Finite.K (0 : Fin 2) (0 : Fin 2) = 1 ∧
    Brock.Finite.K (0 : Fin 2) (1 : Fin 2) = 1 ∧
    Brock.Finite.K (1 : Fin 2) (0 : Fin 2) = 1 ∧
    Brock.Finite.K (1 : Fin 2) (1 : Fin 2) = 0 := Brock.Finite.kernel_table
