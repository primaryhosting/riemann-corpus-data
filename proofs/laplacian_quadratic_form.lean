        simp +decide [ Finset.sum_ite, Finset.filter_mem_eq_inter ];
        ac_rfl;
      simpa [ mul_comm, SimpleGraph.degree, SimpleGraph.neighborFinset_def ] using h_exp

/-
Probability decomposition: P(A and B) = P(A) - P(A and not B).
-/
lemma prob_and_neg {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (Pred1 Pred2 : Finset V → Prop) [DecidablePred Pred1] [DecidablePred Pred2] :
    prob p (fun S => Pred1 S ∧ Pred2 S) = prob p Pred1 - prob p (fun S => Pred1 S ∧ ¬ Pred2 S) := by
      unfold prob;
      simp +decide only [Expectation];
      simpa only [ ← Finset.sum_sub_distrib ] using Finset.sum_congr rfl fun x _ => by split_ifs <;> aesop;

/-
Helper lemmas relating weights of subsets with and without a specific vertex.
-/
lemma weight_insert_eq {V : Type*} [Fintype V] [DecidableEq V] (v : V) (T : Finset V) (h : v ∉ T) (p : ℝ) :
    weight (insert v T) p = p * (p ^ T.card * (1 - p) ^ (Fintype.card V - 1 - T.card)) := by
      simp +decide [ weight, h, mul_assoc, mul_comm, mul_left_comm, Finset.card_insert_of_notMem h ];
      grind

lemma weight_not_mem_eq {V : Type*} [Fintype V] [DecidableEq V] (v : V) (T : Finset V) (h : v ∉ T) (p : ℝ) :
    weight T p = (1 - p) * (p ^ T.card * (1 - p) ^ (Fintype.card V - 1 - T.card)) := by
      unfold weight;
      rw [ show Fintype.card V - T.card = ( Fintype.card V - 1 - T.card ) + 1 by rw [ tsub_right_comm, tsub_add_cancel_of_le ] ; exact Nat.succ_le_of_lt ( Nat.sub_pos_of_lt ( Finset.card_lt_card <| Finset.ssubset_iff_subset_ne.mpr ⟨ Finset.subset_univ _, by aesop_cat ⟩ ) ) ] ; ring

/-
Decomposition of probability sum based on whether v is in S or not.
-/
lemma prob_decomposition {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (Pred : Finset V → Prop) [DecidablePred Pred] (v : V) :
    prob p Pred = ∑ S ∈ (Finset.univ.erase v).powerset, (weight S p * (if Pred S then 1 else 0) + weight (insert v S) p * (if Pred (insert v S) then 1 else 0)) := by
      -- By definition of probability, we can split the sum into two parts: one where $v \in S$ and one where $v \notin S$.
      have h_split : ∑ S : Finset V, weight S p * (if Pred S then 1 else 0) = (∑ S ∈ Finset.powerset (Finset.univ.erase v), weight S p * (if Pred S then 1 else 0)) + (∑ S ∈ Finset.powerset (Finset.univ.erase v), weight (insert v S) p * (if Pred (insert v S) then 1 else 0)) := by
        have h_split : Finset.univ = Finset.powerset (Finset.univ.erase v) ∪ Finset.image (fun S => insert v S) (Finset.powerset (Finset.univ.erase v)) := by
          ext S; by_cases hv : v ∈ S <;> simp +decide [ hv ] ;
          · exact Or.inr ⟨ S.erase v, fun x hx => Finset.mem_erase_of_ne_of_mem ( by aesop ) ( Finset.mem_univ x ), by aesop ⟩;
          · exact Or.inl fun x hx => Finset.mem_erase_of_ne_of_mem ( by rintro rfl; exact hv hx ) ( Finset.mem_univ x );
        rw [ h_split, Finset.sum_union, Finset.sum_image ];
        · intro S hS T hT h_eq; simp_all +decide [ Finset.ext_iff ] ;
          intro a; specialize h_eq a; replace hS := @hS a; replace hT := @hT a; aesop;
        · norm_num [ Finset.disjoint_right ];
          simp +contextual [ Finset.subset_iff ];
      rw [ Finset.sum_add_distrib, ← h_split ];
      unfold prob;
      unfold Expectation; aesop;

