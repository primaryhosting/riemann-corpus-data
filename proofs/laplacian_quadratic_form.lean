/-
Definition: A subset S satisfies the degree condition if the induced degree of every vertex in S is at most epsilon times its degree in G.
-/
def SatisfiesDegreeCondition {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  ∀ (v : V) (h : v ∈ S), (G.induce ↑S).degree ⟨v, h⟩ ≤ ε * G.degree v

/-
Redefinition of goodSubset using explicit neighbor intersection to avoid subtype issues.
-/
def goodSubset {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S0 : Finset V) (ε : ℝ) : Finset V :=
  S0.filter (fun v => (G.neighborFinset v ∩ S0).card ≤ ε * G.degree v)

/-
The good subset satisfies the degree condition.
-/
lemma goodSubset_satisfies_condition {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S0 : Finset V) (ε : ℝ) :
    SatisfiesDegreeCondition G (goodSubset G S0 ε) ε := by
  intro v hv
  rw [goodSubset, Finset.mem_filter] at hv
  let S := goodSubset G S0 ε
  have h_sub : S ⊆ S0 := Finset.filter_subset _ _
  -- The degree in G[S] is the number of neighbors in S.
  -- The degree in G[S0] is the number of neighbors in S0.
  -- Since S ⊆ S0, neighbors in S are a subset of neighbors in S0.
  -- But wait, the condition checked in goodSubset is about neighbors in S0, not S.
  -- The condition is: deg_{S0}(v) <= ε * deg_G(v).
  -- We need to show: deg_S(v) <= ε * deg_G(v).
  -- deg_S(v) = |N(v) ∩ S|
  -- deg_{S0}(v) = |N(v) ∩ S0|
  -- Since S ⊆ S0, N(v) ∩ S ⊆ N(v) ∩ S0.
  -- So |N(v) ∩ S| ≤ |N(v) ∩ S0|.
  -- And we know |N(v) ∩ S0| ≤ ε * deg_G(v) from the filter condition.
  -- Thus |N(v) ∩ S| ≤ ε * deg_G(v).
  -- Since S is a subset of S0, the neighbors of v in S are a subset of the neighbors of v in S0. Therefore, the degree of v in the induced subgraph is the number of neighbors of v in S, which is less than or equal to the number of neighbors of v in S0. Hence, the degree of v in the induced subgraph is at most the cardinality of the intersection of the neighbor set of v with S0.
  have h_deg_le : (G.induce S).degree ⟨v, by aesop⟩ ≤ (G.neighborFinset v ∩ S0).card := by
    refine' le_trans _ ( Finset.card_mono _ );
    rotate_left;
    exact Finset.image ( fun x : { x : V // x ∈ S } => x.val ) ( Finset.filter ( fun x : { x : V // x ∈ S } => G.Adj v x.val ) Finset.univ );
    · intro x hx
      aesop;
    · rw [ Finset.card_image_of_injective _ fun x y hxy => by aesop ];
      exact Finset.card_le_card fun x hx => by aesop;
  exact le_trans ( Nat.cast_le.mpr h_deg_le ) hv.2

/-
The sum of weights over all subsets is 1, using the binomial theorem for Fintypes.
-/
def weight {V : Type*} [Fintype V] [DecidableEq V] (S : Finset V) (p : ℝ) : ℝ :=
  p ^ S.card * (1 - p) ^ (Fintype.card V - S.card)

lemma sum_weight_eq_one {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) :
    ∑ S : Finset V, weight S p = 1 := by
  simp [weight]
  rw [Fintype.sum_pow_mul_eq_add_pow]
  simp

/-
Linearity of expectation: Expected size is sum of probabilities.
-/
lemma expected_size_eq_sum_prob {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (ε p : ℝ) :
    ∑ S0 : Finset V, weight S0 p * (goodSubset G S0 ε).card =
    ∑ v : V, ∑ S0 : Finset V, weight S0 p * (if v ∈ goodSubset G S0 ε then 1 else 0) := by
      rw [ Finset.sum_comm, Finset.sum_congr rfl ];
      simp +decide [ Finset.sum_ite ];
      exact fun _ => mul_comm _ _

/-
Definitions of Expectation and Probability using Classical logic.
-/
open Classical

def Expectation {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (X : Finset V → ℝ) : ℝ :=
  ∑ S : Finset V, weight S p * X S

def prob {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (Pred : Finset V → Prop) : ℝ :=
  Expectation p (fun S => if Pred S then 1 else 0)

end

/-
Markov's inequality.
-/
lemma prob_markov {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (f : Finset V → ℝ) (c : ℝ) (hc : 0 < c)
    (hf : ∀ S, 0 ≤ f S) :
    prob p (fun S => f S ≥ c) ≤ (Expectation p f) / c := by
      rw [ le_div_iff₀ hc ];
      convert Finset.sum_le_sum fun S _ => mul_le_mul_of_nonneg_left ( show ( if c ≤ f S then ( 1 : ℝ ) else 0 ) * c ≤ f S from ?_ ) ( show ( 0 : ℝ ) ≤ weight S p from ?_ ) using 1;
      · simp +decide only [prob, mul_comm, mul_left_comm];
        simp +decide only [Expectation, Finset.mul_sum _ _ _];
      · split_ifs <;> linarith [ hf S ];
      · exact mul_nonneg ( pow_nonneg hp.1 _ ) ( pow_nonneg ( sub_nonneg.2 hp.2 ) _ )

/-
Probability of the universal set is 1.
-/
lemma prob_univ {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) :
    prob p (fun (S : Finset V) => True) = 1 := by
      convert sum_weight_eq_one p hp using 1;
      rotate_left;
      exact V;
      all_goals try infer_instance;
      exact Finset.sum_congr rfl fun _ _ => by aesop;

/-
Probability of the universal set is 1.
-/
lemma prob_univ_eq_one {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) :
    prob p (fun (S : Finset V) => True) = 1 := by
  unfold prob Expectation
  simp only [if_true, mul_one]
  exact sum_weight_eq_one p hp

/-
The expected degree of a vertex in a random subset is p times its original degree.
-/
lemma expected_degree_in_subset {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) :
    Expectation p (fun S => (G.neighborFinset v ∩ S).card) = p * G.degree v := by
      -- The expectation of the size of the intersection of the neighbor set of v with a random subset S0 is the sum of the probabilities that each neighbor of v is in S0.
      have h_exp : ∑ S : Finset V, weight S p * (G.neighborFinset v ∩ S).card = ∑ u ∈ G.neighborFinset v, p := by
        -- The probability that a specific neighbor u is in S is p, since each vertex is included in S independently with probability p.
        have h_prob : ∀ u ∈ G.neighborFinset v, ∑ S : Finset V, weight S p * (if u ∈ S then 1 else 0) = p := by
          intro u hu
          have h_exp_degree : (∑ S : Finset V, weight S p * (if u ∈ S then 1 else 0)) = p := by
            have h_sum : ∑ S : Finset V, weight S p * (if u ∈ S then 1 else 0) = ∑ S ∈ Finset.powerset (Finset.univ.erase u), (p ^ (S.card + 1) * (1 - p) ^ (Fintype.card V - (S.card + 1))) := by
              have h_sum : ∑ S : Finset V, weight S p * (if u ∈ S then 1 else 0) = ∑ S ∈ Finset.filter (fun S => u ∈ S) (Finset.powerset (Finset.univ : Finset V)), p ^ S.card * (1 - p) ^ (Fintype.card V - S.card) := by
                simp +decide [ Finset.sum_ite, weight ];
              rw [ h_sum ];
              refine' Finset.sum_bij ( fun S hS => S.erase u ) _ _ _ _ <;> simp +decide [ Finset.mem_powerset, Finset.subset_iff ];
              · exact?;
              · intro a₁ ha₁ a₂ ha₂ h; rw [ ← Finset.insert_erase ha₁, ← Finset.insert_erase ha₂, h ] ;
              · exact fun b hb => ⟨ Insert.insert u b, Finset.mem_insert_self _ _, by rw [ Finset.erase_insert hb ] ⟩;
              · intro S hu; rw [ Finset.card_erase_add_one hu ] ;
            -- We can factor out $p$ from the sum.
            have h_factor : ∑ S ∈ Finset.powerset (Finset.univ.erase u), p ^ (S.card + 1) * (1 - p) ^ (Fintype.card V - (S.card + 1)) = p * ∑ S ∈ Finset.powerset (Finset.univ.erase u), p ^ S.card * (1 - p) ^ ((Fintype.card V - 1) - S.card) := by
              rw [ Finset.mul_sum _ _ _ ] ; exact Finset.sum_congr rfl fun _ _ => by rw [ Nat.sub_sub, pow_succ' ] ; ring;
            have h_binom : ∑ S ∈ Finset.powerset (Finset.univ.erase u), p ^ S.card * (1 - p) ^ ((Fintype.card V - 1) - S.card) = (p + (1 - p)) ^ (Fintype.card V - 1) := by
