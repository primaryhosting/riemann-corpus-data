/-- Definition: Epsilon-Light Property -/
def IsEpsilonLight {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  (ε • laplacianMatrix G - inducedLaplacian G S).PosSemidef

