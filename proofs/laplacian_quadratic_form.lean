abbrev laplacianMatrix {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) : Matrix V V ℝ := G.lapMatrix ℝ

def inducedLaplacian {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  let G' := G.induce ↑S
  let L' := G'.lapMatrix ℝ
  Matrix.of (fun i j => if h : i ∈ S ∧ j ∈ S then L' ⟨i, h.1⟩ ⟨j, h.2⟩ else 0)

