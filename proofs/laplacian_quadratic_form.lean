/-
Algebraic identity for probability terms using independence.
-/
lemma prob_term_equality {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (v : V) (S : Finset V) 
    (h_not_mem : v ∉ S) (Pred : Finset V → Prop) [DecidablePred Pred]
    (h_indep : Pred (insert v S) ↔ Pred S) :
    weight (insert v S) p * (if Pred (insert v S) then 1 else 0) = 
    p * (weight S p * (if Pred S then 1 else 0) + weight (insert v S) p * (if Pred (insert v S) then 1 else 0)) := by
  rw [weight_insert_eq v S h_not_mem p]
  rw [weight_not_mem_eq v S h_not_mem p]
  simp only [h_indep]
  ring

/-
If a property is independent of v's presence, then P(v in S and Pred S) = p * P(Pred S).
-/
lemma prob_v_in_and_property {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (v : V)
    (Pred : Finset V → Prop) [DecidablePred Pred]
    (h_indep : ∀ S, v ∉ S → (Pred (insert v S) ↔ Pred S)) :
    prob p (fun S => v ∈ S ∧ Pred S) = p * prob p Pred := by
      convert prob_v_in_decomposition p ( fun S => v ∈ S ∧ Pred S ) v using 1;
      · simp +decide only [and_self_left];
      · rw [ show prob p Pred = ∑ S ∈ ( Finset.univ.erase v ).powerset, weight S p * ( if Pred S then 1 else 0 ) + ∑ S ∈ ( Finset.univ.erase v ).powerset, weight ( Insert.insert v S ) p * ( if Pred ( Insert.insert v S ) then 1 else 0 ) from ?_ ];
        · rw [ ← Finset.sum_add_distrib, Finset.mul_sum ];
          refine' Finset.sum_congr rfl fun x hx => _;
          rw [ weight_insert_eq ] <;> simp_all +decide [ weight_insert_eq, weight_not_mem_eq ];
          · by_cases h : Pred x <;> simp_all +decide [ Finset.subset_iff ];
            exact Or.inl ( by rw [ show weight x p = ( 1 - p ) * ( p ^ x.card * ( 1 - p ) ^ ( Fintype.card V - 1 - x.card ) ) by exact? ] ; ring );
          · exact fun h => Finset.notMem_erase _ _ ( hx h );
        · convert prob_decomposition p Pred v using 1;
          rw [ Finset.sum_add_distrib ]

/-
If a property is independent of v's presence, then P(v in S and Pred S) = p * P(Pred S).
-/
lemma prob_v_in_and_property' {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (v : V)
    (Pred : Finset V → Prop) [DecidablePred Pred]
    (h_indep : ∀ S, v ∉ S → (Pred (insert v S) ↔ Pred S)) :
    prob p (fun S => v ∈ S ∧ Pred S) = p * prob p Pred := by
      exact?

/-
Algebraic relation between weights of S and insert v S.
-/
lemma weight_relation {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (v : V) (S : Finset V) (h : v ∉ S) :
    weight (insert v S) p = p * (weight (insert v S) p + weight S p) := by
  rw [weight_insert_eq v S h p]
  rw [weight_not_mem_eq v S h p]
  ring

/-
Intersection of neighbors with S is independent of v's presence in S.
-/
lemma neighbor_intersection_independent {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (S : Finset V) :
    G.neighborFinset v ∩ (insert v S) = G.neighborFinset v ∩ S := by
      ext w
      simp [Finset.mem_insert, Finset.mem_inter]

/-
If a property is independent of v's presence, then P(v in S and Pred S) = p * P(Pred S).
-/
lemma prob_v_in_and_property_eq {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (v : V)
    (Pred : Finset V → Prop) [DecidablePred Pred]
    (h_indep : ∀ S, v ∉ S → (Pred (insert v S) ↔ Pred S)) :
    prob p (fun S => v ∈ S ∧ Pred S) = p * prob p Pred := by
      -- Apply the lemma that connects the probability of the intersection to the sum of probabilities for the independent events.
      apply prob_v_in_and_property' G p hp v Pred h_indep

/-
Definition of the degree condition and its independence from v.
-/
def is_good_degree {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (ε : ℝ) (S : Finset V) : Prop :=
  (G.neighborFinset v ∩ S).card ≤ ε * G.degree v

lemma is_good_degree_independent {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (ε : ℝ) (S : Finset V) (h : v ∉ S) :
    is_good_degree G v ε (insert v S) ↔ is_good_degree G v ε S := by
      unfold is_good_degree; aesop;

/-
Probability of complement.
-/
lemma prob_compl {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (Pred : Finset V → Prop) [DecidablePred Pred] :
    prob p (fun S => ¬ Pred S) = 1 - prob p Pred := by
      -- The sum of the weights over all subsets is 1.
      have h_sum_weights : ∑ S : Finset V, weight S p = 1 := by
        exact?;
      unfold prob;
      unfold Expectation; simp +decide [ Finset.sum_ite ] ;
      exact eq_sub_of_add_eq' ( h_sum_weights ▸ Finset.sum_filter_add_sum_filter_not _ _ _ )

/-
Strict Markov inequality.
-/
lemma prob_strict_markov {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (f : Finset V → ℝ) (c : ℝ) (hc : 0 < c)
    (hf : ∀ S, 0 ≤ f S) :
    prob p (fun S => f S > c) ≤ (Expectation p f) / c := by
      -- Apply Markov's inequality to the function $g(S) = \mathbf{1}_{\{f(S) > c\}}$ and the random variable $f(S)$.
      have h_markov : ∑ S, weight S p * (if f S > c then 1 else 0) ≤ (∑ S, weight S p * (f S)) / c := by
        rw [ le_div_iff₀' hc ];
        rw [ Finset.mul_sum _ _ _ ] ; exact Finset.sum_le_sum fun S _ => by split_ifs <;> nlinarith [ hf S, show 0 ≤ weight S p by exact mul_nonneg ( pow_nonneg hp.1 _ ) ( pow_nonneg ( sub_nonneg.2 hp.2 ) _ ) ] ;
      exact?

/-
Probability of bad degree is at most 1/4 using Markov's inequality.
-/
def is_bad_degree {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (ε : ℝ) (S : Finset V) : Prop :=
  (G.neighborFinset v ∩ S).card > ε * G.degree v

lemma prob_bad_degree_le {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (ε : ℝ) (p : ℝ)
    (hp : 0 ≤ p ∧ p ≤ 1) (hε : 0 < ε) (h_p_eps : p = ε / 4) :
    prob p (is_bad_degree G v ε) ≤ 1 / 4 := by
      -- Apply Markov's inequality to the random variable `f v S`. The random variable `f v S` is the size of the intersection of the neighborhood of `v` with `S`.
      set f : Finset V → ℝ := fun S => (G.neighborFinset v ∩ S).card;
      -- By Markov's inequality, we have $\Pr(f v S > \epsilon \cdot \text{degree}(v)) \leq \frac{\mathbb{E}[f v S]}{\epsilon \cdot \text{degree}(v)}$.
      have h_markov : prob p (fun S => f S > ε * G.degree v) ≤ (Expectation p f) / (ε * G.degree v) := by
        by_cases h : G.degree v = 0 <;> simp_all +decide [ div_eq_inv_mul ];
        · simp_all +decide [ SimpleGraph.degree, SimpleGraph.neighborFinset_def ];
          simp +zetaDelta at *;
          simp_all +decide [ SimpleGraph.neighborFinset, Finset.Nonempty ];
          simp +decide [ prob ];
          simp +decide [ Expectation ];
        · convert prob_strict_markov ( 4⁻¹ * ε ) ⟨ by linarith, by linarith ⟩ f ( ε * G.degree v ) ( mul_pos hε ( Nat.cast_pos.mpr ( Nat.pos_of_ne_zero h ) ) ) _ using 1 <;> norm_num [ Expectation ] ; ring;
          exact fun S => Nat.cast_nonneg _;
      -- By definition of $f$, we know that $\mathbb{E}[f v S] = p \cdot \text{degree}(v)$.
      have h_exp : Expectation p f = p * G.degree v := by
        convert expected_degree_in_subset G v p hp using 1;
      by_cases h : G.degree v = 0 <;> simp_all +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm ];
      · convert h_markov.trans _;
        · unfold is_bad_degree; aesop;
        · norm_num;
      · convert h_markov using 1 ; norm_num [ h, hε.ne' ]

/-
The expected size of the good subset is at least 3p/4 * |V|.
-/
lemma expected_good_subset_size {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (ε : ℝ)
    (hε : 0 < ε) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (h_p_eps : p = ε / 4) :
    Expectation p (fun S0 => (goodSubset G S0 ε).card) ≥ (3 * p / 4) * Fintype.card V := by
      have h_good_subset_size : ∀ v : V, prob p (fun S0 => is_good_degree G v ε S0) ≥ 3 / 4 := by
        intro v
        have h_prob_good_degree : prob p (fun S0 => ¬ is_good_degree G v ε S0) ≤ 1 / 4 := by
          convert prob_bad_degree_le G v ε p hp hε h_p_eps using 1;
          exact congr_arg _ ( funext fun S0 => by unfold is_good_degree is_bad_degree; aesop );
        have h_prob_good_degree : prob p (fun S0 => is_good_degree G v ε S0) = 1 - prob p (fun S0 => ¬ is_good_degree G v ε S0) := by
          convert prob_compl p hp _;
          · rw [ Classical.not_not ];
          · infer_instance;
        linarith;
      -- By linearity of expectation, we can sum the probabilities over all vertices.
      have h_sum_prob : (Expectation p fun S0 => (goodSubset G S0 ε).card) = ∑ v : V, prob p (fun S0 => is_good_degree G v ε S0 ∧ v ∈ S0) := by
        have h_sum_prob : ∀ S0 : Finset V, (goodSubset G S0 ε).card = ∑ v : V, (if is_good_degree G v ε S0 ∧ v ∈ S0 then 1 else 0) := by
          simp +decide [ goodSubset, is_good_degree ];
          exact fun S0 => congr_arg Finset.card ( Finset.ext fun x => by simp +contextual [ and_comm ] );
        simp +decide only [Expectation, h_sum_prob, prob];
        rw [ Finset.sum_comm, Finset.sum_congr rfl ] ; intros ; simp +decide [ Finset.sum_ite ];
        ring;
      -- By linearity of expectation, we can factor out the constant $p$ from the sum.
      have h_factor_p : ∑ v : V, prob p (fun S0 => is_good_degree G v ε S0 ∧ v ∈ S0) = p * ∑ v : V, prob p (fun S0 => is_good_degree G v ε S0) := by
        rw [ Finset.mul_sum _ _ _ ];
        refine' Finset.sum_congr rfl fun v _ => _;
        convert prob_v_in_and_property_eq G p hp v ( fun S0 => is_good_degree G v ε S0 ) _ using 1;
        · simp +decide only [and_comm];
        · exact?;
      exact h_sum_prob.symm ▸ h_factor_p.symm ▸ by nlinarith [ show ( Fintype.card V : ℝ ) ≥ 0 by positivity, show ( ∑ v : V, prob p fun S0 => is_good_degree G v ε S0 ) ≥ ( 3 / 4 ) * Fintype.card V by simpa [ mul_comm ] using Finset.sum_le_sum fun v ( hv : v ∈ Finset.univ ) => h_good_subset_size v ] ; ;

/-
Probability of good degree is at least 3/4.
-/
lemma prob_good_degree_ge {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) (ε : ℝ) (p : ℝ) 
    (hp : 0 ≤ p ∧ p ≤ 1) (hε : 0 < ε) (h_p_eps : p = ε / 4) :
    prob p (is_good_degree G v ε) ≥ 3 / 4 := by
  have h_bad : prob p (is_bad_degree G v ε) ≤ 1 / 4 := 
    prob_bad_degree_le G v ε p hp hε h_p_eps
  
  have h_compl : is_good_degree G v ε = fun S => ¬ is_bad_degree G v ε S := by
    ext S
    unfold is_good_degree is_bad_degree
    rw [not_lt]
  
  rw [h_compl]
  rw [prob_compl p hp]
  linarith

/-
The expected size of the good subset is at least 3p/4 * |V|.
-/
lemma expected_good_subset_size' {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (ε : ℝ)
    (hε : 0 < ε) (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (h_p_eps : p = ε / 4) :
    Expectation p (fun S0 => (goodSubset G S0 ε).card) ≥ (3 * p / 4) * Fintype.card V := by
      convert expected_good_subset_size G ε hε p hp h_p_eps using 1

/-
If expectation is at least c, there exists an element at least c.
-/
lemma exists_of_expectation_ge {V : Type*} [Fintype V] [DecidableEq V] (p : ℝ) (hp : 0 ≤ p ∧ p ≤ 1) (f : Finset V → ℝ) (c : ℝ)
    (h_exp : Expectation p f ≥ c) :
    ∃ S : Finset V, f S ≥ c := by
      contrapose! h_exp;
      -- Since the sum of the weights is 1, we can factor out c and conclude that the sum of f(x) times the weights is less than c.
      have h_sum_weights : ∑ x : Finset V, weight x p = 1 := by
        convert sum_weight_eq_one p hp;
      -- Apply the fact that if each term in a sum is less than a certain value, then the sum itself is less than the sum of that value times the weights.
      have h_sum_lt : ∑ x : Finset V, weight x p * f x < ∑ x : Finset V, weight x p * c := by
        apply Finset.sum_lt_sum;
        · exact fun x _ => mul_le_mul_of_nonneg_left ( le_of_lt ( h_exp x ) ) ( show 0 ≤ weight x p from mul_nonneg ( pow_nonneg hp.1 _ ) ( pow_nonneg ( sub_nonneg.2 hp.2 ) _ ) );
        · exact Exists.elim ( show ∃ x : Finset V, weight x p ≠ 0 from not_forall.mp fun h => by simp +decide [ h ] at h_sum_weights ) fun x hx => ⟨ x, Finset.mem_univ _, mul_lt_mul_of_pos_left ( h_exp x ) ( lt_of_le_of_ne ( by unfold weight; exact mul_nonneg ( pow_nonneg hp.1 _ ) ( pow_nonneg ( sub_nonneg.2 hp.2 ) _ ) ) ( Ne.symm hx ) ) ⟩;
      simpa only [ ← Finset.sum_mul _ _ _, h_sum_weights, one_mul ] using h_sum_lt

/-
Existence of a subset satisfying the degree condition and size bound.
-/
lemma exists_subset_degree_condition {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (ε : ℝ)
    (hε : 0 < ε ∧ ε < 1) :
    ∃ S : Finset V, SatisfiesDegreeCondition G S ε ∧ (8 : ℝ) * S.card ≥ ε * Fintype.card V := by
      -- Apply the lemma `exists_of_expectation_ge` with the expectation value from `expected_good_subset_size'` and the threshold `ε * |V| / 8`.
      obtain ⟨S, hS⟩ : ∃ S : Finset V, (goodSubset G S ε).card ≥ (3 * (ε / 4) / 4) * Fintype.card V := by
        convert exists_of_expectation_ge ( ε / 4 ) ⟨ by linarith, by linarith ⟩ ( fun S0 => ( goodSubset G S0 ε |> Finset.card : ℝ ) ) ( 3 * ( ε / 4 ) / 4 * Fintype.card V ) ?_ using 1;
        convert expected_good_subset_size' G ε hε.1 ( ε / 4 ) ⟨ by linarith, by linarith ⟩ rfl using 1;
      refine' ⟨ goodSubset G S ε, _, _ ⟩;
      · exact?;
      · nlinarith [ show ( Fintype.card V : ℝ ) ≥ 0 by positivity ]
