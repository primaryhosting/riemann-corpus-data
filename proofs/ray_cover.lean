/-- The `p`-ray indexed by `i : ZMod p` as a subset of `ℕ`. -/
def ray (p : ℕ) (i : ZMod p) : Set ℕ :=
  {n : ℕ | (n : ZMod p) = i}

/-- Membership in a ray is exactly the cast-to-`ZMod p` equality. -/
@[simp] theorem mem_ray_iff {p : ℕ} {i : ZMod p} {n : ℕ} :
    n ∈ ray p i ↔ (n : ZMod p) = i :=
  Iff.rfl

/-- Rays cover all naturals (trivial from the definition). -/
theorem ray_cover (p : ℕ) (n : ℕ) : ∃ i : ZMod p, n ∈ ray p i := by
  refine ⟨(n : ZMod p), ?_⟩
  simp [ray]

/-- Cycle adjacency on `ZMod p`: neighbors differ by `±1`. -/
def cycleAdj (p : ℕ) : ZMod p → ZMod p → Prop :=
  fun a b => b = a + 1 ∨ b = a - 1

/-- The cycle graph on `ZMod p` (a combinatorial p-gon). -/
def cycleGraph (p : ℕ) [Fact p.Prime] : SimpleGraph (ZMod p) where
  Adj := cycleAdj p
  symm := by
    intro a b hab
    rcases hab with h | h
    · -- b = a + 1  ⇒  a = b - 1
      right
      -- `b = a + 1` -> `a = b - 1`
      -- rearrange in additive group
      simpa [h, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
    · -- b = a - 1  ⇒  a = b + 1
      left
      simpa [h, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
  loopless := by
    intro a haa
    rcases haa with h | h
    · -- a = a + 1 is impossible unless 1=0
      have : (1 : ZMod p) = 0 := by
        have := congrArg (fun x => x - a) h
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using this
      exact one_ne_zero this
    · have : (1 : ZMod p) = 0 := by
        have := congrArg (fun x => x - a) h
        simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using this
      exact one_ne_zero this

/-- The finset of admissible nonzero labels for a given `g : ZMod p`. -/
def admissibleLabels (p : ℕ) [Fintype (ZMod p)] (g : ZMod p) : Finset (ZMod p) :=
  (univ : Finset (ZMod p)).filter (fun i => i ≠ 0 ∧ i + g ≠ 0)

/-- Helper: card of `ZMod p` is `p` (for prime p, hence p>0). -/
lemma card_zmod {p : ℕ} [Fact p.Prime] : Fintype.card (ZMod p) = p := by
  simpa using (ZMod.card p)

/-- Helper: `univ.erase 0` has card `p-1`. -/
lemma card_univ_erase_zero {p : ℕ} [Fact p.Prime] :
    (univ.erase (0 : ZMod p)).card = p - 1 := by
  classical
  have h0 : (0 : ZMod p) ∈ (univ : Finset (ZMod p)) := by simp
  -- card(erase) = card - 1
  simpa [card_zmod] using (card_erase_of_mem h0)

/-- Universal (p-2) law on admissible labels for a nonzero gap `g`. -/
theorem card_admissibleLabels {p : ℕ} [Fact p.Prime] (g : ZMod p) (hg : g ≠ 0) :
    (admissibleLabels p g).card = p - 2 := by
  classical
  -- Step 1: rewrite the filter as erasing exactly two labels: 0 and -g
  have hset :
      admissibleLabels p g = (univ.erase (0 : ZMod p)).erase (-g) := by
    ext i
    -- membership unfolding
    simp [admissibleLabels, Finset.mem_filter, Finset.mem_erase, and_assoc, and_left_comm,
      and_comm, add_eq_zero_iff_eq_neg, hg]

  -- Step 2: compute the card of the RHS
  have hmem_neg : (-g : ZMod p) ∈ (univ.erase (0 : ZMod p)) := by
    -- -g is in univ and not erased because -g ≠ 0
    have hneg0 : (-g : ZMod p) ≠ 0 := by
      exact neg_ne_zero.mpr hg
    simp [Finset.mem_erase, hneg0]

  calc
    (admissibleLabels p g).card
        = ((univ.erase (0 : ZMod p)).erase (-g)).card := by simpa [hset]
    _   = (univ.erase (0 : ZMod p)).card - 1 := by
            simpa using (card_erase_of_mem hmem_neg)
    _   = (p - 1) - 1 := by
            simp [card_univ_erase_zero]
    _   = p - 2 := by
            -- (p-1)-1 = p-(1+1) = p-2
            simp [Nat.sub_sub, Nat.add_assoc]

/-- Tier I statement: a prime that is 0 mod 5 must be 5. -/
theorem prime_eq_five_of_mod5_eq_zero {q : ℕ} (hq : Nat.Prime q)
    (hmod : (q : ZMod 5) = 0) : q = 5 := by
  -- Proof idea:
  --   (q : ZMod 5) = 0  ↔  5 ∣ q
  --   with q prime ⇒ q = 5
  -- This is standard; lemma names vary by mathlib version.
  -- Replace this `sorry` with your preferred dvd/cast lemma.
  -- Since $q$ is prime and $q \equiv 0 \pmod{5}$, it follows that $q = 5$.
  have hq_eq_5 : 5 ∣ q := by
    -- Since $q \equiv 0 \pmod{5}$, we have $5 \mid q$ by definition of modular equivalence.
    apply CharP.cast_eq_zero_iff (ZMod 5) 5 q |>.1 hmod;
  -- Since $q$ is prime and $5 \mid q$, it follows that $q = 5$.
  rw [Nat.dvd_prime hq] at hq_eq_5; aesop

/-- Corollary: if q is prime and q ≠ 5, then q is not on the 0-ray mod 5. -/
theorem prime_mod5_ne_zero {q : ℕ} (hq : Nat.Prime q) (hq5 : q ≠ 5) :
    (q : ZMod 5) ≠ 0 := by
  intro h0
  have : q = 5 := prime_eq_five_of_mod5_eq_zero hq h0
  exact hq5 this

