  have h_unit : sys.unitIso := (B0.unitIso_of_rank_one (sys := sys)) h_rank_eq_one
  -- Step 5: unit iso ⇒ equivalence (B0)
  have h_equiv : sys.transformEquiv := (B0.equiv_of_unitIso (sys := sys)) h_unit
