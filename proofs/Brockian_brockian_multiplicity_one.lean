  multiplicity_one_of_unitIso : sys.unitIso → ∀ σ, σ ∈ sys.prime → sys.multiplicity σ = 1

/-
The Template Theorem (Echo-Rigidity ⇒ Multiplicity One)
-/
theorem brockian_multiplicity_one (sys : BrockianSystem)
    [B0 sys] [B12 sys] [B3 sys] [B4 sys] :
    sys.transformEquiv ∧ (∀ σ ∈ sys.prime, sys.multiplicity σ = 1) := by
  -- Step 1: rank ≤ dimH0 by Hartogs extension (B3)
  have h_rank_le_dim : sys.rank ≤ sys.dimH0 := (B3.dim_ge_rank (sys := sys))
  -- Step 2: dimH0 = 1 by vacuum scalar endomorphisms (B4)
  have h_dim_eq_one : sys.dimH0 = 1 := (B4.dim_eq_one (sys := sys))
