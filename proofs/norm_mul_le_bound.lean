/-- The Brockian Potential is real-valued. -/
theorem brockianPotential_im_zero (primes : Set ℕ) (ε : ℝ) (z : ℂ) :
  (brockianPotential primes ε z : ℂ).im = 0 := by
  simp only [Complex.ofReal_im]

/-
Defines the p-th term of the Brockian Potential sum.
-/
/-- The p-th term of the Brockian Potential sum. -/
def brockianPotentialTerm (p : ℕ) (ε : ℝ) (z : ℂ) : ℝ :=
  (Real.log p / p) * Real.exp (-(dist z (brockianSpiral 1 1 p)) ^ 2 / ε ^ 2)

