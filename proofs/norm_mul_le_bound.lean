open MeasureTheory ENNReal

/-- The function underlying the multiplication operator. -/
def multiplication_toFun {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α]
  (f : α → ℂ) (hf : Continuous f) (hb : Bornology.IsBounded (Set.range (norm ∘ f)))
  (g : Lp ℂ 2 (volume : Measure α)) : Lp ℂ 2 (volume : Measure α) :=
  let M := sSup (Set.range (norm ∘ f))
  let hg := Lp.memLp g
  let hf_ae := hf.aestronglyMeasurable
  let hf_mem : MemLp f ∞ volume := memLp_top_of_bound hf_ae M (by
    filter_upwards
    intro x
    exact le_csSup (Bornology.IsBounded.bddAbove hb) (Set.mem_range_self x))
  (MemLp.mul hf_mem hg).toLp (g * f)

