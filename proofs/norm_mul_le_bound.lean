open MeasureTheory ENNReal

/-- Multiplication operator by a bounded continuous function on Lp as a continuous linear map. -/
def multiplicationOp {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α]
  (f : α → ℂ) (hf : Continuous f) (hb : Bornology.IsBounded (Set.range (norm ∘ f))) :
  Lp ℂ 2 (volume : Measure α) →L[ℂ] Lp ℂ 2 (volume : Measure α) :=
  LinearMap.mkContinuous
    (multiplicationLinearMap f hf hb)
    (sSup (Set.range (norm ∘ f)))
    (multiplicationLinearMap_bound f hf hb)

