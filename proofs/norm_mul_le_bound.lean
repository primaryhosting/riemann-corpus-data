/-
Proves that the multiplication linear map is bounded by the sup norm of the function f.
-/
open MeasureTheory ENNReal

lemma multiplicationLinearMap_bound {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α]
  (f : α → ℂ) (hf : Continuous f) (hb : Bornology.IsBounded (Set.range (norm ∘ f)))
  (g : Lp ℂ 2 (volume : Measure α)) :
  ‖multiplicationLinearMap f hf hb g‖ ≤ sSup (Set.range (norm ∘ f)) * ‖g‖ := by
    simp +decide [ multiplicationLinearMap ];
    rw [ MeasureTheory.Lp.norm_def ];
    rw [ MeasureTheory.Lp.norm_def ];
    -- Apply the norm_mul_le_bound lemma to bound the norm of the product.
    have h_norm_mul : MeasureTheory.eLpNorm (fun x => f x * g x) 2 MeasureTheory.MeasureSpace.volume ≤ ENNReal.ofReal (sSup (Set.range (norm ∘ f))) * MeasureTheory.eLpNorm g 2 MeasureTheory.MeasureSpace.volume := by
      apply norm_mul_le_bound;
      · apply_rules [ Real.sSup_nonneg ] ; aesop;
      · exact Filter.Eventually.of_forall fun x => le_csSup ( hb.bddAbove ) ( Set.mem_range_self x );
      · exact g.1.aestronglyMeasurable;
    convert ENNReal.toReal_mono _ h_norm_mul using 1;
    · unfold multiplication_toFun;
      simp +decide [ mul_comm ];
      rw [ MeasureTheory.eLpNorm_congr_ae ( MeasureTheory.MemLp.coeFn_toLp _ ) ];
      rfl;
    · rw [ ENNReal.toReal_mul, ENNReal.toReal_ofReal ( by apply_rules [ Real.sSup_nonneg ] ; rintro x ⟨ y, rfl ⟩ ; exact norm_nonneg _ ) ];
    · refine' ENNReal.mul_ne_top _ _;
      · exact ENNReal.ofReal_ne_top;
      · exact?

