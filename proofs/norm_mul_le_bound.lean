/-
Proves that the multiplication operator by a real-valued function is self-adjoint.
-/
open MeasureTheory ENNReal

/-- A multiplication operator by a real-valued function is self-adjoint. -/
theorem multiplicationOp_isSelfAdjoint {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α]
  (f : α → ℂ) (hf : Continuous f) (hb : Bornology.IsBounded (Set.range (norm ∘ f)))
  (h_real : ∀ x, (f x).im = 0) :
  IsSelfAdjoint (multiplicationOp f hf hb) := by
    simp +decide [ IsSelfAdjoint, h_real ];
    simp +decide [ Star.star, multiplicationOp ];
    refine' ContinuousLinearMap.ext fun g => _;
    refine' ext_inner_left ℂ _;
    simp +decide [ ContinuousLinearMap.adjoint_inner_right, multiplicationLinearMap ];
    unfold multiplication_toFun;
    simp +decide [ Inner.inner, MeasureTheory.MemLp.toLp ];
    intro a ha; rw [ MeasureTheory.integral_congr_ae ];
    filter_upwards [ MeasureTheory.AEEqFun.coeFn_mk ( ( a : α → ℂ ) * f ) ( by exact MeasureTheory.AEStronglyMeasurable.mul ( a.aestronglyMeasurable ) ( hf.aestronglyMeasurable ) ), MeasureTheory.AEEqFun.coeFn_mk ( ( g : α → ℂ ) * f ) ( by exact MeasureTheory.AEStronglyMeasurable.mul ( g.1.aestronglyMeasurable ) ( hf.aestronglyMeasurable ) ) ] with x hx₁ hx₂;
    simp_all +decide [ Complex.ext_iff, mul_assoc, mul_comm, mul_left_comm ];
    ring

