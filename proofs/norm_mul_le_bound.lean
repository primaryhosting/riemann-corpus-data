lemma norm_mul_le_bound {α : Type*} [MeasureSpace α]
  {f : α → ℂ} {g : α → ℂ} {M : ℝ} (hM : 0 ≤ M)
  (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M)
  (hg : AEStronglyMeasurable g volume) :
  eLpNorm (f * g) 2 volume ≤ ENNReal.ofReal M * eLpNorm g 2 volume := by
    have h_le : ∀ᵐ x ∂MeasureTheory.MeasureSpace.volume, ‖(f * g) x‖ ≤ M * ‖g x‖ := by
      filter_upwards [ hf ] with x hx using by simpa [ mul_assoc ] using mul_le_mul_of_nonneg_right hx ( norm_nonneg ( g x ) ) ;
    generalize_proofs at *; (
    exact?)

