-/
/-- The Spectral Determinant Identity (Theorem 7.1). -/
def SpectralDeterminantIdentity {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (det : (H →L[ℂ] H) → ℂ) (C : ℂ) (G : ℂ → ℂ) (L : BrockianZetaOperator H) : Prop :=
  ∀ s : ℂ, det (s • (1 : H →L[ℂ] H) - (-L.laplacian + L.potential)) = C * riemannZeta (s + 1/2) * G s

