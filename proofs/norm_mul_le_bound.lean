/-
Constructs a Brockian Zeta Operator given a self-adjoint Laplacian and a bounded continuous real-valued potential.
-/
open MeasureTheory ENNReal

/-- Construct a Brockian Zeta Operator from a Laplacian and a real-valued potential. -/
def mkBrockianZetaOperator {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α] [IsFiniteMeasure (volume : Measure α)]
  (laplacian : Lp ℂ 2 (volume : Measure α) →L[ℂ] Lp ℂ 2 (volume : Measure α))
  (h_laplacian_sa : IsSelfAdjoint laplacian)
  (V : α → ℝ) (hV_cont : Continuous V) (hV_bound : Bornology.IsBounded (Set.range V)) :
  BrockianZetaOperator (Lp ℂ 2 (volume : Measure α)) :=
  let V_complex : α → ℂ := fun x => V x
  have hV_complex_cont : Continuous V_complex := continuous_ofReal.comp hV_cont
  have hV_complex_bound : Bornology.IsBounded (Set.range (norm ∘ V_complex)) := by
    -- Boundedness of V implies boundedness of |V|
    -- Since $V$ is bounded, the range of $V_complex$ is also bounded.
    have h_complex_range_bounded : Bornology.IsBounded (Set.range V_complex) := by
      rw [ isBounded_iff_forall_norm_le ] at *;
      aesop;
    rw [ isBounded_iff_forall_norm_le ] at h_complex_range_bounded ⊢;
    aesop
  let potentialOp := multiplicationOp V_complex hV_complex_cont hV_complex_bound
  { laplacian := laplacian
    potential := potentialOp
    is_self_adjoint_laplacian := h_laplacian_sa
    is_self_adjoint_potential := by
      apply multiplicationOp_isSelfAdjoint
      intro x
      simp only [V_complex, Complex.ofReal_im] }

