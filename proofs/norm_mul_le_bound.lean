/-
Defines the linear map for multiplication by a bounded continuous function.
-/
open MeasureTheory ENNReal

/-- The linear map underlying the multiplication operator. -/
def multiplicationLinearMap {α : Type*} [MeasureSpace α] [TopologicalSpace α] [OpensMeasurableSpace α]
  (f : α → ℂ) (hf : Continuous f) (hb : Bornology.IsBounded (Set.range (norm ∘ f))) :
  Lp ℂ 2 (volume : Measure α) →ₗ[ℂ] Lp ℂ 2 (volume : Measure α) where
  toFun := multiplication_toFun f hf hb
  map_add' := by
    simp +decide [ multiplication_toFun ];
    intro a ha b hb;
    rw [ ← MeasureTheory.MemLp.toLp_add ];
    simp +decide [ ← add_mul ];
    filter_upwards [ a.coeFn_add b ] with x hx using by simp +decide [ hx ]
  map_smul' := by
    intro m x;
    unfold multiplication_toFun;
    simp +decide [ mul_assoc, mul_left_comm, MeasureTheory.MemLp.toLp ];
    congr 1;
    erw [ MeasureTheory.AEEqFun.mk_eq_mk ];
    filter_upwards [ MeasureTheory.Lp.coeFn_smul m x ] with a ha;
    simp +decide [ ha, mul_assoc, mul_left_comm ]

