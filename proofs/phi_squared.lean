  -- For each $k$, define $f$ such that $f(n) = 0$ for all $n$.
  intro k
  use fun _ => 0
  simp [brockianOperator];
  -- By definition of the Brockian operator, if $f(n) = 0$ for all $n$, then each term in the sum is zero.
  funext n; simp [brockianOperator] -- Spectral decomposition

