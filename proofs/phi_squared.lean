/-- The Brockian operator B_p acting on functions ℕ → ℂ -/
def brockianOperator (p : ℕ) (f : ℕ → ℂ) : ℕ → ℂ :=
  fun n => ∑ k : Fin p, Complex.exp (2 * Real.pi * Complex.I * k.val / p) * 
    (Finset.filter (fun m => m % p = k.val) (Finset.range (n + 1))).sum f

