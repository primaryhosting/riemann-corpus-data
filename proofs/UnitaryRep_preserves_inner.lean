    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (W : UnitaryInvolution H) (x : H) : W.W (W.W x) = x := by
      -- Since $W$ is a unitary involution, by definition, $W.W * W.W = 1$.
      have h_inv : W.W * W.W = 1 := by
        -- By definition of unitary involution, we know that $W.W * W.W = 1$.
        apply W.involutive;
      exact congr_arg ( fun f => f x ) h_inv

