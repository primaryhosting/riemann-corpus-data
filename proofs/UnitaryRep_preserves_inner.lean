    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- The underlying self-adjoint operator. -/
  A : H →L[ℂ] H
  A_selfadjoint : IsSelfAdjoint A
  /-- The spectral zeta function ζ_A(s) = Σ_n λ_n^(-s). -/
