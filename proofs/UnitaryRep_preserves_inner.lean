  /-- π is D₅-invariant: π ∘ ρ(g) = π for all g ∈ D₅. -/
  proj_invariant : ∀ g : D5, proj.comp (D5_action.ρ g : D5_action.H →L[ℂ] D5_action.H) = proj

  /-- The Laplacian on H_full. -/
  Δ_full : D5_action.H →L[ℂ] D5_action.H  -- Should be unbounded; simplified here

  /-- Laplacian commutes with D₅ action. -/
  Δ_commutes_D5 : ∀ g : D5, Δ_full.comp (D5_action.ρ g : D5_action.H →L[ℂ] D5_action.H) =
                            (D5_action.ρ g : D5_action.H →L[ℂ] D5_action.H).comp Δ_full

