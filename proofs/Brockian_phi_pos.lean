  unfold Brockian.spiralPrime
  rw [Brockian.spiral_norm]
  exact Real.exp_log (Nat.cast_pos.mpr p.isPrime.pos)

/-
The Brockian character χ_B(n) = n^(iφ) = exp(iφ log n)
