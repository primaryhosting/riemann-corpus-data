      unfold Brockian.brockianChar;
      norm_num [ Real.log_mul, hm, hn ];
      rw [ ← Complex.exp_add, mul_add ]

/-
Goldbach representation count: number of ways to write n = p + q with both prime
-/
def Brockian.goldbachCount (n : ℕ) : ℕ :=
  ((Finset.range (n / 2 + 1)).filter 
    (fun p => Nat.Prime p ∧ Nat.Prime (n - p))).card

/-
If representation count ≥ 1, then a Goldbach pair exists
-/
theorem Brockian.goldbach_from_count {n : ℕ} (h : Brockian.goldbachCount n ≥ 1) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- By definition of goldbachCount, if it is at least 1, then there exists a prime p in the range such that n - p is also prime.
      obtain ⟨p, hp⟩ : ∃ p ∈ Finset.range (n / 2 + 1), Nat.Prime p ∧ Nat.Prime (n - p) := by
        contrapose! h;
        rw [Brockian.goldbachCount];
        aesop;
      grind

/-
Key lemma: |x - m| ≤ e implies m - e ≤ x
-/
lemma Brockian.lower_bound_from_abs {x m e : ℝ} (h : |x - m| ≤ e) :
    m - e ≤ x := by
      linarith [ abs_le.mp h ]

/-
A spectral model predicting Goldbach counts via main term + error
-/
structure Brockian.GoldbachSpectralModel where
  mainTerm : ℕ → ℝ
  errorTerm : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorTerm n
  /-- The approximation: |G(n) - Main(n)| ≤ Error(n) -/
  approximation : ∀ n, n > 2 → Even n →
    |(Brockian.goldbachCount n : ℝ) - mainTerm n| ≤ errorTerm n
  /-- Threshold beyond which we have margin -/
  threshold : ℕ
  /-- The key margin condition: Main(n) - Error(n) ≥ 1/2 for large n -/
  margin : ∀ n, n > threshold → mainTerm n - errorTerm n ≥ 1 / 2

/-
For large n, the spectral model guarantees G(n) ≥ 1
-/
theorem Brockian.goldbach_count_positive_large (M : Brockian.GoldbachSpectralModel) :
    ∀ n, n > max 2 M.threshold → Even n → Brockian.goldbachCount n ≥ 1 := by
      intros n hn h_even
      have h_approx : |(Brockian.goldbachCount n : ℝ) - (M.mainTerm n : ℝ)| ≤ (M.errorTerm n : ℝ) := by
        exact M.approximation n ( lt_of_le_of_lt ( le_max_left _ _ ) hn ) h_even;
      exact Nat.pos_of_ne_zero fun h => by have := M.margin n ( lt_of_le_of_lt ( le_max_right _ _ ) hn ) ; norm_num [ h ] at * ; linarith [ abs_le.mp h_approx ] ;

/-
The CONDITIONAL Goldbach Theorem
-/
theorem Brockian.goldbach_conditional (M : Brockian.GoldbachSpectralModel)
    (h_small : ∀ n, n ≤ max 2 M.threshold → n > 2 → Even n →
               ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n) :
    ∀ n, n > 2 → Even n →
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      intro n hn hn_even;
      by_cases h : n ≤ max 2 M.threshold;
      · exact h_small n h hn hn_even;
      · exact Brockian.goldbach_from_count ( Brockian.goldbach_count_positive_large M n ( not_le.mp h ) hn_even )

