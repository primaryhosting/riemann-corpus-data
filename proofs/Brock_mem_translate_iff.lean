/-
Formalization of the core counting lemma for pattern-avoiding translates in Z/qZ, proving the 'q - |G|' law for good starting residues. This module defines bad and good starts for a set of offsets G and proves that the number of good starts is exactly q - |G|.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

open scoped BigOperators

variable {q : ℕ}

/-- Translate a finite set of offsets `G` by a start residue `r0`. -/
def Brock.translate (r0 : ZMod q) (G : Finset (ZMod q)) : Finset (ZMod q) :=
  G.image (fun g => r0 + g)

/-- A start `r0` is *bad* for `G` if 0 appears in the translated pattern. -/
def Brock.BadStart (G : Finset (ZMod q)) (r0 : ZMod q) : Prop :=
  (0 : ZMod q) ∈ Brock.translate r0 G

/-- The set of all bad starts: exactly the negation image of `G`. -/
def Brock.BadStarts (G : Finset (ZMod q)) : Finset (ZMod q) :=
  G.image (fun g => -g)

variable [NeZero q]

/-- The set of all good starts: the complement of `BadStarts` inside `univ`. -/
def Brock.GoodStarts (G : Finset (ZMod q)) : Finset (ZMod q) :=
  Finset.univ \ Brock.BadStarts G

lemma Brock.mem_translate_iff {G : Finset (ZMod q)} {r0 x : ZMod q} :
    x ∈ Brock.translate r0 G ↔ ∃ g ∈ G, r0 + g = x := by
      -- By definition of image, x is in the translate of G by r0 if and only if there exists some g in G such that r0 + g = x.
      simp [Brock.translate];
      -- To prove the equivalence, we can use the fact that addition is commutative and associative in the modular arithmetic.
      apply Iff.intro
      intro h
      use -r0 + x
      aesop
      intro h
      obtain ⟨g, hgG, hg⟩ := h
      have : r0 + g = x := hg
      aesop

/-- Characterization: `r0` is bad iff `r0` is `-g` for some `g ∈ G`. -/
lemma Brock.badStart_iff_mem_badStarts {G : Finset (ZMod q)} {r0 : ZMod q} :
    Brock.BadStart G r0 ↔ r0 ∈ Brock.BadStarts G := by
  constructor
  · intro h
    -- h : 0 ∈ image (fun g => r0 + g) G
    -- so ∃ g ∈ G, r0 + g = 0  ⇒ r0 = -g
    rcases (Brock.mem_translate_iff (G := G) (r0 := r0) (x := (0 : ZMod q))).1 h with ⟨g, hgG, hsum⟩
    -- from r0 + g = 0 we get r0 = -g
    have : r0 = -g := by
      -- rearrange in additive group
      -- r0 + g = 0 ⇒ r0 = -g
      simpa [add_eq_zero_iff_eq_neg] using hsum
    -- show r0 ∈ image (fun g => -g) G
    -- by exhibiting g and using the equality
    refine Finset.mem_image.2 ?_
    refine ⟨g, hgG, ?_⟩
    simpa [Brock.BadStarts, this]
  · intro hr
    -- hr : r0 ∈ image (fun g => -g) G
    rcases Finset.mem_image.1 hr with ⟨g, hgG, rfl⟩
    -- show 0 ∈ image (fun g => r0 + g) G with r0 = -g
    -- choose g itself; (-g) + g = 0
    have : (0 : ZMod q) ∈ Brock.translate (-g) G := by
      -- use mem_translate_iff
      refine (Brock.mem_translate_iff (G := G) (r0 := (-g)) (x := (0 : ZMod q))).2 ?_
      refine ⟨g, hgG, ?_⟩
      simp
    simpa [Brock.BadStart] using this

/-- Negation on `ZMod q` is injective. -/
lemma Brock.neg_injective_zmod : Function.Injective (fun g : ZMod q => -g) := by
  intro a b h
  -- `neg_injective` is available in additive groups
  exact neg_injective h

/-- Cardinality of bad starts equals cardinality of the offset set `G`. -/
theorem Brock.card_badStarts (G : Finset (ZMod q)) :
    (Brock.BadStarts G).card = G.card := by
  -- card(image f G) = card G if f is injective
  simpa [Brock.BadStarts] using Finset.card_image_of_injective G Brock.neg_injective_zmod

/-- Cardinality of good starts is `q - |G|`. -/
theorem Brock.card_goodStarts (G : Finset (ZMod q)) :
    (Brock.GoodStarts G).card = Fintype.card (ZMod q) - G.card := by
      -- By definition of complement, we have |GoodStarts| = |univ| - |BadStarts|.
      have h_compl : (Finset.univ \ Brock.BadStarts G).card = Fintype.card (ZMod q) - (Brock.BadStarts G).card := by
        -- The cardinality of the complement of a set is equal to the total cardinality minus the cardinality of the set itself.
        simp [Finset.card_sdiff, Finset.card_univ];
      -- Substitute the cardinality of the bad starts into the equation from h_compl.
      rw [Brock.card_badStarts G] at h_compl; exact h_compl

/-- For `ZMod q`, the good-start count is exactly `q - |G|` (as a Nat). -/
theorem Brock.card_goodStarts_eq_q_sub (G : Finset (ZMod q)) :
    (Brock.GoodStarts G).card = q - G.card := by
  -- use `Fintype.card (ZMod q) = q`
  simpa [ZMod.card q] using (Brock.card_goodStarts (q := q) G)

/-- The classic “q − 2 law”: if the pattern has two distinct offsets, good starts are `q - 2`. -/
theorem Brock.card_goodStarts_two_offsets {g : ZMod q} (hg : g ≠ 0) :
    (Brock.GoodStarts (q := q) ({(0 : ZMod q), g})).card = q - 2 := by
      convert Brock.card_goodStarts_eq_q_sub _;
      -- Since $g \neq 0$, the set $\{0, g\}$ has exactly two elements, so its cardinality is 2.
      apply Eq.symm; exact Finset.card_pair (by aesop)

/-- A start `r0` is *good* for `G` if 0 does not appear in the translated pattern. -/
def Brock.GoodStart (G : Finset (ZMod q)) (r0 : ZMod q) : Prop :=
  ¬ Brock.BadStart G r0
