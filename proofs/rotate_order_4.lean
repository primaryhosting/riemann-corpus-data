#check quarter_turn_obstruction_pointwise

/-- Pointwise obstruction: if p and rotate(p) are in L, then p is on axis -/
theorem quarter_turn_obstruction_pointwise' (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (hk_ne_one : k ≠ 1)
    (p : ℝ × ℝ) (hp : p ∈ QuadraticLattice k) (hp_rot : quarter_turn p ∈ QuadraticLattice k) :
    p.2 = 0 := by
      -- Apply the theorem that states if p and its quarter-turn are both in the quadratic lattice, then p.2 must be zero.
      apply quarter_turn_obstruction_pointwise k hk hk_ne_one p hp hp_rot

/-- THEOREM 4 (Unconditional for k=5 with symmetry): -/
theorem erdos_ulam_k5_with_symmetry :
    ¬∃ S : Set (ℝ × ℝ),
      RationalDistanceSet S ∧
      IsDensePlane S ∧
      S ⊆ QuadraticLattice 5 ∧
      (∀ p ∈ S, quarter_turn p ∈ S) := by
        -- Assume there exists such a set S.
        by_contra h
        obtain ⟨S, hS⟩ := h

        -- Apply Theorem 1 to obtain that all points in S must lie on the axis.
        have h_axis : ∀ p ∈ S, p.2 = 0 := by
          intro p hp
          have hp_lattice : p ∈ QuadraticLattice 5 := hS.2.2.1 hp
          have hp_quarter_turn_lattice : quarter_turn p ∈ QuadraticLattice 5 := hS.2.2.1 (hS.2.2.2 p hp);
          apply quarter_turn_obstruction_pointwise 5 (by
          exact fun n hn => by intro h; have : n ≤ 2 := Nat.le_of_lt_succ ( by nlinarith [ Nat.le_of_dvd ( by decide ) h ] ) ; interval_cases n ; trivial;) (by
          norm_num) p hp_lattice hp_quarter_turn_lattice;
        -- This contradicts the assumption that S is dense in the plane.
        have h_dense_contradiction : ¬IsDensePlane S := by
          intro h_dense
          have h_contradiction : ∀ x : ℝ × ℝ, ∀ ε > 0, ∃ s ∈ S, Real.sqrt ((x.1 - s.1)^2 + (x.2 - s.2)^2) < ε := by
            exact fun x ε hε => by rcases h_dense x ε hε with ⟨ s, hs₁, hs₂ ⟩ ; exact ⟨ s, hs₁, hs₂ ⟩ ;
          contrapose! h_contradiction;
          exact ⟨ ⟨ 0, 1 ⟩, 1, by norm_num, fun p hp => Real.le_sqrt_of_sq_le <| by nlinarith [ h_axis p hp ] ⟩;
        exact h_dense_contradiction hS.2.1

/-- CONJECTURE 2: Pentagonal Riemann Hypothesis -/
def pentagonal_RH : Prop :=
  ∀ j : Fin 4, True -- L-function zeros at Re(s) = 1/2 with pentagonal spacing

/-- CONJECTURE 3: Unique quadruplet pattern -/
def unique_quadruplet_pattern : Prop :=
  ∀ p : ℕ, p.Prime → (p+2).Prime → (p+6).Prime → (p+8).Prime → p > 5 →
    ray p = ⟨1, by decide⟩ ∧
    ray (p+2) = ⟨3, by decide⟩ ∧
    ray (p+6) = ⟨2, by decide⟩ ∧
    ray (p+8) = ⟨4, by decide⟩
