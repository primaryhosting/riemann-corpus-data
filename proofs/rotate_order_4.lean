def equal_constants_conjecture : Prop :=
  ∃ C : ℝ, ∀ (r₁ r₂ : Fin 5), TwinTransition r₁ r₂ →
    True -- Each transition has constant C/3

/-- Pointwise obstruction: if p and rotate(p) are in L, then p is on axis -/
theorem quarter_turn_obstruction_pointwise (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (hk_ne_one : k ≠ 1)
    (p : ℝ × ℝ) (hp : p ∈ QuadraticLattice k) (hp_rot : quarter_turn p ∈ QuadraticLattice k) :
    p.2 = 0 := by
      -- By definition of $L_k$, we know that $p.2 = 0$ because $p.2 * \sqrt{k}$ and $p.1 * \sqrt{k}$ are both rational.
      have h_rational : ∃ r : ℚ, p.2 = r / Real.sqrt k := by
        obtain ⟨ x, y, hx, hy ⟩ := hp; use y * k; by_cases hk : k = 0 <;> simp_all +decide [ mul_div_cancel₀ ] ;
        rw [ mul_div_assoc, Real.div_sqrt ];
      -- Since $\sqrt{k}$ is irrational, for $p.2 * \sqrt{k}$ to be rational, $p.2$ must be zero.
      obtain ⟨r, hr⟩ : ∃ r : ℚ, p.2 = r / Real.sqrt k := h_rational
      have h_irrational : Irrational (Real.sqrt k) := by
        -- Since $k$ is not a perfect square, $\sqrt{k}$ is irrational.
        have h_irrational : ¬∃ (q : ℚ), q^2 = k := by
          rintro ⟨ q, hq ⟩;
          -- Since $q$ is rational and $q^2 = k$, $k$ must be a perfect square.
          obtain ⟨m, hm⟩ : ∃ m : ℕ, k = m^2 := by
            exact ⟨ q.num.natAbs, by simpa [ ← Int.natCast_inj, sq, Rat.mul_self_num ] using congr_arg Rat.num hq.symm ⟩;
          rcases m with ( _ | _ | m ) <;> simp_all +decide;
          · linarith [ hk 2 ];
          · exact hk _ ( Nat.succ_lt_succ ( Nat.succ_pos _ ) ) ( dvd_refl _ );
        exact fun ⟨ q, hq ⟩ => h_irrational ⟨ q, by rw [ ← @Rat.cast_inj ℝ ] ; push_cast; rw [ hq, Real.sq_sqrt ( Nat.cast_nonneg _ ) ] ⟩;
      obtain ⟨ s, hs ⟩ := hp_rot;
      obtain ⟨ t, ht ⟩ := hs; simp_all +decide [ quarter_turn ] ;
      exact Classical.or_iff_not_imp_right.2 fun h => by exact Classical.not_not.1 fun hr' => h_irrational ⟨ -s⁻¹ * r, by push_cast [ ← ht.1 ] ; ring_nf; norm_num [ hr', h, h_irrational.ne_zero ] ⟩ ;

#check Irrational

#check IsSquare
