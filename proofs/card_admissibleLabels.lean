/-
The Chebyshev function psi(x) is the sum of the von Mangoldt function for all integers up to x.
-/
/-- The Chebyshev function ψ(x). -/
noncomputable def chebyshev_psi (x : ℝ) : ℝ :=
  ∑ n ∈ Finset.range (Nat.floor x + 1), ArithmeticFunction.vonMangoldt n

/-
The Explicit Formula Conjecture states that the error term in the Chebyshev function is bounded by x^(1/2) * log^2(x).
-/
/--
  The Explicit Formula Conjecture:
  The error term in the Prime Number Theorem is bounded by x^(1/2) * log^2(x).
-/
def ExplicitFormulaConjecture : Prop :=
  ∃ C : ℝ, ∀ x : ℝ, x ≥ 2 → |chebyshev_psi x - x| ≤ C * x^(1/2) * (Real.log x)^2

