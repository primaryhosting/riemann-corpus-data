      convert h_eq using 1;
      -- Since the functions are equal almost everywhere, their integrals are equal. Therefore, the equivalence holds.
      apply Iff.intro;
      · exact?;
      · intro h_eq
        have h_eq' : ∀ᵐ x ∂μ, (g x) * (starRingEnd ℂ (d.f x * f x)) = (d.f x * g x) * (starRingEnd ℂ (f x)) := by
          exact h_eq
        have h_eq'' : ∀ᵐ x ∂μ, (d.M f) x = d.f x * f x := by
          convert MeasureTheory.MemLp.coeFn_toLp ( L2Layer.MulOpData.mul_mem_L2 d f ) using 1
        have h_eq''' : ∀ᵐ x ∂μ, (d.M g) x = d.f x * g x := by
          convert MeasureTheory.MemLp.coeFn_toLp ( L2Layer.MulOpData.mul_mem_L2 d g ) using 1
        have h_eq'''' : ∀ᵐ x ∂μ, (g x) * (starRingEnd ℂ ((d.M f) x)) = (d.M g) x * (starRingEnd ℂ (f x)) := by
          filter_upwards [ h_eq', h_eq'', h_eq''' ] with x hx₁ hx₂ hx₃ using by rw [ hx₂, hx₃ ] ; exact hx₁;
        exact h_eq'''';
    intro f; exact (by
    refine' ext_inner_right ℂ _;
    simp +decide [ h_adj, ContinuousLinearMap.adjoint_inner_left ]);
  exact h_adj x ▸ Filter.Eventually.of_forall fun x => rfl

