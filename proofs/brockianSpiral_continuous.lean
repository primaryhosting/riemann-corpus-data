/-- Prime weight log(p)/p. -/
def primeWeight (p : ℕ) : ℝ :=
  Real.log (p : ℝ) / (p : ℝ)

/-- Gaussian-like kernel centered at `w` evaluated at `z`. -/
def gaussianKernel (ε : ℝ) (z w : ℂ) : ℝ :=
  Real.exp (-(norm (z - w))^2 / (ε^2))

/-- Formal Brockian potential (function-level), no convergence claims yet. -/
