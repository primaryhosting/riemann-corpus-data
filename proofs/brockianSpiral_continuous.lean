open MeasureTheory

lemma QuadForms.QForm.Friedrichs_unique_u {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) (x : QF.dom) (u v : H)
    (hu : ∀ y : QF.dom, QF.Q x y = @inner ℂ H _ u (y : H))
    (hv : ∀ y : QF.dom, QF.Q x y = @inner ℂ H _ v (y : H)) : u = v := by
      -- Since the domain is dense, there exists a sequence {y_n} in the domain such that y_n converges to u - v.
      obtain ⟨y_n, hy_n⟩ : ∃ y_n : ℕ → QF.dom, Filter.Tendsto (fun n => (y_n n : H)) Filter.atTop (nhds (u - v)) := by
        -- Since the domain is dense, for any ε > 0, there exists a y in the domain such that ‖y - (u - v)‖ < ε.
        have h_dense : ∀ ε > 0, ∃ y : QF.dom, ‖(y : H) - (u - v)‖ < ε := by
          have := QF.dense ( u - v );
          rw [ Metric.mem_closure_iff ] at this;
          exact fun ε hε => by rcases this ε hε with ⟨ y, hy, hy' ⟩ ; exact ⟨ ⟨ y, hy ⟩, by simpa [ dist_eq_norm' ] using hy' ⟩ ;
        exact ⟨ fun n => Classical.choose ( h_dense ( 1 / ( n + 1 ) ) ( by positivity ) ), by exact tendsto_iff_norm_sub_tendsto_zero.mpr ( squeeze_zero ( fun _ => norm_nonneg _ ) ( fun n => Classical.choose_spec ( h_dense ( 1 / ( n + 1 ) ) ( by positivity ) ) |> le_of_lt ) ( tendsto_one_div_add_atTop_nhds_zero_nat ) ) ⟩;
      -- Since the inner product is continuous, we have that the inner product of (u - v) with y_n tends to the inner product of (u - v) with (u - v).
      have h_inner_cont : Filter.Tendsto (fun n => inner ℂ (u - v) (y_n n : H)) Filter.atTop (nhds (inner ℂ (u - v) (u - v))) := by
        exact Filter.Tendsto.inner tendsto_const_nhds hy_n;
      have h_inner_zero : ∀ n, inner ℂ (u - v) (y_n n : H) = 0 := by
        intro n; have := hu ( y_n n ) ; have := hv ( y_n n ) ; simp_all +decide [ inner_sub_left, inner_sub_right ] ;
      have h_inner_zero : inner ℂ (u - v) (u - v) = 0 := by
        exact tendsto_nhds_unique h_inner_cont ( by simpa only [ h_inner_zero ] using tendsto_const_nhds );
      exact sub_eq_zero.mp ( by simpa [ inner_self_eq_norm_sq_to_K ] using h_inner_zero )

open MeasureTheory

def QuadForms.QForm.FriedrichsDomain {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) : Submodule ℂ H where
  carrier := { u : H | ∃ (h : u ∈ QF.dom) (f : H), ∀ v : QF.dom, QF.Q ⟨u, h⟩ v = @inner ℂ H _ f (v : H) }
  add_mem' := by
    -- By definition of the set, if a and b are in the set, then there exist f_a and f_b in H such that for all v in QF.dom, Q(a, v) = inner(f_a, v) and Q(b, v) = inner(f_b, v).
    intro a b ha hb
    obtain ⟨ha_dom, f_a, hf_a⟩ := ha
    obtain ⟨hb_dom, f_b, hf_b⟩ := hb
    use QF.dom.add_mem ha_dom hb_dom, f_a + f_b;
    -- By linearity of QF.Q, we have Q(a + b, v) = Q(a, v) + Q(b, v).
    have h_linear : ∀ v : QF.dom, QF.Q (⟨a + b, by
      -- Since QF.dom is a submodule, it is closed under addition.
      apply QF.dom.add_mem ha_dom hb_dom⟩ : QF.dom) v = QF.Q (⟨a, ha_dom⟩ : QF.dom) v + QF.Q (⟨b, hb_dom⟩ : QF.dom) v := by
      -- By linearity of QF.Q in the first argument, we have QF.Q (⟨a + b, by sorry⟩) v = QF.Q (⟨a, ha_dom⟩) v + QF.Q (⟨b, hb_dom⟩) v.
      have h_linear : ∀ u v : QF.dom, QF.Q (u + v) = QF.Q u + QF.Q v := by
        exact?
      generalize_proofs at *;
      exact fun v => congr_arg ( fun f => f v ) ( h_linear ⟨ a, ha_dom ⟩ ⟨ b, hb_dom ⟩ )
    generalize_proofs at *;
    -- By linearity of the inner product, we can combine the terms.
    intros v
    rw [h_linear, hf_a, hf_b]
    simp [inner_add_left]
  zero_mem' := by
    -- Since 0 is in any submodule, we can take h to be the trivial proof that 0 is in the domain.
    use QF.dom.zero_mem, 0; simp;
    -- Since $QF.Q$ is a linear map, we have $QF.Q 0 = 0$.
    have h_zero : QF.Q ⟨0, QF.dom.zero_mem⟩ = 0 := by
      -- Since $QF.Q$ is a linear map, we have $QF.Q 0 = 0$ by definition of linearity.
      apply LinearMap.map_zero;
    -- Since $QF.Q ⟨0, QF.dom.zero_mem⟩$ is the zero map, applying it to any element gives zero.
    simp [h_zero]
  smul_mem' := by
    -- Let $x$ be in the set, so there exists $h \in QF.dom$ and $f \in H$ such that $QF.Q h v = \langle f, v \rangle$ for all $v \in QF.dom$.
    intro c x hx
    obtain ⟨h, f, hf⟩ := hx;
    -- If $x \in QF.dom$, then $c \cdot x \in QF.dom$ because $QF.dom$ is a submodule.
    have h_dom : c • x ∈ QF.dom := by
      exact QF.dom.smul_mem c h;
    -- Let $g = c \cdot f$. Then for any $v \in QF.dom$, we have $\langle g, v \rangle = \langle c \cdot f, v \rangle = c \cdot \langle f, v \rangle = c \cdot QF.Q ⟨x, h⟩ v = QF.Q ⟨c \cdot x, h_dom⟩ v$.
    use h_dom, c • f;
    intro v; have := QF.Q ⟨ c • x, h_dom ⟩ v; have := QF.Q ⟨ x, h ⟩ v; simp_all +decide [ inner_smul_left, inner_smul_right ] ;
    convert congr_arg ( · * ( starRingEnd ℂ c ) ) ( hf v v.2 ) using 1 ; ring!;
    -- By definition of $QF.Q$, we know that it is conjugate linear in the first argument.
    have h_conj : ∀ (x y : QF.dom) (c : ℂ), QF.Q (c • x) y = starRingEnd ℂ c • QF.Q x y := by
      exact?
    generalize_proofs at *; (
    convert h_conj ⟨ x, h ⟩ v c using 1 ; simp +decide [ mul_comm ])

open MeasureTheory

def QuadForms.QForm.FriedrichsOp {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) : QF.FriedrichsDomain →ₗ[ℂ] H where
  toFun := fun ⟨u, hu⟩ => Classical.choose hu.2
  map_add' := by
    -- By definition of the Friedrichs domain, for any x and y in the domain, there exist f and g such that Q(x) = inner f and Q(y) = inner g.
    intro x y
    obtain ⟨f, hf⟩ := (x : QF.FriedrichsDomain).2
    obtain ⟨g, hg⟩ := (y : QF.FriedrichsDomain).2;
    have h_sum : ∀ v : QF.dom, QF.Q (⟨(x : H) + (y : H), by
      exact QF.dom.add_mem f g⟩ : QF.dom) v = @inner ℂ H _ (Classical.choose hf + Classical.choose hg) (v : H) := by
      -- By definition of QF.Q, we have QF.Q (x + y) v = QF.Q x v + QF.Q y v.
      have h_split : ∀ v : QF.dom, QF.Q (⟨(x : H) + (y : H), by
        exact QF.dom.add_mem f g⟩ : QF.dom) v = QF.Q ⟨(x : H), f⟩ v + QF.Q ⟨(y : H), g⟩ v := by
        exact fun v => by simpa using congr_arg ( fun f : QF.dom →ₗ[ℂ] ℂ => f v ) ( QF.Q.map_add ⟨ ( x : H ), f ⟩ ⟨ ( y : H ), g ⟩ ) ;
      generalize_proofs at *;
      intro v; rw [ h_split v, hf.choose_spec v, hg.choose_spec v, inner_add_left ] ;
    generalize_proofs at *;
    have h_unique : ∀ u v : H, (∀ w : QF.dom, @inner ℂ H _ u (w : H) = @inner ℂ H _ v (w : H)) → u = v := by
      intro u v huv
      have h_eq : ∀ w : QF.dom, @inner ℂ H _ (u - v) (w : H) = 0 := by
        simp +decide [ huv, inner_sub_left ]
      generalize_proofs at *;
      have h_eq : ∀ w : H, @inner ℂ H _ (u - v) w = 0 := by
        intro w
        have h_dense : ∀ w : H, ∃ seq : ℕ → QF.dom, Filter.Tendsto (fun n => (seq n : H)) Filter.atTop (nhds w) := by
          intro w
          have h_dense : Dense (QF.dom : Set H) := by
            exact QF.dense
            skip
          generalize_proofs at *;
          have := h_dense w
          generalize_proofs at *;
          rw [ mem_closure_iff_seq_limit ] at this
          generalize_proofs at *;
          exact ⟨ fun n => ⟨ this.choose n, this.choose_spec.1 n ⟩, this.choose_spec.2 ⟩
        generalize_proofs at *;
        obtain ⟨ seq, hseq ⟩ := h_dense w
        generalize_proofs at *;
        exact tendsto_nhds_unique ( Filter.Tendsto.inner tendsto_const_nhds hseq ) ( tendsto_const_nhds.congr fun n => by simp +decide [ h_eq ] )
      generalize_proofs at *;
      exact sub_eq_zero.mp ( by simpa [ inner_self_eq_norm_sq_to_K ] using h_eq ( u - v ) )
    generalize_proofs at *;
    -- Apply the uniqueness property h_unique to conclude that the chosen element for x + y is indeed the sum of the chosen elements for x and y.
    apply h_unique;
    intro w
    generalize_proofs at *;
    exact Eq.symm ( Classical.choose_spec ( show ∃ f : H, ∀ v : QF.dom, QF.Q ⟨ x + y, by tauto ⟩ v = Inner.inner ℂ f ( v : H ) from ⟨ _, h_sum ⟩ ) w ) ▸ h_sum w ▸ rfl
    skip
  map_smul' := by
    -- By definition of the Friedrichs domain, we know that for any x in the domain, there exists a unique u in H such that QF.Q x y = inner u y for all y.
    intro m x
    obtain ⟨u, hu⟩ := x.prop
    obtain ⟨v, hv⟩ := (m • x).prop
    generalize_proofs at *;
    -- By the uniqueness of the Riesz representation, if two f's satisfy the same condition, they must be the same.
    have h_unique : ∀ f₁ f₂ : H, (∀ v : QF.dom, QF.Q (m • ⟨x.val, u⟩) v = inner ℂ f₁ v) → (∀ v : QF.dom, QF.Q (m • ⟨x.val, u⟩) v = inner ℂ f₂ v) → f₁ = f₂ := by
      intro f₁ f₂ h_eq
      have h_dense : Dense (QF.dom : Set H) := by
        exact QF.dense;
      -- Since the domain is dense, the orthogonal complement of the domain is trivial.
      have h_orthogonal_complement : ∀ (v : H), (∀ w : QF.dom, inner ℂ v w = 0) → v = 0 := by
        exact?
      generalize_proofs at *;
      specialize h_orthogonal_complement ( f₁ - f₂ ) ; simp_all +decide [ sub_eq_zero ] ;
    apply h_unique;
    · exact Classical.choose_spec hv;
    · intro v; have := Classical.choose_spec ( show ∃ f : H, ∀ v : QF.dom, QF.Q ⟨ x, u ⟩ v = Inner.inner ℂ f v from hu ) v; simp +decide [ this, inner_smul_left, inner_smul_right ] ;
      convert congr_arg ( · * ( starRingEnd ℂ m ) ) this using 1;
      · rw [ mul_comm ];
        -- By the properties of the sesquilinear form QF.Q, we have QF.Q (m • x) v = starRingEnd ℂ m * QF.Q x v.
        have h_sesq : ∀ (m : ℂ) (x : QF.dom) (v : QF.dom), QF.Q (m • x) v = starRingEnd ℂ m * QF.Q x v := by
          exact fun m x v => by simp [ mul_comm ];
        -- Apply the hypothesis `h_sesq` with `x` and `v`.
        convert h_sesq m ⟨x.val, u⟩ v using 1;
      · grind

open MeasureTheory

def QuadForms.QForm.Friedrichs {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) (hH : QF.IsHermitian) (hC : QF.IsClosed) (hLB : QF.LowerBounded) : UOp H :=
  { dom := QF.FriedrichsDomain
    op := QF.FriedrichsOp }
