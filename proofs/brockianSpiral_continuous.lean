theorem L2Layer.MulOpData.isSelfAdjoint_of_real' {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (d : L2Layer.MulOpData μ) (hreal : ∀ᵐ x ∂μ, (d.f x).im = 0) :
    IsSelfAdjoint (L2Layer.MulOpData.M d) := by
      -- Apply the theorem that states if the function f is real almost everywhere, then the multiplication operator M is self-adjoint.
      apply L2Layer.MulOpData.isSelfAdjoint_of_real d hreal

