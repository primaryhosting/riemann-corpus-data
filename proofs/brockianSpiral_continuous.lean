/-- Minimal quadratic form interface (sesquilinear on a dense domain). -/
structure QuadForms.QForm (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  dom : Submodule ℂ H
  Q : dom →ₗ⋆[ℂ] (dom →ₗ[ℂ] ℂ)   -- Antilinear in first, linear in second
  dense : Dense (dom : Set H)

/-- Lower boundedness: ∃c, Re(Q(x,x)) ≥ c‖x‖². -/
def QuadForms.QForm.LowerBounded {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) : Prop :=
  ∃ c : ℝ, ∀ x : QF.dom, (QF.Q x x).re ≥ c * ‖(x : H)‖^2

/-- Closedness: The domain is complete with respect to the form norm. -/
def QuadForms.QForm.IsClosed {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) : Prop :=
  ∃ c : ℝ, (∀ x : QF.dom, (QF.Q x x).re ≥ c * ‖(x : H)‖^2) ∧
  ∀ (u : ℕ → QF.dom),
    (∀ ε > 0, ∃ N, ∀ n m, N ≤ n → N ≤ m →
      (QF.Q (u n - u m) (u n - u m)).re + (1 - c) * ‖(u n - u m : H)‖^2 < ε^2) →
    ∃ x : QF.dom, ∀ ε > 0, ∃ N, ∀ n, N ≤ n →
      (QF.Q (u n - x) (u n - x)).re + (1 - c) * ‖(u n - x : H)‖^2 < ε^2

/-- Symmetry of the form: Q(x,y) = conj(Q(y,x)). -/
def QuadForms.QForm.IsHermitian {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) : Prop :=
  ∀ x y : QF.dom, QF.Q x y = star (QF.Q y x)

/-- The form norm squared. -/
def QuadForms.QForm.formNormSq {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (QF : QuadForms.QForm H) (c : ℝ) (x : QF.dom) : ℝ :=
  (QF.Q x x).re + (1 - c) * ‖(x : H)‖^2

