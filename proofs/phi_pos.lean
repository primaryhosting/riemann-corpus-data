noncomputable section

/-- The golden ratio φ = (1 + √5)/2 -/
abbrev phi : ℝ := Real.goldenRatio

/-- Exact definition: 2/φ -/
noncomputable def two_over_phi : ℝ := 2 / phi

/-- Exact definition: 2/√3 -/
noncomputable def two_over_sqrt3 : ℝ := 2 / Real.sqrt 3

theorem phi_pos : 0 < phi := by
  exact?

theorem phi_gt_one : 1 < phi := by
  exact?

theorem phi_defining_eq : phi ^ 2 = phi + 1 := by
  grind

theorem phi_reciprocal : phi⁻¹ = phi - 1 := by
  -- By definition of $phi$, we know that $phi = \frac{1 + \sqrt{5}}{2}$.
  have h_phi_def : phi = (1 + Real.sqrt 5) / 2 := by
    exact?
  rw [h_phi_def]
  -- Now compute the inverse of $phi$.
  field_simp
  ring_nf
  norm_num at *

theorem two_over_phi_pos : 0 < two_over_phi := by
  -- By definition of $two_over_phi$, we know that $0 < two_over_phi$.
  unfold two_over_phi at *;
  norm_num at *; -- Since $\phi$ is positive, $2 / \phi$ is also positive.;
  -- Since $\sqrt{5}$ is positive, adding 1 to it will also result in a positive number.
  apply add_pos_of_pos_of_nonneg; norm_num; exact Real.sqrt_nonneg 5

theorem two_over_sqrt3_pos : 0 < two_over_sqrt3 := by
  -- By definition of $two_over_sqrt3$, we know that $two_over_sqrt3 = \frac{2}{\sqrt{3}}$.
  simp [two_over_sqrt3]

/-- Rays of the Pentagon: residues {1,2,3,4} modulo 5 -/
inductive PentagonRay : Type
  | one   : PentagonRay
  | two   : PentagonRay
  | three : PentagonRay
  | four  : PentagonRay
  deriving DecidableEq, Repr

/-- Geometric types: Spiral or Pentagram -/
inductive GeometricType : Type
  | Spiral    : GeometricType  -- rays {1,4}
  | Pentagram : GeometricType  -- rays {2,3}
  deriving DecidableEq, Repr

/-- Classify a prime by its residue modulo 5 -/
def pentagonRay (p : ℕ) : Option PentagonRay :=
  match p % 5 with
  | 1 => some PentagonRay.one
  | 2 => some PentagonRay.two
  | 3 => some PentagonRay.three
  | 4 => some PentagonRay.four
  | _ => none

/-- Assign geometric type based on residue -/
def geometricType (p : ℕ) : Option GeometricType :=
  match p % 5 with
  | 1 | 4 => some GeometricType.Spiral
  | 2 | 3 => some GeometricType.Pentagram
  | _ => none

theorem prime_gt_five_has_ray (p : ℕ) (hp : Nat.Prime p) (hp5 : 5 < p) :
    ∃ r : PentagonRay, pentagonRay p = some r := by
      -- Since p is a prime greater than 5, it must be congruent to 1, 2, 3, or 4 modulo 5. Therefore, pentagonRay p is some PentagonRay.
      have h_mod : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
        -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p \mod 5$ must be one of 1, 2, 3, or 4.
        have h_mod : p % 5 ≠ 0 := by
          exact fun h => by have := Nat.dvd_of_mod_eq_zero h; rw [ hp.dvd_iff_eq ] at this <;> linarith;
        grind;
      -- By definition of pentagonRay, if p % 5 is 1, 2, 3, or 4, then pentagonRay p is some PentagonRay.
      cases h_mod <;> simp [pentagonRay, *];
      -- By cases on the disjunction in ‹p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4›, we can handle each case individually.
      cases' ‹p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4› with h2 h3 h4;
      · -- Since $p \equiv 2 \pmod{5}$, we have $pentagonRay p = some PentagonRay.two$.
        use PentagonRay.two
        simp [h2];
      · -- By cases on the disjunction in h3, we can handle each case individually.
        cases h3 <;> simp [*]

theorem prime_gt_five_has_type (p : ℕ) (hp : Nat.Prime p) (hp5 : 5 < p) :
    ∃ t : GeometricType, geometricType p = some t := by
      -- Since $p$ is a prime greater than 5, it is not divisible by 5, so $p \mod 5$ must be 1, 2, 3, or 4.
      have h_mod : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
        -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p \mod 5$ must be one of 1, 2, 3, or 4.
        have h_mod : p % 5 ≠ 0 := by
          exact fun h => by have := Nat.dvd_of_mod_eq_zero h; rw [ hp.dvd_iff_eq ] at this <;> linarith;
        grind;
      -- By definition of geometricType, we can split into cases based on p % 5.
      cases' h_mod with h_mod h_mod h_mod h_mod;
      · -- Since $p \mod 5 = 1$, we have $geometricType p = some GeometricType.Spiral$.
        use GeometricType.Spiral
        simp [geometricType, h_mod];
      · -- By definition of geometricType, we can split into cases based on p % 5 and show that each case leads to the existence of t.
        cases' h_mod with h_mod h_mod h_mod_mod;
        · exact ⟨ GeometricType.Pentagram, by unfold geometricType; aesop ⟩;
        · cases h_mod <;> simp +decide [ *, geometricType ]

/-- Four types of consecutive prime transitions -/
inductive TransitionType : Type
  | SpiralToSpiral      : TransitionType  -- S → S
  | SpiralToPentagram   : TransitionType  -- S → P
  | PentagramToSpiral   : TransitionType  -- P → S
  | PentagramToPentagram : TransitionType  -- P → P
  deriving DecidableEq, Repr

/-- Classify a transition between consecutive primes -/
def classifyTransition (p q : ℕ) : Option TransitionType :=
  match geometricType p, geometricType q with
  | some GeometricType.Spiral, some GeometricType.Spiral =>
      some TransitionType.SpiralToSpiral
  | some GeometricType.Spiral, some GeometricType.Pentagram =>
      some TransitionType.SpiralToPentagram
  | some GeometricType.Pentagram, some GeometricType.Spiral =>
      some TransitionType.PentagramToSpiral
  | some GeometricType.Pentagram, some GeometricType.Pentagram =>
      some TransitionType.PentagramToPentagram
  | _, _ => none

/-- Cross-type transitions: S↔P -/
def is_cross_type : TransitionType → Bool
  | TransitionType.SpiralToPentagram => true
  | TransitionType.PentagramToSpiral => true
  | _ => false

/-- Within-type transitions: S→S, P→P -/
def is_within_type : TransitionType → Bool
  | TransitionType.SpiralToSpiral => true
  | TransitionType.PentagramToPentagram => true
  | _ => false

theorem cross_within_partition (t : TransitionType) :
    is_cross_type t = true ∨ is_within_type t = true := by
  cases t <;> simp [is_cross_type, is_within_type]

theorem cross_within_exclusive (t : TransitionType) :
    is_cross_type t = true → is_within_type t = false := by
  cases t <;> simp [is_cross_type, is_within_type]

def BrockianConjecture : Prop :=
    (∃ (transition_ratio : ℕ → ℝ),
      (∀ N, 0 < transition_ratio N) ∧ 
      Filter.Tendsto transition_ratio Filter.atTop (nhds two_over_phi))

theorem BrockianConjecture.statement :
    BrockianConjecture ↔ 
    (∃ (transition_ratio : ℕ → ℝ),
      (∀ N, 0 < transition_ratio N) ∧ 
      Filter.Tendsto transition_ratio Filter.atTop (nhds two_over_phi)) := by
  rfl

/-- Normalized gap between consecutive primes -/
noncomputable def normalizedGap (p q : ℕ) : ℝ :=
  (q - p : ℝ) / Real.log p

/-- Conjecture: Gap ratio structure -/
def GapStructureConjecture : Prop :=
    (∃ (gap_ratio_within gap_ratio_cross : ℕ → ℝ),
      Filter.Tendsto (fun N => gap_ratio_within N / gap_ratio_cross N)
        Filter.atTop (nhds two_over_sqrt3))

theorem GapStructureConjecture.statement :
    GapStructureConjecture ↔
    (∃ (gap_ratio_within gap_ratio_cross : ℕ → ℝ),
      Filter.Tendsto (fun N => gap_ratio_within N / gap_ratio_cross N)
        Filter.atTop (nhds two_over_sqrt3)) := by
  rfl

/-- Theoretical conservation: weighted gaps sum to 1/2 per transition -/
def ConservationLaw : Prop :=
    (∀ (p_cross p_within : ℝ) (g_cross g_within : ℝ),
      p_cross + p_within = 1 →
      p_cross * g_cross + p_within * g_within = (1 : ℝ) / 2)

theorem ConservationLaw.statement :
    ConservationLaw ↔
    (∀ (p_cross p_within : ℝ) (g_cross g_within : ℝ),
      p_cross + p_within = 1 →
      p_cross * g_cross + p_within * g_within = (1 : ℝ) / 2) := by
  rfl
