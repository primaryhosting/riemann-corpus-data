def FirstProofQ6.refine (G : SimpleGraph V) (ε : ℝ) (S : Finset V) : Finset V :=
  if h : ∃ v ∈ S, FirstProofQ6.isBad G S ε v then
    let v := h.choose
    FirstProofQ6.refine G ε (S.erase v)
  else
