def FirstProofQ6.boundary_term (G : SimpleGraph V) (S : Finset V) (x : V → ℝ) : ℝ :=
  ∑ i ∈ S, ∑ j ∈ Finset.univ \ S, if G.Adj i j then (x i - x j)^2 else 0

