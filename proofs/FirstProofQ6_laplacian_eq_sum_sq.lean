def FirstProofQ6.isBad (G : SimpleGraph V) (S : Finset V) (ε : ℝ) (v : V) : Prop :=
  2 * (FirstProofQ6.degreeInduced G S v : ℝ) > ε * (FirstProofQ6.degreeBoundary G S v : ℝ)

