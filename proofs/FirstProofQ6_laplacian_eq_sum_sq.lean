/-- Laplacian matrix L = D - A -/
abbrev FirstProofQ6.laplacianMatrix (G : SimpleGraph V) : Matrix V V ℝ := 
  G.lapMatrix ℝ

/-- Induced Laplacian on subset S -/
def FirstProofQ6.inducedLaplacian (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  let G' := G.induce ↑S
  Matrix.of (fun i j => 
    if h : i ∈ S ∧ j ∈ S then (G'.lapMatrix ℝ) ⟨i, h.1⟩ ⟨j, h.2⟩ else 0)

/-- S is ε-light if εL - L_S is positive semidefinite -/
def FirstProofQ6.IsEpsilonLight (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  (ε • FirstProofQ6.laplacianMatrix G - FirstProofQ6.inducedLaplacian G S).PosSemidef

/-- Internal edges (both endpoints in S) -/
def FirstProofQ6.internalEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S)).card

/-- Boundary edges (exactly one endpoint in S) -/
def FirstProofQ6.boundaryEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => ∃ v ∈ e, v ∈ S ∧ ∃ w ∈ e, w ∉ S)).card

/-- Local degree condition: 2 * deg_S(v) ≤ ε * deg_∂S(v) -/
def FirstProofQ6.LocalLightCondition (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  ∀ v ∈ S, 2 * (FirstProofQ6.internalEdges G {v} : ℝ) ≤ ε * (FirstProofQ6.boundaryEdges G {v} : ℝ) -- Wait, internalEdges of {v} is 0!

-- Correct definition:
-- deg_S(v) is |N(v) ∩ S|
-- deg_∂S(v) is |N(v) \ S|
def FirstProofQ6.degreeInduced (G : SimpleGraph V) (S : Finset V) (v : V) : ℕ :=
  (G.neighborFinset v ∩ S).card

def FirstProofQ6.degreeBoundary (G : SimpleGraph V) (S : Finset V) (v : V) : ℕ :=
  (G.neighborFinset v \ S).card

def FirstProofQ6.SatisfiesLocalCondition (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  ∀ v ∈ S, 2 * (FirstProofQ6.degreeInduced G S v : ℝ) ≤ ε * (FirstProofQ6.degreeBoundary G S v : ℝ)

