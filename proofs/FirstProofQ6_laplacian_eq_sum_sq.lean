        exact mul_nonneg ( by norm_num ) ( Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => by split_ifs <;> positivity );
      nlinarith [ mul_le_mul_of_nonneg_left h_boundary_term hε.le ]

lemma FirstProofQ6.local_implies_epsilon_light_supported_v2 (G : SimpleGraph V) (S : Finset V) (ε : ℝ)
    (hε : 0 < ε) (hε1 : ε < 1)
    (h_local : FirstProofQ6.SatisfiesLocalCondition G S ε)
    (x : V → ℝ) (hx : ∀ v ∉ S, x v = 0) :
    x ⬝ᵥ (ε • FirstProofQ6.laplacianMatrix G - FirstProofQ6.inducedLaplacian G S) *ᵥ x ≥ 0 := by
      -- Apply the lemma that states if the local condition holds, then the quadratic form is non-negative for x with zero support outside S. This follows directly from the hypothesis h_local and the definition of the quadratic form.
      apply FirstProofQ6.local_implies_epsilon_light_supported G S ε hε hε1 h_local x hx

lemma FirstProofQ6.schur_complement_condition (G : SimpleGraph V) (S : Finset V) (ε : ℝ) :
    FirstProofQ6.IsEpsilonLight G S ε ↔
    ∀ x : V → ℝ, (1 - ε) * (x ⬝ᵥ FirstProofQ6.inducedLaplacian G S *ᵥ x) ≤
    ε * (x ⬝ᵥ FirstProofQ6.laplacianMatrix G *ᵥ x - x ⬝ᵥ FirstProofQ6.inducedLaplacian G S *ᵥ x) := by
      constructor;
      · intro h x
        have h_pos_semidef : x ⬝ᵥ (ε • FirstProofQ6.laplacianMatrix G - FirstProofQ6.inducedLaplacian G S) *ᵥ x ≥ 0 := by
          exact h.2 x;
        simp_all +decide [ Matrix.mulVec, dotProduct ];
        simp_all +decide [ mul_assoc, mul_sub, sub_mul, Finset.mul_sum _ _ _, Finset.sum_mul ];
        simpa only [ mul_left_comm ] using h_pos_semidef;
      · intro h;
        constructor;
        · simp +decide [ Matrix.IsHermitian, Matrix.transpose_sub, Matrix.transpose_smul ];
          congr! 1;
          · simp +decide [ SimpleGraph.lapMatrix ];
            simp +decide [ SimpleGraph.degMatrix, SimpleGraph.adjMatrix ];
          · unfold FirstProofQ6.inducedLaplacian;
            ext i j; simp +decide [ SimpleGraph.lapMatrix ] ;
            simp +decide [ SimpleGraph.degMatrix, SimpleGraph.neighborFinset ];
            split_ifs <;> simp_all +decide [ SimpleGraph.adj_comm ];
            · by_cases hij : i = j <;> simp +decide [ hij ];
              exact if_neg ( by aesop );
            · exact False.elim ( ‹¬G.Adj _ _› ( by rwa [ SimpleGraph.adj_comm ] ) );
            · tauto;
            · by_cases hij : i = j <;> simp_all +decide [ Matrix.diagonal ];
              grind;
        · simp_all +decide [ Matrix.mulVec, dotProduct ];
          simp_all +decide [ sub_mul, mul_sub, Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, mul_assoc, mul_comm, mul_left_comm ]

lemma FirstProofQ6.local_implies_epsilon_light_supported_v3 (G : SimpleGraph V) (S : Finset V) (ε : ℝ)
    (hε : 0 < ε) (hε1 : ε < 1)
    (h_local : FirstProofQ6.SatisfiesLocalCondition G S ε)
    (x : V → ℝ) (hx : ∀ v ∉ S, x v = 0) :
    x ⬝ᵥ (ε • FirstProofQ6.laplacianMatrix G - FirstProofQ6.inducedLaplacian G S) *ᵥ x ≥ 0 := by
      apply FirstProofQ6.local_implies_epsilon_light_supported_v2 G S ε hε hε1 h_local x hx
