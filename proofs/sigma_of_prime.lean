  simp [add_div]
  -- The difference between the two exponents is $2\pi i (j.val + 1)$, which is an integer multiple of $2\pi i$, so the exponentials are equal.
  have h_diff : 2 * Real.pi * Complex.I * (j.val + 1) * (n + q) / q - 2 * Real.pi * Complex.I * (j.val + 1) * n / q = 2 * Real.pi * Complex.I * (j.val + 1) := by
    rw [ div_sub_div_same, div_eq_iff ] <;> ring ; norm_num [ q ];
  -- Since the difference between the exponents is an integer multiple of $2\pi i$, the exponentials are equal.
  have h_exp_eq : Complex.exp (2 * Real.pi * Complex.I * (j.val + 1)) = 1 := by
    exact Complex.exp_eq_one_iff.mpr ⟨ j.val + 1, by push_cast; ring ⟩;
  -- Using the property of exponentials that $e^{a + b} = e^a \cdot e^b$, we can rewrite the first exponential as the product of the second exponential and $e^{2\pi i (j.val + 1)}$.
  have h_exp_prop : Complex.exp (2 * Real.pi * Complex.I * (j.val + 1) * (n + q) / q) = Complex.exp (2 * Real.pi * Complex.I * (j.val + 1) * n / q) * Complex.exp (2 * Real.pi * Complex.I * (j.val + 1)) := by
    -- Using the property of exponentials that $e^{a + b} = e^a \cdot e^b$, we can rewrite the left-hand side as the product of the two exponentials.
    rw [←Complex.exp_add];
    exact congr_arg _ ( by linear_combination' h_diff );
  rw [ h_exp_prop, h_exp_eq, mul_one ] -- Complete with periodicity

