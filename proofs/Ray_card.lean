def D5 := DihedralGroup 5

inductive Ray : Type
  | ray_0 : Ray  -- n ≡ 0 (mod 5)
  | ray_1 : Ray  -- n ≡ 1 (mod 5)
  | ray_2 : Ray  -- n ≡ 2 (mod 5)
  | ray_3 : Ray  -- n ≡ 3 (mod 5)
  | ray_4 : Ray  -- n ≡ 4 (mod 5)
  deriving DecidableEq, Inhabited, Fintype

def Ray.toNat : Ray → Fin 5
  | Ray.ray_0 => 0
  | Ray.ray_1 => 1
  | Ray.ray_2 => 2
  | Ray.ray_3 => 3
  | Ray.ray_4 => 4

def Ray.toString : Ray → String
  | Ray.ray_0 => "Ray_0"
  | Ray.ray_1 => "Ray_1"
  | Ray.ray_2 => "Ray_2"
  | Ray.ray_3 => "Ray_3"
  | Ray.ray_4 => "Ray_4"

instance : ToString Ray := ⟨Ray.toString⟩

theorem Ray.card : Fintype.card Ray = 5 := by decide

def assignRay (n : ℕ) : Ray :=
  match n % 5 with
  | 0 => Ray.ray_0
  | 1 => Ray.ray_1
  | 2 => Ray.ray_2
  | 3 => Ray.ray_3
  | _ => Ray.ray_4

theorem assignRay_spec (n : ℕ) : (assignRay n).toNat = n % 5 := by
  unfold assignRay Ray.toNat
  have h := Nat.mod_lt n (by norm_num : 0 < 5)
  interval_cases n % 5 <;> rfl

def isPentagonRay : Ray → Bool
  | Ray.ray_1 | Ray.ray_4 => true
  | _ => false

def isPentagramRay : Ray → Bool
  | Ray.ray_2 | Ray.ray_3 => true
  | _ => false

theorem ray_dichotomy (r : Ray) (h : r ≠ Ray.ray_0) :
    isPentagonRay r = true ∨ isPentagramRay r = true := by
  cases r <;> simp [isPentagonRay, isPentagramRay] <;> try contradiction

theorem pentagon_pentagram_disjoint (r : Ray) :
    ¬(isPentagonRay r = true ∧ isPentagramRay r = true) := by
  cases r <;> simp [isPentagonRay, isPentagramRay]

instance : Fact (3 ≤ 5) := ⟨by norm_num⟩

#synth Group (DihedralGroup 5)

instance : Group D5 := inferInstanceAs (Group (DihedralGroup 5))

instance : Monoid D5 := inferInstanceAs (Monoid (DihedralGroup 5))

def Ray.toZMod : Ray → ZMod 5
  | Ray.ray_0 => 0
  | Ray.ray_1 => 1
  | Ray.ray_2 => 2
  | Ray.ray_3 => 3
  | Ray.ray_4 => 4

def Ray.ofZMod : ZMod 5 → Ray
  | 0 => Ray.ray_0
  | 1 => Ray.ray_1
  | 2 => Ray.ray_2
  | 3 => Ray.ray_3
  | 4 => Ray.ray_4

@[simp] theorem Ray.toZMod_ofZMod (z : ZMod 5) : Ray.toZMod (Ray.ofZMod z) = z := by
  fin_cases z <;> rfl

@[simp] theorem Ray.ofZMod_toZMod (r : Ray) : Ray.ofZMod (Ray.toZMod r) = r := by
  cases r <;> rfl

def actionZMod : D5 → ZMod 5 → ZMod 5
  | DihedralGroup.r k, x => x + k
  | DihedralGroup.sr k, x => -(x + k)

#eval (DihedralGroup.r 1 : DihedralGroup 5) * (DihedralGroup.sr 0)
#eval (DihedralGroup.sr 0 : DihedralGroup 5) * (DihedralGroup.r 1)

def raySmul (g : D5) (r : Ray) : Ray :=
  Ray.ofZMod (match g with
    | DihedralGroup.r k => r.toZMod + k
    | DihedralGroup.sr k => -(r.toZMod + k))

/-
`Ray.toZMod` is injective.
-/
theorem Ray.toZMod_injective : Function.Injective Ray.toZMod := by
  intro x y h
  rw [← Ray.ofZMod_toZMod x, ← Ray.ofZMod_toZMod y, h]

#check Ray.toZMod_injective

def φ : ℝ := (1 + Real.sqrt 5) / 2

theorem GoldenRatio.phi_squared : φ ^ 2 = φ + 1 := by
  unfold φ
  field_simp
  ring_nf
  rw [sq, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 5)]
  ring

theorem GoldenRatio.phi_positive : 0 < φ := by
  -- Since $\sqrt{5}$ is positive, we have $1 + \sqrt{5} > 0$, and thus $(1 + \sqrt{5}) / 2 > 0$.
  apply div_pos; exact add_pos zero_lt_one (Real.sqrt_pos.mpr (by norm_num)); norm_num

theorem GoldenRatio.phi_greater_than_one : 1 < φ := by
  -- By definition of φ, we know that φ = (1 + Real.sqrt 5) / 2.
  have h_phi_def : φ = (1 + Real.sqrt 5) / 2 := by
    -- By definition of φ, we know that φ = (1 + Real.sqrt 5) / 2. We can use the rfl tactic to prove this.
    apply rfl;
  -- By definition of φ, we know that φ = (1 + Real.sqrt 5) / 2. Since Real.sqrt 5 is greater than 1, adding 1 to it will make the numerator larger than 2. Dividing by 2, the result is definitely more than 1.
  rw [h_phi_def]
  skip
  nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]

theorem GoldenRatio.phi_reciprocal : φ⁻¹ = φ - 1 := by
  -- By definition of φ, we know that φ = (1 + Real.sqrt 5) / 2.
  have h_phi_def : φ = (1 + Real.sqrt 5) / 2 := by
    -- By definition of φ, we have φ = (1 + Real.sqrt 5) / 2.
    rw [show φ = (1 + Real.sqrt 5) / 2 from rfl];
  grind

theorem GoldenRatio.pentagon_diagonal_ratio : 
    ∃ (diagonal side : ℝ), 
    diagonal > 0 ∧ side > 0 ∧ 
    diagonal / side = φ := by
  use φ, 1
  constructor
  · exact GoldenRatio.phi_positive
  constructor
  · norm_num
  · simp [φ]

def spiralRadius (n : ℕ) : ℝ := φ ^ (Real.log n)

def spiralAngle (n : ℕ) : ℝ := (2 * π / 5) * (n % 5)

def θ₅ : ℝ := 2 * π / 5

theorem pentagonal_angle_degrees : θ₅ = 72 * (π / 180) := by
  unfold θ₅
  ring

def spiralEmbedding (n : ℕ) : ℂ := 
  let r := spiralRadius n
  let θ := spiralAngle n
  (r : ℂ) * Complex.exp (Complex.I * θ)

def rayTransition (p g : ℕ) : Ray × Ray :=
  (assignRay p, assignRay (p + g))

theorem twin_prime_transitions (p : ℕ)
    (hp : Nat.Prime p) (hp2 : Nat.Prime (p + 2)) (h : p > 5) :
    rayTransition p 2 ∈
    ({(Ray.ray_1, Ray.ray_3),
      (Ray.ray_2, Ray.ray_4),
      (Ray.ray_4, Ray.ray_1)} : Finset (Ray × Ray)) := by
        -- Since $p > 5$, we know that $p \equiv 1, 2, 3,$ or $4 \pmod{5}$.
        have h_mod : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
          have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq, hp2.dvd_iff_eq ] ;
        rcases h_mod with ( h | h | h | h ) <;> unfold rayTransition <;> simp +decide [ *, Nat.add_mod ];
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 2 ) % 5 = 0 from by norm_num [ Nat.add_mod, h ] ) ) ( by rw [ hp2.dvd_iff_eq ] <;> linarith );
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;

theorem quadruplet_unique_pattern (p : ℕ)
    (hp : Nat.Prime p) (hp2 : Nat.Prime (p + 2))
    (hp6 : Nat.Prime (p + 6)) (hp8 : Nat.Prime (p + 8))
    (h : p > 5) :
    (assignRay p, assignRay (p + 2), assignRay (p + 6), assignRay (p + 8)) =
    (Ray.ray_1, Ray.ray_3, Ray.ray_2, Ray.ray_4) := by
  -- Proof follows from twin prime theorem + arithmetic
  -- Full proof in Mod5RayDecomposition.lean
  -- By examining the possible values of $p \mod 5$, we can deduce the rays for $p$, $p+2$, $p+6$, and $p+8$.
  have h_mod : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
    have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq, hp2.dvd_iff_eq, hp6.dvd_iff_eq, hp8.dvd_iff_eq ] ;
  rcases h_mod with ( h | h | h | h ) <;> simp +decide [ *, Nat.add_mod ] at *;
  · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
  · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 8 ) % 5 = 0 from by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ hp8.dvd_iff_eq ] <;> linarith );
  · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 2 ) % 5 = 0 from by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ hp2.dvd_iff_eq ] <;> linarith );
  · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 6 ) % 5 = 0 by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ hp6.dvd_iff_eq ] <;> linarith )

def L2_Z5 := Ray → ℂ

/-
The phi-weighted inner product on L2(Z5).
-/
def phi_inner_product (f g : L2_Z5) : ℂ :=
  (φ ^ 0 : ℂ) * f Ray.ray_0 * star (g Ray.ray_0) +
  (φ ^ 1 : ℂ) * f Ray.ray_1 * star (g Ray.ray_1) +
  (φ ^ 2 : ℂ) * f Ray.ray_2 * star (g Ray.ray_2) +
  (φ ^ 3 : ℂ) * f Ray.ray_3 * star (g Ray.ray_3) +
  (φ ^ 4 : ℂ) * f Ray.ray_4 * star (g Ray.ray_4)

def transferOperator (X : ℕ) (f : L2_Z5) : L2_Z5 :=
  fun k => 
    ∑ p ∈ (Finset.range (X + 1)).filter Nat.Prime, 
      (1 / Real.sqrt p : ℂ) * f (assignRay ((k.toNat + p) % 5))

/-
The statement of the conjecture that the transfer operator is unitary.
-/
def transfer_operator_unitary (X : ℕ) : Prop :=
    ∀ f g : L2_Z5,
    phi_inner_product (transferOperator X f) (transferOperator X g) = 
    phi_inner_product f g

def metallicMean (n : ℕ) : ℝ := (n + Real.sqrt (n^2 + 4)) / 2

/-
The metallic mean satisfies the quadratic equation $\psi^2 = n\psi + 1$.
-/
theorem metallic_mean_equation (n : ℕ) :
    let ψ := metallicMean n
    ψ ^ 2 = n * ψ + 1 := by
      unfold metallicMean; ring;
      rw [ Real.sq_sqrt ] <;> nlinarith

theorem golden_ratio_is_metallic_1 : metallicMean 1 = φ := by
  -- By definition of metallicMean, we have metallicMean 1 = (1 + Real.sqrt (1^2 + 4)) / 2.
  simp [metallicMean];
  -- By definition of φ, we have φ = (1 + Real.sqrt 5) / 2.
  rw [show φ = (1 + Real.sqrt 5) / 2 from rfl];
  -- Simplify the expression inside the square root.
  norm_num

/-
Definition of an eigenvalue for an operator on L2(Z5). Renamed λ to eig and used explicit zero function.
-/
def isEigenvalue (T : L2_Z5 → L2_Z5) (eig : ℂ) :=
  ∃ f : L2_Z5, f ≠ (fun _ => 0) ∧ T f = fun r => eig * f r

/-
Placeholder definition for isTransferEigenvalue. Renamed λ to eig.
-/
def isTransferEigenvalue (n : ℕ) (eig : ℂ) : Prop := True

/-
Statement of the conjecture that the spiral embedding respects rotation.
-/
def spiral_respects_rotation_stmt : Prop :=
    ∀ n : ℕ, spiralEmbedding (n + 1) = spiralEmbedding n * Complex.exp (Complex.I * θ₅)

/-
Statement of the conjecture that the spiral embedding respects reflection.
-/
def spiral_respects_reflection_stmt : Prop :=
    ∀ n : ℕ, spiralEmbedding (5 - (n % 5)) = star (spiralEmbedding n)

structure ImplementedTheorem where
  statement : Prop
  classical_proof : statement
  formal_verification : True  -- This file IS the formal verification
  computational_evidence : ℕ → Bool  -- Test function
  evidence_bound : ℕ  -- Tested up to this value
  evidence_holds : ∀ n ≤ evidence_bound, computational_evidence n = true

