/-
The Riemann Hypothesis is equivalent to the unitarity of the transfer operator. Renamed λ to eig and used norm.
-/
def riemann_hypothesis_spectral_form : Prop :=
    (∀ s : ℂ, s ≠ 1 → riemannZeta s = 0 → s.re = 1/2) ↔ 
    (∀ X : ℕ, ∀ eig : ℂ, isEigenvalue (transferOperator X) eig → ‖eig‖ = 1)

/-
The Universal Dihedral Structure conjecture.
-/
def universal_dihedral_structure (n : ℕ) (hn : n ≥ 3) : Prop :=
    ∃ (action : DihedralGroup n → (Fin n → Fin n)),
    ∃ (embedding : ℕ → ℂ),
    (∀ p : ℕ, Nat.Prime p → ∀ g : DihedralGroup n,
      let p_res : Fin n := ⟨p % n, Nat.mod_lt p (lt_trans (by norm_num) hn)⟩
      let p_rot := (p / n) * n + (action g p_res).val
      embedding p_rot = (metallicMean n : ℂ) * embedding p) ∧
    (∀ eig : ℂ, isTransferEigenvalue n eig → ‖eig‖ = 1)

