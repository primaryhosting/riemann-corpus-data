/-- Degree matrix (diagonal) -/
def degreeMatrix (G : SimpleGraph V) : Matrix V V ℝ :=
  Matrix.diagonal (fun v => (G.degree v : ℝ))

/-- Adjacency matrix -/
def adjacencyMatrix (G : SimpleGraph V) : Matrix V V ℝ :=
  Matrix.of (fun i j => if G.Adj i j then 1 else 0)

/-- Laplacian matrix L = D - A -/
def laplacianMatrix (G : SimpleGraph V) : Matrix V V ℝ :=
  degreeMatrix G - adjacencyMatrix G

theorem laplacian_symmetric (G : SimpleGraph V) :
    (laplacianMatrix G).IsSymm := by
      -- The adjacency matrix of a simple graph is symmetric, and the degree matrix is diagonal, hence symmetric.
      have h_adj_symm : Matrix.IsSymm (G.adjMatrix ℝ) := by
        -- Since adjacency is symmetric, the adjacency matrix is symmetric.
        ext i j; simp [SimpleGraph.adj_comm]
      have h_deg_symm : Matrix.IsSymm (Matrix.diagonal (fun i => G.degree i : V → ℝ)) := by
        -- The diagonal matrix is symmetric because it is equal to its transpose.
        simp [Matrix.IsSymm];
      -- The Laplacian matrix is the difference of the degree matrix and the adjacency matrix, both of which are symmetric.
      have h_laplacian_symm : Matrix.IsSymm (Matrix.diagonal (fun i => G.degree i : V → ℝ) - G.adjMatrix ℝ) := by
        exact?;
      exact?

/-- Induced Laplacian on subset S -/
def inducedLaplacian (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  Matrix.of (fun i j =>
    if i ∈ S ∧ j ∈ S then
      if i = j then
        (S.filter (fun u => G.Adj i u)).card
      else
        if G.Adj i j then -1 else 0
    else 0)

/-- Internal edges (both endpoints in S) -/
def internalEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => e ∈ S.sym2)).card

/-- Boundary edges (exactly one endpoint in S) -/
def boundaryEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => e ∉ S.sym2 ∧ e ∉ Sᶜ.sym2)).card

/-- Degree within subset S -/
def degreeInSubset (G : SimpleGraph V) (S : Finset V) (v : V) : ℕ :=
  (S.filter (fun u => G.Adj v u)).card

/-- Degree to boundary of S -/
def degreeToBoundary (G : SimpleGraph V) (S : Finset V) (v : V) : ℕ :=
  ((Finset.univ \ S).filter (fun u => G.Adj v u)).card

/-- 
Core Definition: S is ε-light if εL - L_S is positive semidefinite.
This spectral constraint ensures internal energy ≤ ε × total energy.
-/
def IsEpsilonLight (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  (ε • laplacianMatrix G - inducedLaplacian G S).PosSemidef

/-- Indicator vector for subset S -/
def indicatorVec (S : Finset V) : V → ℝ :=
  fun v => if v ∈ S then 1 else 0

