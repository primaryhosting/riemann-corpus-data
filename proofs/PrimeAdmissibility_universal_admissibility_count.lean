/-
Definition of admissible residues: residues n mod q such that n != 0 and n + g != 0.
-/
def PrimeAdmissibility.admissible_residues (q : ℕ) [Fact q.Prime] (g : ℕ) : Finset (ZMod q) := Finset.univ.filter (fun n => n ≠ 0 ∧ n + g ≠ 0)

/-
The "q-2" Admissibility Law: For any prime q and any gap g not divisible by q, there are exactly q - 2 residues that do not hit the "excluded" points (0 and -g).
-/
theorem PrimeAdmissibility.universal_admissibility_count (q : ℕ) [Fact q.Prime] (g : ℕ) (hg : (g : ZMod q) ≠ 0) :
    (admissible_residues q g).card = q - 2 := by
      -- Let's first establish that the set of admissible residues is correctly defined.
      have h_def : PrimeAdmissibility.admissible_residues q g = Finset.univ \ ({0, -↑g} : Finset (ZMod q)) := by
        ext n; simp [PrimeAdmissibility.admissible_residues];
        exact fun _ => ⟨ fun h => by contrapose! h; linear_combination' h, fun h => by contrapose! h; linear_combination' h ⟩;
      simp_all +decide [ Finset.card_sdiff, Finset.card_singleton, Finset.card_univ ]

/-
Corollary 1: The Twin Prime Constant Origin (q=3). For q=3, the exclusion leaves 3 - 2 = 1 admissible residue.
-/
theorem PrimeAdmissibility.twin_prime_origin (g : ℕ) (hg : g % 3 ≠ 0) :
    (admissible_residues 3 g).card = 1 := by
      convert PrimeAdmissibility.universal_admissibility_count 3 g _;
      erw [ Ne.eq_def, ZMod.natCast_eq_zero_iff ] ; omega

/-
Instance of Fact (Nat.Prime 5) for use in subsequent theorems.
-/
instance : Fact (Nat.Prime 5) := ⟨by norm_num⟩

/-
Corollary 2: The "Brockian Law" (q=5). For q=5, the exclusion leaves 5 - 2 = 3 admissible residues.
-/
theorem PrimeAdmissibility.brockian_pentagonal_case (g : ℕ) (hg : g % 5 ≠ 0) :
    (admissible_residues 5 g).card = 3 := by
      -- Apply the universal_admissibility_count theorem with q=5 and the given hg.
      apply PrimeAdmissibility.universal_admissibility_count;
      erw [ Ne, ZMod.natCast_eq_zero_iff ] ; exact fun h => hg <| Nat.mod_eq_zero_of_dvd h
