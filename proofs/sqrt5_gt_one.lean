/-- Shift parameter γ for aperiodicity -/
def γ : Fin 5 → ℝ := fun _ => 1 / (2 * sqrt 5)

/-- 
Parallel projection: π‖ : ℤ⁵ → ℝ² (physical space)
This is where the tiling lives.
-/
def pi_par (n : Fin 5 → ℤ) : EuclideanSpace ℝ (Fin 2) :=
  ∑ k : Fin 5, ((n k : ℝ) + γ k) • vertex k

/--
Perpendicular projection: π⊥ : ℤ⁵ → ℝ² (internal space)  
Used for acceptance window.
-/
def pi_perp (n : Fin 5 → ℤ) : EuclideanSpace ℝ (Fin 2) :=
  ∑ k : Fin 5, ((n k : ℝ) + γ k) • 
    toReal2 (ζ₅ ^ (k : ℕ) * exp (π * I / 5))

/-- Acceptance window: closed ball of radius φ in perpendicular space -/
def Window : Set (EuclideanSpace ℝ (Fin 2)) :=
  Metric.closedBall 0 φ

/--
PENROSE TILING: The cut-and-project construction
Points are π‖(n) where n ∈ ℤ⁵ and π⊥(n) ∈ Window.
-/
def Penrose : Set (EuclideanSpace ℝ (Fin 2)) :=
  {p | ∃ n : Fin 5 → ℤ, p = pi_par n ∧ pi_perp n ∈ Window}

