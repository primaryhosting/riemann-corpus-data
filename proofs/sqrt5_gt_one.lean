lemma summable_sum_sq_neighbors [PenroseSpectralAxioms] (f : L2Penrose) :
  Summable (fun p => ∑ q ∈ neighbors p, (f.val q)^2) := by
    refine' summable_of_sum_le _ _;
    exact ∑' p, ( f.val p ) ^ 2 * ( ‹PenroseSpectralAxioms›.neighbors_finite p ).toFinset.card;
    · exact fun p => Finset.sum_nonneg fun _ _ => sq_nonneg _;
    · -- Since the degree of each vertex is bounded by D, we can factor out D from the sum.
      have h_deg_bound : ∀ p : PenrosePoint, (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset.card ≤ (‹PenroseSpectralAxioms›.degree_bounded.choose : ℕ) := by
        exact fun p => by simpa using ‹PenroseSpectralAxioms›.degree_bounded.choose_spec p;
      intro u;
      refine' le_trans _ ( Summable.sum_le_tsum _ _ _ );
      rotate_left;
      exact Finset.biUnion u fun p => ( ‹PenroseSpectralAxioms›.neighbors_finite p ).toFinset;
      · exact fun _ _ => by positivity;
      · refine' Summable.of_nonneg_of_le ( fun p => mul_nonneg ( sq_nonneg _ ) ( Nat.cast_nonneg _ ) ) ( fun p => mul_le_mul_of_nonneg_left ( Nat.cast_le.mpr ( h_deg_bound p ) ) ( sq_nonneg _ ) ) _;
        exact Summable.mul_right _ ( f.2 );
      · -- By Fubini's theorem, we can interchange the order of summation.
        have h_fubini : ∑ p ∈ u, ∑ q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset, (f.val q) ^ 2 = ∑ q ∈ Finset.biUnion u (fun p => (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset), (f.val q) ^ 2 * (∑ p ∈ u, if q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset then 1 else 0) := by
          simp +decide only [Finset.mul_sum _ _ _, mul_boole];
          -- By Fubini's theorem, we can interchange the order of summation. The left-hand side sums over u first, then over the neighbors of each p in u. The right-hand side sums over the union of all neighbors of p in u, then over u. Since the neighbors of p in u are exactly the elements in the union, the two sums are equal.
          have h_fubini : ∀ p ∈ u, ∑ q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset, (f.val q) ^ 2 = ∑ q ∈ Finset.biUnion u (fun p => (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset), if q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset then (f.val q) ^ 2 else 0 := by
            intro p hp; rw [ ← Finset.sum_filter ] ; congr; ext q; aesop;
          rw [ Finset.sum_congr rfl h_fubini, Finset.sum_comm ];
        convert h_fubini.le.trans _;
        -- Since the sum over p in u of if q is in the neighbors of p then 1 else 0 is equal to the cardinality of the neighbors of q, we can replace the sum with the cardinality.
        have h_card : ∀ q ∈ Finset.biUnion u (fun p => (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset), (∑ p ∈ u, if q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset then 1 else 0) ≤ (‹PenroseSpectralAxioms›.neighbors_finite q).toFinset.card := by
          intros q hq
          have h_card : (∑ p ∈ u, if q ∈ (‹PenroseSpectralAxioms›.neighbors_finite p).toFinset then 1 else 0) ≤ (‹PenroseSpectralAxioms›.neighbors_finite q).toFinset.card := by
            simp +zetaDelta at *;
            refine' Finset.card_le_card _;
            simp +decide [ Finset.subset_iff, neighbors_set ];
            exact?;
          convert h_card using 1;
        exact Finset.sum_le_sum fun q hq => mul_le_mul_of_nonneg_left ( mod_cast h_card q hq ) ( sq_nonneg _ )
