theorem sum_neighbors_rearrange_ennreal_v2 [PenroseSpectralAxioms] (g : PenrosePoint → ENNReal) : 
  (∑' p, ∑ q ∈ neighbors p, g q) = ∑' q, (degree q) * g q := by
  -- Convert inner sum to tsum
  have h1 : (∑' p, ∑ q ∈ neighbors p, g q) = ∑' p, ∑' q, if adjacent p q then g q else 0 := by
    congr; ext p
    rw [sum_neighbors_eq_tsum_ite]
  rw [h1]
  -- Swap sums
  rw [ENNReal.tsum_comm]
  -- Analyze the new inner sum
  congr; ext q
  -- Use symmetry
  have h_symm : ∀ p, adjacent p q ↔ adjacent q p := fun p => ⟨adjacent_symm p q, adjacent_symm q p⟩
  simp_rw [h_symm]
  -- Factor out g q
  have h_factor : ∀ p, (if adjacent q p then g q else 0) = (if adjacent q p then 1 else 0) * g q := by
    intro p; split_ifs <;> simp
  simp_rw [h_factor]
  rw [ENNReal.tsum_mul_right]
  congr
  -- Identify the sum of indicators as the degree
  rw [← sum_neighbors_eq_tsum_ite]
  simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
  rfl

