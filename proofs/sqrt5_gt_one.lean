      exact ha.add hb;
    refine' .of_nonneg_of_le ( fun p => sq_nonneg _ ) ( fun p => _ ) ( h_summable_linear_combination.mul_left 2 );
    linarith [ sq_nonneg ( a p + b p ) ];
  apply h_summable_linear_combination;
  · obtain ⟨ D, hD ⟩ := ‹PenroseSpectralAxioms›.degree_bounded;
    exact Summable.of_nonneg_of_le ( fun p => sq_nonneg _ ) ( fun p => by simpa [ mul_pow ] using mul_le_mul_of_nonneg_right ( pow_le_pow_left₀ ( Nat.cast_nonneg _ ) ( Nat.cast_le.mpr ( hD p ) ) 2 ) ( sq_nonneg _ ) ) ( this.mul_left _ );
  · aesop

lemma sum_sq_neighbors_le [PenroseSpectralAxioms] (f : PenrosePoint → ℝ) (p : PenrosePoint) :
  (∑ q ∈ neighbors p, f q)^2 ≤ (degree p : ℝ) * ∑ q ∈ neighbors p, (f q)^2 := by
    have h_cauchy_schwarz : ∀ (S : Finset PenrosePoint) (f : PenrosePoint → ℝ), (∑ q ∈ S, f q) ^ 2 ≤ (S.card : ℝ) * ∑ q ∈ S, f q ^ 2 := by
      exact?;
    -- Apply the Cauchy-Schwarz inequality to the sum over the finite set `neighbors p`.
    apply h_cauchy_schwarz

lemma sum_sq_neighbors_le_aux [PenroseSpectralAxioms] (f : PenrosePoint → ℝ) (p : PenrosePoint) :
  (∑ q ∈ neighbors p, f q)^2 ≤ (degree p : ℝ) * ∑ q ∈ neighbors p, (f q)^2 := by
    -- By the Cauchy-Schwarz inequality, we have that for any finite set of real numbers, the square of their sum is less than or equal to the product of the number of elements and the sum of their squares.
    have h_cauchy_schwarz : ∀ (s : Finset PenrosePoint), (∑ q ∈ s, f q)^2 ≤ (s.card : ℝ) * ∑ q ∈ s, (f q)^2 := by
      exact?;
    -- Apply the Cauchy-Schwarz inequality to the set of neighbors.
    apply h_cauchy_schwarz

lemma sum_sq_neighbors_le_v2 [PenroseSpectralAxioms] (f : PenrosePoint → ℝ) (p : PenrosePoint) :
  (∑ q ∈ neighbors p, f q)^2 ≤ (degree p : ℝ) * ∑ q ∈ neighbors p, (f q)^2 := by
    -- By the Cauchy-Schwarz inequality, we have that for any vectors $u$ and $v$ of equal length, $(u \cdot v)^2 \leq \|u\|^2 \|v\|^2$.
    have h_cauchy_schwarz : ∀ (u v : Finset PenrosePoint), (∑ q ∈ u, f q) ^ 2 ≤ (Finset.card u : ℝ) * ∑ q ∈ u, f q ^ 2 := by
      exact?;
    exact h_cauchy_schwarz _ ∅

lemma sum_sq_le_card_mul_sum_sq_real {α : Type*} (s : Finset α) (f : α → ℝ) :
  (∑ x ∈ s, f x)^2 ≤ (s.card : ℝ) * ∑ x ∈ s, (f x)^2 := by
    exact?

lemma summable_degree_mul_sq [PenroseSpectralAxioms] (f : L2Penrose) :
  Summable (fun p => ((degree p : ℝ) * f.val p)^2) := by
    have h_summable : Summable (fun p => (f.val p) ^ 2) := by
      exact f.2;
    obtain ⟨ D, hD ⟩ := ‹PenroseSpectralAxioms›.degree_bounded;
    have h_summable : Summable (fun p => (D : ℝ) ^ 2 * (f.val p) ^ 2) := by
      exact h_summable.mul_left _;
    refine' .of_nonneg_of_le ( fun p => sq_nonneg _ ) ( fun p => _ ) h_summable;
    rw [ mul_pow ];
    gcongr;
    exact hD p

lemma summable_degree_mul_sq_aux [PenroseSpectralAxioms] (f : L2Penrose) :
  Summable (fun p => ((degree p : ℝ) * f.val p)^2) := by
    field_simp;
    obtain ⟨ D, hD ⟩ := ‹PenroseSpectralAxioms›.degree_bounded;
    -- Since the degree is bounded by D, we can use the fact that the sum of (f(p))^2 is summable to show that the sum of (D * f(p))^2 is also summable.
    have h_summable : Summable (fun p => (D * f.val p)^2) := by
      convert f.2.mul_left ( D ^ 2 : ℝ ) using 2 ; ring;
    refine' .of_nonneg_of_le ( fun p => by positivity ) ( fun p => _ ) h_summable;
    rw [ mul_pow ] ; gcongr ; aesop

/--
Inner product on ℓ²(Penrose)
In full formalization, would prove this converges.
-/
def L2_inner (f g : L2Penrose) : ℝ := ∑' p, f.val p * g.val p

theorem L2_inner_converges (f g : L2Penrose) : Summable (fun p => f.val p * g.val p) := by
  -- By the Cauchy-Schwarz inequality, if $f$ and $g$ are in $L^2$ (i.e., their squares are summable), then their product is in $L^1$ (i.e., the sum of their products is summable).
  have h_cauchy_schwarz : Summable (fun p => (f.val p)^2) → Summable (fun p => (g.val p)^2) → Summable (fun p => f.val p * g.val p) := by
    intro hf hg;
    -- By the Cauchy-Schwarz inequality, we have |f(p)g(p)| ≤ (f(p)^2 + g(p)^2)/2.
    have h_cauchy_schwarz : ∀ p : PenrosePoint, abs ((f.val p) * (g.val p)) ≤ (f.val p)^2 / 2 + (g.val p)^2 / 2 := by
      exact fun p => abs_le.mpr ⟨ by linarith [ sq_nonneg ( f.val p - g.val p ), sq_nonneg ( f.val p + g.val p ) ], by linarith [ sq_nonneg ( f.val p - g.val p ), sq_nonneg ( f.val p + g.val p ) ] ⟩;
    -- Since the absolute value of the product is bounded by a summable series, we can apply the comparison test.
    have h_comparison : Summable (fun p : PenrosePoint => abs ((f.val p) * (g.val p))) := by
      exact Summable.of_nonneg_of_le ( fun p => abs_nonneg _ ) ( fun p => h_cauchy_schwarz p ) ( Summable.add ( hf.div_const 2 ) ( hg.div_const 2 ) );
    exact h_comparison.of_abs;
  exact h_cauchy_schwarz f.2 g.2

theorem L2_inner_symm (f g : L2Penrose) : L2_inner f g = L2_inner g f := by
  unfold L2_inner;
  ac_rfl

theorem L2_inner_pos (f : L2Penrose) : 0 ≤ L2_inner f f := by
  exact tsum_nonneg fun _ => by exact mul_self_nonneg _;

lemma sum_sq_le_card_mul_sum_sq_real_v2 {α : Type*} (s : Finset α) (f : α → ℝ) :
  (∑ x ∈ s, f x)^2 ≤ (s.card : ℝ) * ∑ x ∈ s, (f x)^2 := by
  have h := Finset.sum_mul_sq_le_sq_mul_sq s (fun _ => 1) f
  simp only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one] at h
  exact h

