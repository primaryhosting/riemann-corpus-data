    HarmonicArch.ray (n * k) = 
    ⟨((HarmonicArch.ray n).val * k) % 5, Nat.mod_lt _ (by decide)⟩ := by
  simp [HarmonicArch.ray, Nat.mul_mod]

/-- Every natural number maps to a unique ray. -/
theorem HarmonicArch.ray_unique (n : ℕ) : ∃! r : HarmonicArch.RaySpace, HarmonicArch.ray n = r := by
  use HarmonicArch.ray n
  simp [HarmonicArch.ray]

/-! ## §3. Prime Ray Classification -/

/-- **Ray Zero Singularity**: Among primes, only p = 5 lies on ray 0.
    Every prime p > 5 has p mod 5 ≠ 0. -/
