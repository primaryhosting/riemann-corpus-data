/-- **Euler's Totient**: φ(5) = 4 explains why there are exactly 4 active rays. -/
theorem HarmonicArch.totient_eq_active_ray_count : Nat.totient 5 = 4 := by
  -- We can calculate the totient function of 5 directly.
