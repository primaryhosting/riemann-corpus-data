    HarmonicArch.ray_zero_singularity p hp h (Fin.ext h0)
  have hmod_ne4 : p % 5 ≠ 4 := fun h4 =>
    HarmonicArch.sexy_primes_not_ray4 p hp hp6 h (Fin.ext h4)
  have hlt : p % 5 < 5 := Nat.mod_lt p (by decide)
  have hcases : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 := by omega
