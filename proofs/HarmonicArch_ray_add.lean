/-! ## §1. Basic Definitions -/

/-- The modulus q = 5 governing the ray decomposition. -/
def HarmonicArch.q : ℕ := 5

/-- The full ray space: residue classes mod 5. -/
abbrev HarmonicArch.RaySpace := Fin 5

/-- The active rays: residue classes coprime to 5, indexed as Fin 4. -/
abbrev HarmonicArch.ActiveRay := Fin 4

/-- Assign a natural number to its ray (residue class mod 5). -/
def HarmonicArch.ray (n : ℕ) : HarmonicArch.RaySpace :=
  ⟨n % 5, Nat.mod_lt n (by decide)⟩

/-- Map an active ray index j to the corresponding residue j + 1 ∈ {1,2,3,4}. -/
def HarmonicArch.activeRayToResidue (j : HarmonicArch.ActiveRay) : HarmonicArch.RaySpace :=
  ⟨j.val + 1, by have := j.isLt; omega⟩

/-! ## §2. Ray Arithmetic -/

/-- Ray addition is compatible with modular addition. -/
lemma HarmonicArch.ray_add (a b : ℕ) : 
    HarmonicArch.ray (a + b) = 
    ⟨((HarmonicArch.ray a).val + (HarmonicArch.ray b).val) % 5, 
     Nat.mod_lt _ (by decide)⟩ := by
  simp [HarmonicArch.ray, Nat.add_mod]

/-- Ray multiplication is compatible with modular multiplication. -/
lemma HarmonicArch.ray_mul (a b : ℕ) :
    HarmonicArch.ray (a * b) = 
    ⟨((HarmonicArch.ray a).val * (HarmonicArch.ray b).val) % 5, 
     Nat.mod_lt _ (by decide)⟩ := by
  simp [HarmonicArch.ray, Nat.mul_mod]

/-- Scalar multiplication preserves ray structure. -/
