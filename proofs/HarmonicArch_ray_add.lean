  have : p % 5 = 4 := congr_arg Fin.val hray
  have : (p + 6) % 5 = 0 := by omega
  have : 5 ∣ (p + 6) := Nat.dvd_of_mod_eq_zero this
  rw [hp6.dvd_iff_eq] at this <;> omega

/-- **Sexy primes follow sequential transitions**: 1→2, 2→3, or 3→4. -/
