inductive HarmonicArch.TwinTransition : HarmonicArch.RaySpace → HarmonicArch.RaySpace → Prop
  | ray1_to_ray3 : HarmonicArch.TwinTransition ⟨1, by decide⟩ ⟨3, by decide⟩
  | ray2_to_ray4 : HarmonicArch.TwinTransition ⟨2, by decide⟩ ⟨4, by decide⟩
  | ray4_to_ray1 : HarmonicArch.TwinTransition ⟨4, by decide⟩ ⟨1, by decide⟩

/-- **Twin constraint**: ray(p+2) is determined by ray(p) via addition mod 5. -/
theorem HarmonicArch.twin_constraint (p : ℕ) (hp : p.Prime) (hp2 : (p + 2).Prime) (h : p > 3) :
