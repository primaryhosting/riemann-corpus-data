    HarmonicArch.rotate (HarmonicArch.rotate (HarmonicArch.rotate (HarmonicArch.rotate j))) = j := by
  rcases j with ⟨_ | _ | _ | _ | j, hj⟩ <;> trivial

/-- **Reflection is involutory**: s² = id. -/
