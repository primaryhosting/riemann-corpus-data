    Function.RightInverse HarmonicArch.rotateInv HarmonicArch.rotate := by
  intro j
  cases j with | mk v hv => 
    exact Fin.ext (by simp [HarmonicArch.rotate, HarmonicArch.rotateInv]; omega)

/-- **Rotation is bijective**. -/
theorem HarmonicArch.rotate_bijective : Function.Bijective HarmonicArch.rotate :=
  ⟨HarmonicArch.rotateInv_left_inverse.injective,
   HarmonicArch.rotateInv_right_inverse.surjective⟩

/-- **Reflection is bijective** (immediate from involution). -/
