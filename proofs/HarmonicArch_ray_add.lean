theorem HarmonicArch.forbidden_transition_3_to_0 :
    ¬∃ p : ℕ, p.Prime ∧ (p + 2).Prime ∧ p > 5 ∧
      HarmonicArch.ray p = ⟨3, by decide⟩ := by
  rintro ⟨p, hp, hp2, hgt, hray⟩
