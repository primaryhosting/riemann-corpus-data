        -- Since $p$ is not divisible by 5, $p \mod 5$ is not zero. This follows directly from the definition of divisibility.
        exact fun h => h_not_div (Nat.dvd_of_mod_eq_zero h);
      -- Since $p$ is not divisible by 5, $p \mod 5$ is not zero, hence the ray of $p$ is not ⟨0, by decide⟩.
      simp [HarmonicArch.ray, h_mod_ne_zero]

/-- **Ray Periodicity**: Ray assignment has period 5. -/
theorem HarmonicArch.ray_periodic (n k : ℕ) :
    HarmonicArch.ray (n + k * 5) = HarmonicArch.ray n := by
      -- By definition of ray, we have that ray (n + k * 5) = (n + k * 5) % 5.
      simp [HarmonicArch.ray]

/-- **Framework Completeness**: Every prime > 5 lies on a unique active ray. -/
theorem HarmonicArch.prime_on_unique_active_ray (p : ℕ) (hp : p.Prime) (h : p > 5) :
    ∃! j : HarmonicArch.ActiveRay, HarmonicArch.ray p = HarmonicArch.activeRayToResidue j := by
