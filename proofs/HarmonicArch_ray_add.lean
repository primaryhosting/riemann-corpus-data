    Real.cos (2 * Real.pi / 5) = (HarmonicArch.φ - 1) / 2 := by
      -- Using the known value of $\cos(72^\circ)$, we have $\cos(72^\circ) = \frac{\sqrt{5} - 1}{4}$.
      have h_cos_72 : Real.cos (2 * Real.pi / 5) = (Real.sqrt 5 - 1) / 4 := by
        -- Using the known value of $\cos(72^\circ)$, which is $\frac{\sqrt{5}-1}{4}$, we can conclude the proof.
        have h_cos_72 : Real.cos (2 * Real.pi / 5) = (Real.sqrt 5 - 1) / 4 := by
          have h_cos_36 : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := by
            exact?
          -- Using the double-angle formula for cosine, we have $\cos(2\theta.pi = 2\cos^2(\theta) - 1$.
          have h_cos_72 : Real.cos (2 * Real.pi / 5) = 2 * (Real.cos (Real.pi / 5))^2 - 1 := by
            rw [ ← Real.cos_two_mul, mul_div_assoc ];
          exact h_cos_72.trans ( by rw [ h_cos_36 ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] );
        exact h_cos_72;
      -- Substitute the definition of `HarmonicArch.φ` into the right-hand side.
      rw [h_cos_72]
      field_simp [HarmonicArch.φ]
      ring;
      unfold HarmonicArch.φ; ring;

/-- The primitive 5th root of unity ω = e^{2πi/5}. -/
def HarmonicArch.ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

/-- **ω is a 5th root of unity**: ω⁵ = 1. -/
theorem HarmonicArch.omega_fifth_root : HarmonicArch.ω ^ 5 = 1 := by
  -- By definition of exponentiation in the complex numbers, we know that $(e^{2\pi i / 5})^5 = e^{2\pi i} = 1$.
  norm_num [HarmonicArch.ω];
  -- Using the property of exponents, we can simplify $(e^{2\pi i / 5})^5$ to $e^{2\pi i} = 1$.
  rw [← Complex.exp_nat_mul]
  ring;
  -- Using Euler's formula, we know that $e^{i \cdot 2\pi} = \cos(2\pi) + i \sin(2\pi) = 1 + 0i = 1$.
  rw [Complex.exp_eq_one_iff]
  use 1
  ring

/-! ## §11. Fibonacci and Pisano Period -/

/-- Fibonacci sequence mod m. -/
def HarmonicArch.fibMod (m : ℕ) : ℕ → ℕ
  | 0 => 0
  | 1 => 1
  | n + 2 => (HarmonicArch.fibMod m n + HarmonicArch.fibMod m (n + 1)) % m

/-- The Pisano period of the Fibonacci sequence mod 5. -/
def HarmonicArch.pisanoPeriod : ℕ := 20

/-- The Pisano period for mod 5 is indeed 20. -/
theorem HarmonicArch.pisano_period_is_20 : 
    (∀ k, 0 < k → k < 20 → ¬(HarmonicArch.fibMod 5 k = 0 ∧ HarmonicArch.fibMod 5 (k+1) = 1)) ∧
    HarmonicArch.fibMod 5 20 = 0 ∧ HarmonicArch.fibMod 5 21 = 1 := by
  constructor
  · intro k hk_pos hk_lt
    interval_cases k <;> decide
  · decide

/-! ## §12. Metallic Means -/

/-- The n-th metallic mean: ψₙ = (n + √(n² + 4))/2. -/
def HarmonicArch.metallicMean (n : ℕ) : ℝ := (n + Real.sqrt (n ^ 2 + 4)) / 2

/-- **Metallic means satisfy their defining equation**: ψₙ² = n·ψₙ + 1. -/
theorem HarmonicArch.metallic_mean_equation (n : ℕ) :
    (HarmonicArch.metallicMean n) ^ 2 = n * HarmonicArch.metallicMean n + 1 := by
  have h_metallic_mean : ∀ n : ℕ, HarmonicArch.metallicMean n = (n + Real.sqrt (n^2 + 4)) / 2 := by
    intro n
    simp [HarmonicArch.metallicMean]
  rw [h_metallic_mean n]
  field_simp
  ring
  rw [Real.sq_sqrt (by positivity)]
  ring

/-- **φ is the first metallic mean**: ψ₁ = φ. -/
theorem HarmonicArch.phi_is_first_metallic :
    HarmonicArch.metallicMean 1 = HarmonicArch.φ := by
  simp [HarmonicArch.metallicMean, HarmonicArch.φ]
  norm_num
