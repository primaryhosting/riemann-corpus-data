/-- The golden ratio φ = (1 + √5)/2 -/
noncomputable def goldenRatio : ℝ := (1 + Real.sqrt 5) / 2

theorem golden_ratio_equation : goldenRatio^2 = goldenRatio + 1 := by
  -- We can calculate $\phi^2$ directly.
  norm_num [goldenRatio]

theorem golden_ratio_pos : 0 < goldenRatio := by
  -- The golden ratio is positive because it is the sum of two positive numbers divided by 2.
  apply div_pos; exact add_pos zero_lt_one (Real.sqrt_pos.mpr (by norm_num)); exact zero_lt_two

/-- 2D rotation matrix by angle θ -/
def rotationMatrix (θ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.cos θ, -Real.sin θ; 
     Real.sin θ,  Real.cos θ]

noncomputable def pentagonRotation : Matrix (Fin 2) (Fin 2) ℝ :=
  rotationMatrix (2 * Real.pi / 5)

theorem rotation_char_poly (θ : ℝ) (x : ℝ) :
    Matrix.det (rotationMatrix θ - x • (1 : Matrix (Fin 2) (Fin 2) ℝ)) =
    x^2 - 2 * Real.cos θ * x + 1 := by
      -- Expand the determinant using the formula for a 2x2 matrix.
      simp [rotationMatrix, Matrix.det_fin_two];
      -- Combine like terms and use the Pythagorean identity.
      ring_nf
      rw [Real.sin_sq]
      ring

theorem cos_2pi5_eq_golden : Real.cos (2 * Real.pi / 5) = (goldenRatio - 1) / 2 := by
  have h : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := Real.cos_pi_div_five
  have h2 : 2 * Real.pi / 5 = 2 * (Real.pi / 5) := by ring
  rw [h2, Real.cos_two_mul, h]
  simp [goldenRatio]
  ring_nf
  rw [Real.sq_sqrt (by norm_num)]
  ring

