/-- A ray modulo p is the set of natural numbers congruent to i modulo p -/
def Ray (p : ℕ) (i : ZMod p) : Set ℕ :=
  {n : ℕ | (n : ZMod p) = i}

/-- The ray partition of ℕ for a given prime p -/
def RayPartition (p : ℕ) : Set (Set ℕ) :=
  {S | ∃ i : ZMod p, S = Ray p i}

theorem mem_ray_iff (p : ℕ) (i : ZMod p) (n : ℕ) :
    n ∈ Ray p i ↔ (n : ZMod p) = i := Iff.rfl

theorem ray_nonempty (p : ℕ) [NeZero p] (i : ZMod p) :
    (Ray p i).Nonempty := by
      -- By definition of Ray, there exists some natural number n such that n ≡ i (mod p).
      use i.val;
      -- By definition of Ray, we need to show that i.val ≡ i (mod p).
      simp [Ray]

/-- Covering: every natural number belongs to some ray -/
theorem ray_partition_covers (p : ℕ) [hp : Fact p.Prime] :
    ⋃ i : ZMod p, Ray p i = Set.univ := by
  ext n
  simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
  use (n : ZMod p)
  rfl

/-- Disjointness: distinct rays are disjoint -/
theorem rays_disjoint (p : ℕ) [hp : Fact p.Prime] {i j : ZMod p} (hij : i ≠ j) :
    Ray p i ∩ Ray p j = ∅ := by
      -- If there exists an element $n$ in both $Ray p i$ and $Ray p j$, then $n \equiv i \pmod{p}$ and $n \equiv j \pmod{p}$, which implies $i \equiv j \pmod{p}$, contradicting $i \neq j$.
      ext n
      simp [Ray];
      grind

/-- Main partition theorem: each n belongs to exactly one ray -/
theorem ray_partition_unique (p : ℕ) [hp : Fact p.Prime] (n : ℕ) :
    ∃! i : ZMod p, n ∈ Ray p i := by
  use (n : ZMod p)
  constructor
  · rfl
  · intro j hn
    exact hn.symm

