/-- Action of D_p on ZMod p -/
def dihedralAction (p : ℕ) [Fact p.Prime] : DihedralElem p → ZMod p → ZMod p
  | DihedralElem.rot k, i => i + k
  | DihedralElem.ref k, i => k - i

