  mul := DihedralElem.mul
  one := DihedralElem.one
  inv := DihedralElem.inv
  mul_assoc := DihedralElem.mul_assoc
  one_mul := by
    -- By definition of the group operation, multiplying by 1 (which is the rotation by 0) leaves any element unchanged.
    intros a
    cases a <;> simp [DihedralElem.mul]
  mul_one := by
    aesop
  inv_mul_cancel := by
    -- By definition of the inverse, we know that for any element a in D_p, a.inv * a = 1.
    apply inv_mul_cancel

