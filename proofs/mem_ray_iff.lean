    let θ := 2 * Real.pi / 5
    let lam := Complex.exp (Complex.I * θ)
    lam.re = (goldenRatio - 1) / 2 := by
      -- Using the fact that the real part of $e^{i\theta}$ is $\cos\theta$, we can simplify the expression.
      simp [Complex.exp_re, cos_2pi5_eq_golden]

theorem golden_ratio_eigenvalue' :
    let θ := 2 * Real.pi / 5
    let lam := Complex.exp (Complex.I * θ)
    lam.re = (goldenRatio - 1) / 2 := by
  simp only [mul_comm Complex.I, Complex.exp_ofReal_mul_I_re]
  exact cos_2pi5_eq_golden

theorem fibonacci_divisible_by_5 (k : ℕ) :
    5 ∣ Nat.fib (5 * k) := by
  have h : Nat.fib 5 = 5 := by rfl
  rw [← h]
  apply Nat.fib_dvd
  apply dvd_mul_right

theorem fibonacci_in_ray_0 (k : ℕ) :
    Nat.fib (5 * k) ∈ Ray 5 0 := by
      -- By definition of Fibonacci sequence, we know that $F_{5k}$ is divisible by 5.
      have h_div : 5 ∣ Nat.fib (5 * k) := by
        -- Apply the theorem that states 5 divides F_{5k} for any integer k.
        apply fibonacci_divisible_by_5;
      -- Since $5 \mid \text{Nat.fib}(5k)$, we have $\text{Nat.fib}(5k) \equiv 0 \pmod{5}$.
      have h_mod : Nat.fib (5 * k) % 5 = 0 := by
        -- Since $5 \mid \text{Nat.fib}(5k)$, we have $\text{Nat.fib}(5k) \equiv 0 \pmod{5}$ by definition of divisibility.
        apply Nat.mod_eq_zero_of_dvd h_div;
      -- Since $Nat.fib (5 * k) \equiv 0 \pmod{5}$, we have $Nat.fib (5 * k) \in Ray 5 0$ by definition of Ray.
      simp [Ray, h_mod];
      erw [ ZMod.natCast_eq_zero_iff ] ; exact Nat.dvd_of_mod_eq_zero h_mod

/-- A configuration for gap g modulo p -/
structure Configuration (p : ℕ) (g : ℕ) where
  start : ZMod p
  finish : ZMod p
  gap_condition : finish = start + g

def Configuration.IsAdmissible {p g : ℕ} [Fact p.Prime] (c : Configuration p g) : Prop :=
  c.start ≠ 0 ∧ c.finish ≠ 0

def Configuration.allConfigs (p g : ℕ) [Fact p.Prime] : Finset (Configuration p g) :=
  (Finset.univ : Finset (ZMod p)).map ⟨fun s => { start := s, finish := s + g, gap_condition := rfl }, 
    by intro x y h; simp at h; exact h⟩

def Configuration.admissibleConfigs (p g : ℕ) [Fact p.Prime] : Finset (Configuration p g) :=
  (Configuration.allConfigs p g).filter (fun c => c.IsAdmissible)

#check ZMod.card

theorem all_configs_count (p g : ℕ) [Fact p.Prime] :
    (Configuration.allConfigs p g).card = p := by
      -- The cardinality of `Finset.univ : Finset (ZMod p)` is `p` because `ZMod p` has `p` elements.
      simp [Configuration.allConfigs]

/-- Universal p-2 law -/
theorem config_count_universal (p g : ℕ) [hp : Fact p.Prime]
    (hg : Nat.Coprime g p) :
    (Configuration.admissibleConfigs p g).card = p - 2 := by
  -- Let's count the number of configurations where start = 0 or finish = 0.
  have h_count : (Configuration.admissibleConfigs p g).card = (Finset.univ : Finset (ZMod p)).card - ((Finset.univ.filter (fun s : ZMod p => s = 0)) ∪ (Finset.filter (fun s : ZMod p => s + g = 0) Finset.univ)).card := by
    rw [ show ( Configuration.admissibleConfigs p g : Finset ( Configuration p g ) ) = Finset.image ( fun s : ZMod p => Configuration.mk s ( s + ↑g ) ( by aesop ) ) ( Finset.univ \ ( Finset.filter ( fun s : ZMod p => s = 0 ) Finset.univ ∪ Finset.filter ( fun s : ZMod p => s + g = 0 ) Finset.univ ) ) from ?_ ];
    · rw [ Finset.card_image_of_injective _ fun x y hxy => by injection hxy, Finset.card_sdiff ] ; aesop;
    · ext ⟨s, f, h⟩; simp [Configuration.admissibleConfigs];
      unfold Configuration.allConfigs Configuration.IsAdmissible; aesop;
  cases eq_or_ne ( g : ZMod p ) 0 <;> simp_all +decide [ Finset.filter_eq', Finset.filter_or ];
  · rw [ ZMod.natCast_eq_zero_iff ] at * ; have := Nat.gcd_eq_right ‹_› ; aesop;
  · rw [ show ( Finset.filter ( fun s : ZMod p => s + ( g : ZMod p ) = 0 ) Finset.univ ) = { - ( g : ZMod p ) } by ext x; simp +decide [ add_eq_zero_iff_eq_neg ] ] ; aesop

/-- Partition theorem -/
theorem main_partition (p : ℕ) [hp : Fact p.Prime] (n : ℕ) :
    ∃! i : ZMod p, n ∈ Ray p i :=
  ray_partition_unique p n

/-- Canonicity -/
theorem main_canonical (p : ℕ) [hp : Fact p.Prime] (σ : AdditiveAut) :
    ∀ i : ZMod p, σ '' (Ray p i) = Ray p i :=
  ray_partition_canonical p σ
