/-- Weak canonicity: the ray partition is preserved by all automorphisms -/
theorem ray_partition_canonical (p : ℕ) [hp : Fact p.Prime] (σ : AdditiveAut) :
    ∀ i : ZMod p, σ '' (Ray p i) = Ray p i := by
  intro i
  rw [additive_aut_is_id σ]
  simp [Set.image_id]

