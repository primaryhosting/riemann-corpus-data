/-
  Brockian/GaloisNgonClassification.lean — the unified Galois classification of the
  quadratic spectral fields across ALL `n`, separating the GOLDEN `n`-gons from the
  silver/bronze ones.

  The adjacency spectrum of the cycle graph `C_n` is `{2 cos(2πk/n)}`, generated by
  `α_n = spectralGen n = 2 cos(2π/n)` (`Brockian.GaloisWhyFive.spectralGen`).  The
  real subfield `ℚ(α_n) = ℚ(ζ_n)⁺` is quadratic for exactly four `n`; this file
  assembles the three faces of that fact into a single `TFAE`, pins down WHICH
  quadratic each of the four `n`-gons realizes, and proves the Golden Dichotomy that
  isolates `n ∈ {5,10}` (the golden field, discriminant `5`) from `n = 8` (silver,
  `√2`, discriminant `8`) and `n = 12` (bronze, `√3`, discriminant `12`).

  ## What is proved (AXLE-verified at lean-4.32.0, axioms ⊆
     {propext, Classical.choice, Quot.sound}; no `sorry`/`native_decide`)

  ### (1) The classification TFAE  (`quadratic_ngon_tfae`)
  For every `n ≥ 3` the following are equivalent:
    * `[ℚ(2cos 2π/n):ℚ] = 2`      — the real subfield is a quadratic field;
    * `n ∈ {5,8,10,12}`          — the concrete four-element list;
    * `φ(n) = 4`                 — the Euler-totient arithmetic face.
  Routed through the existing `CyclotomicRealDegree` lemmas
  (`quadratic_iff_totient_four`, `totient_eq_four_iff`).

  ### (2) The concrete minimal-polynomial witnesses
    * `spectralGen_eight  = √2`, root of `X² − 2`     (`aeval_spectralGen_eight`);
    * `spectralGen_ten    = φ`,  root of `X² − X − 1` (`aeval_spectralGen_ten`);
    * `spectralGen_twelve = √3`, root of `X² − 3`     (`aeval_spectralGen_twelve`);
    * `n = 5` reuses `CosAlgebraicInteger.aeval_spectralGen_five_X_sq_add_X_sub_one`
      (`α_5 = φ − 1`, root of `X² + X − 1`).

  ### (3) The Golden Galois Dichotomy  (`golden_ngons_are_five_and_ten`)
  Among the four quadratic `n`-gons, exactly `n ∈ {5,10}` give the golden field
  `ℚ(√5)`: their minimal polynomials `X²+X−1` (n=5) and `X²−X−1` (n=10) both have
  discriminant `5`, whereas `n=8` gives `√2` (discriminant `8`) and `n=12` gives `√3`
  (discriminant `12`).  Stated as the discriminant of each identified minimal
  polynomial, `ngonDisc`, with `ngonDisc n = 5 ↔ n = 5 ∨ n = 10`.

  ## What is NOT claimed
    * Field equality `ℚ(spectralGen n) = ℚ(√5)` for `n ∈ {5,10}` is not attempted;
      the honest deliverable is the concrete minimal-polynomial witnesses (2) and the
      discriminant dichotomy (3), which already separate golden from silver/bronze.
-/
import Mathlib
import Brockian.GaloisWhyFive
import Brockian.CyclotomicRealDegree
import Brockian.CosAlgebraicInteger

namespace Brockian.GaloisNgonClassification

open Brockian.GaloisWhyFive Brockian.CyclotomicRealDegree Polynomial

/-! ### (1) The classification TFAE -/

/-- **The quadratic `n`-gon TFAE.**  For every `n ≥ 3`, three faces of "the real
cyclotomic field `ℚ(2cos 2π/n)` is quadratic" coincide: the degree being `2`, the
concrete membership `n ∈ {5,8,10,12}`, and the arithmetic condition `φ(n) = 4`.
Assembled from `quadratic_iff_totient_four` (degree ↔ totient) and
`totient_eq_four_iff` (totient ↔ membership). -/
theorem quadratic_ngon_tfae {n : ℕ} (hn : 3 ≤ n) :
    List.TFAE
      [ (minpoly ℚ (Brockian.GaloisWhyFive.spectralGen n)).natDegree = 2,
        n = 5 ∨ n = 8 ∨ n = 10 ∨ n = 12,
        Nat.totient n = 4 ] := by
  tfae_have 1 ↔ 3 := quadratic_iff_totient_four hn
  tfae_have 3 ↔ 2 := totient_eq_four_iff
  tfae_finish

/-! ### (2) The concrete minimal-polynomial witnesses -/

/-- **`α_8 = √2`.**  `2 cos(2π/8) = 2 cos(π/4) = 2·(√2/2) = √2`. -/
theorem spectralGen_eight : spectralGen 8 = Real.sqrt 2 := by
  have harg : (2 * Real.pi / ((8 : ℕ) : ℝ)) = Real.pi / 4 := by push_cast; ring
  unfold spectralGen
  rw [harg, Real.cos_pi_div_four]
  ring

/-- **`α_10 = φ` (the golden ratio itself).**  `2 cos(2π/10) = 2 cos(π/5)
= 2·(1+√5)/4 = (1+√5)/2 = φ`. -/
theorem spectralGen_ten : spectralGen 10 = Real.goldenRatio := by
  have hcos : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := Real.cos_pi_div_five
  have harg : (2 * Real.pi / ((10 : ℕ) : ℝ)) = Real.pi / 5 := by push_cast; ring
  have hg : Real.goldenRatio = (1 + Real.sqrt 5) / 2 := rfl
  unfold spectralGen
  rw [harg, hcos, hg]
  ring

/-- **`α_12 = √3`.**  `2 cos(2π/12) = 2 cos(π/6) = 2·(√3/2) = √3`. -/
theorem spectralGen_twelve : spectralGen 12 = Real.sqrt 3 := by
  have harg : (2 * Real.pi / ((12 : ℕ) : ℝ)) = Real.pi / 6 := by push_cast; ring
  unfold spectralGen
  rw [harg, Real.cos_pi_div_six]
  ring

/-- **`α_8 = √2` is a root of the monic integer polynomial `X² − 2`** — the silver
quadratic (discriminant `8`). -/
theorem aeval_spectralGen_eight :
    (aeval (spectralGen 8)) (X ^ 2 - 2 : Polynomial ℤ) = 0 := by
  rw [spectralGen_eight]
  have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  simp only [map_sub, map_pow, aeval_X, map_ofNat]
  linear_combination h2

/-- **`α_10 = φ` is a root of the monic integer polynomial `X² − X − 1`** — the golden
quadratic (discriminant `5`), the same golden field `ℚ(√5)` as the pentagon `n = 5`. -/
theorem aeval_spectralGen_ten :
    (aeval (spectralGen 10)) (X ^ 2 - X - 1 : Polynomial ℤ) = 0 := by
  rw [spectralGen_ten]
  have hsq : Real.goldenRatio ^ 2 = Real.goldenRatio + 1 := Real.goldenRatio_sq
  simp only [map_sub, map_pow, aeval_X, map_one]
  linear_combination hsq

/-- **`α_12 = √3` is a root of the monic integer polynomial `X² − 3`** — the bronze
quadratic (discriminant `12`). -/
theorem aeval_spectralGen_twelve :
    (aeval (spectralGen 12)) (X ^ 2 - 3 : Polynomial ℤ) = 0 := by
  rw [spectralGen_twelve]
  have h3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp only [map_sub, map_pow, aeval_X, map_ofNat]
  linear_combination h3

/-! ### (3) The Golden Galois Dichotomy -/

/-- The discriminant `b² − 4ac` of the identified monic minimal polynomial
`X² + bX + c` of `α_n`, for each of the four quadratic `n`-gons:
`n=5`: `X²+X−1` (disc `5`); `n=8`: `X²−2` (disc `8`); `n=10`: `X²−X−1` (disc `5`);
`n=12`: `X²−3` (disc `12`). -/
def ngonDisc (n : ℕ) : ℤ :=
  if n = 5 then discrim 1 1 (-1)
  else if n = 8 then discrim 1 0 (-2)
  else if n = 10 then discrim 1 (-1) (-1)
  else discrim 1 0 (-3)

/-- Discriminant of the pentagon's minimal polynomial `X² + X − 1` is `5` (golden). -/
theorem disc_five : discrim (1 : ℤ) 1 (-1) = 5 := by norm_num [discrim]

/-- Discriminant of the `n = 10` minimal polynomial `X² − X − 1` is `5` (golden). -/
theorem disc_ten : discrim (1 : ℤ) (-1) (-1) = 5 := by norm_num [discrim]

/-- Discriminant of the `n = 8` minimal polynomial `X² − 2` is `8` (silver, `√2`). -/
theorem disc_eight : discrim (1 : ℤ) 0 (-2) = 8 := by norm_num [discrim]

/-- Discriminant of the `n = 12` minimal polynomial `X² − 3` is `12` (bronze, `√3`). -/
theorem disc_twelve : discrim (1 : ℤ) 0 (-3) = 12 := by norm_num [discrim]

/-- **The Golden Galois Dichotomy.**  Among the four quadratic `n`-gons
`n ∈ {5,8,10,12}`, exactly `n ∈ {5,10}` give the golden field `ℚ(√5)`: the
discriminant of the identified minimal polynomial equals `5` iff `n = 5 ∨ n = 10`.
The other two are silver (`n=8`, disc `8`, `√2`) and bronze (`n=12`, disc `12`, `√3`). -/
theorem golden_ngons_are_five_and_ten {n : ℕ}
    (hn : n = 5 ∨ n = 8 ∨ n = 10 ∨ n = 12) :
    ngonDisc n = 5 ↔ (n = 5 ∨ n = 10) := by
  rcases hn with rfl | rfl | rfl | rfl <;> norm_num [ngonDisc, discrim]

end Brockian.GaloisNgonClassification
