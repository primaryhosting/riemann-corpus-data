open scoped BigOperators
open Real

/-- The number of distinct residues of a finite set modulo p -/
def nu_p (G : Finset ℕ) (p : ℕ) : ℕ :=
  (G.image (· % p)).card

/-- Alternative definition using our residue cardinality framework -/
def nu_p' (g : ℕ → ℕ) (k p : ℕ) : ℕ :=
  (Finset.univ.image (fun i : Fin k => (g i) % p)).card

/-
Definitions of localFactor and singularSeriesFinite. Note: localFactor modified to not require Fact (Nat.Prime p) to ease usage in singularSeriesFinite.
-/
open scoped BigOperators
open Real

/-- The local density correction factor at prime p for k-tuple G -/
def localFactor (G : Finset ℕ) (p : ℕ) : ℝ :=
  let k := G.card
  let ν := nu_p G p
  (1 - (ν : ℝ) / p) / ((1 - 1/p)^k)

/-- Finite product of local factors up to bound P -/
def singularSeriesFinite (G : Finset ℕ) (P : ℕ) : ℝ :=
  ∏ p ∈ (Finset.range (P+1)).filter Nat.Prime, 
    localFactor G p

