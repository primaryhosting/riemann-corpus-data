/-- For admissible G, nu_p < p for all primes p -/
theorem admissible_implies_nu_lt (G : Finset ℕ)
    (h : IsAdmissibleAlt G) (p : ℕ) (hp : Nat.Prime p) :
    nu_p G p < p :=
  h p hp

/-
The singular series is strictly positive for admissible tuples
-/
open scoped BigOperators
open Real

/-- The singular series is strictly positive for admissible tuples -/
theorem singular_series_pos (G : Finset ℕ)
    (h_adm : ∀ p : ℕ, Nat.Prime p → nu_p G p < p)
    (h_nonempty : G.Nonempty) :
    0 < singularSeries G := by
  obtain ⟨S, hS_pos, hS_lim⟩ := singular_series_converges G h_adm h_nonempty
  unfold singularSeries
  rw [lim_eq hS_lim]
  exact hS_pos

/-
Computational definitions
-/
open scoped BigOperators
open Real

/-- Compute nu_p for a specific set and prime -/
def compute_nu_p (G : List ℕ) (p : ℕ) : ℕ :=
  (G.toFinset.image (· % p)).card

/-- Compute local factor (as rational approximation) -/
def compute_local_factor (G : List ℕ) (p : ℕ) : ℚ :=
  let k := G.length
  let ν := compute_nu_p G p
  (p - ν : ℚ) / (p - 1)^k

/-- Compute finite product up to P -/
def compute_singular_series_finite (G : List ℕ) (P : ℕ) : ℚ :=
  (List.range P).filter Nat.Prime |>.foldl 
    (fun acc p => acc * compute_local_factor G p) 1

/-- Check if a list represents an admissible tuple -/
def isAdmissibleList (G : List ℕ) (max_prime : ℕ) : Bool :=
  (List.range max_prime).filter Nat.Prime |>.all fun p =>
    G.any fun g => g % p ≠ 0

/-- Compute which primes make the tuple non-admissible -/
def findBadPrimes (G : List ℕ) (max_prime : ℕ) : List ℕ :=
  (List.range max_prime).filter fun p =>
    Nat.Prime p ∧ G.all fun g => p ∣ g

/-
nu_p from residue cardinality
-/
open scoped BigOperators
open Real

/-- Our residue cardinality theorem provides nu_p -/
theorem nu_p_from_residue_cardinality (g : ℕ → ℕ) (k : ℕ) (p : ℕ) [Fact (Nat.Prime p)]
    (hga : AdmissibleTuple p g k) :
    nu_p ((Finset.range k).image g) p =
    p - (PrincipalKTuples p g k).card := by
      -- Apply the card_principal_eq_q_sub_image lemma.
      have h_card_principal : (PrincipalKTuples p g k).card = p - (Finset.image (fun i => (g i) % p) (Finset.range k)).card := by
        exact?;
      rw [ h_card_principal, tsub_tsub_cancel_of_le ];
      · exact congr_arg Finset.card ( by ext; aesop );
      · exact le_trans ( Finset.card_le_card ( Finset.image_subset_iff.mpr fun i hi => Finset.mem_range.mpr <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ) ) ( by simpa )

/-
The complete picture: For admissible k-tuple G, we have exact count, positive count, and singular series convergence.
-/
open scoped BigOperators
open Real

/-- The complete picture: For admissible k-tuple G, we have:
    1. Exact count: |P_q(G)| = q - nu_q(G)
    2. Positive count: |P_q(G)| > 0 for all primes q
    3. Singular series: S(G) = ∏_p localFactor(G,p) converges and is positive
    4. Hardy-Littlewood predicts: π_G(x) ~ S(G) * x / (log x)^k
-/
theorem complete_hardy_littlewood_picture (G : Finset ℕ) (k : ℕ) (g : ℕ → ℕ)
    [Fact (k = G.card)]
    (h_G : G = (Finset.range k).image g)
    (h_adm : IsAdmissibleAlt G)
    (h_nonempty : G.Nonempty) :
    (∀ (q : ℕ) [Fact (Nat.Prime q)] (hga : AdmissibleTuple q g k),
      (PrincipalKTuples q g k).card = q - nu_p G q) ∧
    (∀ (q : ℕ) [Fact (Nat.Prime q)], nu_p G q < q) ∧
    (∃ S : ℝ, 0 < S ∧ S = singularSeries G) := by
      have h_card_principal : ∀ q : ℕ, Nat.Prime q → (PrincipalKTuples q g k).card = q - nu_p G q := by
        intro q hq_prime
        have h_principal_card : (PrincipalKTuples q g k).card = q - (Finset.image (fun i => (g i) % q) (Finset.range k)).card := by
          convert card_principal_eq_q_sub_image q g k using 1;
          · tauto;
          · exact ⟨ hq_prime ⟩;
        unfold nu_p;
        rw [ h_principal_card, h_G, Finset.image_image ];
        rfl;
      exact ⟨ fun q _ hq => h_card_principal q <| Fact.out, fun q _ => h_adm q <| Fact.out, _, singular_series_pos G ( fun q hq => h_adm q hq ) h_nonempty, rfl ⟩

/-
Definition of AdmissiblePair
-/
open scoped BigOperators
open Real

/-- Correct admissibility condition for pairs -/
def AdmissiblePair (q : ℕ) (g : ℕ → ℕ) : Prop := g 0 % q ≠ g 1 % q

/-
Universal q-2 Theorem for pairs (Corrected)
-/
open scoped BigOperators
open Real

/-- Universal q-2 Theorem for pairs (Corrected) -/
theorem k_tuple_pairs_theorem_correct (q : ℕ) [Fact (Nat.Prime q)]
    (g : ℕ → ℕ) (hga : AdmissiblePair q g) :
    (PrincipalKTuples q g 2).card = q - 2 := by
      -- Let's first show that the number of elements in the finite set `PrincipalKTuples q g 2` is equal to `q - 2`.
      have h_card : (Finset.univ.filter (fun n : ZMod q => ∀ i : Fin 2, (n + g i) ≠ 0)).card = q - 2 := by
        -- Since the tuple is admissible, the numbers $-g(0)$ and $-g(1)$ are distinct modulo $q$.
        have h_distinct : (-(g 0 : ZMod q)) ≠ (-(g 1 : ZMod q)) := by
          exact fun h => hga <| by simpa [ ← ZMod.natCast_eq_natCast_iff' ] using neg_inj.mp h;
        simp_all +decide [ Fin.forall_fin_two, Finset.filter_ne', Finset.card_sdiff ];
        rw [ show ( Finset.univ.filter fun n : ZMod q => ¬n + ( g 0 : ZMod q ) = 0 ∧ ¬n + ( g 1 : ZMod q ) = 0 ) = Finset.univ \ { - ( g 0 : ZMod q ), - ( g 1 : ZMod q ) } by ext; simp +decide [ add_eq_zero_iff_eq_neg ] ] ; rw [ Finset.card_sdiff ] ; norm_num [ Finset.card_univ, h_distinct ];
      convert h_card using 1;
      refine' Finset.card_bij ( fun n hn => n ) _ _ _ <;> simp +decide [ Finset.mem_filter, Finset.mem_range ];
      · simp_all +decide [ ← ZMod.val_natCast, Finset.mem_filter, Finset.mem_range, PrincipalKTuples ];
      · simp +decide [ PrincipalKTuples ];
        exact fun a₁ ha₁ ha₂ a₂ ha₃ ha₄ h => Nat.mod_eq_of_lt ha₁ ▸ Nat.mod_eq_of_lt ha₃ ▸ by simpa [ ← ZMod.natCast_eq_natCast_iff' ] using h;
      · intro b hb₀ hb₁; use b.val; simp_all +decide [ PrincipalKTuples ] ;
        exact ⟨ ZMod.val_lt b, fun i hi => by rw [ ← ZMod.val_natCast ] ; interval_cases i <;> simp_all +decide [ ← ZMod.natCast_eq_zero_iff ] ⟩

/-
The set of residues that make a pair inadmissible mod q has size 2
-/
open scoped BigOperators
open Real

/-- The set of residues that make a pair inadmissible mod q has size 2 -/
lemma card_bad_residues_pair (q : ℕ) [Fact (Nat.Prime q)] (g : ℕ → ℕ)
    (hga : AdmissiblePair q g) :
    ((Finset.range 2).image (fun i => (q - g i % q) % q)).card = 2 := by
      rw [ Finset.card_image_of_injOn ];
      · rfl;
      · intro i hi j hj hij; simp_all +decide [ AdmissiblePair ] ;
        interval_cases i <;> interval_cases j <;> simp_all +decide;
        · simp_all +decide [ ← ZMod.natCast_eq_natCast_iff', Nat.cast_sub ( show g 0 % q ≤ q from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ), Nat.cast_sub ( show g 1 % q ≤ q from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ) ];
        · have := Nat.modEq_iff_dvd.mp hij.symm; simp_all +decide [ ← ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_sub ( show g 1 % q ≤ q from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ), Nat.cast_sub ( show g 0 % q ≤ q from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ) ] ;
          simp_all +decide [ sub_eq_iff_eq_add, ← ZMod.natCast_eq_natCast_iff' ]

/-
Principal tuples are the complement of the bad residues
-/
open scoped BigOperators
open Real

/-- Principal tuples are the complement of the bad residues -/
lemma principal_tuples_eq_sdiff_bad_residues (q : ℕ) [Fact (Nat.Prime q)] (g : ℕ → ℕ) :
    PrincipalKTuples q g 2 = (Finset.range q) \ ((Finset.range 2).image (fun i => (q - g i % q) % q)) := by
      ext x;
      simp [PrincipalKTuples];
      intro hx; constructor <;> intro h i hi <;> specialize h i hi <;> simp_all +decide [ ← ZMod.val_natCast, Nat.mod_eq_of_lt ] ;
      · rw [ Nat.cast_sub ] <;> norm_num;
        · contrapose! h; aesop;
        · exact Nat.le_of_lt ( Nat.mod_lt _ ( Nat.Prime.pos Fact.out ) );
      · contrapose! h; interval_cases i <;> simp_all +decide [ ← eq_sub_iff_add_eq', ZMod.natCast_zmod_val ] ;
        · simp +decide [ ← ZMod.val_natCast, Nat.cast_sub hx.le ];
          rw [ Nat.cast_sub ] <;> norm_num;
          · exact Nat.mod_eq_of_lt hx;
          · exact Nat.le_of_lt ( ZMod.val_lt _ );
        · simp +decide [ ← ZMod.val_natCast, Nat.cast_sub hx.le ];
          rw [ Nat.cast_sub ] <;> norm_num;
          · exact Nat.mod_eq_of_lt hx;
          · exact Nat.le_of_lt ( ZMod.val_lt _ )

/-
Structure depends only on residue pattern
-/
open scoped BigOperators
open Real

/-- Structure depends only on residue pattern -/
theorem gap_independence (p : ℕ) (g1 g2 : ℕ → ℕ) (k : ℕ)
    (h_mod : ∀ i ∈ Finset.range k, g1 i % p = g2 i % p) :
    PrincipalKTuples p g1 k = PrincipalKTuples p g2 k := by
      unfold PrincipalKTuples;
      simp_all +decide [ Nat.add_mod ]

/-
For admissible tuple (using IsAdmissibleAlt), PrincipalKTuples is non-empty
-/
open scoped BigOperators
open Real

/-- For admissible tuple (using IsAdmissibleAlt), PrincipalKTuples is non-empty -/
theorem admissible_alt_implies_nonempty_principal (g : ℕ → ℕ) (k : ℕ) (p : ℕ)
    [Fact (Nat.Prime p)] [NeZero k]
    (hga : AdmissibleTuple p g k)
    (h_adm : IsAdmissibleAlt ((Finset.range k).image g)) :
    (PrincipalKTuples p g k).Nonempty := by
      have h_card : (PrincipalKTuples p g k).card = p - (Finset.image (fun i => (g i) % p) (Finset.range k)).card := by
        exact?;
      have h_card_pos : 0 < p - (Finset.image (fun i => (g i) % p) (Finset.range k)).card := by
        have := h_adm p ( Fact.out : Nat.Prime p );
        simp_all +decide [ nu_p ];
        convert this using 1;
        rw [ Finset.image_image ];
        rfl;
      exact Finset.card_pos.mp ( h_card.symm ▸ h_card_pos )

