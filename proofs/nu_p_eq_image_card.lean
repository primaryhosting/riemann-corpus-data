/-- Singular series for twin primes -/
def twinPrimeSingularSeries : ℝ :=
  singularSeries {0, 2}

/-
Disproof of singular_series_finite_antitone
-/
open scoped BigOperators
open Real

/-- Disproof of singular_series_finite_antitone -/
theorem not_singular_series_finite_antitone :
    ¬(∀ (G : Finset ℕ), (∀ p : ℕ, Nat.Prime p → nu_p G p < p) → Antitone (singularSeriesFinite G)) := by
      simp +zetaDelta at *;
      refine' ⟨ { 0, 2 }, _, _ ⟩ <;> norm_num [ Antitone ];
      · unfold nu_p;
        rintro ( p | p | p | p ) <;> simp +arith +decide [ Finset.card ];
        rcases p with ( _ | _ | p ) <;> simp +arith +decide [ Nat.mod_eq_of_lt ];
      · refine' ⟨ 1, 2, by norm_num, _ ⟩ ; unfold singularSeriesFinite ; norm_num [ Finset.prod_filter, Finset.prod_range_succ ];
        unfold localFactor ; norm_num [ nu_p ]

/-
Disproof of admissible_iff_positive_count
-/
open scoped BigOperators
open Real

/-- Disproof of admissible_iff_positive_count -/
theorem not_admissible_iff_positive_count :
    ¬(∀ (G : Finset ℕ) (k : ℕ) (g : ℕ → ℕ) [Fact (k = G.card)] (p : ℕ) [Fact (Nat.Prime p)]
      (h_G : G = (Finset.range k).image g)
      (hga : AdmissibleTuple p g k),
      IsAdmissibleAlt G ↔ (PrincipalKTuples p g k).card > 0) := by
        simp +zetaDelta at *;
        refine' ⟨ _, 3, _, _ ⟩;
        exact { 0, 2, 4 };
        · exact ⟨ rfl ⟩;
        · use fun i => if i = 0 then 0 else if i = 1 then 2 else 4;
          refine' ⟨ 5, _, _, _, _ ⟩ <;> norm_cast;
          unfold IsAdmissibleAlt; simp +decide ;
          exists 3

/-
The statement of the Hardy-Littlewood conjecture (as a Prop)
-/
open scoped BigOperators
open Real
open scoped Asymptotics

/-- The statement of the Hardy-Littlewood conjecture -/
def HardyLittlewoodConjectureStatement (G : Finset ℕ) : Prop :=
  ∀ (h_adm : ∀ p : ℕ, Nat.Prime p → nu_p G p < p)
    (h_nonempty : G.Nonempty),
    let π_G := fun (x : ℝ) => ((Finset.range (Nat.floor x)).filter 
                         (fun n => ∀ g ∈ G, Nat.Prime (n + g))).card
    (fun x => (π_G x : ℝ)) ~[Filter.atTop] (fun x => singularSeries G * x / (Real.log x)^G.card)

/-
Disproof of local_factor_le_one
-/
open scoped BigOperators
open Real

/-- Disproof of local_factor_le_one -/
theorem not_local_factor_le_one :
    ¬(∀ (G : Finset ℕ) (p : ℕ) [Fact (Nat.Prime p)], nu_p G p < p → localFactor G p ≤ 1) := by
      norm_num +zetaDelta at *;
      use { 0, 2 }, 2;
      unfold localFactor nu_p; norm_num;
      exact ⟨ trivial ⟩

/-
Twin primes are admissible
-/
open scoped BigOperators
open Real

/-- Twin primes are admissible -/
lemma twin_primes_admissible : ∀ p : ℕ, Nat.Prime p → nu_p {0, 2} p < p := by
  intro p hp
  unfold nu_p
  simp +decide [hp];
  rcases p with ( _ | _ | _ | p ) <;> simp_all +arith +decide [ Nat.mod_eq_of_lt ]
