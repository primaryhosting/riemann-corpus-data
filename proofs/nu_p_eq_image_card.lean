/-
Helper lemma: If a prime p divides some shift for every n, then there are finitely many prime tuples
-/
open scoped BigOperators
open Real

/-- Helper lemma: If a prime p divides some shift for every n, then there are finitely many prime tuples -/
lemma finite_of_prime_divisor_for_all_shifts (G : Finset ℕ) (p : ℕ) [Fact (Nat.Prime p)]
    (h_div : ∀ n : ℕ, ∃ g ∈ G, p ∣ (n + g)) :
    Set.Finite {n : ℕ | ∀ g ∈ G, Nat.Prime (n + g)} := by
      refine Set.finite_iff_bddAbove.mpr ⟨ p, fun n hn => ?_ ⟩;
      obtain ⟨ g, hg₁, hg₂ ⟩ := h_div n ; have := Nat.prime_dvd_prime_iff_eq ( Fact.out ( p := Nat.Prime p ) ) ( hn g hg₁ ) ; aesop

/-
nu_p is bounded by p for p > 0
-/
open scoped BigOperators
open Real

/-- nu_p is bounded by p for p > 0 -/
lemma nu_p_le_p (G : Finset ℕ) (p : ℕ) (hp : p ≠ 0) : nu_p G p ≤ p := by
  exact le_trans ( Finset.card_le_card <| Finset.image_subset_iff.2 fun i hi => Finset.mem_range.2 <| Nat.mod_lt i <| Nat.pos_of_ne_zero hp ) <| by aesop;

/-
Non-admissible tuples have finitely many prime instances (using helper lemmas)
-/
open scoped BigOperators
open Real

/-- Main theorem: Non-admissible tuples have finitely many prime instances -/
theorem non_admissible_implies_finite (G : Finset ℕ)
    (h : ¬IsAdmissibleAlt G)
    (h_nonempty : G.Nonempty)
    (h_zero : 0 ∈ G) :
    Set.Finite {n : ℕ | ∀ g ∈ G, Nat.Prime (n + g)} := by
      -- If $0 \in G$, then for any $n$, $n + 0 = n$ must be prime. The only primes are $2, 3, 5, \ldots$, but the set of primes is infinite. However, the problem states that the set of prime tuples is finite. There must be a mistake here.
      by_contra h_contra;
      have h_inf : Set.Infinite {n : ℕ | ∀ g ∈ G, Nat.Prime (n + g)} := by
        exact h_contra;
      -- Let $p$ be a prime such that $\nu_p(G) = p$.
      obtain ⟨p, hp_prime, hp_eq⟩ : ∃ p, Nat.Prime p ∧ nu_p G p = p := by
        contrapose! h;
        exact fun p hp => lt_of_le_of_ne ( nu_p_le_p G p hp.ne_zero ) ( h p hp );
      -- By definition of $nu_p$, if $\nu_p(G) = p$, then for every $n$, there exists $g \in G$ such that $p \mid (n + g)$.
      have h_div : ∀ n : ℕ, ∃ g ∈ G, p ∣ (n + g) := by
        haveI := Fact.mk hp_prime; exact?;
      exact h_inf <| Set.finite_iff_bddAbove.mpr ⟨ p, fun n hn => not_lt.mp fun contra => by obtain ⟨ g, hg₁, hg₂ ⟩ := h_div n; have := Nat.dvd_of_mod_eq_zero ( show ( n + g ) % p = 0 from Nat.mod_eq_zero_of_dvd hg₂ ) ; exact absurd this ( by rw [ Nat.dvd_prime ( hn g hg₁ ) ] ; aesop ) ⟩

/-
Admissibility is necessary for infinitely many primes (using IsAdmissibleAlt)
-/
open scoped BigOperators
open Real

/-- Admissibility is necessary for infinitely many primes -/
theorem admissible_necessary (G : Finset ℕ)
    (h_infinite : Set.Infinite {n : ℕ | ∀ g ∈ G, Nat.Prime (n + g)})
    (h_nonempty : G.Nonempty)
    (h_zero : 0 ∈ G) :
    IsAdmissibleAlt G := by
      contrapose! h_infinite;
      convert non_admissible_implies_finite G h_infinite h_nonempty h_zero using 1;
      exact?

/-
For admissible G, nu_p < p for all primes p (using IsAdmissibleAlt)
-/
open scoped BigOperators
