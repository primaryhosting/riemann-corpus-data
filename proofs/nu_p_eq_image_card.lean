  have h_split : Summable (fun p : ℕ => if Nat.Prime p ∧ p < N then |localFactor G p - 1| else 0) ∧ Summable (fun p : ℕ => if Nat.Prime p ∧ N ≤ p then |localFactor G p - 1| else 0) := by
    constructor;
    · rw [ ← summable_nat_add_iff N ];
      exact ⟨ _, hasSum_single 0 fun n hn => by aesop ⟩;
    · exact Summable.of_nonneg_of_le ( fun p => by positivity ) ( fun p => by aesop ) ( Summable.mul_left _ <| Real.summable_nat_pow_inv.2 one_lt_two );
  convert h_split.1.add h_split.2 using 2 ; aesop

