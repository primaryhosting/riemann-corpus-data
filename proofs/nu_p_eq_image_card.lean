/-- Principal k-tuples are the residues n mod p such that n+g(i) is never 0 mod p -/
def PrincipalKTuples (p : ℕ) (g : ℕ → ℕ) (k : ℕ) : Finset ℕ :=
  (Finset.range p).filter (fun n => ∀ i ∈ Finset.range k, (n + g i) % p ≠ 0)

/-- Admissibility condition for the tuple structure -/
def AdmissibleTuple (p : ℕ) (g : ℕ → ℕ) (k : ℕ) : Prop := True

/-- Cardinality theorem for principal k-tuples -/
theorem card_principal_eq_q_sub_image (p : ℕ) (g : ℕ → ℕ) (k : ℕ)
    [Fact (Nat.Prime p)] (hga : AdmissibleTuple p g k) :
    (PrincipalKTuples p g k).card = p - (Finset.image (fun i => (g i) % p) (Finset.range k)).card := by
  -- The set of principal k-tuples is exactly the set of numbers in the range 0 to p-1 that are not congruent to any of the g_i modulo p.
  have h_principal_set : Finset.filter (fun n => ∀ i ∈ Finset.range k, ¬(n + g i) % p = 0) (Finset.range p) = Finset.range p \ Finset.image (fun i => (p - g i % p) % p) (Finset.range k) := by
    ext n;
    simp +decide [ ← ZMod.val_natCast, Nat.add_mod ];
    intro hn; constructor <;> intro h i hi <;> specialize h i hi <;> simp_all +decide [ ← eq_sub_iff_add_eq', ZMod.natCast_zmod_val ] ;
    · contrapose! h;
      simp +decide [ ← h, Nat.cast_sub ( show g i % p ≤ p from Nat.le_of_lt ( Nat.mod_lt _ ( Nat.Prime.pos Fact.out ) ) ) ];
    · contrapose! h;
      rw [ Nat.ModEq.symm ];
      exact Nat.mod_eq_of_lt hn;
      simp_all +decide [ ← ZMod.natCast_eq_natCast_iff, Nat.cast_sub ( show g i % p ≤ p from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ) ];
  -- The cardinality of the difference of two sets is the difference of their cardinalities.
  have h_card_diff : Finset.card (Finset.range p \ Finset.image (fun i => (p - g i % p) % p) (Finset.range k)) = p - Finset.card (Finset.image (fun i => (p - g i % p) % p) (Finset.range k)) := by
    rw [ Finset.card_sdiff ] ; norm_num;
    rw [ Finset.inter_eq_left.mpr ];
    exact Finset.image_subset_iff.mpr fun i hi => Finset.mem_range.mpr <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out;
  convert h_card_diff using 2;
  refine' Finset.card_bij ( fun x hx => ( p - x ) % p ) _ _ _ <;> simp +contextual;
  · exact fun i hi => ⟨ i, hi, rfl ⟩;
  · intro i hi j hj h; have := Nat.modEq_iff_dvd.mp h.symm; simp_all +decide [ ← ZMod.intCast_zmod_eq_zero_iff_dvd, Nat.cast_sub ( show g i % p ≤ p from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ), Nat.cast_sub ( show g j % p ≤ p from Nat.le_of_lt <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out ) ] ;
    simp_all +decide [ sub_eq_zero, ← ZMod.natCast_eq_natCast_iff' ]

/-
If nu_p = p, then some shift is always divisible by p
-/
open scoped BigOperators
open Real

/-- If nu_p = p, then some shift is always divisible by p -/
theorem nu_p_eq_p_implies_divisor (G : Finset ℕ) (p : ℕ) [Fact (Nat.Prime p)]
    (h : nu_p G p = p) :
    ∀ n : ℕ, ∃ g ∈ G, p ∣ (n + g) := by
      -- Since $nu_p G p = p$, the set $G \mod p$ covers all residues modulo $p$.
      have h_covers_all_residues : ∀ r : ℕ, r < p → ∃ g ∈ G, g % p = r := by
        contrapose! h;
        obtain ⟨ r, hr, hr' ⟩ := h; exact ne_of_lt ( lt_of_lt_of_le ( Finset.card_lt_card <| Finset.ssubset_iff_subset_ne.2 ⟨ Finset.image_subset_iff.2 fun x hx => Finset.mem_range.2 <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out, fun h => by have := Finset.mem_image.1 ( h.symm ▸ Finset.mem_range.2 hr ) ; aesop ⟩ ) <| by simp +decide [ Finset.card_image_of_injOn ] ) ;
      intro n;
      obtain ⟨ g, hg₁, hg₂ ⟩ := h_covers_all_residues ( ( p - ( n % p ) ) % p ) ( Nat.mod_lt _ ( Nat.Prime.pos Fact.out ) );
      exact ⟨ g, hg₁, Nat.dvd_of_mod_eq_zero ( by rw [ Nat.add_mod, hg₂ ] ; simp +decide [ Nat.add_sub_of_le ( Nat.mod_lt n ( Nat.Prime.pos Fact.out ) |> Nat.le_of_lt ) ] ) ⟩

