/-- **Theorem**: Given a spectral model, G(n) ≥ 1 for all even n > max(2, N₀).

**Proof strategy**:
1. Apply approximation: |G(n) - Main(n)| ≤ Err(n)
2. Extract lower bound: Main(n) - Err(n) ≤ G(n)
3. Use margin: 1/2 ≤ Main(n) - Err(n)
4. Conclude: 1/2 ≤ G(n) in ℝ, hence G(n) ≥ 1 in ℕ

This is the **metatheorem**: it proves the logical structure independent
of any specific spectral theory.
-/
theorem goldbachReps_ge_one_of_model (M : SpectralModel) :
    ∀ n, n > max 2 M.N₀ → Even n → goldbachReps n ≥ 1 := by
  intro n hn hEven
  -- Unpack n > max(2, N₀)
  have hn_gt_2 : n > 2 := by
    calc n > max 2 M.N₀     := hn
         _ ≥ 2              := Nat.le_max_left 2 M.N₀
  have hn_gt_N₀ : n > M.N₀ := by
    calc n > max 2 M.N₀     := hn
         _ ≥ M.N₀           := Nat.le_max_right 2 M.N₀
  
  -- Apply spectral approximation
  have h_approx := M.approx n hn_gt_2 hEven
  
  -- Extract lower bound: Main - Err ≤ G
  have h_lower : M.mainTerm n - M.errTerm n ≤ (goldbachReps n : ℝ) :=
    le_of_abs_sub_le h_approx
  
  -- Apply margin condition: 1/2 ≤ Main - Err
  have h_margin : (1/2 : ℝ) ≤ M.mainTerm n - M.errTerm n :=
    M.main_dominates n hn_gt_N₀
  
  -- Conclude: 1/2 ≤ G(n) in ℝ
  have h_half : (1/2 : ℝ) ≤ (goldbachReps n : ℝ) :=
    le_trans h_margin h_lower
  
  -- Convert to G(n) ≥ 1 in ℕ (since G(n) can't be 0 if it's ≥ 1/2)
  by_contra hnot
  have hlt1 : goldbachReps n < 1 := Nat.lt_of_not_ge hnot
  have hz : goldbachReps n = 0 := Nat.lt_one_iff.mp hlt1
  have : (goldbachReps n : ℝ) = 0 := by simp [hz]
  linarith

/-- **Goldbach conjecture**: Every even n > 2 is a sum of two primes -/
def Goldbach (n : ℕ) : Prop :=
  ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n

/-- **Weak Goldbach**: Every odd n > 5 is a sum of three primes
(Used as stepping stone in some approaches) -/
def WeakGoldbach (n : ℕ) : Prop :=
  ∃ p q r, Nat.Prime p ∧ Nat.Prime q ∧ Nat.Prime r ∧ p + q + r = n

