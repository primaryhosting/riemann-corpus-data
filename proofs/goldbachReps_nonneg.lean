/-- **Base spectral model**: Abstract framework for any spectral theory.

A spectral model consists of:
- `mainTerm`: Predicted count (e.g., singular series × n/(log n)²)
- `errTerm`: Error bound (e.g., from trace formula or circle method)
- `approx`: Approximation guarantee |G(n) - Main(n)| ≤ Err(n)
- `N₀`: Threshold beyond which margin condition holds
- `main_dominates`: Explicit margin Main(n) - Err(n) ≥ 1/2

**Design rationale for margin 1/2**:
- Large enough: guarantees G(n) ≥ 1 (since G(n) ∈ ℕ)
- Small enough: achievable with realistic error bounds
- Explicit: no hidden constants or "sufficiently large n"
-/
structure SpectralModel where
  mainTerm : ℕ → ℝ
  errTerm  : ℕ → ℝ
  /-- Error terms are non-negative -/
  err_nonneg : ∀ n, 0 ≤ errTerm n
  /-- Main approximation: |G(n) - Main(n)| ≤ Err(n) for even n > 2 -/
  approx : ∀ n, n > 2 → Even n →
    |(goldbachReps n : ℝ) - mainTerm n| ≤ errTerm n
  /-- Critical threshold N₀ -/
  N₀ : ℕ
  /-- Margin condition: Main dominates error by at least 1/2 -/
  main_dominates : ∀ n, n > N₀ →
    (1/2 : ℝ) ≤ mainTerm n - errTerm n

/-
Main term is eventually positive (follows from margin + err_nonneg)
-/
/-- Main term is eventually positive (follows from margin + err_nonneg) -/
lemma SpectralModel.mainTerm_eventually_pos (M : SpectralModel) : ∀ n, n > M.N₀ → 0 < M.mainTerm n := by
  intro n hn
  have h_margin := M.main_dominates n hn
  have h_err := M.err_nonneg n
  linarith

/-
Error term is eventually strictly dominated by main term
-/
/-- Error term is eventually strictly dominated by main term -/
lemma SpectralModel.errTerm_eventually_dominated (M : SpectralModel) : ∀ n, n > M.N₀ →
    M.errTerm n < M.mainTerm n := by
  intro n hn
  have h_margin := M.main_dominates n hn
  linarith

/-- **Enhanced spectral model**: Hardy-Littlewood style structure.

This extends the base model with:
- Explicit singular series S(n)
- Asymptotic structure Main(n) ~ S(n) · n/(log n)²
- Lower bound S(n) ≥ c > 0 for even n

This makes the Hardy-Littlewood circle method a specific instance
while leaving room for alternative methods (Brockian, hybrid, etc.).
-/
structure EnhancedSpectralModel extends SpectralModel where
  /-- Singular series factor S(n) -/
  singularSeries : ℕ → ℝ
  /-- Main term has Hardy-Littlewood asymptotic structure -/
  main_asymptotic : ∀ n, n > 2 → Even n →
    ∃ δ : ℝ, |δ| < 1 ∧
      mainTerm n = singularSeries n * (n : ℝ) / (Real.log n) ^ 2 * (1 + δ / Real.log n)
  /-- Singular series bounded below by absolute constant -/
  singular_series_pos : ∃ c : ℝ, c > 0 ∧
    ∀ n, Even n → n > 2 → c ≤ singularSeries n

/-- **Lower bound from absolute value**: |x - m| ≤ e ⟹ m - e ≤ x -/
lemma le_of_abs_sub_le {x m e : ℝ} (h : |x - m| ≤ e) : m - e ≤ x := by
  rw [abs_sub_le_iff] at h
  linarith [h.1]

/-- **Upper bound from absolute value**: |x - m| ≤ e ⟹ x ≤ m + e -/
lemma le_of_abs_sub_le' {x m e : ℝ} (h : |x - m| ≤ e) : x ≤ m + e := by
  rw [abs_sub_le_iff] at h
  linarith [h.2]

