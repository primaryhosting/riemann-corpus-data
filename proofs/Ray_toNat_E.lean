  (Finset.range (N - g)).filter (fun p =>
    p > 5 ∧
    Nat.Prime p ∧
    Nat.Prime (p + g) ∧
    Ray.fromNat p = pair.1 ∧
    Ray.fromNat (p + g) = pair.2
  ) |>.card

