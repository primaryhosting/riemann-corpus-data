          simp [Representation.charInnerProduct];
          erw [ Representation.sum_D5ConjClass ] ; norm_num [ Representation.character ];
          norm_cast;
        · aesop;
        · unfold Representation.charInnerProduct;
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by rfl ] ; simp +decide ; ring;
          norm_num [ Representation.character ];
          norm_num [ Complex.ext_iff, D5.ConjClass.size ];
          ring;
        · unfold Representation.charInnerProduct; simp +decide ;
          erw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by decide ] ; simp +decide;
          norm_num [ Complex.ext_iff, Representation.character ];
          norm_num [ D5.ConjClass.size ] ; ring;
      · -- By definition of D5.IrrepIndex, we can split into cases based on the values of π₂.
        cases' π₂ with π₂_1 π₂_2;
        · exact?;
        · unfold Representation.charInnerProduct; norm_num [ GoldenRatio.phi_bounds ] ;
          unfold Representation.character; norm_num [ D5.ConjClass.size ] ;
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by rfl ] ; simp +decide ; ring;
        · tauto;
        · -- By definition of the character inner product, we can compute it explicitly.
          simp [Representation.charInnerProduct];
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { .identity, .rot1, .rot2, .reflection } by rfl ] ; simp +decide [ Finset.sum_range_succ, Representation.character ] ; ring;
          norm_num [ Complex.ext_iff, sq ];
          -- Substitute the sizes of the conjugacy classes and simplify the expression.
          simp [D5.ConjClass.size];
          nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ];
      · cases' π₂ with π₂_1 π₂_2;
        · unfold Representation.charInnerProduct;
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { .identity, .rot1, .rot2, .reflection } by decide ] ; simp +decide [ Representation.character ];
          unfold D5.ConjClass.size; norm_num;
          ring;
        · -- By definition of the conjugate irrep, its character is the conjugate of the golden irrep's character.
          simp [Representation.charInnerProduct];
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by decide ] ; simp +decide [ Representation.character ] ; ring!;
          norm_cast;
        · unfold Representation.charInnerProduct;
          rw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by decide ] ; simp +decide [ Representation.character ] ; ring;
          norm_num [ Complex.ext_iff, sq ];
          -- Substitute the sizes of the conjugacy classes and simplify the expression.
          simp [D5.ConjClass.size];
          nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ];
        · tauto

structure UnitaryRep (G : Type*) [Group G] (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  ρ : G →* (H ≃ₗᵢ[ℂ] H)

def UnitaryRep.toCLM {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (rep : UnitaryRep G H) (g : G) : H →L[ℂ] H := (rep.ρ g).toContinuousLinearEquiv

theorem UnitaryRep.star_eq_inv {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (rep : UnitaryRep G H) (g : G) : star (UnitaryRep.toCLM rep g) = UnitaryRep.toCLM rep g⁻¹ := by
      have h_unitary : ∀ g : G, star (rep.toCLM g) = rep.toCLM g⁻¹ := by
        intro g
        simp [Star.star, UnitaryRep.toCLM];
        refine' ContinuousLinearMap.ext fun x => _;
        refine' ( InnerProductSpace.toDual ℂ H ).injective _;
        ext y; simp +decide [ ContinuousLinearMap.adjoint_inner_left ] ;
        have := rep.ρ g |>.inner_map_map ( ( rep.ρ g ).symm x ) y; aesop;
      exact h_unitary g

def isotypicProjector {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (rep : UnitaryRep D5 H) (irrep : D5.IrrepIndex) : H →L[ℂ] H :=
  (irrep.dim / 10 : ℂ) • ∑ g : D5, conj (Representation.χ irrep g) • UnitaryRep.toCLM rep g

def P_golden {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (rep : UnitaryRep D5 H) : H →L[ℂ] H :=
  isotypicProjector rep .golden

theorem IsotypicProjector.golden_selfAdjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (rep : UnitaryRep D5 H) : IsSelfAdjoint (P_golden rep) := by
      simp [IsSelfAdjoint, P_golden, isotypicProjector];
      -- By definition of $χ$, we know that $χ(g⁻¹) = \overline{χ(g)}$ for any $g \in D5$.
      have h_char_conj : ∀ g : D5, Representation.χ .golden g⁻¹ = starRingEnd ℂ (Representation.χ .golden g) := by
        -- Since the character of the golden representation is real, conjugating it doesn't change it.
        have h_real : ∀ g : D5, (Representation.χ .golden g).im = 0 := by
          unfold Representation.χ;
          unfold Representation.character; aesop;
        -- Since the character is real, conjugating it doesn't change it. Therefore, the equality holds.
        intros g
        simp [h_real, Complex.ext_iff];
        cases g <;> simp +decide [ h_real ];
        rename_i a; fin_cases a <;> rfl;
      refine' congr_arg _ ( Finset.sum_bij ( fun g _ => g⁻¹ ) _ _ _ _ ) <;> simp +decide [ h_char_conj ];
      intro g; rw [ UnitaryRep.star_eq_inv ] ;

theorem IsotypicProjector.golden_convolution (k : D5) :
    ∑ g : D5, Representation.χ .golden g * Representation.χ .golden (g⁻¹ * k) =
    (5 : ℂ) * Representation.χ .golden k := by
  -- Since these are the only elements in the group, we can split the sum into cases based on the value of `g`.
  have h_cases : ∀ g : D5, Representation.χ D5.IrrepIndex.golden g = if g = DihedralGroup.r 0 then 2 else if g = DihedralGroup.r 1 ∨ g = DihedralGroup.r 4 then (φ - 1 : ℝ) else if g = DihedralGroup.r 2 ∨ g = DihedralGroup.r 3 then (-φ : ℝ) else 0 := by
    intro g; rcases g with ( _ | _ | _ | _ | _ | _ | g ) <;> norm_cast;
    rename_i x; fin_cases x <;> rfl;
  simp +decide only [h_cases] at *;
  rcases k with ⟨ _ | _ | _ | _ | _ | _ | k ⟩ <;> norm_num <;> norm_cast;
  all_goals simp +decide [ Finset.sum_ite, Finset.filter_eq', Finset.filter_or ] at *;
  any_goals nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show ( φ : ℝ ) = ( 1 + Real.sqrt 5 ) / 2 by rfl ];
  · simp +decide [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring;
    grind;
  · simp +decide [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring;
    grind;
  · rename_i k; fin_cases k <;> trivial;

theorem IsotypicProjector.golden_idempotent {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (rep : UnitaryRep D5 H) : P_golden rep * P_golden rep = P_golden rep := by
  unfold P_golden;
  -- Using the convolution property, we can rewrite the sum as:
  have h_convolution : ∑ g : D5, ∑ h : D5, (conj (Representation.χ .golden g) * conj (Representation.χ .golden h)) • (UnitaryRep.toCLM rep g * UnitaryRep.toCLM rep h) = (5 : ℂ) • ∑ k : D5, (conj (Representation.χ .golden k)) • (UnitaryRep.toCLM rep k) := by
    -- Apply the convolution property to rewrite the double sum.
    have h_convolution : ∑ g : D5, ∑ h : D5, (starRingEnd ℂ (Representation.χ .golden g) * starRingEnd ℂ (Representation.χ .golden h)) • (rep.toCLM g * rep.toCLM h) = ∑ k : D5, (∑ g : D5, starRingEnd ℂ (Representation.χ .golden g) * starRingEnd ℂ (Representation.χ .golden (g⁻¹ * k))) • rep.toCLM k := by
      have h_convolution : ∀ g : D5, ∑ h : D5, (starRingEnd ℂ (Representation.χ .golden g) * starRingEnd ℂ (Representation.χ .golden h)) • (rep.toCLM g * rep.toCLM h) = ∑ k : D5, (starRingEnd ℂ (Representation.χ .golden g) * starRingEnd ℂ (Representation.χ .golden (g⁻¹ * k))) • rep.toCLM k := by
        intro g;
        refine' Finset.sum_bij ( fun h _ => g * h ) _ _ _ _ <;> simp +decide;
        · exact fun b => ⟨ g⁻¹ * b, mul_inv_cancel_left g b ⟩;
        · intro a;
          exact ContinuousLinearMap.ext fun x => by simp +decide [ UnitaryRep.toCLM ] ;
      rw [ Finset.sum_congr rfl fun g _ => h_convolution g, Finset.sum_comm ];
      simp +decide only [sum_smul];
    -- Apply the convolution property to rewrite the inner sum.
    have h_inner_sum : ∀ k : D5, ∑ g : D5, starRingEnd ℂ (Representation.χ .golden g) * starRingEnd ℂ (Representation.χ .golden (g⁻¹ * k)) = 5 * starRingEnd ℂ (Representation.χ .golden k) := by
      have h_inner_sum : ∀ k : D5, ∑ g : D5, (Representation.χ .golden g) * (Representation.χ .golden (g⁻¹ * k)) = 5 * (Representation.χ .golden k) := by
        exact?;
      exact fun k => by simpa [ mul_comm ] using congr_arg Star.star ( h_inner_sum k ) ;
    simp_all +decide [ Finset.smul_sum, smul_smul ];
  convert congr_arg ( fun x : H →L[ℂ] H => ( 2 / 10 : ℂ ) • ( 2 / 10 : ℂ ) • x ) h_convolution using 1 <;> norm_num [ isotypicProjector ] ; ring;
  · simp +decide [ Finset.sum_mul _ _ _, Finset.mul_sum, Finset.sum_smul, smul_smul, mul_assoc, mul_comm, mul_left_comm, D5.IrrepIndex.dim ];
    norm_num [ ← mul_assoc, ← smul_assoc ];
  · norm_num [ ← smul_assoc, D5.IrrepIndex.dim ]

theorem Representation.golden_on_reflection (i : Fin 5) : 
    Representation.χ .golden (DihedralGroup.sr i) = 0 := by
  simp [Representation.χ, D5.toConjClass, Representation.character]

theorem Representation.conjugate_on_reflection (i : Fin 5) : 
    Representation.χ .conjugate (DihedralGroup.sr i) = 0 := by
  simp [Representation.χ, D5.toConjClass, Representation.character]

theorem Representation.convolution_orthog_golden_conjugate_reflection (i : ZMod 5) :
    ∑ g : D5, conj (Representation.χ .golden g) * conj (Representation.χ .conjugate (g⁻¹ * DihedralGroup.sr i)) = 0 := by
      unfold Representation.χ;
      unfold Representation.character;
      rw [ show D5.IrrepIndex.golden = D5.IrrepIndex.golden from rfl ] ; ( ( erw [ Finset.sum_eq_zero ] ; intros ; simp +decide ; ) );
      cases ‹D5› <;> simp +decide [ D5.toConjClass ]



