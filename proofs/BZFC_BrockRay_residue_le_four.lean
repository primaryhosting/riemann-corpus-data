theorem Representation.omega_abs : ‖ω‖ = 1 := by
  unfold ω
  rw [Complex.norm_exp]
  have : (2 * π * I / 5).re = 0 := by
    rw [div_eq_mul_inv, mul_assoc, mul_assoc]
    simp [Complex.mul_re, Complex.I_re, Complex.I_im]
  rw [this, Real.exp_zero]

