/-- Self-adjoint unbounded operator. -/
structure SelfAdjointUnbounded (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  A : LinearPMap ℂ H H
  selfAdjoint : A.adjoint = A

open scoped BigOperators Real ComplexConjugate TensorProduct
open Complex Finset MeasureTheory

/-- Hecke operator family. -/
structure HeckeOperatorFamily (ι : Type*) (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  T : ι → (H →L[ℂ] H)
  selfAdjoint : ∀ i, IsSelfAdjoint (T i)
  commute : ∀ i j, Commute (T i) (T j)

def IsTrivialZetaZero (s : ℂ) : Prop :=
  ∃ n : ℕ, s = -((2 : ℂ) * (n + 1 : ℕ))

def brockianSpiral (k α : ℝ) (t : ℝ) : ℂ :=
  ((k * t : ℝ) : ℂ) * exp (2 * π * I * ((Real.rpow t α : ℝ) : ℂ))

def BrockianSpiral.primeWeight (p : ℕ) : ℝ := Real.log p / p

structure BrockianSystem where
  SB : Type
  prime : Set SB
  rank : ℕ
  dimH0 : ℕ
  unitIso : Prop
  transformEquiv : Prop
  multiplicity : SB → ℕ

def BrockianSystem.IsPrime (sys : BrockianSystem) (σ : sys.SB) : Prop := σ ∈ sys.prime

class B12 (sys : BrockianSystem) : Prop where
  rank_pos : 1 ≤ sys.rank

class B3 (sys : BrockianSystem) : Prop where
  dim_ge_rank : sys.rank ≤ sys.dimH0

class B4 (sys : BrockianSystem) : Prop where
  dim_eq_one : sys.dimH0 = 1

class B0 (sys : BrockianSystem) : Prop where
  unitIso_of_rank_one : sys.rank = 1 → sys.unitIso
  equiv_of_unitIso : sys.unitIso → sys.transformEquiv
  multiplicity_one_of_unitIso : sys.unitIso → 
    ∀ σ ∈ sys.prime, sys.multiplicity σ = 1

theorem brockian_multiplicity_one (sys : BrockianSystem)
    [B0 sys] [B12 sys] [B3 sys] [B4 sys] :
    sys.transformEquiv ∧ (∀ σ ∈ sys.prime, sys.multiplicity σ = 1) := by
  have h_rank_le_dim : sys.rank ≤ sys.dimH0 := B3.dim_ge_rank
  have h_dim_eq_one : sys.dimH0 = 1 := B4.dim_eq_one
  have h_rank_le_one : sys.rank ≤ 1 := by simpa [h_dim_eq_one] using h_rank_le_dim
  have h_one_le_rank : 1 ≤ sys.rank := B12.rank_pos
  -- THE CLAMP: 1 ≤ rank ≤ 1 ⟹ rank = 1
  have h_rank_eq_one : sys.rank = 1 := Nat.le_antisymm h_rank_le_one h_one_le_rank
  have h_unit : sys.unitIso := B0.unitIso_of_rank_one h_rank_eq_one
  have h_equiv : sys.transformEquiv := B0.equiv_of_unitIso h_unit
  have h_mult : ∀ σ ∈ sys.prime, sys.multiplicity σ = 1 :=
    B0.multiplicity_one_of_unitIso h_unit
  exact ⟨h_equiv, h_mult⟩

/-- Atkin-Lehner involution. -/
structure AtkinLehnerInvolution (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  W : H ≃ₗᵢ[ℂ] H
  involutive : W.trans W = LinearIsometryEquiv.refl ℂ H

/-- Level 5 covering data. -/
structure Level5CoverData (H5 H0 : Type*) 
    [NormedAddCommGroup H5] [InnerProductSpace ℂ H5] [CompleteSpace H5]
    [NormedAddCommGroup H0] [InnerProductSpace ℂ H0] [CompleteSpace H0] where
  rep : UnitaryRep D5 H5
  proj : H5 →L[ℂ] H0
  proj_invariant : ∀ g : D5, proj.comp (rep.toCLM g) = proj

theorem UnitaryRep.preserves_inner {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (rep : UnitaryRep G H) (g : G) (x y : H) :
    inner (𝕜 := ℂ) (rep.ρ g x) (rep.ρ g y) = inner (𝕜 := ℂ) x y :=
  (rep.ρ g).inner_map_map x y

theorem selfAdjoint_spectrum_real {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] {T : H →L[ℂ] H} (hT : IsSelfAdjoint T) :
    ∀ mu : ℂ, mu ∈ spectrum ℂ T → mu.im = 0 := by
  exact?

def BrockianSpiral.gaussianKernel (ε : ℝ) (z w : ℂ) : ℝ :=
  Real.exp (-(‖z - w‖)^2 / ε^2)

#check BZFC.BrockRay.ofNat

theorem Representation.character_is_real (irrep : D5.IrrepIndex) (c : D5.ConjClass) :
    (Representation.character irrep c).im = 0 := by
      -- By definition of Representation.character, the character values are real for all conjugacy classes.
      cases irrep <;> cases c <;> simp [Representation.character]

theorem Representation.convolution_orthog_golden_conjugate (k : D5) :
    ∑ g : D5, conj (Representation.χ .golden g) * conj (Representation.χ .conjugate (g⁻¹ * k)) = 0 := by
      -- Since the characters are real, their conjugates are just the characters themselves.
      have h_real : ∀ g : D5, (starRingEnd ℂ (Representation.χ .golden g)) = (Representation.χ .golden g) ∧ (starRingEnd ℂ (Representation.χ .conjugate g)) = (Representation.χ .conjugate g) := by
        -- Since the characters are real, their conjugates are equal to themselves.
        intros g
        simp [Representation.χ, Representation.character];
        cases h : g.toConjClass <;> simp +decide [ h ];
        norm_num [ Complex.ext_iff ];
      simp_all +decide [ Representation.χ ];
      fin_cases k <;> simp +decide [ Representation.character ];
      all_goals norm_cast;
      all_goals erw [ Finset.sum_congr rfl fun x hx => by erw [ show D5.toConjClass = fun g => if g = DihedralGroup.r 0 then D5.ConjClass.identity else if g = DihedralGroup.r 1 then D5.ConjClass.rot1 else if g = DihedralGroup.r 2 then D5.ConjClass.rot2 else if g = DihedralGroup.r 3 then D5.ConjClass.rot2 else if g = DihedralGroup.r 4 then D5.ConjClass.rot1 else D5.ConjClass.reflection from by funext g; fin_cases g <;> rfl ] ] ; simp +decide [ Fin.sum_univ_succ ] ;
      all_goals erw [ Finset.sum_eq_multiset_sum ] ; norm_cast;
      all_goals erw [ Multiset.map_coe ] ; simp +decide [ Finset.univ ] ;
      all_goals simp +decide [ List.finRange ] ;
      · norm_cast; ring; norm_num [ φ ] ; ring;
      · ring;
        norm_cast; rw [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring_nf; norm_num;
      · norm_num [ Complex.ext_iff, sq ];
        rw [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring ; norm_num;
      · norm_num [ Complex.ext_iff, sq ];
        rw [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring ; norm_num;
      · norm_num [ Complex.ext_iff, sq ];
        rw [ show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring ; norm_num

theorem BrockianSpiral.continuous (k α : ℝ) : Continuous (brockianSpiral k α) := by
  -- The function $t \mapsto (k * t : ℝ) * \exp(2 * \pi * I * (Real.rpow t α : ℝ))$ is continuous because it is a product of continuous functions.
  have h_cont : Continuous (fun t : ℝ => (k * t : ℝ) * Complex.exp (2 * Real.pi * Complex.I * (Real.rpow t α : ℝ))) := by
    by_cases h : α = 0 <;> simp_all +decide [ Real.rpow_def_of_pos ];
    · continuity;
    · refine' continuous_iff_continuousAt.mpr fun t => _;
      by_cases ht : t = 0 <;> simp_all +decide [ ContinuousAt ];
      · refine' squeeze_zero_norm _ _;
        exacts [ fun n => |k| * |n|, fun n => by simp +decide [ Complex.norm_exp ], Continuous.tendsto' ( by continuity ) _ _ ( by norm_num ) ];
      · exact Filter.Tendsto.mul ( Filter.Tendsto.mul tendsto_const_nhds ( Complex.continuous_ofReal.continuousAt ) ) ( Complex.continuous_exp.continuousAt.comp <| Filter.Tendsto.mul tendsto_const_nhds <| Complex.continuous_ofReal.continuousAt.comp <| Filter.Tendsto.rpow ( Filter.tendsto_id ) tendsto_const_nhds <| by aesop );
  -- Since the function brockianSpiral is defined as the product of two continuous functions, it is continuous.
  convert h_cont using 1

def BrockianSpiral.potential (k α ε : ℝ) (z : ℂ) : ℝ :=
  ∑' p : ℕ, if Nat.Prime p then 
    BrockianSpiral.primeWeight p * BrockianSpiral.gaussianKernel ε z (brockianSpiral k α p)
  else 0

def BrockianSpiral.potentialTrunc (k α ε : ℝ) (N : ℕ) (z : ℂ) : ℝ :=
  ∑ p ∈ range N, if Nat.Prime p then
    BrockianSpiral.primeWeight p * BrockianSpiral.gaussianKernel ε z (brockianSpiral k α p)
  else 0

structure GrandBrockianSystem where
  (H0 : Type*)
  [H0_add : NormedAddCommGroup H0]
  [H0_ip : InnerProductSpace ℂ H0]
  [H0_complete : CompleteSpace H0]
  
  (Δ0 : SelfAdjointUnbounded H0)
  
  (ι : Type)
  (Hecke : HeckeOperatorFamily ι H0)
  (W5 : AtkinLehnerInvolution H0)
  
  (Hecke_commutes_Δ0 : Prop)
  (W5_commutes_Δ0 : Prop)
  (W5_commutes_Hecke : Prop)
  
  (H5 : Type*)
  [H5_add : NormedAddCommGroup H5]
  [H5_ip : InnerProductSpace ℂ H5]
  [H5_complete : CompleteSpace H5]
  
  (cover : Level5CoverData H5 H0)
  
  (HB : Type*)
  [HB_add : NormedAddCommGroup HB]
  [HB_ip : InnerProductSpace ℂ HB]
  [HB_complete : CompleteSpace HB]
  
  (B : SelfAdjointUnbounded HB)
  
  (traceFormula : Prop)
  (spectralDeterminant : Prop)

def GrandBrockianSystem.isComplete (S : GrandBrockianSystem) : Prop :=
  S.Hecke_commutes_Δ0 ∧ S.W5_commutes_Δ0 ∧ S.W5_commutes_Hecke

def GrandBrockianSystem.provesRH (S : GrandBrockianSystem) : Prop := S.spectralDeterminant ∧ S.traceFormula

