/-- The modulus -/
def q : ℕ := 5

/-- Active rays (coprime to q) -/
def ActiveRay := Fin 4

/-- Map from active rays to residues {1,2,3,4} -/
def activeRayToResidue (j : ActiveRay) : Fin q :=
  ⟨j.val + 1, by
    have h_active_ray : ∀ j : Fin 4, j.val + 1 < 5 := by decide
    convert h_active_ray j⟩

/-- Ray assignment for natural number -/
def ray (n : ℕ) : Fin q := ⟨n % q, by exact Nat.mod_lt n (by decide)⟩

/-- PROVEN THEOREM: Ray 0 singularity -/
theorem ray_zero_singularity (p : ℕ) (hp : p.Prime) (h_large : p > 5) :
    ray p ≠ ⟨0, by decide⟩ := by
  have h_not_div : ¬(5 ∣ p) := by
    rw [hp.dvd_iff_eq] <;> linarith
  exact fun h => h_not_div <| Nat.dvd_of_mod_eq_zero <| by 
    simpa [Fin.ext_iff] using congr_arg Fin.val h

/-- PROVEN: Twin prime constraint -/
theorem twin_constraint (p : ℕ) (hp : p.Prime) (hp2 : (p+2).Prime) (h_large : p > 3) :
    ray (p+2) = ⟨((ray p).val + 2) % q, by exact Nat.mod_lt _ (by decide)⟩ := by
  exact Eq.symm (by exact Fin.ext (by unfold ray; norm_num [Nat.add_mod]))

/-- PROVEN: Forbidden transition -/
theorem forbidden_transition :
    ¬∃ p : ℕ, p.Prime ∧ (p+2).Prime ∧ p > 5 ∧ ray p = ⟨3, by decide +revert⟩ := by
  exact fun h => by 
    rcases h with ⟨p, hp₁, hp₂, hp₃, hp₄⟩
    erw [show ray p = ⟨p % 5, Nat.mod_lt p (by decide)⟩ from rfl] at hp₄
    norm_num at hp₄
    have := Nat.dvd_of_mod_eq_zero (show (p + 2) % 5 = 0 from by 
      norm_num [Nat.add_mod, show p % 5 = 3 from hp₄])
    rw [hp₂.dvd_iff_eq] at this <;> linarith

/-- Allowed twin transitions -/
inductive AllowedTwinTransition : Fin q → Fin q → Prop
  | one_to_three : AllowedTwinTransition ⟨1, by decide⟩ ⟨3, by decide +revert⟩
  | two_to_four  : AllowedTwinTransition ⟨2, by decide⟩ ⟨4, by decide⟩
  | four_to_one  : AllowedTwinTransition ⟨4, by decide⟩ ⟨1, by decide⟩

/-- THEOREM: All twins satisfy allowed transitions -/
theorem twins_follow_allowed_transitions (p : ℕ) (hp : p.Prime) (hp2 : (p+2).Prime)
    (h_large : p > 5) :
    AllowedTwinTransition (ray p) (ray (p+2)) := by
  obtain ⟨e, he⟩ : ∃ e : Fin q, ray p = e := by exact ⟨_, rfl⟩
  have h_ray_p2 : ray (p + 2) = ⟨((e.val + 2) % q), by 
    exact Nat.mod_lt _ (by decide)⟩ := by unfold ray at *; aesop
  generalize_proofs at *
  fin_cases e <;> simp_all +decide
  · exact False.elim <| by 
      have := ray_zero_singularity p hp h_large; aesop
  · exact AllowedTwinTransition.one_to_three
  · exact AllowedTwinTransition.two_to_four
  · exact absurd (forbidden_transition ⟨p, hp, hp2, h_large, he⟩) (by tauto)
  · exact AllowedTwinTransition.four_to_one

/-- Rotation action on active rays (cyclic permutation) -/
def rotate (j : ActiveRay) : ActiveRay := 
  ⟨(j.val + 1) % 4, by exact Nat.mod_lt _ (by decide)⟩

/-- Reflection action on active rays -/
def reflect (j : ActiveRay) : ActiveRay :=
  ⟨(4 - j.val) % 4, by apply Nat.mod_lt _ (by decide)⟩

/-- PROVEN: Rotation has order 4 -/
theorem rotate_order_4 (j : ActiveRay) :
    rotate (rotate (rotate (rotate j))) = j := by
  unfold rotate
  rcases j with ⟨_ | _ | _ | _ | j⟩ <;> norm_num
  trivial

/-- PROVEN: Reflection is involution -/
theorem reflect_involution (j : ActiveRay) :
    reflect (reflect j) = j := by
  rcases j with ⟨_ | _ | _ | _ | j⟩ <;> trivial

/-- Weight function -/
def weight (p : ℕ) : ℝ := 1 / Real.sqrt p

/-- Dirichlet character χ_j mod 5 -/
def dirichlet_char (j : ActiveRay) (n : ℕ) : ℂ :=
  let residue := activeRayToResidue j
  Complex.exp (2 * Real.pi * I * (j.val + 1 : ℂ) * (n : ℂ) / q)

/-- CORRECTED DEFINITION: Unnormalized sum -/
def F (j : ActiveRay) (X : ℕ) : ℂ :=
  ∑ p ∈ (range X).filter Nat.Prime, 
    if p % q = 0 then 0 else (dirichlet_char j p : ℂ) * (weight p : ℂ)

/-- THEOREM: F_j converges as X → ∞ (Statement) -/
def F_converges_stmt (j : ActiveRay) : Prop :=
  ∃ L : ℂ, Filter.Tendsto (F j) Filter.atTop (nhds L)

/-- Limiting value of F_j -/
noncomputable def F_infinity (j : ActiveRay) : ℂ :=
  Classical.epsilon (fun L => Filter.Tendsto (F j) Filter.atTop (nhds L))

/-- Ray 0 (principal) -/
def ray0 : ActiveRay := ⟨0, by decide⟩

/-- Absolute value of a complex number (norm) -/
def Complex.abs (z : ℂ) : ℝ := ‖z‖

/-- PROPERTY: |F_j| is bounded -/
theorem F_magnitude_bounded (j : ActiveRay) (X : ℕ) :
    Complex.abs (F j X) ≤ X := by
  refine' le_trans (norm_sum_le _ _) _
  refine' le_trans (Finset.sum_le_sum _) _
  exact fun i => if i % q = 0 then 0 else 1 / Real.sqrt i
  · intro i hi; split_ifs <;> norm_num [Complex.norm_exp]
    unfold dirichlet_char weight; norm_num [Complex.norm_exp]; ring_nf
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
  · refine' le_trans (Finset.sum_le_sum fun i hi => _) _
    exact fun i => 1
    · split_ifs <;> norm_num
      exact inv_le_one_of_one_le₀ <| Real.le_sqrt_of_sq_le <| 
        mod_cast Nat.Prime.pos <| Finset.mem_filter.mp hi |>.2
    · norm_num [Finset.sum_filter]
      exact le_trans (Finset.card_filter_le _ _) (by simpa)

/-- Count transitions from active ray j to k -/
def count_transitions (j k : ActiveRay) (X : ℕ) : ℕ :=
  let primes := ((range X).filter Nat.Prime).sort (· ≤ ·)
  let pairs := primes.zip primes.tail
  (pairs.filter (fun (p1, p2) => 
    ray p1 = activeRayToResidue j ∧ ray p2 = activeRayToResidue k)).length

instance : Fintype ActiveRay := inferInstanceAs (Fintype (Fin 4))

/-- CORRECTED: 4×4 Markov matrix on active rays only -/
def M (j k : ActiveRay) (X : ℕ) : ℝ :=
  let trans_from_j := ∑ k' : ActiveRay, count_transitions j k' X
  if trans_from_j > 0 then
    (count_transitions j k X : ℝ) / trans_from_j
  else 0

/-- PROVEN: M is row-stochastic (conditional on transitions existing) -/
theorem M_row_stochastic (j : ActiveRay) (X : ℕ) 
    (h : ∑ k' : ActiveRay, count_transitions j k' X > 0) :
    ∑ k : ActiveRay, M j k X = 1 := by
  unfold M
  simp_all +decide [← Finset.sum_div _ _ _]
  exact div_self <| ne_of_gt <| mod_cast h

/-- PROVEN: M has Perron-Frobenius eigenvalue 1 (conditional on stochasticity) -/
theorem M_perron_frobenius (X : ℕ) (h_stoch : ∀ j, ∑ k, M j k X = 1) :
  ∃ v : ActiveRay → ℝ, (∀ k, v k ≥ 0) ∧ (∑ k, v k = 1) ∧
    (∀ j, ∑ k, M j k X * v k = v j) := by
  use fun _ => 1 / 4
  norm_num [← Finset.sum_mul _ _ _, h_stoch]

