theorem brockian_char_unitary (n : ℕ) (hn : n ≠ 0) :
    ‖brockianChar n‖ = 1 := by
      -- Since $n \neq 0$, we can apply the definition of `brockianChar` to get $\|brockianChar n\| = \|\exp(i \phi \log n)\|$.
      simp [brockianChar, hn];
      -- The norm of the exponential of a purely imaginary number is 1.
      simp [Complex.norm_exp];
      norm_num [ Complex.log_im ]

example : ‖brockianChar 17‖ = 1 := 
  brockian_char_unitary 17 (by norm_num)

