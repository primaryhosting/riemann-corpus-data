lemma riemann_zeros_in_strip (s : ℂ) (h_zero : riemannZeta s = 0) (h_non_neg : 0 ≤ s.re) :
    CriticalStrip s := by
  unfold CriticalStrip
  constructor
  · -- s.re > 0
    by_contra h_not_pos
    push_neg at h_not_pos
    have h_re_zero : s.re = 0 := le_antisymm h_not_pos h_non_neg
    -- ζ(s) ≠ 0 when Re(s) = 0
    -- Since the Riemann zeta function has no zeros on the imaginary axis, this leads to a contradiction.
    have h_no_zeros_imaginary_axis : ∀ s : ℂ, s.re = 0 → riemannZeta s ≠ 0 := by
      intro s hs;
      by_cases hs_zero : s = 0;
      · rw [ hs_zero, riemannZeta_zero ] ; norm_num;
      · -- Since $s \neq 0$ and $s.re = 0$, we can use the fact that the Riemann zeta function has no zeros on the imaginary axis.
        have h_no_zeros_imaginary_axis : ∀ s : ℂ, s.re = 0 → s ≠ 0 → riemannZeta s ≠ 0 := by
          intros s hs hs_zero;
          have := @riemannZeta_ne_zero_of_one_le_re;
          contrapose! this;
          have := @riemannZeta_one_sub s; aesop;
        exact h_no_zeros_imaginary_axis s hs hs_zero;
    exact h_no_zeros_imaginary_axis s h_re_zero h_zero
  · -- s.re < 1
    by_contra h_not_lt_one
    push_neg at h_not_lt_one
    have : riemannZeta s ≠ 0 := riemannZeta_ne_zero_of_one_le_re h_not_lt_one
    contradiction

