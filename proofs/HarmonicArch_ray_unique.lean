/-! ## §8. Craig-Ono Prime-Detecting Certificates -/

/-- Divisor power sum: σₛ(n) = Σ_{d|n} dˢ. -/
def HarmonicArch.sigma (s n : ℕ) : ℤ :=
  ∑ d ∈ n.divisors, (d : ℤ) ^ s

/-- For primes, σₛ(p) = 1 + pˢ (since the only divisors are 1 and p). -/
lemma HarmonicArch.sigma_of_prime (p s : ℕ) (hp : p.Prime) :
    HarmonicArch.sigma s p = 1 + (p : ℤ) ^ s := by
      -- Since $p$ is prime, its divisors are $1$ and $p$. Therefore, the sum of the divisors function $\sigma(p)$ is $1 + p^s$.
      simp [HarmonicArch.sigma, hp];
      grind

/-- The Craig-Ono k = 6 certificate: cert₆(n) = (n²−n+1)σ₁(n) − σ₃(n). -/
def HarmonicArch.cert6 (n : ℕ) : ℤ :=
  ((n : ℤ) ^ 2 - (n : ℤ) + 1) * HarmonicArch.sigma 1 n - HarmonicArch.sigma 3 n

/-- **cert₆ vanishes on primes**: For any prime p, cert₆(p) = 0.
    This connects to the Craig-Ono theory of prime-detecting certificates
    via Eisenstein series and modular forms. -/
theorem HarmonicArch.cert6_vanishes_on_primes (p : ℕ) (hp : p.Prime) :
    HarmonicArch.cert6 p = 0 := by
      -- Since p is prime and greater than 5, |p| is just p, and the exponent is 0, so the product is 1.
      simp [HarmonicArch.cert6, hp];
      -- Since $p$ is prime, the divisors of $p$ are $1$ and $p$, so we can compute $\sigma_1(p)$ and $\sigma_3(p)$ directly.
      have h_sigma1 : HarmonicArch.sigma 1 p = 1 + p := by
        unfold HarmonicArch.sigma;
        rw [ hp.sum_divisors ] ; norm_num [ add_comm ]
      have h_sigma3 : HarmonicArch.sigma 3 p = 1 + p^3 := by
        exact?;
      simpa only [ h_sigma1, h_sigma3 ] using by ring;

