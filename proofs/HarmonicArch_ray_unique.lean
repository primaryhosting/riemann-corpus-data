      ring

/-- The primitive 5th root of unity ω = e^{2πi/5}. -/
def HarmonicArch.ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

/-- **ω is a 5th root of unity**: ω⁵ = 1. -/
theorem HarmonicArch.omega_fifth_root : HarmonicArch.ω ^ 5 = 1 := by
  -- By definition of exponentiation, we know that $(e^{2\pi i / 5})^5 = e^{2\pi i} = 1$.
  norm_num [HarmonicArch.ω];
  -- By definition of exponentiation, we know that $(e^{2\pi i / 5})^5 = e^{2\pi i} = 1$ using Euler's formula.
  rw [← Complex.exp_nat_mul, mul_comm]
  simp [Complex.exp_nat_mul]

/-! ## §10. Fibonacci and Pisano Period -/

/-- The Pisano period of the Fibonacci sequence mod 5. -/
def HarmonicArch.pisanoPeriod : ℕ := 20

/-! ## §11. Metallic Means -/

/-- The n-th metallic mean: ψₙ = (n + √(n² + 4))/2. -/
def HarmonicArch.metallicMean (n : ℕ) : ℝ := (n + Real.sqrt (n ^ 2 + 4)) / 2

/-- **Metallic means satisfy their defining equation**: ψₙ² = n·ψₙ + 1. -/
theorem HarmonicArch.metallic_mean_equation (n : ℕ) :
    (HarmonicArch.metallicMean n) ^ 2 = n * HarmonicArch.metallicMean n + 1 := by
      -- By definition of the metallic mean, we know that φ_n^2 = n * φ_n + 1.
      have h_metallic_mean : ∀ n : ℕ, HarmonicArch.metallicMean n = (n + Real.sqrt (n^2 + 4)) / 2 := by
        -- By definition of the metallic mean, we know that it satisfies the quadratic equation $x^2 - nx - 1 = 0$.
        intro n
        simp [HarmonicArch.metallicMean];
      -- Substitute the definition of the metallic mean into the equation.
      rw [h_metallic_mean n];
      -- Expanding the left-hand side:
      field_simp
      ring;
      -- By simplifying, we can see that both sides of the equation are equal.
      rw [Real.sq_sqrt (by positivity)]
      ring

/-- **φ is the first metallic mean**: ψ₁ = φ. -/
theorem HarmonicArch.phi_is_first_metallic :
    HarmonicArch.metallicMean 1 = HarmonicArch.φ := by
      -- By definition of metallic mean, we have ρ_n = (n + sqrt(n^2 + 4)) / 2.
      simp [HarmonicArch.metallicMean, HarmonicArch.φ];
      -- Simplify the expression inside the square root.
      norm_num
