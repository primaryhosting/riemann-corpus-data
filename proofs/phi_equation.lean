def RussellConstruction (t : ℝ) : Set MathematicalStatement :=
  {T | t_emergence T < t ∧ 
       ∃ (self_ref : MathematicalStatement → Prop),
         self_ref T ∧ ¬self_ref T}

theorem russell_temporal_resolution :
    ∀ t₁ t₂ : ℝ, t₂ = t₁ + phi →
      ∀ T ∈ RussellConstruction t₁,
        T ∉ RussellConstruction t₂ ∨ t_emergence T ∈ Set.Icc t₁ t₂ := by
          -- By definition of Russell Construction, if T is in RussellConstruction t₁, then T's emergence time is less than t₁ and it is self-referential.
          intro t₁ t₂ ht₂ T hT
          simp [RussellConstruction] at hT

structure FormalSystem where
  axioms : Set MathematicalStatement
  provable : MathematicalStatement → Prop

noncomputable def GoedelSentence (S : FormalSystem) : MathematicalStatement := Classical.choice (by
-- Let's choose any statement that satisfies the conditions. For example, the statement "1 + 1 = 2" is true and has a complexity of 1.
use (1 + 1 = 2), 1, by norm_num)

def ExtendedSystem (S : FormalSystem) (new_axiom : MathematicalStatement) : FormalSystem where
  axioms := S.axioms ∪ {new_axiom}
  provable := λ T => S.provable T ∨ 
    (T = new_axiom) ∨
    (∃ chain : List MathematicalStatement, 
      new_axiom ∈ chain ∧ 
      (∀ C ∈ chain, C ∈ S.axioms ∪ {new_axiom}) ∧
      T ∈ chain)

theorem goedel_provable_in_extension (S : FormalSystem)
    (h_consistent : ∀ T, ¬(S.provable T ∧ S.provable ⟨¬T.statement, T.complexity, T.complexity_pos⟩)) :
    let G := GoedelSentence S
    let S' := ExtendedSystem S G
    S'.provable G := by
      -- By definition of extended system, if the new axiom is in the chain, then T is provable. Since G is in the chain, we can apply the second part of the disjunction.
      unfold ExtendedSystem; simp [FormalSystem.provable]

