                     complexity_pos := ContinuumHypothesis.complexity_pos }) := by
                       -- Let's choose any formal system $S'$ that extends $ZFC$ and contains the continuum hypothesis as an axiom.
                       use ⟨∅, fun T => T = ContinuumHypothesis⟩;
                       aesop
                       skip

