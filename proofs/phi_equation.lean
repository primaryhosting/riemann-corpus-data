theorem fibonacci_phi_stable :
    ∀ n : ℕ, n > 0 →
      ∃ c : ℝ, c > 0 ∧ |((_root_.fib (n + 1) : ℝ) / (_root_.fib n : ℝ)) - phi| < c * phi^(-n : ℝ) := by
  intro n hn
  -- The error decays exponentially at rate related to (1-phi)
  -- Since $\phi$ is a positive constant, we can choose $c$ such that $c > \frac{|\phi - \frac{F_{n+1}}{F_n}|}{\phi^{-n}}$.
  use (|(phi - (_root_.fib (n + 1) : ℝ) / (_root_.fib n : ℝ))| / phi^(-n : ℝ)) + 1;
  -- Since $\phi$ is positive, $\phi^{-n}$ is also positive, and thus the division and addition are valid.
  field_simp [phi];
  -- Since $\phi$ is positive, $\phi^{-n}$ is also positive, and thus the division and addition are valid. We can use the fact that $|\phi - \frac{F_{n+1}}{F_n}|$ is non-negative to conclude the proof.
  simp [abs_sub_comm];
  -- Since $\phi$ is positive and $n > 0$, $\phi^n$ is also positive. The absolute value term is non-negative, so adding it to a positive number keeps it positive.
  have h_pos : 0 < phi ^ n := by
    -- Since $\phi$ is positive, we have $\phi^n > 0$ for all $n$.
    have h_phi_pos : 0 < phi := by
      exact div_pos ( add_pos zero_lt_one ( Real.sqrt_pos.mpr ( by norm_num ) ) ) zero_lt_two
    exact pow_pos h_phi_pos n;
  exact ⟨ add_pos_of_nonneg_of_pos ( abs_nonneg _ ) ( inv_pos.mpr h_pos ), h_pos ⟩ -- Requires explicit bounds from Binet

