def PhiOperator (T : MathematicalStatement) : MathematicalStatement where
  statement := T.statement
  complexity := T.complexity + 1
  complexity_pos := Nat.succ_pos T.complexity

def is_phi_stable (T : MathematicalStatement) : Prop :=
  t_emergence (PhiOperator T) = phi * t_emergence T

theorem all_statements_phi_stable (T : MathematicalStatement) :
    is_phi_stable T := by
      -- By definition of $t_emergence$, we have $t_emergence (PhiOperator T) = \phi^{T.complexity + 1}$.
      simp [is_phi_stable, t_emergence];
      -- By definition of exponentiation, we can rewrite the left-hand side as $\phi^{T.complexity + 1}$.
      simp [PhiOperator];
      grind

theorem phi_uniqueness_for_quantization :
    ∀ c : ℝ, c > 1 →
      (∀ n : ℕ, c^(n+1 : ℝ) = c * c^(n : ℝ)) →
      c^2 = c + 1 →
      c = phi := by
        -- By solving the quadratic equation $c^2 - c - 1 = 0$, we find that the solutions are $c = \frac{1 \pm \sqrt{5}}{2}$.
        have h_solutions : ∀ c : ℝ, c^2 = c + 1 → c = (1 + Real.sqrt 5) / 2 ∨ c = (1 - Real.sqrt 5) / 2 := by
          grind;
        -- By solving the quadratic equation $c^2 - c - 1 = 0$, we find that the solutions are $c = \frac{1 \pm \sqrt{5}}{2}$. Since $c > 1$, we must have $c = \frac{1 + \sqrt{5}}{2}$.
        intros c hc h_exp h_eq
        have h_sol : c = (1 + Real.sqrt 5) / 2 ∨ c = (1 - Real.sqrt 5) / 2 := h_solutions c h_eq
        have h_pos : c > 1 := hc
        have h_phi : c = (1 + Real.sqrt 5) / 2 := by
          -- Since $c > 1$, the only valid solution is $c = \frac{1 + \sqrt{5}}{2}$.
          cases h_sol <;> nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]
        exact h_phi.symm ▸ rfl

