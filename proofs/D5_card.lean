    have h_change_order : ∀ k : D5, ∑ x : D5, ∑ x_1 : D5, (starRingEnd ℂ (Representation.χ .golden x_1) * starRingEnd ℂ (Representation.χ .golden x)) • (rep.toCLM x * rep.toCLM x_1) = ∑ k : D5, ∑ x : D5, (starRingEnd ℂ (Representation.χ .golden (x⁻¹ * k)) * starRingEnd ℂ (Representation.χ .golden x)) • rep.toCLM k := by
      intro k
      have h_change_order : ∑ x : D5, ∑ x_1 : D5, (starRingEnd ℂ (Representation.χ .golden x_1) * starRingEnd ℂ (Representation.χ .golden x)) • (rep.toCLM x * rep.toCLM x_1) = ∑ x : D5, ∑ k : D5, (starRingEnd ℂ (Representation.χ .golden (x⁻¹ * k)) * starRingEnd ℂ (Representation.χ .golden x)) • rep.toCLM k := by
        refine' Finset.sum_congr rfl fun x _ => _;
        rw [ ← Equiv.sum_comp ( Equiv.mulLeft x⁻¹ ) ] ; simp +decide [ mul_assoc, mul_left_comm ];
        ext; simp +decide [ mul_assoc, rep.ρ.map_mul ] ;
        simp +decide [ UnitaryRep.toCLM ];
      rw [ h_change_order, Finset.sum_comm ];
    simp_all +decide [ Finset.sum_smul, mul_comm ];
  -- Apply the convolution formula to simplify the inner sum.
  have h_inner : ∀ k : D5, ∑ g : D5, (starRingEnd ℂ) (Representation.χ .golden g) * (starRingEnd ℂ) (Representation.χ .golden (g⁻¹ * k)) = 5 * (starRingEnd ℂ) (Representation.χ .golden k) := by
    intro k; specialize conv k; simp_all +decide [ ← map_mul, ← map_sum ] ;
    simp +decide [ Complex.ext_iff ];
  simp_all +decide [ ← smul_assoc ];
  norm_num [ Finset.smul_sum, smul_smul ] ; ring;
  erw [ show ( D5.IrrepIndex.golden.dim : ℂ ) = 2 by rfl ] ; norm_num ; ring;

/-- All D₅ characters are real-valued. -/
theorem Representation.character_is_real (idx : D5.IrrepIndex) (g : D5) : 
    (Representation.χ idx g).im = 0 := by
  unfold Representation.χ
  cases idx <;> cases D5.toConjClass g <;> simp [Representation.character, φ]

/-- Character value at inverse equals character value. -/
theorem Representation.character_inverse (idx : D5.IrrepIndex) (g : D5) :
    Representation.χ idx g⁻¹ = Representation.χ idx g := by
      unfold Representation.χ;
      -- By definition of conjugacy classes, we know that $g⁻¹.toConjClass = g.toConjClass$ for any $g \in D5$.
      have h_conj_classes : ∀ g : D5, g⁻¹.toConjClass = g.toConjClass := by
        decide +revert;
      rw [ h_conj_classes ]

/-- Sum of character values over the group. -/
lemma Representation.sum_character (idx : D5.IrrepIndex) :
    ∑ g : D5, Representation.χ idx g = if idx = .trivial then 20 else 0 := by
      -- Use the fact that the character of an irreducible representation evaluated at the identity element is equal to the dimension of the representation.
      have h_sum_eq : ∑ g : D5, Representation.χ idx g = ∑ c : D5.ConjClass, (D5.ConjClass.size c : ℂ) * (Representation.character idx c) := by
        -- By definition of conjugacy classes, we can partition the sum over the group into sums over each conjugacy class.
        have h_partition : ∑ g : D5, Representation.character idx (D5.toConjClass g) = ∑ c : D5.ConjClass, ∑ g ∈ Finset.filter (fun g => D5.toConjClass g = c) (Finset.univ : Finset D5), Representation.character idx c := by
          simp +decide only [sum_filter];
          rw [ Finset.sum_comm, Finset.sum_congr rfl ] ; aesop;
        aesop;
      rw [ h_sum_eq ] ; rcases idx with ( _ | _ | _ | _ ) <;> norm_num [ D5.ConjClass.size ];
      · erw [ Finset.sum_congr rfl fun x hx => by erw [ show Representation.character D5.IrrepIndex.trivial x = 2 by fin_cases x <;> rfl ] ] ; norm_cast;
      · erw [ Representation.sum_D5ConjClass ] ; norm_num [ Representation.character ];
        decide;
      · rw [ Representation.sum_D5ConjClass ] ; norm_num [ Representation.character ] ; ring;
        aesop;
      · rw [ show ( Finset.univ : Finset D5.ConjClass ) = { D5.ConjClass.identity, D5.ConjClass.rot1, D5.ConjClass.rot2, D5.ConjClass.reflection } by rfl ] ; simp +decide [ Finset.sum_pair, Finset.sum_singleton ];
        unfold Representation.character; norm_num [ Finset.sum_range_succ, Finset.sum_range_zero ] ; ring;

/-- Corrected character table for D₅. -/
def Representation.character_new : D5.IrrepIndex → D5.ConjClass → ℂ
  | .trivial,   .identity   => 1
  | .trivial,   .rot1       => 1
  | .trivial,   .rot2       => 1
  | .trivial,   .reflection => 1
  | .sign,      .identity   => 1
  | .sign,      .rot1       => 1
  | .sign,      .rot2       => 1
  | .sign,      .reflection => -1
  | .golden,    .identity   => 2
  | .golden,    .rot1       => (φ - 1 : ℝ)
  | .golden,    .rot2       => (-φ : ℝ)
  | .golden,    .reflection => 0
  | .conjugate, .identity   => 2
  | .conjugate, .rot1       => (-φ : ℝ)
  | .conjugate, .rot2       => (φ - 1 : ℝ)
  | .conjugate, .reflection => 0

/-- Corrected character evaluated at a group element. -/
def Representation.χ_new (idx : D5.IrrepIndex) (g : D5) : ℂ := 
  Representation.character_new idx (D5.toConjClass g)

/-- All new D₅ characters are real-valued. -/
theorem Representation.character_new_is_real (idx : D5.IrrepIndex) (g : D5) : 
    (Representation.χ_new idx g).im = 0 := by
  unfold Representation.χ_new
  cases idx <;> cases D5.toConjClass g <;> simp [Representation.character_new, φ]

/-- The convolution of two characters. -/
def Representation.convolution (idx₁ idx₂ : D5.IrrepIndex) (k : D5) : ℂ :=
  ∑ g : D5, Representation.χ idx₁ g * Representation.χ idx₂ (g⁻¹ * k)

theorem Representation.convolution_orthog_trivial (idx₂ : D5.IrrepIndex) (h : .trivial ≠ idx₂) (k : D5) :
    Representation.convolution .trivial idx₂ k = 0 := by
      -- By definition of convolution, we have:
      simp [Representation.convolution];
      have h_char_sum : ∑ g : D5, Representation.character idx₂ (g⁻¹ * k).toConjClass = 0 := by
        have h_sum : ∑ g : D5, Representation.character idx₂ (g⁻¹ * k).toConjClass = ∑ g : D5, Representation.character idx₂ g.toConjClass := by
          apply Finset.sum_bij (fun g _ => g⁻¹ * k);
          · simp;
          · aesop;
          · exact fun b _ => ⟨ k * b⁻¹, Finset.mem_univ _, by group ⟩;
          · exact fun _ _ => rfl;
        have := Representation.sum_character idx₂; aesop;
      convert congr_arg ( fun x => 2 * x ) h_char_sum using 1;
      · exact?;
      · norm_num
