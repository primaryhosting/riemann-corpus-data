  have h_unitary : ∀ x y : H, inner ℂ (rep.toCLM g x) y = inner ℂ x (rep.toCLM g⁻¹ y) := by
    intro x y;
    have := rep.preserves_inner g x ( ( rep.ρ g⁻¹ ) y );
    convert this using 2;
    simp +decide [ ← map_mul ];
  ext x y;
  refine' ext_inner_right ℂ _;
  simp +decide [ Star.star, ContinuousLinearMap.adjoint_inner_left, h_unitary ];
  intro v; rw [ ← inner_conj_symm, h_unitary ] ; simp +decide [ inner_conj_symm ] ;

