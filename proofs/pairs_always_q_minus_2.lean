theorem gap_independence (q : ℕ) [Fact (Nat.Prime q)] (k : ℕ) [NeZero k] (g₁ g₂ : ℕ → ℕ)
    (hga₁ : AdmissibleTuple q g₁ k) (hga₂ : AdmissibleTuple q g₂ k)
    (h_same_pattern : ∀ i j : Fin k, g₁ i ≡ g₁ j [MOD q] ↔ g₂ i ≡ g₂ j [MOD q]) :
    (PrincipalKTuples q g₁ k).card = (PrincipalKTuples q g₂ k).card := by
      rw [ card_principal_eq_q_sub_image, card_principal_eq_q_sub_image ];
      · -- Since the equivalence relations are the same, the number of equivalence classes is the same, hence the cardinalities of the images are equal.
        have h_card_eq : (Finset.image (fun i : Fin k => (g₁ i) % q) Finset.univ).card = (Finset.image (fun i : Fin k => (g₂ i) % q) Finset.univ).card := by
          have h_equiv_classes : ∀ (f : Fin k → ℕ), (∀ i j : Fin k, (f i ≡ f j [MOD q]) ↔ (g₁ i ≡ g₁ j [MOD q])) → (Finset.image (fun i : Fin k => f i % q) Finset.univ).card = (Finset.image (fun i : Fin k => (g₁ i) % q) Finset.univ).card := by
            intros f hf;
            have h_equiv_classes : Finset.card (Finset.image (fun i : Fin k => (f i) % q) Finset.univ) = Finset.card (Finset.image (fun i : Fin k => (g₁ i) % q) Finset.univ) := by
              have h_equiv_classes : ∀ (s : Finset (Fin k)), (Finset.image (fun i : Fin k => (f i) % q) s).card = (Finset.image (fun i : Fin k => (g₁ i) % q) s).card := by
                intros s
                induction' s using Finset.induction with i s hi ih;
                · norm_num;
                · by_cases hi' : ∃ j ∈ s, g₁ j ≡ g₁ i [MOD q] <;> simp_all +decide [ Finset.image_insert, Nat.ModEq ]
              exact h_equiv_classes Finset.univ;
            exact h_equiv_classes
          rw [ h_equiv_classes ( fun i => g₂ i ) fun i j => by specialize h_same_pattern i j; aesop ];
        rw [ h_card_eq ];
      · assumption;
      · assumption
