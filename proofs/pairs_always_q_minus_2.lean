/-- An admissible k-tuple has gaps coprime to q and g_0 = 0 -/
def AdmissibleTuple (q : ℕ) (g : ℕ → ℕ) (k : ℕ) : Prop :=
  g 0 = 0 ∧ ∀ i, i < k → i ≠ 0 → Nat.gcd (g i) q = 1

/-- A k-tuple of residues is principal if all non-zero and satisfy gap constraint -/
def IsPrincipalKTuple (q : ℕ) [Fact (Nat.Prime q)] (g : ℕ → ℕ) (k : ℕ) [NeZero k] 
    (t : Fin k → Fin q) : Prop :=
  (∀ i, t i ≠ 0) ∧ ∀ i, (t i).val ≡ (t 0).val + g i [MOD q]

instance (q : ℕ) [Fact (Nat.Prime q)] (g : ℕ → ℕ) (k : ℕ) [NeZero k] : 
    DecidablePred (IsPrincipalKTuple q g k) := by
  intro t
  unfold IsPrincipalKTuple
  infer_instance

/-- Finset of principal k-tuples -/
def PrincipalKTuples (q : ℕ) [Fact (Nat.Prime q)] (g : ℕ → ℕ) (k : ℕ) [NeZero k] : 
    Finset (Fin k → Fin q) :=
  Finset.univ.filter (IsPrincipalKTuple q g k)

