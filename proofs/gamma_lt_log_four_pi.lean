    · norm_num [ Complex.ofReal_log ( show 0 ≤ 4 * Real.pi by positivity ) ];
  rw [ h_complete_zero ] ; norm_num [ Complex.ext_iff ] ; linarith [ gamma_lt_log_four_pi ]

