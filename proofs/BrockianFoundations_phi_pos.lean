/-
Riemann Zeta is not zero on the imaginary axis
-/
open Complex
lemma BrockianFoundations.riemannZeta_ne_zero_of_re_eq_zero (s : ℂ) (h : s.re = 0) : riemannZeta s ≠ 0 := by
  have h_nonzero : ∀ s : ℂ, s.re = 0 → s ≠ 0 → riemannZeta s ≠ 0 := by
    intros s hs hne;
    have := @riemannZeta_ne_zero_of_one_le_re;
    contrapose! this;
    have := @riemannZeta_one_sub s; aesop;
  by_cases hs : s = 0 <;> simp_all +decide;
  rw [ riemannZeta ];
  norm_num [ HurwitzZeta.hurwitzZetaEven ]

/-
RH from Brockian Conjectures (properly handling all cases)
-/
open Complex
/-- RH from Brockian Conjectures (properly handling all cases) -/
theorem BrockianFoundations.riemann_hypothesis_from_brockian 
    [BS : BrockianFoundations.BrockianSystem] 
    [BC : BrockianFoundations.BrockianConjectures] 
    (zero_correspondence : ∀ s : ℂ, BrockianFoundations.CriticalStrip s → riemannZeta s = 0 → BrockianFoundations.brockianZeta s = 0) :
    BrockianFoundations.RiemannHypothesis := by
  intro s hs_zero
  -- Case 1: Trivial zeros (s.re < 0)
  by_cases h_neg : s.re < 0
  · left
    exact h_neg
  -- Case 2: s.re ≥ 0
  · push_neg at h_neg
    -- Case 2a: s.re = 0
    by_cases h_re_zero : s.re = 0
    · have : riemannZeta s ≠ 0 := BrockianFoundations.riemannZeta_ne_zero_of_re_eq_zero s h_re_zero
      contradiction
    -- Case 2b: s.re > 0
    · have h_pos : s.re > 0 := lt_of_le_of_ne h_neg (Ne.symm h_re_zero)
      -- Case 2b.i: s.re ≥ 1
      by_cases h_ge_one : 1 ≤ s.re
      · have : riemannZeta s ≠ 0 := riemannZeta_ne_zero_of_one_le_re h_ge_one
        contradiction
      -- Case 2b.ii: 0 < s.re < 1 (Critical Strip)
      · push_neg at h_ge_one
        have h_strip : BrockianFoundations.CriticalStrip s := ⟨h_pos, h_ge_one⟩
        right
        have h_brockian_zero : BrockianFoundations.brockianZeta s = 0 := zero_correspondence s h_strip hs_zero
        exact BC.geometric_rigidity s h_strip h_brockian_zero

/-
Non-trivial zeros of Riemann Zeta with non-negative real part lie in the Critical Strip
-/
open Complex
lemma BrockianFoundations.riemann_zeros_in_strip (s : ℂ) (h_zero : riemannZeta s = 0) (h_non_neg : 0 ≤ s.re) :
    BrockianFoundations.CriticalStrip s := by
      -- Consider two cases: $s.re = 0$ and $0 < s.re < 1$.
      by_cases h_re_zero : s.re = 0;
      · exact False.elim <| absurd h_zero <| by exact?;
      · -- If $s.re \geq 1$, then $\zeta(s) \neq 0$ by riemannZeta_ne_zero_of_one_le_re.
        by_cases h_re_ge_one : s.re ≥ 1;
        · exact False.elim <| absurd h_zero <| by exact?;
        · exact ⟨ lt_of_le_of_ne h_non_neg ( Ne.symm h_re_zero ), lt_of_not_ge h_re_ge_one ⟩

