  mainTerm : ℕ → ℝ
  errorTerm : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorTerm n
  approximation : ∀ n, n > 2 → Even n →
    |(BrockianFoundations.goldbachCount n : ℝ) - mainTerm n| ≤ errorTerm n
  threshold : ℕ
  margin : ∀ n, n > threshold → mainTerm n - errorTerm n ≥ 1 / 2

/-
Goldbach count is positive for large n
-/
open Complex
theorem BrockianFoundations.goldbach_count_positive_large (M : BrockianFoundations.GoldbachSpectralModel) :
    ∀ n, n > max 2 M.threshold → Even n → BrockianFoundations.goldbachCount n ≥ 1 := by
      intro n hn hn_even
      have h_ineq : (BrockianFoundations.goldbachCount n : ℝ) ≥ (M.mainTerm n) - (M.errorTerm n) := by
        linarith [ abs_le.mp ( M.approximation n ( by linarith [ le_max_left 2 M.threshold ] ) hn_even ) ];
      exact Nat.pos_of_ne_zero fun h => by norm_num [ h ] at h_ineq; linarith [ M.margin n <| lt_of_le_of_lt ( le_max_right _ _ ) hn ] ;

/-
Conditional Goldbach Theorem
-/
open Complex
/-- Conditional Goldbach Theorem -/
theorem BrockianFoundations.goldbach_conditional (M : BrockianFoundations.GoldbachSpectralModel)
    (h_small : ∀ n, n ≤ max 2 M.threshold → n > 2 → Even n →
               ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n) :
    ∀ n, n > 2 → Even n → 
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  intro n hn heven
  by_cases hsmall : n ≤ max 2 M.threshold
  · exact h_small n hsmall hn heven
  · push_neg at hsmall
    have hcount := BrockianFoundations.goldbach_count_positive_large M n hsmall heven
    exact BrockianFoundations.goldbach_from_count hcount

