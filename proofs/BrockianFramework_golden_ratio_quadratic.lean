    have key : (s * (1 - s)).im = s.im * (1 - 2 * s.re) := by
      have expand : s * (1 - s) = s - s * s := by ring
      rw [expand]
      rw [Complex.sub_im]
      have sq_im : (s * s).im = 2 * s.re * s.im := by
        rw [Complex.mul_im]
        ring
      rw [sq_im]
      ring
    rw [key] at h
    cases' mul_eq_zero.mp h with h1 h2
    · left
      exact h1
    · right
      linarith
  · intro h
    cases h with
    | inl him =>
        have expand : (s * (1 - s)).im = s.im * (1 - 2 * s.re) := by
          have : s * (1 - s) = s - s * s := by ring
          rw [this, Complex.sub_im, Complex.mul_im]
          ring
        rw [expand, him]
        ring
    | inr hre =>
        have expand : (s * (1 - s)).im = s.im * (1 - 2 * s.re) := by
          have : s * (1 - s) = s - s * s := by ring
          rw [this, Complex.sub_im, Complex.mul_im]
          ring
        rw [expand, hre]
        ring

structure BrockianFramework.BrockianParams where
  ε : ℝ
  X : ℝ
  φ_weight : Bool
  hε : 0 < ε
  hX : 1 < X
