/-
For prime q and gap g, a residue pair (i,j) is principal if both are non-zero and satisfy the gap constraint j ≡ i+g (mod q)
-/
def isPrincipalPair (q g : ℕ) (pair : Fin q × Fin q) : Prop :=
  pair.1.val ≠ 0 ∧
  pair.2.val ≠ 0 ∧
  pair.2.val ≡ pair.1.val + g [MOD q]

instance (q g : ℕ) : DecidablePred (isPrincipalPair q g) := by
  intro pair
  unfold isPrincipalPair
  infer_instance

/-
The set of principal pairs for prime q and gap g
-/
def principalPairsQ (q g : ℕ) : Finset (Fin q × Fin q) :=
  Finset.univ.filter (isPrincipalPair q g)

/-
Main theorem: For odd prime q and g coprime to q, exactly q-2 principal pairs exist
-/
theorem universal_count_theorem (q g : ℕ)
    (hq_prime : Nat.Prime q)
    (hq_odd : q > 2)
    (hg_coprime : Nat.gcd g q = 1) :
    (principalPairsQ q g).card = q - 2 := by
  -- Let's count the number of valid $i$ values in the range $1$ to $q-1$.
  have h_count_i : Finset.card (Finset.filter (fun i => i ≠ 0 ∧ (i + g) % q ≠ 0) (Finset.range q)) = q - 2 := by
    -- Let's count the number of invalid $i$ values in the range $1$ to $q-1$.
    have h_count_i_invalid : Finset.card (Finset.filter (fun i => i = 0 ∨ (i + g) % q = 0) (Finset.range q)) = 2 := by
      have h_count_i_invalid : ∃! i, i ∈ Finset.range q ∧ (i + g) % q = 0 ∧ i ≠ 0 := by
        -- Let's count the number of invalid $i$ values in the range $1$ to $q-1$. There is exactly one such $i$ because $g$ is coprime to $q$.
        obtain ⟨i, hi⟩ : ∃ i ∈ Finset.range q, (i + g) % q = 0 ∧ i ≠ 0 := by
          -- Since $g$ is coprime to $q$, there exists a unique $i$ in the range $1$ to $q-1$ such that $i + g \equiv 0 \pmod{q}$.
          obtain ⟨i, hi⟩ : ∃ i, i ∈ Finset.range q ∧ (i + g) % q = 0 := by
            use ( q - g % q ) % q;
            norm_num [ Nat.mod_lt _ hq_prime.pos ];
            exact Nat.mod_eq_zero_of_dvd ⟨ g / q + 1, by linarith [ Nat.div_add_mod g q, Nat.sub_add_cancel ( show g % q ≤ q from Nat.le_of_lt ( Nat.mod_lt _ hq_prime.pos ) ) ] ⟩;
          have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero hi.2 ) ( Nat.dvd_refl q ) ; aesop;
        use i;
        exact ⟨ hi, fun y hy => by have := Nat.modEq_iff_dvd.mp ( hy.2.1.trans hi.2.1.symm ) ; norm_num at this; obtain ⟨ k, hk ⟩ := this; nlinarith [ show k = 0 by nlinarith [ Finset.mem_range.mp hi.1, Finset.mem_range.mp hy.1 ] ] ⟩;
      obtain ⟨ i, hi₁, hi₂ ⟩ := h_count_i_invalid;
      rw [ Finset.card_eq_two ];
      use 0, i;
      grind;
    rw [ ← h_count_i_invalid, show { i ∈ Finset.range q | i ≠ 0 ∧ ( i + g ) % q ≠ 0 } = Finset.range q \ { i ∈ Finset.range q | i = 0 ∨ ( i + g ) % q = 0 } by ext; aesop, Finset.card_sdiff ] ; norm_num;
    rw [ Finset.inter_eq_left.mpr ( Finset.filter_subset _ _ ) ];
  have h_count_pairs : Finset.card (Finset.filter (fun p => p.1.val ≠ 0 ∧ p.2.val ≠ 0 ∧ p.2.val ≡ p.1.val + g [MOD q]) (Finset.univ : Finset (Fin q × Fin q))) = Finset.card (Finset.filter (fun i => i ≠ 0 ∧ (i + g) % q ≠ 0) (Finset.range q)) := by
    have : Finset.filter (fun p => p.1.val ≠ 0 ∧ p.2.val ≠ 0 ∧ p.2.val ≡ p.1.val + g [MOD q]) (Finset.univ : Finset (Fin q × Fin q)) = Finset.image (fun i : Fin q => (i, ⟨(i.val + g) % q, Nat.mod_lt _ hq_prime.pos⟩)) (Finset.filter (fun i : Fin q => i.val ≠ 0 ∧ (i.val + g) % q ≠ 0) (Finset.univ : Finset (Fin q))) := by
      ext ⟨ i, j ⟩ ; simp +decide [ Nat.ModEq, Nat.mod_eq_of_lt ] ; aesop;
    rw [ this, Finset.card_image_of_injective ];
    · rw [ Finset.card_filter, Finset.card_filter ];
      rw [ Finset.sum_range ];
    · aesop_cat;
  exact h_count_pairs.trans h_count_i -- Proof follows from counting argument

/-
Helper: For each non-zero residue i, exactly one j satisfies j ≡ i+g (mod q)
-/
lemma unique_partner (q g : ℕ) (hq : q > 0) (i : Fin q) (hi : i.val ≠ 0) :
    ∃! j : Fin q, j.val ≡ i.val + g [MOD q] := by
  use ⟨ ( i + g ) % q, Nat.mod_lt _ hq ⟩;
  simp +decide [ Fin.ext_iff, Nat.ModEq ];
  exact fun y hy => by rw [ ← hy, Nat.mod_eq_of_lt y.2 ] ; -- Uniqueness of modular arithmetic

/-
Exactly one non-zero residue i makes j ≡ 0 (mod q) when j ≡ i+g
-/
lemma one_maps_to_zero (q g : ℕ)
    (hq_prime : Nat.Prime q)
    (hg_coprime : Nat.gcd g q = 1) :
    (Finset.univ.filter fun (i : Fin q) =>
      i.val ≠ 0 ∧ (i.val + g) % q = 0).card = 1 := by
  -- Since $i \equiv -g \pmod{q}$ and $g$ is coprime to $q$, there is exactly one $i$ modulo $q$ that satisfies this condition.
  obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin q, (i₀.val + g) % q = 0 ∧ i₀.val ≠ 0 := by
    -- Since $g$ is coprime to $q$, there exists an $i₀$ such that $i₀ \equiv -g \pmod{q}$.
    obtain ⟨i₀, hi₀⟩ : ∃ i₀ : ℕ, i₀ < q ∧ (i₀ + g) % q = 0 := by
      use ( q - g % q ) % q;
      norm_num [ Nat.mod_lt _ hq_prime.pos ];
      rw [ Nat.add_comm, Nat.mod_eq_zero_of_dvd ];
      exact ⟨ g / q + 1, by linarith [ Nat.div_add_mod g q, Nat.sub_add_cancel ( Nat.mod_lt g hq_prime.pos |> Nat.le_of_lt ) ] ⟩;
    by_cases hi₀_eq_zero : i₀ = 0;
    · have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero ( by aesop : g % q = 0 ) ) ( Nat.dvd_refl q ) ; aesop;
    · exact ⟨ ⟨ i₀, hi₀.1 ⟩, hi₀.2, hi₀_eq_zero ⟩;
  have h_unique : ∀ i j : Fin q, (i.val + g) % q = 0 → (j.val + g) % q = 0 → i = j := by
    intro i j hi hj; haveI := Fact.mk hq_prime; simp_all +decide [ ← ZMod.val_natCast, Nat.add_mod ] ;
    exact Fin.ext ( Nat.mod_eq_of_lt i.2 ▸ Nat.mod_eq_of_lt j.2 ▸ by simpa [ ← ZMod.natCast_eq_natCast_iff' ] using by linear_combination' hi - hj );
  exact Finset.card_eq_one.mpr ⟨ i₀, Finset.eq_singleton_iff_unique_mem.mpr ⟨ Finset.mem_filter.mpr ⟨ Finset.mem_univ _, hi₀.2, hi₀.1 ⟩, fun i hi => h_unique _ _ ( Finset.mem_filter.mp hi |>.2.2 ) hi₀.1 ⟩ ⟩ -- The residue i ≡ -g is unique

/-
For q=3, exactly 1 principal pair
-/
theorem q3_count (g : ℕ) (hg : Nat.gcd g 3 = 1) :
    (principalPairsQ 3 g).card = 1 := by
  have : 3 - 2 = 1 := by norm_num
  rw [← this]
  apply universal_count_theorem
  · norm_num
  · norm_num
  · exact hg

