/-
The count depends only on q, not on the specific gap g
-/
theorem independence_of_gap (q g₁ g₂ : ℕ)
    (hq_prime : Nat.Prime q) (hq_odd : q > 2)
    (hg₁ : Nat.gcd g₁ q = 1) (hg₂ : Nat.gcd g₂ q = 1) :
    (principalPairsQ q g₁).card = (principalPairsQ q g₂).card := by
  rw [universal_count_theorem q g₁ hq_prime hq_odd hg₁]
  rw [universal_count_theorem q g₂ hq_prime hq_odd hg₂]

/-
Corollary: All coprime gaps have the same count
-/
theorem all_coprime_same_count (q : ℕ) (hq_prime : Nat.Prime q) (hq_odd : q > 2) :
    ∀ g₁ g₂, Nat.gcd g₁ q = 1 → Nat.gcd g₂ q = 1 →
    (principalPairsQ q g₁).card = (principalPairsQ q g₂).card :=
  fun g₁ g₂ hg₁ hg₂ => independence_of_gap q g₁ g₂ hq_prime hq_odd hg₁ hg₂

/-
Main result: Universal q-2 structure across all odd primes
-/
theorem universal_structure (q g : ℕ)
    (hq : Nat.Prime q) (hq_odd : q > 2) (hg : Nat.gcd g q = 1) :
    ∃ (pairs : Finset (Fin q × Fin q)),
      pairs.card = q - 2 ∧
      ∀ pair ∈ pairs,
        pair.1.val ≠ 0 ∧
        pair.2.val ≠ 0 ∧
        pair.2.val ≡ pair.1.val + g [MOD q] := by
  use principalPairsQ q g
  constructor
  · exact universal_count_theorem q g hq hq_odd hg
  · intro pair hpair
    simp [principalPairsQ, isPrincipalPair] at hpair
    exact hpair

/-
Compute principal pairs for small q and g
-/
def computePrincipalPairs (q g : ℕ) : List (ℕ × ℕ) :=
  let pairs := (List.range q).flatMap fun i =>
    (List.range q).filterMap fun j =>
      if i ≠ 0 ∧ j ≠ 0 ∧ j % q = (i + g) % q
      then some (i, j)
      else none
  pairs

