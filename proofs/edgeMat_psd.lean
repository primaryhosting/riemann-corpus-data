/-- Standard basis vector -/
def e (v : V) : V → ℝ := fun i => if i = v then 1 else 0

/-- Edge matrix: (e_u - e_v)(e_u - e_v)^T -/
def edgeMat (u v : V) : Matrix V V ℝ :=
  Matrix.vecMulVec (e u - e v) (e u - e v)

/-- Edge matrix is PSD -/
