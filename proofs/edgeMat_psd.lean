/-- Moore-Penrose conditions -/
def IsMoorePenrose (M P : Matrix V V ℝ) : Prop :=
  M * P * M = M ∧ P * M * P = P ∧ (M * P).IsHermitian ∧ (P * M).IsHermitian

/-- Pseudoinverse definition -/
def Matrix.pseudoInverse (M : Matrix V V ℝ) : Matrix V V ℝ :=
  if h : ∃ P, IsMoorePenrose M P then Classical.choose h else 0

/-- Pseudoinverse of Laplacian -/
def LDagger (G : SimpleGraph V) : Matrix V V ℝ := 
  (L G).pseudoInverse

#check dotProduct

/-- 
Leverage score of edge (s,t):
ℓ(s,t) = w(s,t) · (δ_s - δ_t)^T L† (δ_s - δ_t)

For simple graphs, w(s,t) = 1 when adjacent, 0 otherwise.
-/
def leverageScore (G : SimpleGraph V) (s t : V) : ℝ :=
  if G.Adj s t then
    let diff := e s - e t
    dotProduct diff ((LDagger G).mulVec diff)
  else 0

/-- 
Total leverage score from S to T:
ℓ(S,T) = Σ_{s∈S, t∈T} ℓ(s,t)
-/
def leverageScoreSet (G : SimpleGraph V) (S T : Finset V) : ℝ :=
  ∑ s ∈ S, ∑ t ∈ T, leverageScore G s t

/-- 
Boundary leverage score:
ℓ(S) = ℓ(S, V \ S)
-/
def boundaryLeverageScore (G : SimpleGraph V) (S : Finset V) : ℝ :=
  leverageScoreSet G S (Finset.univ.filter (· ∉ S))

/-- 
Sum of top σ eigenvalues of matrix A.
Tr_σ(A) = λ₁ + λ₂ + ... + λ_σ where λ₁ ≥ λ₂ ≥ ... ≥ λ_n
-/
def Trσ (A : Matrix V V ℝ) (k : ℕ) : ℝ :=
  if h : A.IsHermitian then
    let evals := (Finset.univ.toList.map (h.eigenvalues)).mergeSort (fun x y => y ≤ x)
    (evals.take k).sum
  else 0

/-- 
Modified barrier function:
Φ_σ^u(A) = Tr_σ((uI - A)^{-1}) = Σᵢ₌₁^σ 1/(u - λᵢ)

If u ≤ λ₁, we define Φ = ∞.
-/
def barrierFunction (A : Matrix V V ℝ) (u : ℝ) (k : ℕ) : ℝ :=
  Trσ (u • (1 : Matrix V V ℝ) - A)⁻¹ k

/-- δ = 21/n (step size for barrier function) -/
def δ (n : ℕ) : ℝ := 21 / n

/-- φ = n/21 (upper bound on barrier function) -/
def φ (n : ℕ) : ℝ := n / 21

/-- σ = ⌊εn/42⌋ (target set size) -/
def σ (ε : ℝ) (n : ℕ) : ℕ := ⌊ε * n / 42⌋₊

/-- The set of vertices t ∉ S that satisfy the leverage score condition -/
def GoodLeverageVertices (G : SimpleGraph V) (S : Finset V) : Finset V :=
  Finset.univ.filter (fun t => t ∉ S ∧ 
    boundaryLeverageScore G (insert t S) ≤ boundaryLeverageScore G S + 4)

/--
Statement of Lemma 2.1: Leverage Score Bound
-/
def LeverageScoreBoundStatement (G : SimpleGraph V) : Prop :=
  ∀ (S : Finset V),
    2 * (Finset.univ.filter (fun t => t ∉ S ∧ 
      boundaryLeverageScore G (insert t S) ≤ boundaryLeverageScore G S + 4)).card 
    > (Finset.univ.filter (· ∉ S)).card

/-- The sum of vertex chunks over all vertices is the Laplacian -/
theorem sum_Av_eq_L (G : SimpleGraph V) : ∑ v ∈ Finset.univ, Av G v = L G := by
  simp [Av, L, SimpleGraph.lapMatrix, SimpleGraph.degMatrix, SimpleGraph.adjMatrix]
  ext i j
  simp [Matrix.sum_apply, Matrix.sub_apply, Matrix.diagonal_apply, Matrix.of_apply]
  -- The ATP should be able to handle the rest with some expansion
  unfold edgeMat;
  simp +decide [ Matrix.vecMulVec, e ];
  by_cases hij : i = j <;> simp +decide [ hij, SimpleGraph.degree, SimpleGraph.neighborFinset ];
  · simp +decide [ Finset.sum_add_distrib, Finset.mul_sum _ _ _, Finset.sum_mul, sub_mul, mul_sub, hij ];
    simp +decide [ Finset.sum_ite, SimpleGraph.adj_comm ];
    ring;
  · rw [ Finset.sum_eq_add ( i ) ( j ) ] <;> simp +decide [ hij, SimpleGraph.neighborSet ];
    · split_ifs <;> simp_all +decide [ SimpleGraph.adj_comm ];
      norm_num;
    · aesop

/--
Statement of Claim 2.2: Self-Leverage Bound
-/
def SelfLeverageBoundStatement (G : SimpleGraph V) : Prop :=
  ∀ (T : Finset V),
    ∑ t ∈ T, leverageScoreSet G {t} T ≤ 2 * ((T.card : ℝ) - 1)

/-
Lemma 2.4: If A, B are PSD, δ > 0, and a specific condition involving traces holds, then the barrier function of A + B at u + δ is bounded by the barrier function of A at u.
-/
/--
**LEMMA 2.4: Barrier Function Decrease**

If A, B are PSD, δ > 0, M = (u+δ)I - A, Φ_σ^u(A) < ∞, and
  Tr_σ(M^{-2}B) / (Φ_σ^u(A) - Φ_σ^{u+δ}(A)) + Tr_σ(M^{-1}B) < 1
then Φ_σ^{u+δ}(A + B) ≤ Φ_σ^u(A)
-/
def BarrierDecreaseStatement (V : Type*) [Fintype V] [DecidableEq V] : Prop :=
  ∀ (A B : Matrix V V ℝ) (u δ : ℝ) (k : ℕ),
    A.PosSemidef → B.PosSemidef → 0 < δ →
    (u • (1 : Matrix V V ℝ) - A).PosDef → -- Corresponds to Φ < ∞ (u > λ₁)
    let M := (u + δ) • (1 : Matrix V V ℝ) - A
    let condition := Trσ (M⁻¹ * M⁻¹ * B) k / 
                     (barrierFunction A u k - barrierFunction A (u + δ) k) +
                     Trσ (M⁻¹ * B) k
    condition < 1 → 
    barrierFunction (A + B) (u + δ) k ≤ barrierFunction A u k

/--
Corrected Statement of Claim 2.2: Self-Leverage Bound
Requires T to be nonempty.
-/
def SelfLeverageBoundProp (G : SimpleGraph V) : Prop :=
  ∀ (T : Finset V), T.Nonempty →
    ∑ t ∈ T, leverageScoreSet G {t} T ≤ 2 * ((T.card : ℝ) - 1)

/--
The update matrix when adding t to S: B_t = L_{S ∪ {t}} - L_S
-/
def UpdateMatrix (G : SimpleGraph V) (S : Finset V) (t : V) : Matrix V V ℝ :=
  Ls G (insert t S) - Ls G S
