    intro y
    have h_sum : ∑ x_2 : V, y x_2 * ∑ x_3 : V, y x_3 * (x x_2 * x x_3) = (∑ x_2 : V, y x_2 * x x_2)^2 := by
      simp +decide only [mul_left_comm, mul_comm, Finset.mul_sum _ _ _, pow_two];
    exact h_sum.symm ▸ sq_nonneg _;
  exact h_edge _

/-- Vertex chunk: A_v := (1/2) Σ_{u~v} (e_v - e_u)(e_v - e_u)^T -/
def Av (G : SimpleGraph V) (v : V) : Matrix V V ℝ :=
  (1/2 : ℝ) • ∑ u ∈ G.neighborFinset v, edgeMat v u

/-- Graph G_S with edges only inside S -/
def restrictToFinset (G : SimpleGraph V) (S : Finset V) : SimpleGraph V where
  Adj i j := i ∈ S ∧ j ∈ S ∧ G.Adj i j
  symm := fun i j h => ⟨h.2.1, h.1, h.2.2.symm⟩
  loopless := fun i hi => hi.2.2.ne rfl

/-- Induced Laplacian L_S -/
abbrev Ls (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  L (restrictToFinset G S)

