    intro x
    unfold Matrix.PosSemidef
    simp [Matrix.vecMulVec];
    simp [Matrix.IsHermitian, Matrix.mulVec, dotProduct];
    -- The transpose of the matrix is equal to itself because multiplication is commutative.
