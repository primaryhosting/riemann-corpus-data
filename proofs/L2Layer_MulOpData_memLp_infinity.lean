      have h_norm : ‖L2Layer.MulOpData.mulOp μ d g‖ ≤ M * ‖g‖ := by
        have h_mul : ∀ᵐ x ∂μ, ‖d.f x * g x‖ ≤ M * ‖g x‖ := by
          filter_upwards [ hbound ] with x hx using by simpa only [ norm_mul ] using mul_le_mul_of_nonneg_right hx ( norm_nonneg _ ) ;
        have h_norm : ∀ᵐ x ∂μ, ‖(d.f x) * g x‖^2 ≤ M^2 * ‖g x‖^2 := by
          filter_upwards [ h_mul ] with x hx using by simpa only [ mul_pow ] using pow_le_pow_left₀ ( norm_nonneg _ ) hx 2;
        have h_norm : ∫ x, ‖(d.f x) * g x‖^2 ∂μ ≤ M^2 * ∫ x, ‖g x‖^2 ∂μ := by
          rw [ ← MeasureTheory.integral_const_mul ];
          apply_rules [ MeasureTheory.integral_mono_of_nonneg ];
          · exact Filter.Eventually.of_forall fun x => sq_nonneg _;
          · refine' MeasureTheory.Integrable.const_mul _ _;
            have h_integrable : MeasureTheory.MemLp (fun x => ‖g x‖) 2 μ := by
              exact MeasureTheory.MemLp.norm ( MeasureTheory.Lp.memLp _ );
            exact MeasureTheory.MemLp.integrable_sq h_integrable;
        convert Real.sqrt_le_sqrt h_norm using 1;
        · simp +decide [ L2Layer.MulOpData.mulOp, MeasureTheory.Lp.norm_def ];
          rw [ MeasureTheory.eLpNorm_congr_ae ( MeasureTheory.MemLp.coeFn_toLp _ ) ];
          rw [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ] <;> norm_num [ mul_pow ];
          rw [ Real.sqrt_eq_rpow, MeasureTheory.integral_eq_lintegral_of_nonneg_ae ];
          · rw [ ← ENNReal.toReal_rpow ] ; norm_num [ ENNReal.ofReal, Real.toNNReal_mul, Real.toNNReal_pow ] ; ring;
            norm_cast;
          · exact Filter.Eventually.of_forall fun x => by positivity;
          · exact MeasureTheory.AEStronglyMeasurable.mul ( MeasureTheory.AEStronglyMeasurable.pow ( d.meas.norm ) 2 ) ( MeasureTheory.AEStronglyMeasurable.pow ( g.1.aestronglyMeasurable.norm ) 2 );
        · rw [ Real.sqrt_mul ( sq_nonneg _ ), Real.sqrt_sq hM, MeasureTheory.Lp.norm_def ];
          rw [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ] <;> norm_num [ Real.sqrt_eq_rpow ];
          rw [ MeasureTheory.integral_eq_lintegral_of_nonneg_ae ] <;> norm_num [ Real.enorm_eq_ofReal ];
          · rw [ ENNReal.toReal_rpow ] ; norm_num;
          · exact Filter.Eventually.of_forall fun x => sq_nonneg _;
          · exact MeasureTheory.AEStronglyMeasurable.pow ( g.1.aestronglyMeasurable.norm ) _;
      -- Apply the hypothesis `h_norm` directly to conclude the proof.
      exact h_norm;
    -- Apply the hypothesis `h_norm` to the specific `g` in the goal.
    apply h_norm g

