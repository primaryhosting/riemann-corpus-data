/-- Minimal quadratic form interface (sesquilinear on a dense domain). -/
structure QuadForms.QForm (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  dom : Submodule ℂ H
  Q : dom →ₗ[ℂ] (dom →ₗ[ℂ] ℂ)   -- Q x y = ⟪x, y⟫_Q (sesq)
  dense : Dense (dom : Set H)

open scoped Classical BigOperators Real ENNReal
open Complex Real MeasureTheory Filter Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The energy norm squared, shifted by c to be positive definite. -/
def QuadForms.QForm.formNormSq (QF : QuadForms.QForm H) (c : ℝ) (x : QF.dom) : ℝ :=
  (QF.Q x x).re + (1 - c) * ‖(x : H)‖^2

open scoped Classical BigOperators Real ENNReal
open Complex Real MeasureTheory Filter Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Symmetry of the form: Q(x,y) = conj(Q(y,x)). -/
def QuadForms.QForm.IsHermitian (QF : QuadForms.QForm H) : Prop :=
  ∀ x y : QF.dom, QF.Q x y = star (QF.Q y x)

open scoped Classical BigOperators Real ENNReal
open Complex Real MeasureTheory Filter Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Lower boundedness: ∃c, Re(Q(x,x)) ≥ c‖x‖². -/
def QuadForms.QForm.LowerBounded (QF : QuadForms.QForm H) : Prop :=
  ∃ c : ℝ, ∀ x : QF.dom, (QF.Q x x).re ≥ c * ‖(x : H)‖^2

open scoped Classical BigOperators Real ENNReal
open Complex Real MeasureTheory Filter Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Closedness: The domain is complete with respect to the energy norm. -/
def QuadForms.QForm.IsClosed (QF : QuadForms.QForm H) : Prop :=
  ∃ c : ℝ, (∀ x : QF.dom, (QF.Q x x).re ≥ c * ‖(x : H)‖^2) ∧
  ∀ (u : ℕ → QF.dom),
    (∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, QF.formNormSq c (u m - u n) < ε^2) →
    ∃ x : QF.dom, Tendsto (fun n => (u n : H)) atTop (nhds (x : H)) ∧
                  Tendsto (fun n => QF.formNormSq c (u n - x)) atTop (nhds 0)
