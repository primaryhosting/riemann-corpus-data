/-- Trivial zeta zeros: negative even integers `-2(n+1)`. -/
def IsTrivialZetaZero (s : ℂ) : Prop :=
  ∃ n : ℕ, s = -((2 : ℂ) * ((n + 1 : ℕ) : ℂ))

/-- Brockian reformulation of RH: every nontrivial zero has Re(s)=1/2. -/
def BrockianRiemannHypothesis : Prop :=
  ∀ s : ℂ, riemannZeta s = 0 → ¬ IsTrivialZetaZero s → s ≠ 1 → s.re = (1/2 : ℝ)

