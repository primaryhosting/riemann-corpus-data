/--
Brockian spiral (Lean-stable version):  `B(t)= (k t) * exp(2π i * (t^α))`,
using `Real.rpow` for the exponent shape.
-/
def brockianSpiral (k α : ℝ) (t : ℝ) : ℂ :=
  ((k * t : ℝ) : ℂ) * Complex.exp (twoPiI * ((Real.rpow t α : ℝ) : ℂ))

