def Brock.Core.Ray0 (r : ZMod 5) : Prop := r = 1 ∨ r = 4

def Brock.Core.rot (r : ZMod 5) : ZMod 5 := r + 1

def Brock.Core.rayVal (r : ZMod 5) : Fin 2 :=
  if Brock.Core.Ray0 r then (0 : Fin 2) else (1 : Fin 2)

def Brock.Core.RotTransition (i j : Fin 2) (r : ZMod 5) : Prop :=
  r ≠ 0 ∧ Brock.Core.rot r ≠ 0 ∧ Brock.Core.rayVal r = i ∧ Brock.Core.rayVal (Brock.Core.rot r) = j

def Brock.Core.K (i j : Fin 2) : ℕ :=
  ((Finset.univ : Finset (ZMod 5)).filter (fun r => Brock.Core.RotTransition i j r)).card

def Brock.Core.kernel : Fin 2 → Fin 2 → ℕ := Brock.Core.K

