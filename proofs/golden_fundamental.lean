      set x : ℝ := Real.cos (Real.pi / 5)
      have hx_poly : 4 * x ^ 2 - 2 * x - 1 = 0 := by
        have := Real.cos_three_mul ( Real.pi / 5 ) ; rw [ show 3 * ( Real.pi / 5 ) = Real.pi - 2 * ( Real.pi / 5 ) by ring, Real.cos_pi_sub, Real.cos_two_mul ] at this ; nlinarith [ show 0 < Real.cos ( Real.pi / 5 ) from Real.cos_pos_of_mem_Ioo ⟨ by linarith [ Real.pi_pos ], by linarith [ Real.pi_pos ] ⟩ ] ;
      nlinarith [ show 1 / 2 < Real.cos ( Real.pi / 5 ) from by nth_rw 1 [ ← Real.cos_pi_div_three ] ; exact Real.cos_lt_cos_of_nonneg_of_le_pi ( by positivity ) ( by linarith [ Real.pi_pos ] ) ( by linarith [ Real.pi_pos ] ), Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
