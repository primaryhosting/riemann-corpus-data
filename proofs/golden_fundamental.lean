inductive BrockRay 
  | E  -- 0 mod 5
  | A  -- 1 mod 5
  | B  -- 2 mod 5
  | C  -- 3 mod 5
  | D  -- 4 mod 5
  deriving DecidableEq, Repr, Fintype

#check DihedralGroup.card

def BrockRay.residue : BrockRay → Fin 5
  | BrockRay.E => 0 | BrockRay.A => 1 | BrockRay.B => 2 | BrockRay.C => 3 | BrockRay.D => 4

def BrockRay.contains (r : BrockRay) (n : ℕ) : Prop := n % 5 = r.residue.val

def BrockRay.nonERays : List BrockRay := [BrockRay.A, BrockRay.B, BrockRay.C, BrockRay.D]

theorem BrockRay.nonERays_card : BrockRay.nonERays.length = 4 := by rfl

#check BrockRay.ofNat

theorem BrockRay.unique_membership (n : ℕ) : ∃! r : BrockRay, BrockRay.contains r n := by
  -- By definition of residue, every natural number n has a unique residue when divided by 5.
  have h_residue : ∃ r : Fin 5, n % 5 = r := by
    exact ⟨ ⟨ n % 5, Nat.mod_lt _ ( by decide ) ⟩, rfl ⟩;
  -- By definition of BrockRay, each residue class corresponds to a unique BrockRay.
  obtain ⟨r, hr⟩ : ∃ r : Fin 5, n % 5 = r := h_residue
  use if r = 0 then BrockRay.E else if r = 1 then BrockRay.A else if r = 2 then BrockRay.B else if r = 3 then BrockRay.C else BrockRay.D;
  fin_cases r <;> simp_all +decide [ BrockRay.contains ]

theorem BrockRay.rays_cover_nat (n : ℕ) : ∃ r : BrockRay, BrockRay.contains r n :=
  (BrockRay.unique_membership n).exists

theorem BrockRay.rays_disjoint (r1 r2 : BrockRay) (h : r1 ≠ r2) (n : ℕ) :
    ¬(BrockRay.contains r1 n ∧ BrockRay.contains r2 n) := by
  intro ⟨h1, h2⟩
  unfold BrockRay.contains at h1 h2
  have : r1.residue.val = r2.residue.val := by omega
  cases r1 <;> cases r2 <;> simp [BrockRay.residue] at this <;> contradiction

abbrev D₅ := DihedralGroup 5

theorem D5_order : Fintype.card D₅ = 10 := by
  -- Let's calculate the cardinality of the dihedral group $D_5$.
  apply DihedralGroup.card

inductive D5ConjClass
  | identity    -- {e}
  | rot1        -- {r, r⁴}
  | rot2        -- {r², r³}  
  | reflection  -- {s, sr, sr², sr³, sr⁴}
  deriving DecidableEq, Fintype

theorem D5_conj_classes : Fintype.card D5ConjClass = 4 := by decide

def D5_golden_character (cl : D5ConjClass) : ℂ :=
  match cl with
  | .identity => 2
  | .rot1 => φ - 1
  | .rot2 => -φ
  | .reflection => 0

theorem D5_golden_char_identity : D5_golden_character .identity = 2 := by rfl

theorem D5_golden_char_rot1 : D5_golden_character .rot1 = φ - 1 := by rfl

theorem D5_golden_char_rot2 : D5_golden_character .rot2 = -φ := by rfl

theorem D5_golden_char_reflection : D5_golden_character .reflection = 0 := by rfl

theorem golden_character_average_zero :
    (1 * D5_golden_character .identity +
     2 * D5_golden_character .rot1 +
     2 * D5_golden_character .rot2 +
     5 * D5_golden_character .reflection) / 10 = 0 := by
       -- Substitute the values of the characters into the equation.
       simp [D5_golden_character];
       -- Combine like terms and simplify the expression.
       ring

structure RayPair where
  first : BrockRay
  second : BrockRay
  deriving DecidableEq, Repr

def RayPair.isActive (rp : RayPair) : Bool :=
  rp.first ≠ BrockRay.E ∧ rp.second ≠ BrockRay.E

def isPrincipalPair (g : ℕ) (rp : RayPair) : Prop :=
  rp.isActive ∧ 
  (rp.second.residue.val : ℤ) = (rp.first.residue.val + g) % 5

def principalPairs (g : ℕ) : List RayPair :=
  BrockRay.nonERays.filterMap fun r1 =>
    let r2_residue := (r1.residue.val + g) % 5
    if r2_residue = 0 then 
      none  -- Exclude pairs involving ray E
    else
      some ⟨r1, BrockRay.ofNat r2_residue⟩

theorem principal_pair_count (g : ℕ) (hg : Nat.gcd g 5 = 1) :
    (principalPairs g).length = 3 := by
      unfold principalPairs;
      have := Nat.mod_lt g ( by decide : 5 > 0 ) ; interval_cases _ : g % 5 <;> simp_all +decide;
      · have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero ‹_› ) ( by decide : 5 ∣ 5 ) ; simp_all +decide ;
      · simp_all +decide [ Nat.add_mod ];
      · simp_all +decide [ Nat.add_mod ];
      · simp_all +decide [ Nat.add_mod ];
      · simp_all +decide [ Nat.add_mod ]

theorem twin_prime_structure : 
    principalPairs 2 = [⟨.A, .C⟩, ⟨.B, .D⟩, ⟨.D, .A⟩] := by
  rfl

theorem cousin_prime_structure :
    principalPairs 4 = [⟨.B, .A⟩, ⟨.C, .B⟩, ⟨.D, .C⟩] := by
  rfl

theorem sexy_prime_structure :
    principalPairs 6 = [⟨.A, .B⟩, ⟨.B, .C⟩, ⟨.C, .D⟩] := by
  rfl

theorem pentagonal_factor (g : ℕ) (hg : Nat.gcd g 5 = 1) :
    ((principalPairs g).length : ℚ) / 25 = 3 / 25 := by
  rw [principal_pair_count g hg]
  norm_num

def countPrimePairsByRay (g N : ℕ) (rp : RayPair) : ℕ :=
  (List.range N).countP fun p =>
    Nat.Prime p ∧ Nat.Prime (p + g) ∧ 
    p % 5 = rp.first.residue.val ∧ 
    (p + g) % 5 = rp.second.residue.val

def equidistribution_law (g : ℕ) (hg : Nat.gcd g 5 = 1) : Prop :=
  ∀ N : ℕ, N ≥ 10000 →
  ∀ rp ∈ principalPairs g,
    let count := countPrimePairsByRay g N rp
    let total := (List.range N).countP (fun p => Nat.Prime p ∧ Nat.Prime (p + g))
    abs ((count : ℚ) / (total : ℚ) - 1/3) < 1/100

