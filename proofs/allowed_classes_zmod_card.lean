def tupleProduct (G : Finset ℕ) (n : ℕ) : ℕ :=
  ∏ g ∈ G, (n + g)

/-- The allowed starting classes using ZMod (MUCH cleaner) -/
def AllowedClassesZMod (q : ℕ) [Fact (Nat.Prime q)] (G : Finset ℕ) : 
    Finset (ZMod q) :=
  Finset.univ.filter fun r0 => 
    r0 ≠ 0 ∧ ∀ g ∈ G, (r0 + (g : ZMod q)) ≠ 0

