/-- Configuration mass for single modulus q and residue class r0 -/
def configurationMass (w : SieveWeight) (G : Finset ℕ) (q : ℕ) 
    (r0 : ZMod q) (x : ℕ) : ℝ :=
  ∑ n ∈ Finset.range x, 
    if (n : ZMod q) = r0 
    then sieveWeightValue w G n 
    else 0

/-- Total mass on coprime residues -/
def totalCoprimeMass (w : SieveWeight) (G : Finset ℕ) (q x : ℕ) : ℝ :=
  ∑ n ∈ (Finset.range x).filter (Nat.Coprime · q),
    sieveWeightValue w G n

/-- Per-modulus discrepancy (max over allowed classes) -/
def perModulusDiscrepancy (w : SieveWeight) (G : Finset ℕ) (q : ℕ) 
    [Fact (Nat.Prime q)] (x : ℕ) : ℝ :=
  let allowed := AllowedClassesZMod q G
  let total := totalCoprimeMass w G q x
  let expected := total / (allowed.card : ℝ)
  allowed.fold max 0 (fun r0 => 
    |(configurationMass w G q r0 x) - expected|)

/-- THE BV DASHBOARD: Aggregate discrepancy (this MUST be small!) -/
def bvDashboardMetric (w : SieveWeight) (G : Finset ℕ) (Q x : ℕ) : ℝ :=
  ∑ q ∈ (Finset.range Q).filter Nat.Prime,
    if h : Nat.Prime q then
      haveI : Fact (Nat.Prime q) := ⟨h⟩
      perModulusDiscrepancy w G q x
    else 0

