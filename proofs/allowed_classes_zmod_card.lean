def sieveWeightValue (w : SieveWeight) (G : Finset ℕ) (n : ℕ) : ℝ :=
  let P_n := tupleProduct G n
  (∑ d ∈ (Finset.range w.R).filter (· ∣ P_n), 
    (ArithmeticFunction.moebius d : ℝ) * w.lambda d)^2

