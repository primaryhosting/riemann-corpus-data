/-- Shift parameter γ for aperiodicity -/
def PenroseTiling.gamma : Fin 5 → ℝ := fun _ => 1 / (2 * Real.sqrt 5)

/-- Physical projection: ℤ⁵ → ℂ (where the tiling lives) -/
def PenroseTiling.projectPhysical (n : Fin 5 → ℤ) : ℂ := ∑ k, (n k : ℂ) * PenroseTiling.pentagonVertex k

/-- Internal projection: ℤ⁵ → ℂ (for acceptance window) -/
def PenroseTiling.projectInternal (n : Fin 5 → ℤ) : ℂ :=
  ∑ k, (n k : ℂ) * PenroseTiling.pentagonVertex (2 * k)

/-- Internal projection for real coordinates -/
def PenroseTiling.projectInternalReal (v : Fin 5 → ℝ) : ℂ :=
  ∑ k, (v k : ℂ) * PenroseTiling.pentagonVertex (2 * k)

/-- Acceptance window: projection of unit hypercube -/
def PenroseTiling.AcceptanceWindow : Set ℂ :=
  { z | ∃ v : Fin 5 → ℝ, (∀ k, 0 ≤ v k ∧ v k ≤ 1) ∧ z = PenroseTiling.projectInternalReal v }

/-- The Penrose tiling vertex set via cut-and-project -/
def PenroseTiling.Vertices : Set ℂ :=
  { z | ∃ n : Fin 5 → ℤ, z = PenroseTiling.projectPhysical n ∧ (PenroseTiling.projectInternal n + PenroseTiling.projectInternalReal PenroseTiling.gamma) ∈ PenroseTiling.AcceptanceWindow }

/-- Penrose tiling vertices are countable -/
