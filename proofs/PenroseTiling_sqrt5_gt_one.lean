      · exact Set.mem_union_right _ ( Set.mem_range_self _ )

/-- Every vertex has finitely many neighbors -/
instance (v : PenroseTiling.Vertices) : Finite (PenroseTiling.Graph.neighborSet v) := by
  have h_neighbor_finite : Set.Finite (PenroseTiling.potentialNeighbors v.val) := by
