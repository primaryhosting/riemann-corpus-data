          have h_fubini : ∫⁻ (x : PenroseTiling.Vertices), ∑ y ∈ PenroseTiling.Graph.neighborFinset x, ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ ≤ 10 * ∫⁻ (y : PenroseTiling.Vertices), ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ := by
            have h_fubini : ∫⁻ (x : PenroseTiling.Vertices), ∑ y ∈ PenroseTiling.Graph.neighborFinset x, ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ = ∑' (y : PenroseTiling.Vertices), ‖f y‖ₑ ^ 2 * (PenroseTiling.Graph.degree y) := by
              have h_fubini : ∫⁻ (x : PenroseTiling.Vertices), ∑ y ∈ PenroseTiling.Graph.neighborFinset x, ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ = ∑' (y : PenroseTiling.Vertices), ∑' (x : PenroseTiling.Vertices), ‖f y‖ₑ ^ 2 * (if x ∈ PenroseTiling.Graph.neighborFinset y then 1 else 0) := by
                have h_fubini : ∫⁻ (x : PenroseTiling.Vertices), ∑ y ∈ PenroseTiling.Graph.neighborFinset x, ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ = ∑' (y : PenroseTiling.Vertices), ∫⁻ (x : PenroseTiling.Vertices), ‖f y‖ₑ ^ 2 * (if x ∈ PenroseTiling.Graph.neighborFinset y then 1 else 0) ∂PenroseTiling.μ := by
                  rw [ ← MeasureTheory.lintegral_tsum ];
                  · congr with x;
                    rw [ tsum_eq_sum ];
                    any_goals exact PenroseTiling.Graph.neighborFinset x;
                    · refine' Finset.sum_congr rfl fun y hy => _;
                      simp_all +decide [ SimpleGraph.adj_comm ];
                    · simp +contextual [ SimpleGraph.adj_comm ];
                  · intro i;
                    exact Measurable.aemeasurable ( by exact Measurable.mul ( measurable_const ) ( by exact Measurable.ite ( by exact Set.Finite.measurableSet ( Finset.finite_toSet _ ) ) measurable_const measurable_const ) );
                rw [ h_fubini, ← tsum_congr ];
                intro y; rw [ MeasureTheory.lintegral_congr_ae ];
                rw [ MeasureTheory.lintegral_countable' ];
                rotate_left;
                use fun x => ‖f y‖ₑ ^ 2 * ( if x ∈ PenroseTiling.Graph.neighborFinset y then 1 else 0 );
                · rfl;
                · simp +decide [ PenroseTiling.μ ];
              simp_all +decide [ Finset.sum_ite ];
              refine' tsum_congr fun y => _;
              rw [ tsum_eq_sum ];
              any_goals exact PenroseTiling.Graph.neighborFinset y;
              · rw [ Finset.sum_congr rfl fun x hx => if_pos <| by simpa using hx ] ; simp +decide [ mul_comm ];
              · simp +contextual [ SimpleGraph.adj_comm ];
            have h_fubini : ∀ y : PenroseTiling.Vertices, ‖f y‖ₑ ^ 2 * (PenroseTiling.Graph.degree y) ≤ 10 * ‖f y‖ₑ ^ 2 := by
              intro y; rw [ mul_comm ] ; gcongr;
              exact_mod_cast PenroseTiling.degree_bound y;
            convert ENNReal.tsum_le_tsum h_fubini using 1;
            rw [ MeasureTheory.lintegral_countable' ];
            simp +decide [ ENNReal.tsum_mul_left, PenroseTiling.μ ];
          rw [ MeasureTheory.lintegral_const_mul' ] <;> norm_num;
          convert mul_le_mul_left' h_fubini 10 using 1 ; ring;
        have h_fubini : (∫⁻ (x : PenroseTiling.Vertices), ‖PenroseTiling.A_raw f x‖ₑ ^ 2 ∂PenroseTiling.μ) ^ (1 / 2 : ℝ) ≤ (100 * ∫⁻ (y : PenroseTiling.Vertices), ‖f y‖ₑ ^ 2 ∂PenroseTiling.μ) ^ (1 / 2 : ℝ) := by
          gcongr;
          refine' le_trans _ ( h_fubini.trans' ‹_› );
          refine' MeasureTheory.lintegral_mono fun x => _;
          -- Apply the triangle inequality to the sum of the norms.
          have h_triangle : ‖∑ y ∈ PenroseTiling.Graph.neighborFinset x, f y‖ₑ ≤ ∑ y ∈ PenroseTiling.Graph.neighborFinset x, ‖f y‖ₑ := by
            exact?;
          exact pow_le_pow_left₀ ( by positivity ) h_triangle 2;
        convert h_fubini using 1 ; norm_num [ MeasureTheory.eLpNorm ];
        rw [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ] <;> norm_num;
        rw [ ENNReal.mul_rpow_of_nonneg ] <;> norm_num;
        rw [ show ( 100 : ENNReal ) = 10 ^ 2 by norm_num, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul ] ; norm_num;
      · norm_num;
      · norm_num

/-- Adjacency preserves ℓ² membership -/
lemma PenroseTiling.memLp_A_raw {f : PenroseTiling.Vertices → ℂ} (hf : MeasureTheory.MemLp f 2 PenroseTiling.μ) : MeasureTheory.MemLp (PenroseTiling.A_raw f) 2 PenroseTiling.μ := by
  refine ⟨Measurable.aestronglyMeasurable (measurable_of_countable _), ?_⟩
  exact lt_of_le_of_lt (PenroseTiling.A_raw_bound f) (ENNReal.mul_lt_top ENNReal.coe_lt_top hf.eLpNorm_lt_top)

/-- Almost everywhere equality implies pointwise equality for counting measure -/
lemma PenroseTiling.ae_eq_of_count {f g : PenroseTiling.Vertices → ℂ} (h : f =ᵐ[PenroseTiling.μ] g) : f = g := by
  -- Since the Penrose tiling vertices are countable, the counting measure μ is such that if f equals g almost everywhere, then f must equal g everywhere.
  have h_countable : ∀ (s : Set PenroseTiling.Vertices), MeasureTheory.Measure.count s = 0 → s = ∅ := by
    aesop;
  -- Apply the countability result to conclude that the set where f and g differ is empty.
  have h_empty : {x : PenroseTiling.Vertices | f x ≠ g x} = ∅ := by
    exact h_countable _ h;
  exact funext fun x => Classical.not_not.1 fun hx => h_empty.subset hx

-- Adjacency on AEEqFun with proper quotient structure
def PenroseTiling.A_ae : (PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) → (PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) :=
  Quotient.lift (fun f : {f : PenroseTiling.Vertices → ℂ // MeasureTheory.AEStronglyMeasurable f PenroseTiling.μ} =>
    MeasureTheory.AEEqFun.mk (PenroseTiling.A_raw f.1) (measurable_of_countable _).aestronglyMeasurable)
    (fun _ _ h => MeasureTheory.AEEqFun.mk_eq_mk.mpr <| by rw [PenroseTiling.ae_eq_of_count h])

lemma PenroseTiling.A_ae_add (f g : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) : PenroseTiling.A_ae (f + g) = PenroseTiling.A_ae f + PenroseTiling.A_ae g := by
  induction' f using Quotient.inductionOn' with f
  induction' g using Quotient.inductionOn' with g
  erw [Quotient.eq'']
  filter_upwards with x
  simp [PenroseTiling.A_raw, Finset.sum_add_distrib]

lemma PenroseTiling.A_ae_smul (c : ℂ) (f : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) : PenroseTiling.A_ae (c • f) = c • PenroseTiling.A_ae f := by
  obtain ⟨f, _⟩ := f
  convert MeasureTheory.AEEqFun.mk_eq_mk.mpr _
  filter_upwards with u
  simp [PenroseTiling.A_raw, Finset.mul_sum]

lemma PenroseTiling.A_ae_memLp (f : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) (hf : f ∈ Lp ℂ 2 PenroseTiling.μ) : PenroseTiling.A_ae f ∈ Lp ℂ 2 PenroseTiling.μ := by
  obtain ⟨ g, hg ⟩ := f;
  -- Since the raw adjacency operator is bounded, applying it to an L² function should give another L² function.
  have h_bounded : ∀ f : PenroseTiling.Vertices → ℂ, MeasureTheory.MemLp f 2 PenroseTiling.μ → MeasureTheory.MemLp (PenroseTiling.A_raw f) 2 PenroseTiling.μ := by
    -- Apply the lemma that states the raw adjacency operator preserves L² membership.
    apply PenroseTiling.memLp_A_raw;
  -- Apply the boundedness result to g.
  have h_A_ae_g : MeasureTheory.MemLp (PenroseTiling.A_raw g) 2 PenroseTiling.μ := by
    apply h_bounded;
    rw [ MeasureTheory.MemLp ];
    rw [ MeasureTheory.Lp.mem_Lp_iff_eLpNorm_lt_top ] at hf ; aesop;
  convert h_A_ae_g using 1;
  simp +decide [ MeasureTheory.Lp, MeasureTheory.MemLp ];
  erw [ MeasureTheory.eLpNorm_congr_ae ];
  exact ⟨ fun h => ⟨ h_A_ae_g.1, h ⟩, fun h => h.2 ⟩;
  exact MeasureTheory.AEEqFun.coeFn_mk _ _ |> fun h => h.mono fun x hx => by aesop;

/-- The adjacency operator as a bounded linear map on ℓ² -/
def PenroseTiling.A : PenroseTiling.L2 →ₗ[ℂ] PenroseTiling.L2 where
  toFun f := ⟨PenroseTiling.A_ae f.1, PenroseTiling.A_ae_memLp f.1 f.2⟩
  map_add' f g := Subtype.eq (PenroseTiling.A_ae_add f.1 g.1)
  map_smul' c f := Subtype.eq (PenroseTiling.A_ae_smul c f.1)

/-- Degree as complex-valued function -/
def PenroseTiling.deg_fn (u : PenroseTiling.Vertices) : ℂ := (PenroseTiling.Graph.degree u : ℂ)

/-- Degree is bounded by 10 -/
lemma PenroseTiling.deg_fn_bound (u : PenroseTiling.Vertices) : ‖PenroseTiling.deg_fn u‖ ≤ 10 := by
  simp [PenroseTiling.deg_fn]
  convert PenroseTiling.degree_bound u using 1

/-- Raw degree operator: multiplication by degree -/
def PenroseTiling.D_raw (f : PenroseTiling.Vertices → ℂ) (u : PenroseTiling.Vertices) : ℂ := PenroseTiling.deg_fn u * f u

/-- Degree operator preserves ℓ² -/
lemma PenroseTiling.memLp_D_raw {f : PenroseTiling.Vertices → ℂ} (hf : MeasureTheory.MemLp f 2 PenroseTiling.μ) : MeasureTheory.MemLp (PenroseTiling.D_raw f) 2 PenroseTiling.μ := by
  -- Since the degree is bounded by 10, we can use the fact that multiplying by a bounded function preserves the L^2 property.
  have h_deg_bound : ∀ u : PenroseTiling.Vertices, ‖PenroseTiling.deg_fn u‖ ≤ 10 := by
    exact?;
  refine' MeasureTheory.MemLp.mono' _ _ _;
  refine' fun u => 10 * ‖f u‖;
  · exact MeasureTheory.MemLp.const_mul ( hf.norm ) _;
  · exact?;
  · filter_upwards [ ] with u using by rw [ show PenroseTiling.D_raw f u = PenroseTiling.deg_fn u * f u from rfl ] ; simpa only [ norm_mul ] using mul_le_mul_of_nonneg_right ( h_deg_bound u ) ( norm_nonneg _ ) ;

def PenroseTiling.D_ae : (PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) → (PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) :=
  Quotient.lift (fun f : {f : PenroseTiling.Vertices → ℂ // MeasureTheory.AEStronglyMeasurable f PenroseTiling.μ} =>
    MeasureTheory.AEEqFun.mk (PenroseTiling.D_raw f.1) (measurable_of_countable _).aestronglyMeasurable)
    (fun _ _ h => MeasureTheory.AEEqFun.mk_eq_mk.mpr <| by rw [PenroseTiling.ae_eq_of_count h])

lemma PenroseTiling.D_ae_add (f g : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) : PenroseTiling.D_ae (f + g) = PenroseTiling.D_ae f + PenroseTiling.D_ae g := by
  induction' f using Quotient.inductionOn' with f
  induction' g using Quotient.inductionOn' with g
  erw [Quotient.eq'']
  filter_upwards with x
  simp [PenroseTiling.D_raw, mul_add]

lemma PenroseTiling.D_ae_smul (c : ℂ) (f : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) : PenroseTiling.D_ae (c • f) = c • PenroseTiling.D_ae f := by
  obtain ⟨f, _⟩ := f
  convert MeasureTheory.AEEqFun.mk_eq_mk.mpr _
  filter_upwards with u
  simp [PenroseTiling.D_raw, mul_comm c, mul_assoc]

lemma PenroseTiling.D_ae_memLp (f : PenroseTiling.Vertices →ₘ[PenroseTiling.μ] ℂ) (hf : f ∈ MeasureTheory.Lp ℂ 2 PenroseTiling.μ) : PenroseTiling.D_ae f ∈ MeasureTheory.Lp ℂ 2 PenroseTiling.μ := by
  -- Since $f$ is in $L^2$, multiplying it by a bounded function (the degree) should keep it in $L^2$.
  have hD_bounded : ∃ C : ℝ, ∀ u : PenroseTiling.Vertices, ‖PenroseTiling.deg_fn u‖ ≤ C := by
    exact ⟨ 10, fun u => PenroseTiling.deg_fn_bound u ⟩;
  have hD_bounded : ∀ f : PenroseTiling.Vertices → ℂ, MeasureTheory.MemLp f 2 PenroseTiling.μ → MeasureTheory.MemLp (fun u => PenroseTiling.deg_fn u * f u) 2 PenroseTiling.μ := by
    intro f hf; obtain ⟨ C, hC ⟩ := hD_bounded; refine' MeasureTheory.MemLp.mono' _ _ _;
    use fun u => C * ‖f u‖;
    · exact MeasureTheory.MemLp.const_mul ( hf.norm ) _;
    · exact?;
    · filter_upwards [ ] using fun u => by simpa only [ norm_mul ] using mul_le_mul_of_nonneg_right ( hC u ) ( norm_nonneg _ ) ;
  obtain ⟨ g, hg ⟩ := f;
  -- Apply the boundedness result to conclude that the product is in L^2.
  have h_prod_L2 : MeasureTheory.MemLp (fun u => PenroseTiling.deg_fn u * g u) 2 PenroseTiling.μ := by
    convert hD_bounded g _;
    convert hf using 1;
    simp +decide [ MeasureTheory.MemLp, MeasureTheory.Lp ];
    exact?;
  convert h_prod_L2 using 1;
  simp +decide [ MeasureTheory.Lp, MeasureTheory.MemLp ];
  erw [ MeasureTheory.eLpNorm_congr_ae ];
  any_goals exact fun u => PenroseTiling.deg_fn u * g u;
  · exact ⟨ fun h => ⟨ h_prod_L2.1, h ⟩, fun h => h.2 ⟩;
  · exact MeasureTheory.AEEqFun.coeFn_mk _ _ |> fun h => h.mono fun u hu => by aesop;

/-- The degree operator as a bounded linear map on ℓ² -/
def PenroseTiling.D : PenroseTiling.L2 →ₗ[ℂ] PenroseTiling.L2 where
  toFun f := ⟨PenroseTiling.D_ae f.1, PenroseTiling.D_ae_memLp f.1 f.2⟩
  map_add' f g := Subtype.eq (PenroseTiling.D_ae_add f.1 g.1)
  map_smul' c f := Subtype.eq (PenroseTiling.D_ae_smul c f.1)

/--
THE GRAPH LAPLACIAN: Δ = D - A

This operator represents the quantum Hamiltonian for an electron on the
Penrose lattice. Its eigenvalues are the allowed energy levels, and its
eigenfunctions are the quantum states.

PHYSICAL INTERPRETATION:
- Δψ = λψ means ψ is a stationary state with energy λ
- The spectrum of Δ determines all quantum properties
- Diffraction patterns arise from Fourier transforms of eigenfunctions
-/
def PenroseTiling.Δ : PenroseTiling.L2 →ₗ[ℂ] PenroseTiling.L2 := PenroseTiling.D - PenroseTiling.A

#check @inner
