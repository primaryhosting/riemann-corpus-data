/-- Neighbors are subset of potential neighbors -/
lemma PenroseTiling.neighbor_subset (u : PenroseTiling.Vertices) :
    PenroseTiling.Graph.neighborSet u ⊆ {v | v.1 ∈ PenroseTiling.potentialNeighbors u.1} := by
      -- By definition of adjacency, if v is adjacent to u, then there exists some k such that v = u + pentagonVertex k or v = u - pentagonVertex k.
      intro v hv
      obtain ⟨k, hk⟩ : ∃ k : Fin 5, v.val = u.val + PenroseTiling.pentagonVertex k ∨ v.val = u.val - PenroseTiling.pentagonVertex k := by
