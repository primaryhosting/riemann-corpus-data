    rintro z ⟨n, rfl, _⟩
    exact Set.mem_range_self n
  exact Set.Countable.to_subtype (Set.Countable.mono h_subset h_range)

/-- Adjacency: vertices connected by a pentagon edge -/
def PenroseTiling.adjacent (u v : ℂ) : Prop := ∃ k : Fin 5, v = u + PenroseTiling.pentagonVertex k

/-- The Penrose graph -/
def PenroseTiling.Graph : SimpleGraph PenroseTiling.Vertices :=
  SimpleGraph.fromRel (fun u v => PenroseTiling.adjacent u.1 v.1)

/-- Potential neighbors within distance ≤ 1 -/
def PenroseTiling.potentialNeighbors (u : ℂ) : Set ℂ :=
  (Set.range (fun k : Fin 5 => u + PenroseTiling.pentagonVertex k)) ∪
  (Set.range (fun k : Fin 5 => u - PenroseTiling.pentagonVertex k))

/-- Potential neighbors form a finite set -/
lemma PenroseTiling.potentialNeighbors_finite (u : ℂ) : (PenroseTiling.potentialNeighbors u).Finite := by
  -- The range of a finite function is finite, so both the range of u + pentagonVertex k and the range of u - pentagonVertex k are finite.
  have h_range_finite : Set.Finite (Set.range (fun k : Fin 5 => u + PenroseTiling.pentagonVertex k)) ∧ Set.Finite (Set.range (fun k : Fin 5 => u - PenroseTiling.pentagonVertex k)) := by
    -- Since Fin 5 is finite, the image of a function from Fin 5 to any set is finite.
    apply And.intro;
    · -- The range of a function from a finite type to any type is finite.
      apply Set.toFinite;
    · -- The range of a function from a finite set to any set is finite.
      apply Set.toFinite;
  -- The union of two finite sets is finite.
  apply Set.Finite.union h_range_finite.left h_range_finite.right

/-- Potential neighbors have cardinality at most 10 -/
lemma PenroseTiling.potentialNeighbors_card (u : ℂ) : (PenroseTiling.potentialNeighbors u).ncard ≤ 10 := by
  -- The set of potential neighbors is the union of two sets, each with cardinality at most 5.
  have h_union_card : (Set.range (fun k : Fin 5 => u + PenroseTiling.pentagonVertex k) ∪ Set.range (fun k : Fin 5 => u - PenroseTiling.pentagonVertex k)).ncard ≤ (Set.range (fun k : Fin 5 => u + PenroseTiling.pentagonVertex k)).ncard + (Set.range (fun k : Fin 5 => u - PenroseTiling.pentagonVertex k)).ncard := by
    -- Apply the fact that the cardinality of the union of two sets is less than or equal to the sum of their cardinalities.
    apply Set.ncard_union_le;
  -- Since each range has at most 5 elements, their sum is at most 10.
  have h_range_card : (Set.range (fun k : Fin 5 => u + PenroseTiling.pentagonVertex k)).ncard ≤ 5 ∧ (Set.range (fun k : Fin 5 => u - PenroseTiling.pentagonVertex k)).ncard ≤ 5 := by
    exact ⟨ by rw [ Set.ncard_eq_toFinset_card _ ] ; simpa using Finset.card_image_le.trans ( by decide ), by rw [ Set.ncard_eq_toFinset_card _ ] ; simpa using Finset.card_image_le.trans ( by decide ) ⟩;
