        obtain ⟨k, hk⟩ := hv;
        rcases hk with ( ⟨ k, hk ⟩ | ⟨ k, hk ⟩ ) <;> [ exact ⟨ k, Or.inl hk ⟩ ; exact ⟨ k, Or.inr <| by linear_combination -hk ⟩ ];
