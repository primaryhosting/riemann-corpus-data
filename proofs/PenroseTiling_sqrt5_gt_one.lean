  have h_card_neighbor : (PenroseTiling.Graph.neighborSet u).ncard ≤ (Set.range (fun k : Fin 5 => u.val + PenroseTiling.pentagonVertex k) ∪ Set.range (fun k : Fin 5 => u.val - PenroseTiling.pentagonVertex k)).ncard := by
    have h_subset : PenroseTiling.Graph.neighborSet u ⊆ {v | v.1 ∈ PenroseTiling.potentialNeighbors u.1} := by
      exact?
    convert Set.ncard_le_ncard ( show ( Set.image Subtype.val ( PenroseTiling.Graph.neighborSet u ) ) ⊆ ( Set.range fun k : Fin 5 => ( u : ℂ ) + PenroseTiling.pentagonVertex k ) ∪ Set.range fun k : Fin 5 => ( u : ℂ ) - PenroseTiling.pentagonVertex k from ?_ ) using 1;
