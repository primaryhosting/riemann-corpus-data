open Nat

/-- A small convenience: "n lies on the residue ray r mod m". -/
def RayInter (m r n : ℕ) : Prop := Nat.ModEq m n r

/-- If r < m then r % m = r. -/
lemma mod_eq_of_lt {m r : ℕ} (hr : r < m) : r % m = r := by
  exact Nat.mod_eq_of_lt hr

/-- If m > 0 then n = m*(n/m) + n%m. -/
lemma div_mod_decomp {m n : ℕ} (hm : 0 < m) : n = m * (n / m) + (n % m) := by
  -- `Nat.mod_add_div` says: n % m + m * (n / m) = n
  -- rearrange to the preferred order.
  simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using (Nat.mod_add_div n m).symm

/--
Key equivalence 1: if r < m, then ModEq m n r is exactly the statement
that n%m = r.
-/
theorem modEq_iff_mod_eq {m r n : ℕ} (hr : r < m) :
    Nat.ModEq m n r ↔ n % m = r := by
      -- By definition of congruence modulo m, we have n ≡ r [MOD m] if and only if m divides (n - r).
      simp [Nat.ModEq];
      -- Since $r < m$, we have $r \% m = r$.
      simp [Nat.mod_eq_of_lt hr]

/--
Key equivalence 2 (normal form): if m > 0 and r < m, then
  ModEq m n r ↔ ∃ t, n = m*t + r.
-/
theorem modEq_iff_exists_eq_mul_add {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    Nat.ModEq m n r ↔ ∃ t : ℕ, n = m * t + r := by
  constructor
  · intro h
    -- reduce to n%m = r
    have hmod : n % m = r := (modEq_iff_mod_eq (m := m) (r := r) (n := n) hr).1 h
    -- choose t = n/m, then use division algorithm
    refine ⟨n / m, ?_⟩
    -- n = m*(n/m) + n%m = m*(n/m) + r
    calc
      n = m * (n / m) + (n % m) := div_mod_decomp (m := m) (n := n) hm
      _ = m * (n / m) + r := by simpa [hmod]
  · rintro ⟨t, rfl⟩
    -- show (m*t + r) ≡ r (mod m)
    -- i.e. (m*t + r) % m = r % m, and since r<m, r%m=r.
    -- Use `Nat.add_mul_mod_self_left`:
    --   (r + m*t) % m = r % m
    -- Our expression is m*t + r; commute.
    have : (m * t + r) % m = r % m := by
      -- rewrite as r + m*t to use the lemma
      simpa [Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using
        (Nat.add_mul_mod_self_left r t m)
    -- Now pack into ModEq
    -- ModEq definition: a % m = b % m
    -- We have (m*t + r) % m = r % m already.
    simpa [Nat.ModEq] using this

/-- The same normal form stated for `RayInter`. -/
theorem rayInter_iff_exists {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    RayInter m r n ↔ ∃ t : ℕ, n = m * t + r := by
  simpa [RayInter] using (modEq_iff_exists_eq_mul_add (m := m) (r := r) (n := n) hm hr)

/-- A convenient corollary: if n = m*t + r then RayInter m r n holds (for r < m). -/
theorem rayInter_of_eq_mul_add {m r t : ℕ} (hm : 0 < m) (hr : r < m) :
    RayInter m r (m * t + r) := by
  have : (∃ u : ℕ, (m * t + r) = m * u + r) := ⟨t, rfl⟩
  exact (rayInter_iff_exists (m := m) (r := r) (n := (m * t + r)) hm hr).2 this
