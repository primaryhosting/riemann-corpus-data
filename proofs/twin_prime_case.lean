/-
A "Principal Configuration" (Admissible Residue) is a residue 'n' modulo 'q' such that:
1. n is not 0 (The prime p is not q itself)
2. n + g is not 0 (The prime p+g is not q itself)
-/
def admissible_residues (q : ℕ) [Fact q.Prime] (g : ℕ) : Finset (ZMod q) :=
  univ.filter (fun n => n ≠ 0 ∧ n + g ≠ 0)

