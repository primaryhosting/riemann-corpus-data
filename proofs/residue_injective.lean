def IsTwinPrimePair (p : ℕ) : Prop :=
  Nat.Prime p ∧ Nat.Prime (p + 2)

def TwinPairInRays (i j : BrockRay) (p : ℕ) : Prop :=
  IsTwinPrimePair p ∧ i.contains p ∧ j.contains (p + 2)

def PrincipalRayPairs : Finset (BrockRay × BrockRay) :=
  {(A, C), (B, D), (D, A)}

