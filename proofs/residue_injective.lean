theorem residue_injective : Function.Injective BrockRay.residue := by
  rintro ( _ | _ | _ | _ | _ | _ | _ ) ( _ | _ | _ | _ | _ | _ | _ ) <;> simp +decide

/-
Every natural number belongs to exactly one ray.
-/
def BrockRay.contains (r : BrockRay) (n : ℕ) : Prop :=
  n % 5 = r.residue.val

theorem unique_ray_membership (n : ℕ) : ∃! r : BrockRay, r.contains n := by
  -- Let's choose any ray $r$ that contains $n$.
  obtain ⟨r, hr⟩ : ∃ r : BrockRay, r.contains n := by
    have h_exists_r : ∃ r : BrockRay, r.contains n := by
      have h : ∃ r : Fin 5, r.val = n % 5 := by
        exact ⟨ ⟨ n % 5, Nat.mod_lt _ ( by decide ) ⟩, rfl ⟩
      obtain ⟨ r, hr ⟩ := h;
      use if r = 0 then E else if r = 1 then A else if r = 2 then B else if r = 3 then C else D;
      fin_cases r <;> simp_all +decide [ BrockRay.contains ];
      · exact?;
      · exact hr.symm;
      · exact hr.symm;
      · exact hr.symm;
      · exact hr.symm;
    exact h_exists_r;
  -- Since the rays are defined such that each natural number belongs to exactly one ray, if there were another ray s containing n, it would contradict the uniqueness.
  have h_unique : ∀ s : BrockRay, s.contains n → s = r := by
    intro s hs;
    rcases s with ( _ | _ | _ | _ | _ | s ) <;> rcases r with ( _ | _ | _ | _ | _ | r ) <;> norm_num [ BrockRay.contains ] at *;
    all_goals cases hr.symm.trans hs;
  exact ⟨ r, hr, h_unique ⟩

/-
Definition of rayOf and its properties.
-/
noncomputable def rayOf (n : ℕ) : BrockRay :=
  (unique_ray_membership n).choose

theorem rayOf_contains (n : ℕ) : (rayOf n).contains n := by
  have := Exists.choose_spec ( unique_ray_membership n );
  bound

theorem rayOf_unique (n : ℕ) (r : BrockRay) (h : r.contains n) : rayOf n = r := by
  -- Since $r.contains n$, we have $n \equiv r.residue.val \pmod{5}$. By the uniqueness part of the theorem, this implies $rayOf n = r$.
  have h_unique : ∀ r' : BrockRay, r'.contains n → r' = r := by
    cases unique_ray_membership n ; aesop;
  exact h_unique _ ( Classical.choose_spec ( unique_ray_membership n ) |>.1 )

