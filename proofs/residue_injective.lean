      -- By choosing $\epsilon = C/4$ in the asymptotic condition, we can find an $x_0$ such that for all $x \ge x_0$, the count of twin primes is at least $(C/4) * x / (\log x)^2$.
      have h_eps : ∃ x₀ : ℝ, ∀ x ≥ x₀, real_twin_prime_counting_function x ≥ (totalTwinConstant / 4) * x / (Real.log x)^2 := by
        obtain ⟨ x₀, hx₀ ⟩ := h_asymp ( totalTwinConstant / 4 ) ( by linarith [ show 0 < totalTwinConstant from totalTwinConstant_pos ] );
        -- Since $Li₂(x) \geq \frac{1}{2} \frac{x}{\log^2 x}$ for large $x$, we have $totalTwinConstant * Li₂(x) \geq \frac{totalTwinConstant}{2} \frac{x}{\log^2 x}$.
        have h_Li₂_bound : ∃ x₁ : ℝ, ∀ x ≥ x₁, Li₂ x ≥ (1 / 2) * x / (Real.log x)^2 := by
          use 200; intro x hx; refine' le_trans _ ( intervalIntegral.integral_mono_on _ _ _ fun t ht => mul_le_mul_of_nonneg_left ( inv_anti₀ ( sq_pos_of_pos <| Real.log_pos <| by linarith [ ht.1 ] ) <| pow_le_pow_left₀ ( Real.log_nonneg <| by linarith [ ht.1 ] ) ( Real.log_le_log ( by linarith [ ht.1 ] ) ht.2 ) 2 ) <| by positivity ) <;> norm_num;
          · rw [ ← div_eq_mul_inv ] ; rw [ div_le_div_iff₀ ] <;> nlinarith [ Real.log_pos ( by linarith : 1 < x ), Real.log_le_sub_one_of_pos ( by linarith : 0 < x ), pow_two_nonneg ( Real.log x - 2 ) ];
          · linarith;
          · apply_rules [ ContinuousOn.intervalIntegrable ];
            exact continuousOn_of_forall_continuousAt fun t ht => ContinuousAt.inv₀ ( ContinuousAt.pow ( Real.continuousAt_log ( by cases Set.mem_uIcc.mp ht <;> linarith ) ) _ ) ( ne_of_gt ( sq_pos_of_pos ( Real.log_pos ( by cases Set.mem_uIcc.mp ht <;> linarith ) ) ) );
        obtain ⟨ x₁, hx₁ ⟩ := h_Li₂_bound; use Max.max x₀ x₁; intro x hx; have := hx₀ x ( le_trans ( le_max_left _ _ ) hx ) ; have := hx₁ x ( le_trans ( le_max_right _ _ ) hx ) ; norm_num [ abs_lt ] at *;
        ring_nf at *; nlinarith [ show 0 ≤ totalTwinConstant by exact le_of_lt ( show 0 < totalTwinConstant from by exact lt_of_le_of_lt ( by norm_num ) ( totalTwinConstant_pos ) ) ] ;
      -- Since the count of twin primes tends to infinity, for any $N$, there exists an $x$ such that the count of twin primes up to $x$ is greater than $N$.
      have h_inf : ∀ N : ℕ, ∃ x : ℝ, real_twin_prime_counting_function x > N := by
        have h_inf : Filter.Tendsto (fun x : ℝ => (totalTwinConstant / 4) * x / (Real.log x)^2) Filter.atTop Filter.atTop := by
          -- We can use the change of variables $u = \log x$ to transform the limit expression.
          suffices h_log : Filter.Tendsto (fun u : ℝ => (totalTwinConstant / 4) * Real.exp u / u^2) Filter.atTop Filter.atTop by
            have := h_log.comp Real.tendsto_log_atTop;
            exact this.congr' ( by filter_upwards [ Filter.eventually_gt_atTop 0 ] with x hx using by rw [ Function.comp_apply, Real.exp_log hx ] );
          have := Real.tendsto_exp_div_pow_atTop 2;
          simpa only [ mul_div_assoc ] using this.const_mul_atTop ( show 0 < totalTwinConstant / 4 by exact div_pos ( show 0 < totalTwinConstant by exact? ) zero_lt_four );
        exact fun N => by rcases Filter.eventually_atTop.mp ( h_inf.eventually_gt_atTop N ) with ⟨ x₀, hx₀ ⟩ ; rcases h_eps with ⟨ x₁, hx₁ ⟩ ; exact ⟨ Max.max x₀ x₁, by linarith [ hx₀ ( Max.max x₀ x₁ ) ( le_max_left _ _ ), hx₁ ( Max.max x₀ x₁ ) ( le_max_right _ _ ) ] ⟩ ;
      contrapose! h_inf;
      obtain ⟨ N, hN ⟩ := h_inf;
      use ∑ x ∈ Finset.range ( N + 1 ), if IsTwinPrimePair x then 1 else 0;
      intro x; rw [ real_twin_prime_counting_function ] ; norm_cast; simp +decide [ Finset.sum_filter, Finset.sum_range_succ' ] ;
      rw [ show countTwinPrimes ⌊x⌋₊ = Finset.card ( Finset.filter IsTwinPrimePair ( Finset.range ( ⌊x⌋₊ + 1 ) ) ) from ?_ ];
      · exact Finset.card_mono fun x hx => Finset.mem_filter.mpr ⟨ Finset.mem_range.mpr ( Nat.lt_succ_of_le ( le_of_not_gt fun hx' => hN x hx' <| Finset.mem_filter.mp hx |>.2 ) ), Finset.mem_filter.mp hx |>.2 ⟩;
      · rw [ countTwinPrimes ];
        rw [ List.countP_eq_length_filter ];
        congr

/-
Conditional reduction of RH to spectral identity (with necessary hypotheses).
-/
theorem rh_reduction
    (h_real : ∀ s : ℂ, spectralDeterminant s = 0 → s.im = 0)
    (h_nontrivial : ∃ s, spectralDeterminant s ≠ 0) :
    ∀ s : ℂ, riemannZeta s = 0 → 0 < s.re ∧ s.re < 1 → s.re = 1/2 := by
  unfold spectralDeterminant at *; aesop;

/-
Li₂ tends to infinity.
-/
theorem Li2_unbounded : Filter.Tendsto Li₂ Filter.atTop Filter.atTop := by
  -- We can use the fact that the integral of $\frac{1}{(\ln t)^2}$ diverges.
  have h_integral_diverges : Filter.Tendsto (fun x => ∫ t in (2)..x, (1 : ℝ) / (Real.log t)^2) Filter.atTop Filter.atTop := by
    -- We can use the fact that the integral of $\frac{1}{(\ln t)^2}$ over $[2, x]$ is greater than or equal to $\int_{2}^{x} \frac{dt}{t}$.
    have h_integral_ge : ∀ x : ℝ, 2 ≤ x → ∫ t in (2)..x, (1 : ℝ) / (Real.log t)^2 ≥ ∫ t in (2)..x, (1 : ℝ) / t := by
      intro x hx; refine' intervalIntegral.integral_mono_on _ _ _ _ <;> norm_num;
      · linarith;
      · exact ContinuousOn.intervalIntegrable ( by exact continuousOn_of_forall_continuousAt fun t ht => ContinuousAt.div continuousAt_const continuousAt_id <| by linarith [ Set.mem_Icc.mp <| by simpa [ hx ] using ht ] ) ..;
      · apply_rules [ ContinuousOn.intervalIntegrable ];
        exact ContinuousOn.inv₀ ( ContinuousOn.pow ( Real.continuousOn_log.mono <| by norm_num [ hx ] ) _ ) fun t ht => ne_of_gt <| sq_pos_of_pos <| Real.log_pos <| by cases Set.mem_uIcc.mp ht <;> linarith;
      · intro y hy₁ hy₂; gcongr;
        · exact sq_pos_of_pos <| Real.log_pos <| by linarith;
        · -- We'll use the fact that $\ln y \leq \sqrt{y}$ for all $y \geq 2$.
          have h_ln_le_sqrt : ∀ y : ℝ, 2 ≤ y → Real.log y ≤ Real.sqrt y := by
            intro y hy; have := Real.log_le_sub_one_of_pos ( by positivity : 0 < Real.sqrt y / 2 ) ; rw [ Real.log_div ( by positivity ) ( by positivity ), Real.log_sqrt ( by positivity ) ] at this ; ring_nf at * ; norm_num at *;
            have := Real.log_two_lt_d9 ; norm_num at * ; linarith;
          exact le_trans ( pow_le_pow_left₀ ( Real.log_nonneg ( by linarith ) ) ( h_ln_le_sqrt y hy₁ ) 2 ) ( by rw [ Real.sq_sqrt ( by linarith ) ] );
    -- We can use the fact that the integral of $\frac{1}{t}$ over $[2, x]$ is $\ln x - \ln 2$.
    have h_integral_ln : ∀ x : ℝ, 2 ≤ x → ∫ t in (2)..x, (1 : ℝ) / t = Real.log x - Real.log 2 := by
      intro x hx; rw [ integral_one_div_of_pos, Real.log_div ] <;> linarith;
    exact Filter.tendsto_atTop_atTop.mpr fun x => ⟨ Max.max 2 ( Real.exp ( x + Real.log 2 ) ), fun y hy => by linarith [ h_integral_ge y ( le_trans ( le_max_left _ _ ) hy ), h_integral_ln y ( le_trans ( le_max_left _ _ ) hy ), Real.log_exp ( x + Real.log 2 ), Real.log_le_log ( by positivity ) ( le_trans ( le_max_right _ _ ) hy ) ] ⟩;
  convert h_integral_diverges using 1

/-
Lower bound for Li₂.
-/
lemma Li2_lower_bound : ∃ x₀, ∀ x ≥ x₀, Li₂ x ≥ 0.5 * x / (Real.log x)^2 := by
  use 100;
  intro x hx
  have h_integral_bound : ∫ t in (2)..x, 1 / (Real.log t)^2 ≥ ∫ t in (2)..x, 1 / (Real.log x)^2 := by
    apply_rules [ intervalIntegral.integral_mono_on ];
    · linarith;
    · norm_num;
    · apply_rules [ ContinuousOn.intervalIntegrable ];
      exact continuousOn_of_forall_continuousAt fun u hu => ContinuousAt.div continuousAt_const ( ContinuousAt.pow ( Real.continuousAt_log ( by cases Set.mem_uIcc.mp hu <;> linarith ) ) _ ) ( pow_ne_zero _ <| ne_of_gt <| Real.log_pos <| by cases Set.mem_uIcc.mp hu <;> linarith );
    · exact fun y hy => one_div_le_one_div_of_le ( sq_pos_of_pos <| Real.log_pos <| by linarith [ hy.1 ] ) <| pow_le_pow_left₀ ( Real.log_nonneg <| by linarith [ hy.1 ] ) ( Real.log_le_log ( by linarith [ hy.1 ] ) hy.2 ) _;
  norm_num [ Li₂ ] at *;
  ring_nf at *; nlinarith [ inv_nonneg.mpr ( sq_nonneg ( Real.log x ) ) ] ;

