def total_proven : ℕ :=
  verification_stats.foldl (fun acc (_, proven, _) => acc + proven) 0

def total_theorems : ℕ :=
  verification_stats.foldl (fun acc (_, proven, total) => acc + total) 0

theorem verification_percentage : 
    (total_proven : ℚ) / total_theorems * 100 = 175 / 3 := by
  norm_num [total_proven, total_theorems, verification_stats]
