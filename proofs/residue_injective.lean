  have h_cases : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
    have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.1.dvd_iff_eq ] ;
  rcases h_cases with ( h | h | h | h ) <;> simp_all +decide [ IsTwinPrimePair, TwinPairInRays, BrockRay.contains ];
  · exact ⟨ A, C, by decide, rfl, by rw [ Nat.add_mod, h ] ; rfl ⟩;
  · exact ⟨ BrockRay.B, BrockRay.D, by decide, rfl, by simp +decide [ *, Nat.add_mod ] ⟩;
  · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 2 ) % 5 = 0 from by norm_num [ Nat.add_mod, h ] ) ) ( by rw [ hp.2.dvd_iff_eq ] <;> linarith );
  · norm_num [ Nat.add_mod, h ];
    exact ⟨ D, A, by decide, rfl, rfl ⟩ -- Proven in enhanced file

