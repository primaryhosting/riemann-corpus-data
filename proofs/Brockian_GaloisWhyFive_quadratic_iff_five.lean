/-
  Brockian/GaloisWhyFive.lean — the Galois-degree face of "why five".

  The adjacency spectrum of the cycle graph `C_p` consists of the eigenvalues
  `2 cos(2πk/p)`.  The number-theoretic reason the pentagon is special is a
  statement about the *field* generated by the spectral generator
  `α_p := 2 cos(2π/p)`:  among the primes it is the golden quadratic field
  `ℚ(√5)` for **exactly one** prime, `p = 5`.  This file makes the rigidity
  concrete by computing the degree `[ℚ(α_p) : ℚ] = deg (minpoly ℚ α_p)` for
  `p ∈ {3, 5, 7}`.

  ## What is proved (all AXLE-verified at lean-4.32.0, axioms ⊆
     {propext, Classical.choice, Quot.sound})

    * `spectralGen p`                  — `α_p = 2 cos(2π/p)`, the spectral generator.
    * `spectralGen_three`              — `α_3 = -1`  (rational).
    * `spectralGen_five`               — `α_5 = φ − 1` (the golden number),
                                          `φ = Real.goldenRatio`.
    * `goldenSubOne_irrational`        — `φ − 1` is irrational.
    * `degree_three`                   — `[ℚ(α_3):ℚ] = 1`  (α_3 ∈ ℚ).
    * `degree_five`                    — `[ℚ(α_5):ℚ] = 2`  (the golden QUADRATIC
                                          field; proved via the golden ratio being
                                          irrational + the annihilator `X²+X−1`).
    * `cubic_identity_seven`           — `α_7` is a root of `X³+X²−2X−1`
                                          (from `cos 4θ = cos 3θ` at `θ = 2π/7`).
    * `P7_irreducible`                 — `X³+X²−2X−1` is irreducible over `ℚ`
                                          (rational root theorem: any ℚ-root is an
                                          integer dividing `−1`, and `±1` are not roots).
    * `degree_seven`                   — `[ℚ(α_7):ℚ] = 3`  (so `X³+X²−2X−1 = minpoly ℚ α_7`).
    * `why_five`                       — **the rigidity**: among `p ∈ {3,5,7}` the
                                          adjacency spectrum lands in a real QUADRATIC
                                          field (`[ℚ(α_p):ℚ] = 2`) iff `p = 5`
                                          (degrees `1, 2, 3` respectively).
    * `quadratic_iff_five`             — the same, packaged as an `↔` over `{3,5,7}`.

  ## What is NOT proved (honestly open here)

    * The GENERAL degree theorem `[ℚ(2cos(2π/p)):ℚ] = (p−1)/2` for all primes `p`.
      That requires the degree of the maximal real subfield `ℚ(ζ_p)⁺` of the
      cyclotomic field, which Mathlib 4.32 does not package for this generator.
      We only verify the three small primes `{3,5,7}` bracketing `p = 5`.  The
      `{3,5,7}` computation is nonetheless a genuine rigidity result: it exhibits
      degrees `1 < 2 < 3` and isolates the quadratic (golden) case at `p = 5`.
-/
import Mathlib

namespace Brockian.GaloisWhyFive

open Polynomial

/-! ### The spectral generator -/

/-- **`α_p = 2 cos(2π/p)`** — the generator of the field cut out by the adjacency
spectrum of the cycle `C_p` (its eigenvalues are `2 cos(2πk/p)`; `k = 1` generates). -/
noncomputable def spectralGen (p : ℕ) : ℝ := 2 * Real.cos (2 * Real.pi / p)

/-! ### p = 3 : the rational case (degree 1) -/

/-- **`α_3 = −1`.** `cos(2π/3) = −1/2`, so the eigenvalue is rational. -/
theorem spectralGen_three : spectralGen 3 = -1 := by
  have h : (2 * Real.pi / ((3 : ℕ) : ℝ)) = Real.pi - Real.pi / 3 := by push_cast; ring
  unfold spectralGen
  rw [h, Real.cos_pi_sub, Real.cos_pi_div_three]
  norm_num

/-- **`[ℚ(α_3):ℚ] = 1`.** Since `α_3 = −1 ∈ ℚ`, the minimal polynomial is linear. -/
theorem degree_three : (minpoly ℚ (spectralGen 3)).natDegree = 1 := by
  rw [spectralGen_three, minpoly.natDegree_eq_one_iff, RingHom.mem_range]
  exact ⟨-1, by rw [map_neg, map_one]⟩

/-! ### p = 5 : the golden quadratic case (degree 2) -/

/-- **`α_5 = φ − 1`.** The pentagon eigenvalue is the golden number minus one:
`2 cos(2π/5) = (√5 − 1)/2 = φ − 1`. -/
theorem spectralGen_five : spectralGen 5 = Real.goldenRatio - 1 := by
  have hcos : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := Real.cos_pi_div_five
  have harg : (2 * Real.pi / ((5 : ℕ) : ℝ)) = 2 * (Real.pi / 5) := by push_cast; ring
  have htwo : Real.cos (2 * (Real.pi / 5)) = 2 * Real.cos (Real.pi / 5) ^ 2 - 1 :=
    Real.cos_two_mul (Real.pi / 5)
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hg : Real.goldenRatio = (1 + Real.sqrt 5) / 2 := rfl
  unfold spectralGen
  rw [harg, htwo, hcos, hg]
  linear_combination (1 / 4 : ℝ) * h5

/-- **`φ − 1` is irrational.** Immediate from the irrationality of `φ`. -/
theorem goldenSubOne_irrational : Irrational (Real.goldenRatio - 1) := by
  have := Real.goldenRatio_irrational.sub_natCast 1
  simpa using this

/-- The quadratic annihilator of `φ − 1`: `X² + X − 1`. -/
noncomputable def Q5 : Polynomial ℚ := X ^ 2 + X - 1

theorem Q5_monic : Q5.Monic := by unfold Q5; monicity!

theorem Q5_natDegree : Q5.natDegree = 2 := by unfold Q5; compute_degree!

/-- **`[ℚ(α_5):ℚ] = 2` — the golden quadratic field.**  `α_5 = φ − 1` is a root of the
monic degree-2 polynomial `X²+X−1` (so the degree is `≤ 2`) and is irrational (so the
degree is `≥ 2`).  This is the unique quadratic (golden) case. -/
theorem degree_five : (minpoly ℚ (spectralGen 5)).natDegree = 2 := by
  rw [spectralGen_five]
  have haev5 : (aeval (Real.goldenRatio - 1)) Q5 = 0 := by
    have hsq : Real.goldenRatio ^ 2 = Real.goldenRatio + 1 := Real.goldenRatio_sq
    unfold Q5
    simp only [map_sub, map_add, map_pow, aeval_X, map_one]
    linear_combination hsq
  have hint : IsIntegral ℚ (Real.goldenRatio - 1) := ⟨Q5, Q5_monic, haev5⟩
  have hle : (minpoly ℚ (Real.goldenRatio - 1)).natDegree ≤ 2 := by
    have hd := minpoly.min ℚ (Real.goldenRatio - 1) Q5_monic haev5
    calc (minpoly ℚ (Real.goldenRatio - 1)).natDegree
          ≤ Q5.natDegree := Polynomial.natDegree_le_natDegree hd
      _ = 2 := Q5_natDegree
  have hge : 2 ≤ (minpoly ℚ (Real.goldenRatio - 1)).natDegree := by
    rw [minpoly.two_le_natDegree_iff hint]
    rintro ⟨q, hq⟩
    exact goldenSubOne_irrational ⟨q, (eq_ratCast (algebraMap ℚ ℝ) q).symm.trans hq⟩
  exact le_antisymm hle hge

/-! ### p = 7 : the cubic case (degree 3, NOT quadratic) -/

/-- **`α_7` is a root of `X³ + X² − 2X − 1`.**  From `4θ = 2π − 3θ` at `θ = 2π/7`
we get `cos 4θ = cos 3θ`; expanding both by multiple-angle formulas and dividing off
the spurious factor `(cos θ − 1)` (nonzero since `cos(2π/7) < 1`) yields the cubic. -/
theorem cubic_identity_seven :
    (2 * Real.cos (2 * Real.pi / 7)) ^ 3 + (2 * Real.cos (2 * Real.pi / 7)) ^ 2
      - 2 * (2 * Real.cos (2 * Real.pi / 7)) - 1 = 0 := by
  have h3 : Real.cos (3 * (2 * Real.pi / 7))
      = 4 * Real.cos (2 * Real.pi / 7) ^ 3 - 3 * Real.cos (2 * Real.pi / 7) :=
    Real.cos_three_mul _
  have h2 : Real.cos (2 * (2 * Real.pi / 7)) = 2 * Real.cos (2 * Real.pi / 7) ^ 2 - 1 :=
    Real.cos_two_mul _
  have h4' : Real.cos (4 * (2 * Real.pi / 7))
      = 2 * Real.cos (2 * (2 * Real.pi / 7)) ^ 2 - 1 := by
    rw [show (4 : ℝ) * (2 * Real.pi / 7) = 2 * (2 * (2 * Real.pi / 7)) by ring]
    exact Real.cos_two_mul _
  have hsum : (4 : ℝ) * (2 * Real.pi / 7) = 2 * Real.pi - 3 * (2 * Real.pi / 7) := by ring
  have heq : Real.cos (4 * (2 * Real.pi / 7)) = Real.cos (3 * (2 * Real.pi / 7)) := by
    rw [hsum, Real.cos_two_pi_sub]
  have hkey : 2 * Real.cos (2 * (2 * Real.pi / 7)) ^ 2 - 1
      = 4 * Real.cos (2 * Real.pi / 7) ^ 3 - 3 * Real.cos (2 * Real.pi / 7) :=
    h4'.symm.trans (heq.trans h3)
  rw [h2] at hkey
  have hfac : (Real.cos (2 * Real.pi / 7) - 1)
      * (8 * Real.cos (2 * Real.pi / 7) ^ 3 + 4 * Real.cos (2 * Real.pi / 7) ^ 2
          - 4 * Real.cos (2 * Real.pi / 7) - 1) = 0 := by
    linear_combination hkey
  have hc1 : Real.cos (2 * Real.pi / 7) < 1 := by
    have hp := Real.pi_pos
    have h0 : (0 : ℝ) < 2 * Real.pi / 7 := by positivity
    have hπ : 2 * Real.pi / 7 ≤ Real.pi := by nlinarith [Real.pi_pos]
    have hlt := Real.strictAntiOn_cos (Set.mem_Icc.mpr ⟨le_refl 0, hp.le⟩)
      (Set.mem_Icc.mpr ⟨h0.le, hπ⟩) h0
    rwa [Real.cos_zero] at hlt
  have hcne : Real.cos (2 * Real.pi / 7) - 1 ≠ 0 := by linarith
  have hcubic : 8 * Real.cos (2 * Real.pi / 7) ^ 3 + 4 * Real.cos (2 * Real.pi / 7) ^ 2
      - 4 * Real.cos (2 * Real.pi / 7) - 1 = 0 := by
    rcases mul_eq_zero.mp hfac with h | h
    · exact absurd h hcne
    · exact h
  linear_combination hcubic

/-- The cubic annihilator over `ℤ` (for the rational root theorem). -/
noncomputable def cubic7 : Polynomial ℤ := X ^ 3 + X ^ 2 - 2 * X - 1

/-- The cubic annihilator over `ℚ`. -/
noncomputable def P7 : Polynomial ℚ := X ^ 3 + X ^ 2 - 2 * X - 1

theorem cubic7_monic : cubic7.Monic := by unfold cubic7; monicity!

theorem P7_monic : P7.Monic := by unfold P7; monicity!

theorem P7_natDegree : P7.natDegree = 3 := by unfold P7; compute_degree!

/-- **`α_7` connects to the literal-`7` cosine.** -/
theorem spectralGen_seven : spectralGen 7 = 2 * Real.cos (2 * Real.pi / 7) := by
  simp only [spectralGen, Nat.cast_ofNat]

/-- **`aeval α_7 (X³+X²−2X−1) = 0`.** -/
theorem aeval_spectralGen_seven : (aeval (spectralGen 7)) P7 = 0 := by
  have hval : (aeval (spectralGen 7)) P7
      = spectralGen 7 ^ 3 + spectralGen 7 ^ 2 - 2 * spectralGen 7 - 1 := by
    unfold P7
    simp only [map_sub, map_add, map_mul, map_pow, aeval_X, map_ofNat, map_one]
  rw [hval, spectralGen_seven]
  exact cubic_identity_seven

/-- **`X³ + X² − 2X − 1` is irreducible over `ℚ`.**  Rational root theorem: any rational
root of this monic integer polynomial is an integer dividing the constant term `−1`, hence
`±1`; neither is a root (`eval 1 = −1`, `eval (−1) = 1`).  A cubic with no root is irreducible. -/
theorem P7_irreducible : Irreducible P7 := by
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [P7_natDegree]; decide
  · intro x hx
    have haev : (aeval x) cubic7 = x ^ 3 + x ^ 2 - 2 * x - 1 := by
      unfold cubic7
      simp only [map_sub, map_add, map_mul, map_pow, aeval_X, map_ofNat, map_one]
    have evalP7 : Polynomial.eval x P7 = x ^ 3 + x ^ 2 - 2 * x - 1 := by
      unfold P7
      simp only [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_ofNat, Polynomial.eval_one]
    have hz : (aeval x) cubic7 = 0 := by rw [haev, ← evalP7]; exact hx
    obtain ⟨r', hxeq, hdvd⟩ := exists_integer_of_is_root_of_monic cubic7_monic hz
    have hc0 : cubic7.coeff 0 = -1 := by
      rw [Polynomial.coeff_zero_eq_eval_zero]; unfold cubic7; simp
    rw [hc0] at hdvd
    have hunit : r' = 1 ∨ r' = -1 := Int.isUnit_iff.mp (isUnit_of_dvd_unit hdvd isUnit_one.neg)
    have hxq : x = (r' : ℚ) := hxeq.trans (eq_intCast (algebraMap ℤ ℚ) r')
    rw [haev, hxq] at hz
    have hintr : r' ^ 3 + r' ^ 2 - 2 * r' - 1 = 0 := by exact_mod_cast hz
    rcases hunit with rfl | rfl <;> norm_num at hintr

/-- **`[ℚ(α_7):ℚ] = 3`.**  The irreducible monic cubic annihilating `α_7` is its minimal
polynomial, so the degree is `3` — a CUBIC field, not the golden quadratic. -/
theorem degree_seven : (minpoly ℚ (spectralGen 7)).natDegree = 3 := by
  have h := minpoly.eq_of_irreducible_of_monic P7_irreducible aeval_spectralGen_seven P7_monic
  rw [← h]; exact P7_natDegree

/-! ### The rigidity: quadratic (golden) iff p = 5, among p ∈ {3,5,7} -/

/-- **`why_five` — the pentagon is the unique quadratic case.**  Among the primes
`p ∈ {3, 5, 7}` the adjacency spectrum of `C_p` lands in a real quadratic field
(`[ℚ(2cos 2π/p):ℚ] = 2`) for `p = 5` and for no other: the degrees are `1, 2, 3`.
This is the arithmetic "why five" — the golden field `ℚ(√5)` is spectrally forced by
the pentagon and by nothing else in this window. -/
theorem why_five :
    (minpoly ℚ (spectralGen 3)).natDegree ≠ 2 ∧
    (minpoly ℚ (spectralGen 5)).natDegree = 2 ∧
    (minpoly ℚ (spectralGen 7)).natDegree ≠ 2 := by
  refine ⟨?_, degree_five, ?_⟩
  · rw [degree_three]; decide
  · rw [degree_seven]; decide

/-- **`quadratic_iff_five`** — the rigidity as an `↔` over `p ∈ {3,5,7}`:
the spectral field of `C_p` is quadratic exactly when `p = 5`. -/
theorem quadratic_iff_five {p : ℕ} (hp : p ∈ ({3, 5, 7} : Finset ℕ)) :
    (minpoly ℚ (spectralGen p)).natDegree = 2 ↔ p = 5 := by
  fin_cases hp
  · rw [degree_three]; decide
  · rw [degree_five]; decide
  · rw [degree_seven]; decide

end Brockian.GaloisWhyFive
