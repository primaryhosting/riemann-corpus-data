         set r : D5Structure.Ray := D5Structure.Ray.ray_2;
         -- By definition of $D5Structure.isPentagramRay$, we know that $D5Structure.isPentagramRay (D5Structure.Ray.ray_2)$ holds.
         have h_r2 : D5Structure.isPentagramRay r := by
           exact?;
         -- By definition of $D5Structure.isPentagramRay$, we know that $D5Structure.isPentagramRay (D5Structure.Ray.ray_2)$ holds. Let's choose any $g : D5$ such that $g • r$ is not a pentagram ray.
         obtain ⟨g, hg⟩ : ∃ g : D5, ¬D5Structure.isPentagramRay (g • r) := by
           by_contra! h;
           have := h ( DihedralGroup.r 3 ) ; simp +decide [ D5Structure.Ray.fromZMod ] at this;
           cases this;
         exact fun h => hg <| h r h_r2 g

/-- The spiral embedding respects the D₅ action -/
theorem D5Structure.spiral_respects_D5_rotation (n : ℕ) :
    D5Structure.rotation (D5Structure.spiralEmbedding n) = 
    D5Structure.spiralEmbedding n * exp (I * D5Structure.θ₅) := by
  unfold D5Structure.rotation D5Structure.spiralEmbedding
  ring

/-- Golden ratio emerges from pentagonal geometry -/
theorem D5Structure.phi_from_pentagon_diagonal :
    ∃ (diagonal side : ℝ),
    diagonal > 0 ∧ side > 0 ∧
    diagonal / side = D5Structure.φ ∧
    -- This ratio is preserved under D₅ rotations
    ∀ k : Fin 5, diagonal / side = D5Structure.φ := by
      -- Let's choose any diagonal and side length for the pentagon, such as diagonal = phi and side = 1.
      use D5Structure.φ, 1
      simp [D5Structure.φ];
      -- Since $\sqrt{5}$ is positive, we have $1 + \sqrt{5} > 0$.
      apply add_pos_of_pos_of_nonneg; norm_num; exact Real.sqrt_nonneg 5

theorem D5Structure.pentagram_rays_not_D5_invariant_proven :
    ¬ (∀ r : D5Structure.Ray, D5Structure.isPentagramRay r →
       ∀ g : D5, D5Structure.isPentagramRay (g • r)) := by
         -- By definition of $D5Structure.isPentagramRay$, we know that $D5Structure.isPentagramRay (D5Structure.Ray.ray_2)$ is true.
         apply D5Structure.pentagram_rays_not_D5_invariant
