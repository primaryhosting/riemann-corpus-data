theorem D5Structure.assignRay_eq_fromZMod (n : ℕ) :
    D5Structure.assignRay n = D5Structure.Ray.fromZMod n := by
      -- By definition of `D5Structure.assignRay`, we know that `D5Structure.assignRay n` is the ray corresponding to `n % 5`, and `D5Structure.Ray.fromZMod (n % 5)` is the ray corresponding to the ZMod 5 representation of `n % 5`.
      simp [D5Structure.assignRay, D5Structure.Ray.fromZMod];
      -- Since $n$ is a natural number, its modulo 5 is the same as its ZMod 5 value. Therefore, the two matches are equivalent.
      have h_mod_eq : n % 5 = (n : ZMod 5).val := by
        erw [ ZMod.val_natCast ];
      -- Since $n$ is a natural number, its modulo 5 is the same as its ZMod 5 value. Therefore, the two matches are equivalent by definition.
      rw [h_mod_eq];
      -- Since these are all the cases, we can conclude that the two match expressions are equal by checking each one.
      have h_cases : ∀ x : ZMod 5, x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 ∨ x = 4 := by
        decide +revert;
      rcases h_cases ( n : ZMod 5 ) with h | h | h | h | h <;> simp +decide [ h ]

