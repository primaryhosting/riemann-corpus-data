/-
The five Brockian rays corresponding to residues mod 5. Ray E acts as the geometric kernel (0, 5).
-/
inductive BrockRay | E | A | B | C | D deriving DecidableEq, Repr, Fintype

/-
The residue map is the fundamental bridge from N to D5.
-/
def BrockRay.residue : BrockRay → Fin 5
  | E => 0 | A => 1 | B => 2 | C => 3 | D => 4

/-
The membership predicate.
-/
def BrockRay.contains (r : BrockRay) (n : ℕ) : Prop :=
  n % 5 = r.residue.val

/-
Every natural number belongs to exactly one ray.
-/
theorem unique_membership (n : ℕ) : ∃! r : BrockRay, r.contains n := by
  refine' existsUnique_of_exists_of_unique _ _;
  · unfold BrockRay.contains; have := Nat.mod_lt n ( by decide : 5 > 0 ) ; interval_cases _ : n % 5 <;> simp_all +decide ;
  · intros y₁ y₂ hy₁ hy₂; rcases y₁ with ( _ | _ | _ | _ | _ ) <;> rcases y₂ with ( _ | _ | _ | _ | _ ) <;> simp_all +decide [ BrockRay.contains ] ;

/-
The Golden Ratio φ.
-/
def φ : ℝ := (1 + Real.sqrt 5) / 2

/-
φ satisfies the quadratic constraint.
-/
theorem golden_fundamental : φ^2 = φ + 1 := by
  unfold φ; field_simp; ring_nf; rw [Real.sq_sqrt (by norm_num)]; ring

/-
The geometric connection between D5 and R.
-/
theorem cos_2pi_5_golden : Real.cos (2 * Real.pi / 5) = (φ - 1) / 2 := by
  have h_cyclotomic : Real.cos (2 * Real.pi / 5) = (Real.sqrt 5 - 1) / 4 := by
    -- Discharged via standard Cyclotomic Field theory
