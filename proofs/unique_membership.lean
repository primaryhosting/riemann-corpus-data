    ring
  rw [h_cyclotomic]; unfold φ; ring

/-
A Ray Pair is principal if it is active (non-E) and satisfies the gap constraint.
-/
structure RayPair where
  r1 : BrockRay
  r2 : BrockRay

/-
A Ray Pair is principal if it is active (non-E) and satisfies the gap constraint.
-/
def principalPairs (g : ℕ) : Finset RayPair :=
  (univ : Finset BrockRay).biUnion fun r1 =>
    ((univ : Finset BrockRay).filter fun r2 =>
      r1 ≠ .E ∧ r2 ≠ .E ∧
      (r2.residue.val : ℤ) = (r1.residue.val + g) % 5).image (fun r2 => ⟨r1, r2⟩)

/-
Decidable equality for RayPair.
-/
instance : DecidableEq RayPair := fun x y =>
  match x, y with
  | ⟨r1, r2⟩, ⟨s1, s2⟩ =>
    if h1 : r1 = s1 then
      if h2 : r2 = s2 then isTrue (by rw [h1, h2])
      else isFalse (fun h => h2 (congr_arg RayPair.r2 h))
    else isFalse (fun h => h1 (congr_arg RayPair.r1 h))

/-
Geometric signatures: Star vs Spiral.
-/
inductive RayPattern | star | spiral | special deriving DecidableEq

/-
Mapping residues mod 10 to geometric signatures.
-/
def residuePattern (n : ℕ) : RayPattern :=
  match n % 10 with
  | 1 | 4 | 6 | 9 => .spiral
  | 2 | 3 | 7 | 8 => .star
  | _             => .special

/-
For any gap g coprime to 5, there are exactly 3 principal ray configurations.
-/
theorem principal_pair_count (g : ℕ) (hg : Nat.gcd g 5 = 1) :
    (principalPairs g).card = 3 := by
      unfold principalPairs;
      -- Let's simplify the expression for the cardinality.
      suffices h_card : ∀ g : ℕ, Nat.gcd g 5 = 1 → (Finset.card (Finset.filter (fun r : BrockRay × BrockRay => r.1 ≠ .E ∧ r.2 ≠ .E ∧ (r.2.residue.val : ℤ) = ((r.1.residue.val : ℤ) + g) % 5) (Finset.univ : Finset (BrockRay × BrockRay)))) = 3 by
        convert h_card g hg using 1;
        refine' Finset.card_bij ( fun x hx => ( x.r1, x.r2 ) ) _ _ _ <;> simp +decide;
        · aesop;
        · aesop;
        · exact fun a b ha hb hab => ⟨ ⟨ a, b ⟩, ⟨ a, b, ⟨ ha, hb, hab ⟩, rfl ⟩, rfl, rfl ⟩;
      -- By definition of gcd, if gcd(g, 5) = 1, then g is congruent to 1, 2, 3, or 4 modulo 5.
      intro g hg
      have h_cases : g % 5 = 1 ∨ g % 5 = 2 ∨ g % 5 = 3 ∨ g % 5 = 4 := by
        rw [ Nat.gcd_comm ] at hg; rw [ Nat.gcd_rec ] at hg; have := Nat.mod_lt g ( by decide : 5 > 0 ) ; interval_cases g % 5 <;> trivial;
      rcases h_cases with ( h | h | h | h ) <;> norm_cast <;> simp_all +decide [ Nat.add_mod ]

