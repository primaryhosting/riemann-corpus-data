open Finset

/-
Definition of admissible residues modulo q with gap g.
-/
def admissible_residues (q : ℕ) [Fact q.Prime] (g : ℕ) : Finset (ZMod q) :=
  univ.filter (fun n => n ≠ 0 ∧ n + g ≠ 0)

/-
The "q-2" Admissibility Law. For any prime `q` and any gap `g` not divisible by `q`, there are exactly `q - 2` residues that do not hit the "excluded" points (0 and -g).
-/
theorem universal_admissibility_count (q : ℕ) [Fact q.Prime] (g : ℕ) (hg : (g : ZMod q) ≠ 0) :
    (admissible_residues q g).card = q - 2 := by
      -- The cardinality of the set of residues that are not 0 or -g is q-2.
      have h_card : (Finset.filter (fun n : ZMod q => n ≠ 0 ∧ n ≠ -g) (Finset.univ : Finset (ZMod q))).card = (q - 2) := by
        rw [ show ( Finset.univ.filter fun n : ZMod q => n ≠ 0 ∧ n ≠ - ( g : ZMod q ) ) = Finset.univ \ { 0, - ( g : ZMod q ) } by ext; aesop ];
        rw [ Finset.card_sdiff ] ; norm_num [ Finset.card_univ, hg ];
      unfold admissible_residues;
      simpa [ add_eq_zero_iff_eq_neg ] using h_card

/-
COROLLARY 1: The Twin Prime Constant Origin (q=3). For q=3, the exclusion leaves 3 - 2 = 1 admissible residue.
-/
theorem twin_prime_origin (g : ℕ) (hg : g % 3 ≠ 0) :
    (admissible_residues 3 g).card = 1 := by
      -- Apply the universal_admissibility_count theorem with q=3 and g.
      apply universal_admissibility_count;
      erw [ Ne.eq_def, ZMod.natCast_eq_zero_iff ] ; exact fun h => hg <| Nat.mod_eq_zero_of_dvd h

#check Fact (Nat.Prime 3)
