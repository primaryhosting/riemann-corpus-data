/-- Ray classification based on mod 5 residues -/
inductive Mod5Ray : Type
  | ray_0 : Mod5Ray  -- n ≡ 0 (mod 5)
  | ray_1 : Mod5Ray  -- n ≡ 1 (mod 5) 
  | ray_2 : Mod5Ray  -- n ≡ 2 (mod 5)
  | ray_3 : Mod5Ray  -- n ≡ 3 (mod 5)
  | ray_4 : Mod5Ray  -- n ≡ 4 (mod 5)
  deriving DecidableEq, Inhabited, Fintype

def Mod5Ray.toNat : Mod5Ray → Fin 5
  | ray_0 => 0
  | ray_1 => 1
  | ray_2 => 2
  | ray_3 => 3
  | ray_4 => 4

def Mod5Ray.toString : Mod5Ray → String
  | ray_0 => "Ray_0"
  | ray_1 => "Ray_1"
  | ray_2 => "Ray_2"
  | ray_3 => "Ray_3"
  | ray_4 => "Ray_4"

instance : ToString Mod5Ray := ⟨Mod5Ray.toString⟩

theorem Mod5Ray.card : Fintype.card Mod5Ray = 5 := by decide

/-- Ray assignment function -/
def assignRay (n : ℕ) : Mod5Ray :=
  match n % 5 with
  | 0 => Mod5Ray.ray_0
  | 1 => Mod5Ray.ray_1
  | 2 => Mod5Ray.ray_2
  | 3 => Mod5Ray.ray_3
  | _ => Mod5Ray.ray_4

theorem assignRay_spec (n : ℕ) : (assignRay n).toNat = n % 5 := by
  unfold assignRay Mod5Ray.toNat
  have h := Nat.mod_lt n (by norm_num : 0 < 5)
  interval_cases n % 5 <;> rfl

/-- Pentagon rays (historical naming from geometry) -/
def isPentagonRay : Mod5Ray → Bool
  | Mod5Ray.ray_1 | Mod5Ray.ray_4 => true
  | _ => false

/-- Pentagram rays (historical naming from geometry) -/
def isPentagramRay : Mod5Ray → Bool
  | Mod5Ray.ray_2 | Mod5Ray.ray_3 => true
  | _ => false

theorem ray_partition (r : Mod5Ray) (h : r ≠ Mod5Ray.ray_0) :
    isPentagonRay r = true ∨ isPentagramRay r = true := by
  cases r <;> simp [isPentagonRay, isPentagramRay] <;> try contradiction

def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem GoldenRatio.phi_squared : phi ^ 2 = phi + 1 := by
  unfold phi
  field_simp
  ring_nf
  rw [sq, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 5)]
  ring

theorem GoldenRatio.phi_gt_one : 1 < phi := by
  -- By definition of $phi$, we know that $phi = (1 + Real.sqrt 5) / 2$.
  have h_phi_def : phi = (1 + Real.sqrt 5) / 2 := by
    -- By definition of $phi$, we know that $phi = (1 + \sqrt{5}) / 2$. Therefore, the equality holds by definition.
    simp [phi]
  rw [h_phi_def]
  skip
  exact by nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]

theorem GoldenRatio.phi_pos : 0 < phi := by
  calc 0 < 1 := by norm_num
    _ < phi := GoldenRatio.phi_gt_one

theorem GoldenRatio.phi_bounds : 1.618 < phi ∧ phi < 1.619 := by
  constructor <;> unfold phi <;> nlinarith [
    Real.sqrt_nonneg 5,
    Real.sq_sqrt (show 0 ≤ 5 by norm_num)
  ]

def primeCount (x : ℕ) (P : ℕ → Prop) [DecidablePred P] : ℕ :=
  (Finset.range (x + 1)).filter (fun p => Nat.Prime p ∧ P p) |>.card

def primeWeightedSum (x : ℕ) (w : ℕ → ℝ) (P : ℕ → Prop) [DecidablePred P] : ℝ :=
  ∑ p ∈ (Finset.range (x + 1)).filter (fun p => Nat.Prime p ∧ P p), w p

def weightedPrimeCount (x : ℕ) (mod4class : Fin 4) : ℝ :=
  primeWeightedSum x (fun p => 1 / Real.sqrt p) (fun p => p % 4 = mod4class)

/-- Chinese Remainder Theorem for mod 5 and mod 4 -/
theorem mod5_mod4_crt (p : ℕ) (hp : p > 5) :
    ∃! (a : Fin 5 × Fin 4), p % 5 = a.1.val ∧ p % 4 = a.2.val := by
      -- By the Chinese Remainder Theorem, there exists a unique pair (a.1, a.2) such that p ≡ a.1 (mod 5) and p ≡ a.2 (mod 4).
      use (⟨p % 5, by
        -- By definition of modulo, the remainder when p is divided by 5 is always less than 5.
        apply Nat.mod_lt p (by decide)⟩, ⟨p % 4, by
        -- By definition of modulo, the remainder when p is divided by 4 is always less than 4.
        apply Nat.mod_lt p (by decide)⟩)
      generalize_proofs at *;
      -- By the Chinese Remainder Theorem, there exists a unique pair (a.1, a.2) such that p ≡ a.1 (mod 5) and p ≡ a.2 (mod 4). Hence, we have |p % 5| = 1 ∧ |p % 4| = 2.
      aesop

/-- Mod 20 decomposition for pentagon rays -/
theorem pentagon_mod20_decomposition :
    ∀ p : ℕ, Nat.Prime p → p > 5 → isPentagonRay (assignRay p) →
    (p % 20 ∈ ({1, 9, 11, 19} : Finset ℕ)) := by
      -- By definition of assignRay, we know that p % 5 is either 1 or 4.
      intros p hp hp_gt5 h_ray
      have h_mod5 : p % 5 = 1 ∨ p % 5 = 4 := by
        unfold isPentagonRay at h_ray; unfold assignRay at h_ray; have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases p % 5 <;> trivial;
      -- Since $p$ is a prime greater than 5, it must be odd, so $p \equiv 1 \pmod{2}$.
      have h_mod2 : p % 2 = 1 := by
        exact hp.eq_two_or_odd.resolve_left ( by linarith );
      grind

/-- Prime constellation types -/
inductive ConstellationType
  | twin : ConstellationType           -- (p, p+2)
  | cousin : ConstellationType         -- (p, p+4)
  | sexy : ConstellationType           -- (p, p+6)
