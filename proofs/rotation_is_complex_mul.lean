/-
Linear map definition of raw adjacency and proof that it preserves L2 membership.
-/
def rawAdjacencyLinearMap (gamma : Fin 5 → ℝ) : (PenroseTilingVertices gamma → ℂ) →ₗ[ℂ] (PenroseTilingVertices gamma → ℂ) where
  toFun := rawAdjacency gamma
  map_add' f g := by
    ext u
    simp [rawAdjacency, Finset.sum_add_distrib]
  map_smul' c f := by
    ext u
    simp [rawAdjacency, Finset.mul_sum]

lemma memLp_rawAdjacency (gamma : Fin 5 → ℝ) {f : PenroseTilingVertices gamma → ℂ}
    (hf : MemLp f 2 (verticesMeasure gamma)) :
    MemLp (rawAdjacency gamma f) 2 (verticesMeasure gamma) := by
      refine' ⟨ _, _ ⟩;
      · exact?;
      · refine' lt_of_le_of_lt ( rawAdjacency_bound gamma f ) _;
        exact ENNReal.mul_lt_top ENNReal.coe_lt_top ( hf.eLpNorm_lt_top )

/-
Almost everywhere equality with respect to counting measure implies pointwise equality.
-/
lemma ae_eq_eq_of_count {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α] (f g : α → ℂ)
    (h : f =ᵐ[Measure.count] g) : f = g := by
  ext x
  have h_null : Measure.count {a | ¬ f a = g a} = 0 := h
  have h_empty : {a | ¬ f a = g a} = ∅ := by
    rw [← Measure.count_eq_zero_iff]
    exact h_null
  have h_x : x ∉ {a | ¬ f a = g a} := by
    rw [h_empty]
    exact Set.not_mem_empty x
  simpa using h_x

