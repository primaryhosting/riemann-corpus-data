lemma aestronglyMeasurable_rawAdjacency (gamma : Fin 5 → ℝ) (f : PenroseTilingVertices gamma → ℂ) :
    AEStronglyMeasurable (rawAdjacency gamma f) (verticesMeasure gamma) := by
  apply Measurable.aestronglyMeasurable
  apply measurable_of_countable

/-
Definition of the adjacency operator on AEEqFun.
-/
def adjacencyAEEqFun (gamma : Fin 5 → ℝ) : (PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ) → (PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ) :=
  Quotient.lift (fun f : {f : PenroseTilingVertices gamma → ℂ // AEStronglyMeasurable f (verticesMeasure gamma)} =>
    AEEqFun.mk (rawAdjacency gamma f.1) (by
      apply Measurable.aestronglyMeasurable
      apply measurable_of_countable))
    (fun f g h => by
      apply AEEqFun.mk_eq_mk.mpr
      have h_eq : f.1 = g.1 := ae_eq_eq_of_count f.1 g.1 h
      rw [h_eq])

/-
Linearity lemmas for adjacencyAEEqFun.
-/
lemma adjacencyAEEqFun_add (gamma : Fin 5 → ℝ) (f g : PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ) :
    adjacencyAEEqFun gamma (f + g) = adjacencyAEEqFun gamma f + adjacencyAEEqFun gamma g := by
      induction' f using Quotient.inductionOn' with f;
      induction' g using Quotient.inductionOn' with g;
      erw [ Quotient.eq'' ];
      filter_upwards [ ] with x;
      simp +decide [ rawAdjacency, Finset.sum_add_distrib ]

lemma adjacencyAEEqFun_smul (gamma : Fin 5 → ℝ) (c : ℂ) (f : PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ) :
    adjacencyAEEqFun gamma (c • f) = c • adjacencyAEEqFun gamma f := by
      obtain ⟨ f, hf ⟩ := f;
      convert AEEqFun.mk_eq_mk.mpr _;
      filter_upwards [ ] with u using by simp +decide [ rawAdjacency, Finset.mul_sum _ _ _ ] ;

/-
The adjacency operator on AEEqFun preserves L2 membership.
-/
lemma adjacencyAEEqFun_memLp (gamma : Fin 5 → ℝ) (f : PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ)
    (hf : f ∈ MeasureTheory.Lp ℂ 2 (verticesMeasure gamma)) :
    adjacencyAEEqFun gamma f ∈ MeasureTheory.Lp ℂ 2 (verticesMeasure gamma) := by
      obtain ⟨g, hg⟩ := f;
      -- Apply the lemma that states if `f` is in L2, then `rawAdjacency f` is also in L2.
      have h_memLp : MemLp (rawAdjacency gamma g) 2 (verticesMeasure gamma) := by
        apply memLp_rawAdjacency;
        rw [ MeasureTheory.MemLp ];
        rw [ MeasureTheory.Lp.mem_Lp_iff_eLpNorm_lt_top ] at hf ; aesop;
      convert h_memLp using 1;
      constructor <;> intro h <;> rw [ MeasureTheory.Lp ] at * <;> norm_num at *;
      · exact h_memLp;
      · convert h_memLp.eLpNorm_lt_top using 1;
        rw [ MeasureTheory.eLpNorm_congr_ae ];
        exact AEEqFun.coeFn_mk _ _

/-
Linear map definition of the adjacency operator on the L2 space.
-/
def adjacencyLinearMap (gamma : Fin 5 → ℝ) : l2_space gamma →ₗ[ℂ] l2_space gamma where
  toFun f := ⟨adjacencyAEEqFun gamma f.1, adjacencyAEEqFun_memLp gamma f.1 f.2⟩
  map_add' f g := by
    apply Subtype.eq
    exact adjacencyAEEqFun_add gamma f.1 g.1
  map_smul' c f := by
    apply Subtype.eq
    exact adjacencyAEEqFun_smul gamma c f.1

