/-
The projection from R^5 to C is equivariant under the cyclic shift of coordinates and rotation by 72 degrees in C.
-/
def cyclicShift (v : Fin 5 → ℝ) : Fin 5 → ℝ :=
  fun k => v (k - 1)

def projectToC (v : Fin 5 → ℝ) : ℂ :=
  ∑ k : Fin 5, (v k : ℂ) * complexPentagonVertex k

theorem parallel_projection_equivariant (v : Fin 5 → ℝ) :
    projectToC (cyclicShift v) = zeta5 * projectToC v := by
  unfold projectToC;
  norm_num [ Fin.sum_univ_succ, cyclicShift ];
  unfold complexPentagonVertex; norm_num [ ← Complex.exp_nat_mul, ← Complex.exp_add ] ; ring!;
  norm_num [ zeta5, ← Complex.exp_nat_mul, mul_div_cancel₀ ]

/-
Definitions for the Penrose tiling vertices and adjacency using the cut-and-project method with a shift parameter gamma. The physical projection maps Z^5 to C using powers of zeta5. The internal projection maps Z^5 to C using powers of zeta5^2. The window is the projection of the unit hypercube into the internal space. Vertices are points in the physical projection whose internal projection (shifted by gamma) falls within the window. Adjacency is defined by connecting vertices separated by a unit vector (power of zeta5).
-/
def physicalProjection (n : Fin 5 → ℤ) : ℂ :=
  ∑ k, (n k : ℂ) * complexPentagonVertex k

def internalProjection (n : Fin 5 → ℤ) : ℂ :=
  ∑ k, (n k : ℂ) * complexPentagonVertex (2 * k)

def internalProjectionReal (v : Fin 5 → ℝ) : ℂ :=
  ∑ k, (v k : ℂ) * complexPentagonVertex (2 * k)

def window : Set ℂ :=
  { z | ∃ v : Fin 5 → ℝ, (∀ k, 0 ≤ v k ∧ v k ≤ 1) ∧ z = internalProjectionReal v }

def PenroseTilingVertices (gamma : Fin 5 → ℝ) : Set ℂ :=
  { z | ∃ n : Fin 5 → ℤ, z = physicalProjection n ∧ (internalProjection n + internalProjectionReal gamma) ∈ window }

def PenroseAdjacency (gamma : Fin 5 → ℝ) (u v : ℂ) : Prop :=
  u ∈ PenroseTilingVertices gamma ∧ v ∈ PenroseTilingVertices gamma ∧
  ∃ k : Fin 5, v = u + complexPentagonVertex k

/-
The Penrose tiling graph, defined by connecting vertices separated by a unit vector (power of zeta5).
-/
def PenroseGraph (gamma : Fin 5 → ℝ) : SimpleGraph (PenroseTilingVertices gamma) :=
  SimpleGraph.fromRel (fun u v => ∃ k, v.1 = u.1 + complexPentagonVertex k)

