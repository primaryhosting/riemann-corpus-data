/-
Definition of potential neighbors in the complex plane and proof of their finiteness.
-/
def potentialNeighbors (u : ℂ) : Set ℂ :=
  (Set.range (fun k : Fin 5 => u + complexPentagonVertex k)) ∪
  (Set.range (fun k : Fin 5 => u - complexPentagonVertex k))

lemma potentialNeighbors_finite (u : ℂ) : (potentialNeighbors u).Finite := by
  apply Set.Finite.union <;> apply Set.finite_range

/-
Proof that the neighbors of a vertex are a subset of the potential neighbors.
-/
lemma neighbor_subset_potential (gamma : Fin 5 → ℝ) (u : PenroseTilingVertices gamma) :
    (PenroseGraph gamma).neighborSet u ⊆ {v | v.1 ∈ potentialNeighbors u.1} := by
      intro v hv
      obtain ⟨k, hk⟩ := hv;
      cases hk <;> simp_all +decide [ Set.mem_union, Set.mem_range, potentialNeighbors ];
      · tauto;
      · grind +ring

/-
The neighbor set of any vertex in the Penrose graph is finite.
-/
instance (gamma : Fin 5 → ℝ) (v : PenroseTilingVertices gamma) : Finite ((PenroseGraph gamma).neighborSet v) := by
  let S := potentialNeighbors v.1
  have hS : S.Finite := potentialNeighbors_finite v.1
  have h_subset : (PenroseGraph gamma).neighborSet v ⊆ { w | w.1 ∈ S } := neighbor_subset_potential gamma v
  have h_image_subset : Subtype.val '' ((PenroseGraph gamma).neighborSet v) ⊆ S := by
    rintro _ ⟨w, hw, rfl⟩
    exact h_subset hw
  have h_image_finite : (Subtype.val '' ((PenroseGraph gamma).neighborSet v)).Finite :=
    Set.Finite.subset hS h_image_subset
  apply Set.Finite.of_finite_image h_image_finite
  intro x _ y _ h
  exact Subtype.eq h

/-
The Penrose graph is locally finite, meaning every vertex has a finite number of neighbors.
-/
noncomputable instance (gamma : Fin 5 → ℝ) : (PenroseGraph gamma).LocallyFinite :=
  fun v => Fintype.ofFinite ((PenroseGraph gamma).neighborSet v)

/-
The raw adjacency operator acting on functions on the vertices.
-/
def rawAdjacency (gamma : Fin 5 → ℝ) (f : PenroseTilingVertices gamma → ℂ) (u : PenroseTilingVertices gamma) : ℂ :=
  ∑ v ∈ (PenroseGraph gamma).neighborFinset u, f v

/-
The degree of every vertex in the Penrose graph is bounded by 10.
-/
lemma degree_bound (gamma : Fin 5 → ℝ) (u : PenroseTilingVertices gamma) :
    (PenroseGraph gamma).degree u ≤ 10 := by
  -- The degree of a vertex is the number of neighbors. The neighbors are a subset of the potential neighbors. The set of potential neighbors has size at most 10 (it is the union of two sets of size at most 5). Thus the degree is at most 10.
  have h_degree_le_10 : ∀ u : PenroseTilingVertices gamma, (PenroseGraph gamma).degree u ≤ (potentialNeighbors u.1).ncard := by
    intro u
    have h_subset : (PenroseGraph gamma).neighborSet u ⊆ {v : PenroseTilingVertices gamma | v.1 ∈ potentialNeighbors u.1} := by
      exact?;
    have h_card : (Set.ncard {v : PenroseTilingVertices gamma | v.1 ∈ potentialNeighbors u.1}) ≤ (potentialNeighbors u.1).ncard := by
      have h_card : (Set.ncard (Set.image (fun v : PenroseTilingVertices gamma => v.1) {v : PenroseTilingVertices gamma | v.1 ∈ potentialNeighbors u.1})) ≤ (potentialNeighbors u.1).ncard := by
        apply Set.ncard_le_ncard;
        · aesop_cat;
        · exact potentialNeighbors_finite _;
      rwa [ Set.ncard_image_of_injective _ fun x y hxy => by aesop ] at h_card;
    refine' le_trans _ h_card;
    rw [ Set.ncard_def ];
    rw [ Set.encard ];
    rw [ ENat.card ];
    rw [ SimpleGraph.degree ];
    rw [ ← Set.ncard_coe_finset ];
    rw [ Set.ncard_def ];
    rw [ Set.encard ];
    rw [ ENat.card ];
    gcongr;
    · simp +zetaDelta at *;
      exact Set.Finite.subset ( Set.Finite.preimage ( fun x => by aesop ) ( potentialNeighbors_finite u.1 ) ) fun x hx => hx;
    · exact Cardinal.mk_le_mk_of_subset fun x hx => h_subset <| by simpa using hx;
  have h_card_le_10 : ∀ u : ℂ, (potentialNeighbors u).ncard ≤ 10 := by
    intros u
    have h_card_le_10 : (potentialNeighbors u).ncard ≤ Finset.card (Finset.image (fun k : Fin 5 => u + complexPentagonVertex k) Finset.univ ∪ Finset.image (fun k : Fin 5 => u - complexPentagonVertex k) Finset.univ) := by
      rw [ ← Set.ncard_coe_finset ] ; aesop;
    exact h_card_le_10.trans ( le_trans ( Finset.card_union_le _ _ ) ( by exact le_trans ( add_le_add ( Finset.card_image_le ) ( Finset.card_image_le ) ) ( by decide ) ) );
  exact le_trans ( h_degree_le_10 u ) ( h_card_le_10 u )

