      simp [complexPentagonVertex];
      -- Since $k$ is a `Fin 5`, we have $k + 1 \equiv (k + 1) \mod 5$.
      fin_cases k <;> simp +decide [ pow_succ', mul_assoc ];
      -- By definition of $zeta5$, we know that $zeta5^5 = 1$.
      simp [zeta5];
