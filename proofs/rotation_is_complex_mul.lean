/-
The rotation matrix by 72 degrees is in the orthogonal group O(2).
-/
def theta72 : ℝ := 2 * Real.pi / 5

def rotate72 : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.cos theta72, -Real.sin theta72;
