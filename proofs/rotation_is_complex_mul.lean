def zeta5 : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

def complexPentagonVertex (k : Fin 5) : ℂ := zeta5 ^ (k : ℕ)

theorem rotation_is_complex_mul (k : Fin 5) :
    complexPentagonVertex (k + 1) = zeta5 * complexPentagonVertex k := by
