    exact Set.mem_range_self n
  have h_count : (PenroseTilingVertices gamma).Countable := Set.Countable.mono h_subset h_range
  exact Set.Countable.to_subtype h_count

noncomputable instance (gamma : Fin 5 → ℝ) : MeasurableSpace (PenroseTilingVertices gamma) := ⊤

instance (gamma : Fin 5 → ℝ) : MeasurableSingletonClass (PenroseTilingVertices gamma) := ⟨fun _ => trivial⟩

