theorem Brockian.SpectralTheory.eigenvalues_distinct (n m : ℕ) (h : n ≠ m) : Brockian.SpectralTheory.eigenvalue n ≠ Brockian.SpectralTheory.eigenvalue m := by
  -- Since the golden ratio φ is greater than 1, raising it to different powers will give different results. Therefore, if n ≠ m, then φ^n - 1 and φ^m - 1 must be different.
  have h_eigenvalue_distinct : ∀ n m : ℕ, n ≠ m → (Brockian.φ : ℂ) ^ n - 1 ≠ (Brockian.φ : ℂ) ^ m - 1 := by
    -- Since Brockian.φ is greater than 1, raising it to different powers will result in different values. Therefore, if n ≠ m, then (Brockian.φ : ℂ) ^ n ≠ (Brockian.φ : ℂ) ^ m.
    have h_exp_distinct : ∀ n m : ℕ, n ≠ m → (Brockian.φ : ℂ) ^ n ≠ (Brockian.φ : ℂ) ^ m := by
      -- Since Brockian.φ is greater than 1, raising it to different powers will result in different values. Therefore, if n ≠ m, then (Brockian.φ : ℂ) ^ n ≠ (Brockian.φ : ℂ) ^ m. This follows from the properties of exponents and the fact that Brockian.φ is a positive real number greater than 1.
      have h_exp_distinct : ∀ n m : ℕ, n ≠ m → (Brockian.φ : ℝ) ^ n ≠ (Brockian.φ : ℝ) ^ m := by
        -- Since Brockian.φ is greater than 1, the exponential function with base Brockian.φ is strictly increasing. Therefore, if n < m, then Brockian.φ^n < Brockian.φ^m.
        have h_exp_increasing : StrictMono (fun n : ℕ => Brockian.φ ^ n) := by
          exact fun n m hnm => pow_lt_pow_right₀ ( show 1 < Brockian.φ from by rw [ show Brockian.φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) hnm;
        exact fun n m hnm => h_exp_increasing.injective.ne hnm;
      exact_mod_cast h_exp_distinct;
    exact fun n m h => sub_left_injective.ne ( h_exp_distinct n m h );
  convert h_eigenvalue_distinct n m h using 1;
  · -- By definition of eigenvalue, we have eigenvalue n = φ^n - 1.
    simp [Brockian.SpectralTheory.eigenvalue];
  · -- By definition of eigenvalue, we have eigenvalue m = φ^m - 1.
    simp [Brockian.SpectralTheory.eigenvalue]
