        have h_simplify : 5 ≤ (Brockian.φ ^ n - |Brockian.φ_bar| ^ n) := by
          refine' le_trans _ ( sub_le_sub_left ( pow_le_pow_left₀ ( abs_nonneg _ ) ( show |Brockian.φ_bar| ≤ 1 by rw [ abs_of_nonpos ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show Brockian.φ_bar = ( 1 - Real.sqrt 5 ) / 2 by rfl ] ) _ ) _ );
          exact le_tsub_of_add_le_left ( by exact le_trans ( by norm_num ) ( pow_le_pow_left₀ ( by norm_num ) ( show Brockian.φ ≥ 1.6 by exact by rw [ show Brockian.φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) _ ) |> le_trans <| pow_le_pow_right₀ ( by rw [ show Brockian.φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) hn );
        rw [ div_le_div_iff₀ ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), pow_nonneg ( abs_nonneg ( Brockian.φ_bar ) ) n ];
      exact abs_le.mpr ⟨ by linarith [ abs_le.mp h_simplify ], by linarith [ abs_le.mp h_simplify ] ⟩

noncomputable def Brockian.t_Planck : ℝ := 1

noncomputable def Brockian.t_emergence (T : Brockian.MathematicalTruth) : ℝ := Brockian.φ ^ T.complexity * Brockian.t_Planck

theorem Brockian.TemporalDynamics.time_positive (T : Brockian.MathematicalTruth) : 0 < Brockian.t_emergence T := by
  -- Since Brockian.φ is positive and Brockian.t_Planck is positive, their product is positive. We can use the fact that the product of two positive numbers is positive.
  apply mul_pos; apply Real.rpow_pos_of_pos; exact Brockian.GoldenRatio.pos; exact by unfold Brockian.t_Planck; norm_num

theorem Brockian.TemporalDynamics.complexity_order {T₁ T₂ : Brockian.MathematicalTruth} (h : T₁.complexity < T₂.complexity) :
    Brockian.t_emergence T₁ < Brockian.t_emergence T₂ := by
      -- Since $Brockian.φ > 1$, the function $f(x) = Brockian.φ^x$ is strictly increasing.
      have h_exp_inc : StrictMono (fun x : ℝ => Brockian.φ ^ x) := by
        -- Apply the theorem that states the exponential function with base greater than 1 is strictly increasing.
        apply Real.strictMono_rpow_of_base_gt_one; exact Brockian.GoldenRatio.gt_one;
      -- Apply the strict monotonicity of the exponential function to conclude the proof.
      apply mul_lt_mul_of_pos_right (h_exp_inc h) (by norm_num [Brockian.t_Planck])

theorem Brockian.TemporalDynamics.phi_quantization (T₁ T₂ : Brockian.MathematicalTruth) (h : T₂.complexity = T₁.complexity + 1) :
    Brockian.t_emergence T₂ = Brockian.φ * Brockian.t_emergence T₁ := by
  unfold Brockian.t_emergence Brockian.t_Planck; rw [h]; push_cast
  rw [Real.rpow_add Brockian.GoldenRatio.pos, Real.rpow_one]; ring

noncomputable def Brockian.TemporalDynamics.is_potential (T : Brockian.MathematicalTruth) (t : ℝ) : Prop := t < Brockian.t_emergence T
noncomputable def Brockian.TemporalDynamics.is_actualized (T : Brockian.MathematicalTruth) (t : ℝ) : Prop := t ≥ Brockian.t_emergence T

theorem Brockian.TemporalDynamics.emergence_dichotomy (T : Brockian.MathematicalTruth) (t : ℝ) :
    Brockian.TemporalDynamics.is_potential T t ∨ Brockian.TemporalDynamics.is_actualized T t := by
  unfold Brockian.TemporalDynamics.is_potential Brockian.TemporalDynamics.is_actualized; exact lt_or_le t (Brockian.t_emergence T)

theorem Brockian.Fibonacci.phi_stability_bound (n : ℕ) (hn : 4 ≤ n) :
    |(Nat.fib (n + 1) : ℝ) / Nat.fib n - Brockian.φ| ≤ |Brockian.φ_bar| ^ n / Real.sqrt 5 := by
      -- Apply the hypothesis `h_diff` directly to conclude the proof.
      apply Brockian.Fibonacci.phi_stability n hn

structure Brockian.QuantumState (T : Brockian.MathematicalTruth) where
  ψ_potential : ℂ
  ψ_actual : ℂ
  normalized : Complex.normSq ψ_potential + Complex.normSq ψ_actual = 1

noncomputable def Brockian.QuantumMath.prob_potential {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) : ℝ := Complex.normSq ψ.ψ_potential
noncomputable def Brockian.QuantumMath.prob_actual {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) : ℝ := Complex.normSq ψ.ψ_actual

theorem Brockian.QuantumMath.prob_nonneg {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) : 0 ≤ Brockian.QuantumMath.prob_potential ψ ∧ 0 ≤ Brockian.QuantumMath.prob_actual ψ := by
  -- The norm squared of any complex number is non-negative, so both probabilities are non-negative.
  simp [Brockian.QuantumMath.prob_potential, Brockian.QuantumMath.prob_actual, Complex.normSq_nonneg]

theorem Brockian.QuantumMath.prob_normalized {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) : Brockian.QuantumMath.prob_potential ψ + Brockian.QuantumMath.prob_actual ψ = 1 := by
  unfold Brockian.QuantumMath.prob_potential Brockian.QuantumMath.prob_actual; exact ψ.normalized

noncomputable def Brockian.QuantumMath.pure_potential {T : Brockian.MathematicalTruth} : Brockian.QuantumState T where
  ψ_potential := 1; ψ_actual := 0
  normalized := by norm_num

noncomputable def Brockian.QuantumMath.pure_actual {T : Brockian.MathematicalTruth} : Brockian.QuantumState T where
  ψ_potential := 0; ψ_actual := 1
  normalized := by norm_num

noncomputable def Brockian.QuantumMath.time_evolution {T : Brockian.MathematicalTruth} (t : ℝ) (ψ : Brockian.QuantumState T) : Brockian.QuantumState T where
  ψ_potential := Complex.exp (- Complex.I * t) * ψ.ψ_potential
  ψ_actual := Complex.exp (- Complex.I * t) * ψ.ψ_actual
  normalized := by
    -- The norm squared of the exponential term is 1, and the norm squared of the original components sums to 1 by the hypothesis.normalized.
    simp [Complex.normSq_eq_norm_sq, Complex.norm_exp];
    -- By definition of Brockian.QuantumState, we know that the sum of the squares of the norms of the potential and actual components � is� 1.
    convert ψ.normalized using 1;
    -- By definition of norm squared, we know thatz‖^2 = Complex.normSq z for any complex number z.
    simp [Complex.normSq_eq_norm_sq]

def Brockian.MathSpace := Brockian.MathematicalTruth → ℂ

#check Brockian.QuantumMath.pure_potential
#check Brockian.QuantumMath.pure_actual
#check Brockian.QuantumMath.time_evolution

noncomputable def Brockian.QuantumMath.time_evolution_physical {T : Brockian.MathematicalTruth} (t : ℝ) (ψ : Brockian.QuantumState T) : Brockian.QuantumState T :=
  if h : t ≥ Brockian.t_emergence T then
    Brockian.QuantumMath.pure_actual
  else
    Brockian.QuantumMath.time_evolution t ψ

instance : MeasurableSpace Brockian.MathematicalTruth := ⊤

theorem Brockian.QuantumMath.measurement_collapse {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) (t : ℝ) :
    t ≥ Brockian.t_emergence T → Brockian.QuantumMath.prob_actual (Brockian.QuantumMath.time_evolution_physical t ψ) = 1 := by
      -- Since $t \geq T.emergence$, we have $Brockian.QuantumMath.time_evolution_physical t ψ = Brockian.QuantumMath.pure_actual$.
      intro ht
      simp [Brockian.QuantumMath.time_evolution_physical, ht];
      -- By definition of Brockian.QuantumMath.pure_actual, its ψ_actual is 1.
      simp [Brockian.QuantumMath.prob_actual, Brockian.QuantumMath.pure_actual]

noncomputable def Brockian.SpectralTheory.emergence_measure : MeasureTheory.Measure Brockian.MathematicalTruth := MeasureTheory.Measure.count

noncomputable def Brockian.SpectralTheory.inner (f g : Brockian.MathSpace) : ℂ := 
  MeasureTheory.integral Brockian.SpectralTheory.emergence_measure (fun T => f T * star (g T))

theorem Brockian.QuantumMath.measurement_collapse_axiom {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) (t : ℝ) :
    t ≥ Brockian.t_emergence T → Brockian.QuantumMath.prob_actual (Brockian.QuantumMath.time_evolution_physical t ψ) = 1 := 
  Brockian.QuantumMath.measurement_collapse ψ t

noncomputable def Brockian.SpectralTheory.PhiOperator (T : Brockian.MathematicalTruth) : Brockian.MathematicalTruth where
  statement := T.statement
  complexity := Brockian.φ * T.complexity
  complexity_pos := mul_pos Brockian.GoldenRatio.pos T.complexity_pos

noncomputable def Brockian.SpectralTheory.phi_op (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => f (Brockian.SpectralTheory.PhiOperator T)

noncomputable def Brockian.SpectralTheory.TemporalLaplacian (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => -(Brockian.φ : ℂ) * (Brockian.SpectralTheory.phi_op f T - f T)

noncomputable def Brockian.SpectralTheory.eigenmode (n : ℕ) : Brockian.MathSpace := fun T => (Brockian.φ : ℂ) ^ (-(T.complexity * n) : ℂ)

noncomputable def Brockian.SpectralTheory.eigenvalue (n : ℕ) : ℂ := (Brockian.φ : ℂ) ^ (n : ℂ) - 1

