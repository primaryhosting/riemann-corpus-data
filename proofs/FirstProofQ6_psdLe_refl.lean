def FirstProofQ6.restrictToFinset {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) : SimpleGraph V where
  Adj i j := i ∈ S ∧ j ∈ S ∧ G.Adj i j
  symm := by
    exact fun i j h => ⟨ h.2.1, h.1, h.2.2.symm ⟩
  loopless := by
    exact fun i hi => hi.2.2.ne rfl

