def Brock.Core.Mod.RayInter (m r n : ℕ) : Prop := Nat.ModEq m n r

#check Nat.modEq_iff_dvd'

theorem Brock.Core.Mod.modEq_iff_exists {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    Nat.ModEq m n r ↔ ∃ t : ℕ, n = m * t + r := by
      -- The forward direction follows from the definition of congruence: if $n \equiv r \pmod{m}$, then by definition, $m$ divides $n - r$. So, $n - r = m * t$ for some integer $t$. Since $n$ is a natural number, $t$ must be non-negative. Therefore, $n = m * t + r$.
      apply Iff.intro;
      · -- By definition of congruence, if $n \equiv r \pmod{m}$, then $m$ divides $n - r$.
        intro h_congr
        have h_div : m ∣ n - r := by
          rw [ ← Nat.modEq_zero_iff_dvd ];
          cases le_total n r <;> simp_all +decide [ ← ZMod.natCast_eq_natCast_iff ];
        obtain ⟨t, ht⟩ : ∃ t : ℕ, n - r = m * t := h_div;
        use t, by rw [ ← ht, Nat.sub_add_cancel ( show r ≤ n from Nat.le_of_not_gt fun h => by rw [ Nat.ModEq ] at h_congr; rw [ Nat.mod_eq_of_lt, Nat.mod_eq_of_lt ] at h_congr <;> linarith ) ] ;
      · -- If $n = m * t + r$, then $n - r = m * t$, which is divisible by $m$. Hence, $n \equiv r \pmod{m}$.
        intro h
        obtain ⟨t, ht⟩ := h
        rw [ht]
        simp [Nat.ModEq]

theorem Brock.Core.Mod.rayInter_iff_exists {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    RayInter m r n ↔ ∃ t : ℕ, n = m * t + r :=
  modEq_iff_exists hm hr

theorem Brock.Core.Mod.rayInter_mul_add {m r t : ℕ} (hm : 0 < m) :
    RayInter m r (m * t + r) := by
      -- By definition of RayInter, we need to show that $m * (t + 1) + r \equiv r \pmod{m}$.
      unfold Brock.Core.Mod.RayInter
      simp [Nat.ModEq]

abbrev Brock.Core.Rays.q : ℕ := 5

def Brock.Core.Rays.Ray0 (r : ZMod 5) : Prop := r = 1 ∨ r = 4

def Brock.Core.Rays.Ray1 (r : ZMod 5) : Prop := r = 2 ∨ r = 3

instance : DecidablePred Brock.Core.Rays.Ray0 := fun _ => inferInstance
instance : DecidablePred Brock.Core.Rays.Ray1 := fun _ => inferInstance

theorem Brock.Core.Rays.ray_partition (r : ZMod 5) (hr : r ≠ 0) : Brock.Core.Rays.Ray0 r ∨ Brock.Core.Rays.Ray1 r := by
  fin_cases r <;> simp [Brock.Core.Rays.Ray0, Brock.Core.Rays.Ray1] at * <;> tauto

theorem Brock.Core.Rays.ray_disjoint (r : ZMod 5) : ¬(Brock.Core.Rays.Ray0 r ∧ Brock.Core.Rays.Ray1 r) := by
  -- By definition of $Ray0$ and $Ray1$, we know that $Ray0 r$ and $Ray1 r$ are mutually exclusive.
  simp [Brock.Core.Rays.Ray0, Brock.Core.Rays.Ray1];
  grind

def Brock.Core.Rays.rayVal (r : ZMod 5) : Fin 2 :=
  if Brock.Core.Rays.Ray0 r then (0 : Fin 2) else (1 : Fin 2)

def Brock.Core.Rays.ray (n : ℕ) : Fin 5 := ⟨n % 5, Nat.mod_lt _ (by decide)⟩

theorem Brock.Core.Rays.ray_zero_singularity (p : ℕ) (hp : p.Prime) (h : p > 5) :
    Brock.Core.Rays.ray p ≠ ⟨0, by decide⟩ := by
  intro hc
  have hmod : p % 5 = 0 := by
    simpa [Brock.Core.Rays.ray] using congrArg Fin.val hc
  have hdiv : 5 ∣ p := Nat.dvd_of_mod_eq_zero hmod
  -- since p is prime, 5 ∣ p implies p = 5
  have : p = 5 := (hp.dvd_iff_eq (by decide)).1 hdiv
  omega

inductive Brock.Core.Rays.AllowedTwinTransition : Fin 5 → Fin 5 → Prop
  | one_to_three : Brock.Core.Rays.AllowedTwinTransition ⟨1, by decide⟩ ⟨3, by decide⟩
  | two_to_four  : Brock.Core.Rays.AllowedTwinTransition ⟨2, by decide⟩ ⟨4, by decide⟩
  | four_to_one  : Brock.Core.Rays.AllowedTwinTransition ⟨4, by decide⟩ ⟨1, by decide⟩

lemma Brock.Core.Rays.dvd_of_mod_eq_three (p : ℕ) (hmod : p % 5 = 3) : 5 ∣ (p + 2) := by
  -- (p+2) % 5 = (3+2) % 5 = 0
  have : (p + 2) % 5 = 0 := by
    calc
      (p + 2) % 5 = (p % 5 + 2 % 5) % 5 := by simpa [Nat.add_mod]
      _ = (3 + 2) % 5 := by simp [hmod]
      _ = 0 := by decide
  exact Nat.dvd_of_mod_eq_zero this

theorem Brock.Core.Rays.forbidden_transition_3 :
    ¬∃ p : ℕ, p.Prime ∧ (p + 2).Prime ∧ p > 5 ∧ Brock.Core.Rays.ray p = ⟨3, by decide⟩ := by
  rintro ⟨p, hp, hp2, hgt, hray⟩
  have hmod : p % 5 = 3 := by
    simpa [Brock.Core.Rays.ray] using congrArg Fin.val hray
  have hdiv : 5 ∣ (p + 2) := Brock.Core.Rays.dvd_of_mod_eq_three p hmod
  -- since p+2 is prime, 5 ∣ p+2 implies p+2 = 5
  have : p + 2 = 5 := (hp2.dvd_iff_eq (by decide)).1 hdiv
  omega

theorem Brock.Core.Rays.twins_follow_allowed_transitions (p : ℕ)
    (hp : p.Prime) (hp2 : (p + 2).Prime) (hgt : p > 5) :
    Brock.Core.Rays.AllowedTwinTransition (Brock.Core.Rays.ray p) (Brock.Core.Rays.ray (p + 2)) := by
      -- By examining the possible values of $p \mod 5$, we can see that the only valid transitions are those listed.
      have h_cases : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 4 := by
        have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ] ;
        exact absurd ( Nat.dvd_of_mod_eq_zero ( by norm_num [ *, Nat.add_mod ] : ( p + 2 ) % 5 = 0 ) ) ( by rw [ hp2.dvd_iff_eq ] <;> linarith );
      rcases h_cases with ( h | h | h ) <;> simp_all +decide [ Nat.add_mod, Brock.Core.Rays.ray ];
      · constructor;
      · -- Since $p \equiv 2 \pmod{5}$, we have $p + 2 \equiv 4 \pmod{5}$, which corresponds to the transition $2 \to 4$.
        apply Brock.Core.Rays.AllowedTwinTransition.two_to_four;
      · constructor

theorem Brock.Core.Rays.perfect_square_rays (n : ℕ) :
    (n ^ 2) % 5 = 0 ∨ (n ^ 2) % 5 = 1 ∨ (n ^ 2) % 5 = 4 := by
  -- brute force on n%5
  have hn : n % 5 < 5 := Nat.mod_lt _ (by decide)
  interval_cases h : (n % 5) <;> -- n%5 = 0..4
    simp [Nat.pow_two, Nat.mul_mod, Nat.add_mod, Nat.mod_mul_mod,
      h] <;> decide

abbrev Brock.Core.D4.ActiveRay := Fin 4

def Brock.Core.D4.rotate (j : Brock.Core.D4.ActiveRay) : Brock.Core.D4.ActiveRay :=
  ⟨(j.val + 1) % 4, Nat.mod_lt _ (by decide)⟩

def Brock.Core.D4.reflect (j : Brock.Core.D4.ActiveRay) : Brock.Core.D4.ActiveRay :=
  ⟨(4 - j.val) % 4, Nat.mod_lt _ (by decide)⟩

theorem Brock.Core.D4.rotate_order_4 (j : Brock.Core.D4.ActiveRay) :
    Brock.Core.D4.rotate (Brock.Core.D4.rotate (Brock.Core.D4.rotate (Brock.Core.D4.rotate j))) = j := by
  fin_cases j <;> rfl

theorem Brock.Core.D4.reflect_involution (j : Brock.Core.D4.ActiveRay) :
    Brock.Core.D4.reflect (Brock.Core.D4.reflect j) = j := by
  fin_cases j <;> rfl

theorem Brock.Core.D4.reflection_rotation_braid (j : Brock.Core.D4.ActiveRay) :
    Brock.Core.D4.reflect (Brock.Core.D4.rotate (Brock.Core.D4.reflect j)) = Brock.Core.D4.rotate (Brock.Core.D4.rotate (Brock.Core.D4.rotate j)) := by
  fin_cases j <;> rfl

theorem Brock.Core.D4.totient_5_eq_4 : Nat.totient 5 = 4 := by decide

def Brock.Core.Count.translate {q : ℕ} [NeZero q] (r₀ : ZMod q) (Γ : Finset (ZMod q)) : Finset (ZMod q) :=
  Γ.image (fun g => g + r₀)

def Brock.Core.Count.BadStart {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) (r₀ : ZMod q) : Prop := (0 : ZMod q) ∈ Brock.Core.Count.translate r₀ Γ

def Brock.Core.Count.BadStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) : Finset (ZMod q) := Γ.image (fun g => -g)

def Brock.Core.Count.GoodStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) : Finset (ZMod q) := Finset.univ \ Brock.Core.Count.BadStarts Γ

def Brock.Core.Count.GoodStart {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) (r₀ : ZMod q) : Prop := ¬ Brock.Core.Count.BadStart Γ r₀

lemma Brock.Core.Count.badStart_iff {q : ℕ} [NeZero q] {Γ : Finset (ZMod q)} {r₀ : ZMod q} :
    Brock.Core.Count.BadStart Γ r₀ ↔ r₀ ∈ Brock.Core.Count.BadStarts Γ := by
      -- By definition of `BadStart` and `BadStarts`, we can show that they are equivalent.
      simp [Brock.Core.Count.BadStart, Brock.Core.Count.BadStarts];
      -- By definition of translate, 0 is in the translate of Γ by r₀ if and only if there exists some g in Γ such that g + r₀ = 0.
      simp [Brock.Core.Count.translate];
      grind

theorem Brock.Core.Count.card_badStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) :
    (Brock.Core.Count.BadStarts Γ).card = Γ.card := by
  classical
  -- image under neg is injective
  exact Finset.card_image_of_injective Γ (fun a b h => by simpa using neg_injective h)

theorem Brock.Core.Count.good_start_law {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) :
    (Brock.Core.Count.GoodStarts Γ).card = q - Γ.card := by
      -- The cardinality of the good starts is the total number of elements in ZMod q minus the number of elements in the bad starts. This follows directly from the definition of good starts and bad starts.
      have h_card : (Brock.Core.Count.GoodStarts Γ).card = Finset.card (Finset.univ : Finset (ZMod q)) - Finset.card (Brock.Core.Count.BadStarts Γ) := by
        -- The set of good starts is the complement of the set of bad starts within the universal set.
        have h_complement : Brock.Core.Count.GoodStarts Γ = Finset.univ \ Brock.Core.Count.BadStarts Γ := by
          -- By definition of GoodStarts, we have GoodStarts Γ = Finset.univ \ BadStarts Γ.
          ext; simp [Brock.Core.Count.GoodStarts, Brock.Core.Count.BadStarts];
        grind;
      convert h_card using 1;
      simp +decide [ Finset.card_univ, Brock.Core.Count.card_badStarts ]  -- `card (ZMod q) = q`

abbrev Brock.Core.Eigen.φ : ℝ := Real.goldenRatio

lemma Brock.Core.Eigen.φ_pos : 0 < Brock.Core.Eigen.φ := Real.goldenRatio_pos
lemma Brock.Core.Eigen.φ_gt_one : 1 < Brock.Core.Eigen.φ := Real.one_lt_goldenRatio
theorem Brock.Core.Eigen.φ_sq : Brock.Core.Eigen.φ ^ 2 = Brock.Core.Eigen.φ + 1 := Real.goldenRatio_sq

theorem Brock.Core.Eigen.φ_is_root : Brock.Core.Eigen.φ ^ 2 - Brock.Core.Eigen.φ - 1 = 0 := by
